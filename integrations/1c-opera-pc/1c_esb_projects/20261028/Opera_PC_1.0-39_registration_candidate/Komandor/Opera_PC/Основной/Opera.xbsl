метод HttpExchageOperaПодготовкаЗапроса(Контекст: Opera.КонтекстВызова, Сообщение: Opera.Сообщение, Запрос: ЗапросHttp): ЗапросHttp
    
    // Отправка данных на бэк
    знч Заголовки = Запрос.Заголовки

    Заголовки.Установить("Content-Type", "application/json")
    Заголовки.Установить("Accept", "application/json")
   // Заголовки.Установить("X-Api-Key", ExchangeOpera.Параметры.API_key)

    // 1. Получаем тело сообщения в виде потока
    //знч ПотокТела = Сообщение.ПолучитьТелоКакПоток()
    // 2. Устанавливаем в тело поток сообщение из Астора в формате JSON
    //знч ТелоЗапроса = Запрос.УстановитьТело(ПотокТела)
    
    возврат Запрос
;

