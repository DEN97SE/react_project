импорт Основной
импорт ВнутреннийEDO

структура ИнформационнаяСистема
    обз пер Код: Строка
    обз пер Наименование: Строка
    обз пер Описание: Строка
    пер ИдентификаторПользователя: Строка? = ""
    пер clientid: Строка = ""
    пер clientsecret: Строка = ""
    пер ОписаниеКлюча: Строка = ""
;


структура ОписаниеИнформационнаяСистема
    обз пер Код: Строка
    обз пер Наименование: Строка
    обз пер Описание: Строка 
    обз пер ГруппаУчастников: Строка 
;

структура ТокенДоступа
    обз пер clientid: Строка
    обз пер secretid: Строка
;

метод ПолучитьСписокИнформационныхСистем(Запрос: HttpСервисЗапрос)
    
    пер ИнфоСистемы = Запрос{
        ВЫБРАТЬ
            Т.Код,
            Т.Name КАК Наименование,
            Т.Description КАК Описание,
            Т.DefaultUser КАК Пользователь
        ИЗ
            ИнформационныеСистемы КАК Т
    }
    
    пер ИдПользователя: Строка = ""
    
    знч МассивСистем = новый Массив<ИнформационнаяСистема>()
    для СтрокаТ из ИнфоСистемы.Выполнить()
        пер ИС = новый ИнформационнаяСистема(СтрокаТ.Код, СтрокаТ.Наименование, СтрокаТ.Описание)
        
        если СтрокаТ.Пользователь == Неопределено
           ИдПользователя = ""
        иначе 
            ИдПользователя = СтрокаТ.Пользователь?.Ид.ВСтроку()
        ;    
        ИС.ИдентификаторПользователя = ИдПользователя
        МассивСистем.Добавить(ИС)
    ;

    Запрос.Ответ.УстановитьТело(СериализацияJson.ЗаписатьОбъект(МассивСистем))
;


метод СоздатьИнформационнуюСистему(Запрос: HttpСервисЗапрос)
    исп Транзакция = Транзакции.Начать()
    
    попытка 
        
        пер НастройкаJSON = новый НастройкиЧтенияОбъектовJson()
        НастройкаJSON.ИгнорироватьНеизвестныеСвойства = Истина
        знч ВходящиеДанные = СериализацияJson.ПрочитатьОбъект(Запрос.Тело,
            Тип<ОписаниеИнформационнаяСистема>, 
            НастройкаJSON)
            
        пер ИнформационнаяСистема = новый ИнформационнаяСистема(
            (ВходящиеДанные).Код,
            (ВходящиеДанные).Наименование,
            (ВходящиеДанные).Описание
        )
        
        пер ГруппаУчастников = ВходящиеДанные.ГруппаУчастников
        
        пер Ид = СпискиПользователей.ПолучитьСписокПоУмолчанию().Ид
        пер ОписаниеПользователя = новый ОписаниеПользователяСервиса(
            Ид,
            ИнформационнаяСистема.Наименование,
            ИнформационнаяСистема.Код)
            
        ПользователиСервиса.Создать(ОписаниеПользователя)
        знч ТокеныДоступа = ПользователиСервиса.СгенерироватьДанныеЗапросаТокенаДоступа(ОписаниеПользователя.Ид, "Доступ к приложению через HTTP")
        
        пер ПользовательПриложения = Пользователи.Подключить(ОписаниеПользователя.Ид)
        
        //знч НовыйИС = новый  Std::IntegrationBus::ИнформационныеСистемы.Объект()
        знч НовыйИС = новый ИнформационныеСистемы.Объект()
        НовыйИС.Name = ИнформационнаяСистема.Наименование
        НовыйИС.Код = ИнформационнаяСистема.Код
        НовыйИС.Description = ИнформационнаяСистема.Описание
        НовыйИС.DefaultUser = ПользовательПриложения.Ссылка
        НовыйИС.Записать()
        
        
        ИнформационнаяСистема.ИдентификаторПользователя = НовыйИС.DefaultUser.Ид.ВСтроку()
        ИнформационнаяСистема.clientid = ТокеныДоступа.Ид
        ИнформационнаяСистема.clientsecret = ТокеныДоступа.Секрет
        //ИнформационнаяСистема.ОписаниеКлюча = ТокеныДоступа.Описание
        ИнформационнаяСистема.ОписаниеКлюча = ТокеныДоступа.Представление()
        
        ExchangeVEDO.ДобавитьУчастника(НовыйИС, НовыйИС.DefaultUser)
        ExchangeVEDO.ДобавитьУчастниковВГруппы(ГруппаУчастников, НовыйИС)
        
        Транзакция.Фиксировать()
        
        Запрос.Ответ.УстановитьТело(СериализацияJson.ЗаписатьОбъект(ИнформационнаяСистема))
        
    поймать Искл: Исключение
        Транзакция.Откатить()
        Запрос.Ответ.КодСтатуса = 500
        Запрос.Ответ.УстановитьТело(Искл.Описание)
    ;
;

// возвращает clientid и secetid
// по переданному коду ИС
метод DataGETОбработкаЗапроса(Запрос: HttpСервисЗапрос)
     
    пер параметры = Запрос.Параметры
    пер код = параметры.ПолучитьПервый("kod").ВСтроку()

    если не код.Пусто()
        пер ИдСпискаПользователей = СпискиПользователей.ПолучитьСписокПоУмолчанию()
        пер Пользователь = ПользователиСервиса.НайтиПоПредставлению(код, ИдСпискаПользователей.Ид)
        //пер Пользователь = ПользователиСервиса.НайтиПоЛогину(код, ИдСпискаПользователей.Ид)

        если Пользователь == Неопределено
            Запрос.Ответ.КодСтатуса = 500
            Запрос.Ответ.УстановитьТело("Инфосистема не найдена!")
            возврат
        ;
        пер Описание = ПользователиСервиса.СгенерироватьДанныеЗапросаТокенаДоступа(Пользователь.Ид)

        пер токены = новый ТокенДоступа(Описание.Ид, Описание.Секрет)
        Запрос.Ответ.УстановитьТело(СериализацияJson.ЗаписатьОбъект(токены))

    иначе
        Запрос.Ответ.КодСтатуса = 500
        Запрос.Ответ.УстановитьТело("Не указан kod инфосиситемы!")
    ;
       
;