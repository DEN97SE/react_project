метод МаршрутизаторПоСодержимомуВыборПолучателей(Контекст: КонтекстВызоваИнтеграции,
        Сообщение: ExchangeVEDO.Сообщение): Коллекция<УзелСхемыИнтеграции>

    пер СледующийУзел = [Схема.Узлы.ВЭДО]
    попытка
        // TODO выпилить в будущем
        //если (не Параметры.ВключитьМаршрутизациюВЭДО)
        //    возврат СледующийУзел
        //;

        пер ТипСообщения = Сообщение.ПолучитьПараметрИлиУмолчание("ТипСообщения", "Default") как Строка

        если ТипСообщения == "receipt"
            СледующийУзел = КаналДляКвитанции(Сообщение.Отправитель.Код)
        иначе
            выбор ТипСообщения
            когда "DataEDO"
                СледующийУзел = [Схема.Узлы.ВЭДОEDO]
            когда "ORDER", "DESADV", "RECADV", "APERAK"
                СледующийУзел = [Схема.Узлы.ВЭДОEDI]
            когда "SendETRN", "StatusETRN"
                СледующийУзел = [Схема.Узлы.ВЭДОэТрН]
            иначе
                СледующийУзел = [Схема.Узлы.ВЭДО]
            ;
        ;
    поймать Искл: Исключение
        пер ОшибкаМаршрутизации = новый ОшибкаМаршрутизацииСообщения(
            ИдСообщения = Сообщение.Ид, ТекстОшибки = Искл.Описание, УзелМаршрутизации = "МаршрутизаторВЭДО")
        ОшибкаМаршрутизации.Записать()
        // установим узел по умолчанию
        СледующийУзел = [Схема.Узлы.ВЭДО]
    ;

    возврат СледующийУзел
;

// возвращет следующий узел для квитанции по номеру отправителя
// если определить не получилось, то возвращаем первый канал
// если не включена маршрутизация квитанция возвращаем узел ВЭДО
// на време перехода TODO выпилить потом
// 
@ВПроекте
метод КаналДляКвитанции(КодОтправителя: Строка): Массив<УзелСхемыИнтеграции>
    // TODO выпилить в будущем
    //если (не Параметры.МаршрутизацияКвитанцийДополнитьльно)
    //    возврат [Схема.Узлы.ВЭДО]
    //;

    пер СледующийУзел = [Схема.Узлы.Квитанция1]
    // балансируем накгрузку в зависимости он номера ИС
    // если номер отличен от astor[0-9] 
    // передаем в первый канал
    пер НовыйКод = КодОтправителя.Заменить("astor", "")

    если не НовыйКод.ТолькоЦифры()
        возврат СледующийУзел
    ;

    пер КодЧисло = новый Число(НовыйКод)
    пер Остаток = КодЧисло % 5

    выбор Остаток
    когда 0
        СледующийУзел = [Схема.Узлы.Квитанция1]
    когда 1
        СледующийУзел = [Схема.Узлы.Квитанция2]
    когда 2
        СледующийУзел = [Схема.Узлы.Квитанция3]
    когда 3
        СледующийУзел = [Схема.Узлы.Квитанция4]
    когда 4
        СледующийУзел = [Схема.Узлы.Квитанция5]
    иначе
        СледующийУзел = [Схема.Узлы.Квитанция1]
    ;

    возврат СледующийУзел
;

метод МаршрутизаторВАбонентыВыборПолучателей(Контекст: КонтекстВызоваИнтеграции, Сообщение: ExchangeVEDO.Сообщение): Коллекция<УзелСхемыИнтеграции>

    пер СледующийУзел = [Схема.Узлы.ВАбоненты]
    // TODO убрать после запуска
    если не Параметры.ВключитьМаршрутизациюВАбоненты
        возврат СледующийУзел
    ;
    
    попытка
    
        пер ТипСообщения = Сообщение.ПолучитьПараметрИлиУмолчание("ТипСообщения", "Default") как Строка
        выбор ТипСообщения
        когда "ARMSupervisor", "Quickly"
            СледующийУзел = [Схема.Узлы.ВАбонентыНеЭДО]
        иначе
            СледующийУзел = [Схема.Узлы.ВАбоненты]
        ;
        
    поймать Искл: Исключение
        пер ОшибкаМаршрутизации = новый ОшибкаМаршрутизацииСообщения(
            ИдСообщения = Сообщение.Ид, ТекстОшибки = Искл.Описание, УзелМаршрутизации = "МаршрутизаторВАбоненты")
        ОшибкаМаршрутизации.Записать()
        // установим узел по умолчанию
        СледующийУзел = [Схема.Узлы.ВАбоненты]
    ;

    возврат СледующийУзел
;