Процедура РегистрыСведенийПроверкаНаличияРолиПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	Если Отказ Или Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	 
	ИмяОбъекта = Источник.Метаданные().Имя;
	
	// {{ kurzhosvl - 29.10.2025 - #Проект Онлайн продажи	
	Если ЭтоИсключениеИзПроверкиПоРолям(ИмяОбъекта) Тогда		
		Возврат;	
	КонецЕсли;
	// }} kurzhosvl - 29.10.2025 - #Проект Онлайн продажи
		
	СписокРолей = ПроверкаПравПользователяДляОбъекта(ИмяОбъекта, ПараметрыСеанса.ТекущийПользователь);
	Если ЗначениеЗаполнено(СписокРолей) Тогда
		ТекстСообщения = "Регистр сведений " + ИмяОбъекта 
		   + " может изменять только пользователь с ролью: [" + СписокРолей + "].
			|Получение данной роли необходимо согласовать с отделом по управлению Мастер Данными.";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры
