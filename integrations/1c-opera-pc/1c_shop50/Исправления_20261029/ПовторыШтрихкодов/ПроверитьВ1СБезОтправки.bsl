// Консоль кода в базе магазина 410 ПОСЛЕ замены существующей функции и обновления сеанса.
// Читает три карточки. Не запускает full, не меняет регистры и не отправляет сообщения.
КонтекстПроверки = КХ_ПилотШины.Контекст();
Если КонтекстПроверки.Номер <> 410 Тогда
    ВызватьИсключение "Этот контрольный прогон подготовлен для магазина 410";
КонецЕсли;
СЕ = ОбщиеПроцедурыИФункцииПовтИсп.ТекущаяСтруктурнаяЕдиница();
Для Каждого ШК Из СтрРазделить("4607174577787,4607031101100,2000452859001", ",") Цикл
    Карточка = КХ_ДанныеОпера.ПолучитьКарточкуПоШтрихкоду(СЕ, ШК);
    Если Карточка = Неопределено Тогда
        ВызватьИсключение "Не найдена контрольная карточка по ШК " + ШК;
    КонецЕсли;
    Уникальные = Новый Соответствие;
    Для Каждого ЗаписьШК Из Карточка.barcodes Цикл
        Ключ = ЗначениеВСтрокуВнутр(ЗаписьШК);
        Если Уникальные.Получить(Ключ) <> Неопределено Тогда
            ВызватьИсключение "Остался полный повтор в карточке " + Карточка.nomenclature_id;
        КонецЕсли;
        Уникальные.Вставить(Ключ, Истина);
    КонецЦикла;
    Сообщить(Карточка.nomenclature_id + " | " + Карточка.name);
    Сообщить(КХ_ОбменШиныОпера.ВJSON(Карточка.barcodes));
КонецЦикла;
Сообщить("Контроль полных повторов пройден. Разные упаковки сохранены; конфликты количества проверяются отдельно.");
