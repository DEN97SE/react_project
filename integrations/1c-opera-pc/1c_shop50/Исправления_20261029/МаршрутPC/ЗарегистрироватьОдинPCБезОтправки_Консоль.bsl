// ОДИН РАЗ в консоли 410. Задания отправки/очистки остановлены; PC выключен.
// Обычная карточка текущего каталога, отдельный PC-пакет; без новой full/OperaChange/Opera-пакета.
К = КХ_ПилотШины.Контекст();
Если К.Номер <> 410 ИЛИ К.Код <> "40933103-84ba-4d00-ab50-ce9efa15eda8" Тогда
    ВызватьИсключение "Выполнять только в базе магазина 410";
КонецЕсли;
Если ТранзакцияАктивна() Тогда ВызватьИсключение "Запустите вне транзакции"; КонецЕсли;
Если СервисыИнтеграции.ExchPriceChecker.ПолучитьАктивность() Тогда
    ВызватьИсключение "Сначала выключите ExchPriceChecker";
КонецЕсли;
Маршрут = КХ_ОбменШиныОпера.ПараметрыМаршрутаПрайсЧекеров();
СвойУзел = "S" + СтрЗаменить(К.Код, "-", "");
Если НЕ Маршрут.Настроен ИЛИ Маршрут.КодОтправителя <> СвойУзел
    ИЛИ Маршрут.КодПолучателя <> СвойУзел Тогда
    ВызватьИсключение "Маршрут PC не соответствует исправленной схеме своего магазина";
КонецЕсли;

Запрос = Новый Запрос(
    "ВЫБРАТЬ СтроковыйОбъект ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема = &Система И ИдентификаторОбъекта = &Ид
    | И УзелПолучатель = &Пусто И КаналСервисаИнтеграции = &Пусто");
Запрос.УстановитьПараметр("Система", "OperaState");
Запрос.УстановитьПараметр("Ид", "КХ_OperaState");
Запрос.УстановитьПараметр("Пусто", "");
Строки = Запрос.Выполнить().Выгрузить();
Если Строки.Количество() <> 1 Тогда ВызватьИсключение "Нет состояния обмена"; КонецЕсли;
Состояние = КХ_ОбменШиныОпера.ИзJSON(Строки[0].СтроковыйОбъект);

СЕ = КХ_ОбменШиныОпера.ТекущаяСЕ();
Номенклатура = КХ_ДанныеОпера.НайтиНоменклатуруПоШтрихкоду("4607174577787");
Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда ВызватьИсключение "Не найдена карточка Палпи"; КонецЕсли;
Ссылки = Новый Массив;
Ссылки.Добавить(Номенклатура);
Данные = КХ_ДанныеОпера.СформироватьСостояниеКаталога(СЕ, Ссылки);
Если Данные.products.Количество() <> 1 ИЛИ Данные.deleted_nomenclature_ids.Количество() <> 0 Тогда
    ВызватьИсключение "Палпи не входит в текущий каталог магазина";
КонецЕсли;

ИдПакетаPC = Строка(Новый УникальныйИдентификатор);
Версия = СокрЛП(Формат(Состояние.revision, "ЧГ=0;ЧДЦ=0"));
Если ПустаяСтрока(Версия) Тогда Версия = "0"; КонецЕсли;
Пакет = Новый Структура("schema_version,message_type,project,kind", 1, "products", "pricechecker", "delta");
Пакет.Вставить("batch_id", ИдПакетаPC);
Пакет.Вставить("store_id", К.Код);
Пакет.Вставить("store_code", СокрЛП(Строка(СЕ.Код)));
Пакет.Вставить("source_node", Маршрут.КодОтправителя);
Пакет.Вставить("source_epoch", Состояние.source_epoch);
Пакет.Вставить("source_revision", Версия);
Пакет.Вставить("created_at", КХ_ДанныеОпера.ДатаВJSON(ТекущаяДатаСеанса()));
Пакет.Вставить("products", Данные.products);
Пакет.Вставить("deleted_nomenclature_ids", Данные.deleted_nomenclature_ids);
КаналPC = КХ_ОбменШиныОпера.ПараметрыОбмена().КаналПрайсЧекеры;
КХ_ОбменШиныОпера.ЗарегистрироватьПакет(Пакет, "PriceCheker", КаналPC, Маршрут.КодПолучателя);

Запрос = Новый Запрос(
    "ВЫБРАТЬ ИдентификаторОбъекта, ВнешняяСистема, СтатусСообщения,
    | КаналСервисаИнтеграции, УзелПолучатель
    |ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема = &Система И ИдентификаторОбъекта = &Ид");
Запрос.УстановитьПараметр("Система", "PriceCheker");
Запрос.УстановитьПараметр("Ид", ИдПакетаPC);
Строки = Запрос.Выполнить().Выгрузить();
Если Строки.Количество() <> 1 Тогда ВызватьИсключение "После регистрации не найдена единственная строка PC"; КонецЕсли;
Сообщить("batch_id: " + ИдПакетаPC);
Сообщить("Система: " + Строки[0].ВнешняяСистема);
Сообщить("Статус: " + Строка(Строки[0].СтатусСообщения));
Сообщить("Канал: " + Строки[0].КаналСервисаИнтеграции);
Сообщить("Получатель: " + Строки[0].УзелПолучатель);
Сообщить("Зарегистрирована одна строка PC. Отправка не запускалась. Повторно этот блок не выполняйте.");
