// В консоли базы 410. Задания подготовки/отправки остановлены, оба сервиса выключены.
// Только доготовка текущей full и уже принятых запросов; самостоятельные новые full не запускаются.
К = КХ_ПилотШины.Контекст();
Если К.Номер <> 410 ИЛИ К.Код <> "40933103-84ba-4d00-ab50-ce9efa15eda8" Тогда
    ВызватьИсключение "Этот блок подготовлен для магазина 410";
КонецЕсли;
Для Каждого Имя Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
    Если СервисыИнтеграции[Имя].ПолучитьАктивность() Тогда
        ВызватьИсключение "Сначала выключите " + Имя;
    КонецЕсли;
КонецЦикла;

Запрос = Новый Запрос(
    "ВЫБРАТЬ СтроковыйОбъект
    |ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема = &Система
    | И ИдентификаторОбъекта = &Ид
    | И УзелПолучатель = &Пусто
    | И КаналСервисаИнтеграции = &Пусто");
Запрос.УстановитьПараметр("Система", "OperaState");
Запрос.УстановитьПараметр("Ид", "КХ_OperaState");
Запрос.УстановитьПараметр("Пусто", "");

Подготовлено = 0;
Для НомерПорции = 1 По 20 Цикл
    Таблица = Запрос.Выполнить().Выгрузить();
    Если Таблица.Количество() <> 1 Тогда
        ВызватьИсключение "Нет единственного состояния обмена";
    КонецЕсли;
    С = КХ_ОбменШиныОпера.ИзJSON(Таблица[0].СтроковыйОбъект);
    Если НЕ С.full_active Тогда
        Если С.catalog_requests.Количество() = 0 Тогда Прервать; КонецЕсли;
        // Вызываем только при существующем запросе: его session_id уже сохранён.
        КХ_ОбменШиныОпера.ПодготовитьНачалоПолнойВыгрузкиКаталога();
    КонецЕсли;
    Если КХ_ОбменШиныОпера.ПодготовитьСледующийПолныйПакет() Тогда
        Подготовлено = Подготовлено + 1;
    КонецЕсли;
КонецЦикла;

Таблица = Запрос.Выполнить().Выгрузить();
Если Таблица.Количество() <> 1 Тогда
    ВызватьИсключение "Нет единственного состояния обмена";
КонецЕсли;
С = КХ_ОбменШиныОпера.ИзJSON(Таблица[0].СтроковыйОбъект);
Сообщить("Подготовлено порций: " + Строка(Подготовлено));
Сообщить("full_active=" + Строка(С.full_active)
    + "; сохранённых запросов=" + Строка(С.catalog_requests.Количество()));

Если НЕ С.full_active И С.catalog_requests.Количество() = 0 Тогда
    КХ_ПилотШины.ИсправитьАдресБэкаPC();
    КХ_ПилотШины.Показать();
Иначе
    Если С.full_active Тогда
        Сообщить("Сессия=" + С.full.session_id
            + "; следующая порция=" + Строка(С.full.next_sequence)
            + "/" + Строка(С.full.total_batches));
    КонецЕсли;
    Сообщить("Осталась подготовка. Повторите этот же блок. Отправка не запускалась.");
КонецЕсли;
