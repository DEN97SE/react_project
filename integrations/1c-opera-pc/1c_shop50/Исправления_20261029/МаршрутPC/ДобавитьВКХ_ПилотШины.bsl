// {{ semidockij - 29.10.2026 - Исправление адреса PC без смены магазина и содержимого пакетов
// Перед вызовом остановить задания выгрузки и оба подключения; дождаться завершения обработки.
Процедура ИсправитьАдресБэкаPC() Экспорт
    К = Контекст();
    Если (К.Номер = 410 И К.Код <> "40933103-84ba-4d00-ab50-ce9efa15eda8")
        ИЛИ (К.Номер = 50 И К.Код <> "3370588b-0742-11e0-b9c1-001a64c3f566") Тогда
        ВызватьИсключение "GUID не соответствует тестовому магазину";
    КонецЕсли;
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "Запустите вне транзакции"; КонецЕсли;
    Для Каждого Имя Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
        Если СервисыИнтеграции[Имя].ПолучитьАктивность() Тогда
            ВызватьИсключение "Сначала выключите " + Имя + " и дождитесь остановки подключения";
        КонецЕсли;
    КонецЦикла;

    Узел = "S" + СтрЗаменить(К.Код, "-", "");
    СтарыеАдреса = Новый Массив;
    СтарыеАдреса.Добавить("Backend_PC");
    // В присланном Применить() адрес 410 был зашит также для базы 50.
    Если К.Номер = 50 Тогда СтарыеАдреса.Добавить("S4093310384ba4d00ab50ce9efa15eda8"); КонецЕсли;

    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Элемент = Блокировка.Добавить("РегистрСведений.ОчередьШины");
        Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        Элемент.УстановитьЗначение("ВнешняяСистема", "OperaState");
        Элемент.УстановитьЗначение("ИдентификаторОбъекта", "КХ_OperaState");
        Элемент.УстановитьЗначение("УзелПолучатель", "");
        Элемент.УстановитьЗначение("КаналСервисаИнтеграции", "");
        Элемент = Блокировка.Добавить("РегистрСведений.ОчередьШины");
        Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        Элемент.УстановитьЗначение("ВнешняяСистема", "PriceCheker");
        Блокировка.Заблокировать();

        НаборСостояния = РегистрыСведений.ОчередьШины.СоздатьНаборЗаписей();
        НаборСостояния.ОбменДанными.Загрузка = Истина;
        НаборСостояния.Отбор.ВнешняяСистема.Установить("OperaState");
        НаборСостояния.Отбор.ИдентификаторОбъекта.Установить("КХ_OperaState");
        НаборСостояния.Отбор.УзелПолучатель.Установить("");
        НаборСостояния.Отбор.КаналСервисаИнтеграции.Установить("");
        НаборСостояния.Прочитать();
        Если НаборСостояния.Количество() <> 1 Тогда ВызватьИсключение "Нет единственного состояния обмена"; КонецЕсли;
        Состояние = КХ_ОбменШиныОпера.ИзJSON(НаборСостояния[0].СтроковыйОбъект);
        Если КХ_ОбменШиныОпера.СтроковоеПоле(Состояние, "pc_store_id") <> К.Код
            ИЛИ КХ_ОбменШиныОпера.СтроковоеПоле(Состояние, "pc_node_code") <> Узел Тогда
            ВызватьИсключение "Отправитель PC не совпадает с текущей ИС; это не исправление адреса";
        КонецЕсли;
        Если Состояние.full_active ИЛИ Состояние.catalog_requests.Количество() > 0 Тогда
            ВызватьИсключение "Сначала завершите подготовку текущей full/запросов; новую full не запускайте";
        КонецЕсли;
        ПрежнийБэк = КХ_ОбменШиныОпера.СтроковоеПоле(Состояние, "pc_backend_node");
        Если ПрежнийБэк <> Узел И СтарыеАдреса.Найти(ПрежнийБэк) = Неопределено Тогда
            ВызватьИсключение "Неожиданный прежний адрес PC: " + ПрежнийБэк;
        КонецЕсли;

        Набор = РегистрыСведений.ОчередьШины.СоздатьНаборЗаписей();
        Набор.ОбменДанными.Загрузка = Истина;
        Набор.Отбор.ВнешняяСистема.Установить("PriceCheker");
        Набор.Прочитать();
        Резерв = Новый Структура("Состояние,Очередь", НаборСостояния.Выгрузить(), Набор.Выгрузить());
        Перенесено = 0;
        Ключи = Новый Соответствие;
        Для Каждого СтрокаОчереди Из Набор Цикл
            Если СтрокаОчереди.СтатусСообщения <> Перечисления.СтатусыСообщенийШины.ДоставкаПодтверждена Тогда
                Д = КХ_ОбменШиныОпера.ИзJSON(СтрокаОчереди.СтроковыйОбъект);
                Если КХ_ОбменШиныОпера.СтроковоеПоле(Д, "store_id") <> К.Код
                    ИЛИ КХ_ОбменШиныОпера.СтроковоеПоле(Д, "source_node") <> Узел
                    ИЛИ КХ_ОбменШиныОпера.СтроковоеПоле(Д, "project") <> "pricechecker"
                    ИЛИ КХ_ОбменШиныОпера.СтроковоеПоле(Д, "message_type") <> "products" Тогда
                    ВызватьИсключение "Неподтверждённый PC-пакет требует отдельного разбора: " + СтрокаОчереди.ИдентификаторОбъекта;
                КонецЕсли;
                Если XMLСтрока(Новый УникальныйИдентификатор(Д.batch_id)) <> СокрЛП(СтрокаОчереди.ИдентификаторОбъекта) Тогда
                    ВызватьИсключение "batch_id не совпадает с ключом очереди";
                КонецЕсли;
                Если СокрЛП(СтрокаОчереди.УзелПолучатель) <> Узел Тогда
                    Если СтарыеАдреса.Найти(СокрЛП(СтрокаОчереди.УзелПолучатель)) = Неопределено Тогда
                        ВызватьИсключение "Неожиданный адрес пакета PC: " + СтрокаОчереди.УзелПолучатель;
                    КонецЕсли;
                    СтрокаОчереди.УзелПолучатель = Узел;
                    СтрокаОчереди.СтатусСообщения = Перечисления.СтатусыСообщенийШины.ОжидаетОтправки;
                    СтрокаОчереди.ИдентификаторСообщения = "";
                    СтрокаОчереди.Объект = "";
                    СтрокаОчереди.ДатаОтправки = Дата(1, 1, 1);
                    СтрокаОчереди.ДатаЗагрузки = Дата(1, 1, 1);
                    СтрокаОчереди.ТекстОшибки = "Исправлен транспортный адрес PC; требуется новая попытка отправки";
                    Перенесено = Перенесено + 1;
                КонецЕсли;
            КонецЕсли;
            Ключ = ЗначениеВСтрокуВнутр(Новый Структура("Ид,Узел,Канал", СтрокаОчереди.ИдентификаторОбъекта,
                СтрокаОчереди.УзелПолучатель, СтрокаОчереди.КаналСервисаИнтеграции));
            Если Ключи.Получить(Ключ) <> Неопределено Тогда
                ВызватьИсключение "Перенос создаёт дубль ключа; очередь не изменена";
            КонецЕсли;
            Ключи.Вставить(Ключ, Истина);
        КонецЦикла;

        АдресРезерва = ПоместитьВоВременноеХранилище(Резерв, Новый УникальныйИдентификатор);
        Если Перенесено > 0 Тогда Набор.Записать(Истина); КонецЕсли;
        Если ПрежнийБэк <> Узел Тогда
            Состояние.Вставить("pc_backend_node", Узел);
            НаборСостояния[0].СтроковыйОбъект = КХ_ОбменШиныОпера.ВJSON(Состояние);
            НаборСостояния.Записать(Истина);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Сообщить("PC магазина " + Строка(К.Номер) + ": получатель=" + Узел + "; перенесено=" + Строка(Перенесено));
    Сообщить("Временная копия до исправления: " + АдресРезерва);
    Сообщить("batch_id, JSON, канал, source_node и подтверждённые записи сохранены. Отправка не запускалась.");
КонецПроцедуры
// }} semidockij - 29.10.2026
