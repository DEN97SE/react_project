// {{ semidockij - 28.10.2026 - Регистрация и проверка пилота

// Читает внешний GUID текущей СЕ, независимо от названия базы.
Функция Контекст() Экспорт
    СЕ = ОбщиеПроцедурыИФункцииПовтИсп.ТекущаяСтруктурнаяЕдиница();

    Если НЕ ЗначениеЗаполнено(СЕ) Тогда
        ВызватьИсключение "Текущая СЕ не определена";
    КонецЕсли;

    Номер = Число(СЕ.НомерМагазина);

    Если Номер <> 50 И Номер <> 410 Тогда
        ВызватьИсключение "Этот пилот только для №50/№410";
    КонецЕсли;

    GUID = Строка(Новый УникальныйИдентификатор(
        СокрЛП(Строка(СЕ.СтроковыйИдентификатор))));

    Если GUID = "00000000-0000-0000-0000-000000000000" Тогда
        ВызватьИсключение "Нулевой GUID СЕ";
    КонецЕсли;

    Имя = "K" + Прав("0000" + Формат(Номер, "ЧДЦ=0;ЧГ=0"), 4);

    Возврат Новый Структура(
        "Код,Наименование,Номер", GUID, Имя, Номер);
КонецФункции

// Читает нашу часть очереди без отправки и изменения состояния.
Функция Очередь() Экспорт
    Запрос = Новый Запрос(
    "ВЫБРАТЬ
    |	ОчередьШины.ВнешняяСистема КАК ВнешняяСистема,
    |	ОчередьШины.ИдентификаторОбъекта КАК ИдентификаторОбъекта,
    |	ОчередьШины.УзелПолучатель КАК УзелПолучатель,
    |	ОчередьШины.КаналСервисаИнтеграции КАК КаналСервисаИнтеграции,
    |	ОчередьШины.СтатусСообщения КАК СтатусСообщения,
    |	ОчередьШины.СтроковыйОбъект КАК СтроковыйОбъект
    |ИЗ
    |	РегистрСведений.ОчередьШины КАК ОчередьШины
    |ГДЕ
    |	ОчередьШины.ВнешняяСистема В (""Opera"", ""PriceCheker"", ""StructuralUnits"", ""OperaState"", ""OperaChange"")
    |
    |УПОРЯДОЧИТЬ ПО
    |	ОчередьШины.ВнешняяСистема,
    |	ОчередьШины.ИдентификаторОбъекта,
    |	ОчередьШины.УзелПолучатель,
    |	ОчередьШины.КаналСервисаИнтеграции");

    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Показывает контекст и пакеты, не выводя тела товаров и ключи.
Процедура Показать() Экспорт
    Контекст = Контекст();

    Сообщить("Магазин=" + Строка(Контекст.Номер)
        + "; GUID=" + Контекст.Код);

    Для Каждого Запись Из Очередь() Цикл
        Если СокрЛП(Запись.ВнешняяСистема) = "OperaChange" Тогда
            Продолжить;
        КонецЕсли;

        Если СокрЛП(Запись.ВнешняяСистема) = "OperaState" Тогда
            Если СокрЛП(Запись.ИдентификаторОбъекта) = "КХ_OperaState" Тогда
                Данные = КХ_ОбменШиныОпера.ИзJSON(
                    Запись.СтроковыйОбъект);

                Сообщить("Товары: revision="
                    + Строка(Данные.revision)
                    + "; full_active=" + Строка(Данные.full_active));
            КонецЕсли;

            Продолжить;
        КонецЕсли;

        Сообщить(СокрЛП(Запись.ВнешняяСистема)
            + " | " + СокрЛП(Запись.ИдентификаторОбъекта)
            + " | " + Строка(Запись.СтатусСообщения)
            + " | " + СокрЛП(Запись.УзелПолучатель));
    КонецЦикла;
КонецПроцедуры

// Не позволяет сменить личность поверх незавершённого обмена.
Процедура ПроверитьПереход()
    Контекст = Контекст();

    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "Запуск вне транзакции";
    КонецЕсли;

    Для Каждого Запись Из Очередь() Цикл
        Система = СокрЛП(Запись.ВнешняяСистема);

        Если Система = "Opera"
            ИЛИ Система = "PriceCheker"
            ИЛИ Система = "StructuralUnits" Тогда

            Если Запись.СтатусСообщения <>
                Перечисления.СтатусыСообщенийШины.ДоставкаПодтверждена Тогда

                ВызватьИсключение
                    "Есть неподтвержденные пакеты: сначала завершите прежний обмен";
            КонецЕсли;

        ИначеЕсли Система = "OperaChange" Тогда
            ВызватьИсключение
                "Есть маркеры изменений: сначала обработайте их прежним обменом";

        ИначеЕсли Система = "OperaState" Тогда
            Узел = СокрЛП(Запись.УзелПолучатель);

            Если СтрНайти(Узел, "КХ_СЕRequest_") = 1
                ИЛИ СтрНайти(Узел, "КХ_CatalogRequest_") = 1 Тогда

                Если Запись.СтатусСообщения =
                    Перечисления.СтатусыСообщенийШины.ОжидаетОтправки Тогда

                    ВызватьИсключение
                        "Есть сохраненные запросы выгрузки";
                КонецЕсли;
            КонецЕсли;

            Ид = СокрЛП(Запись.ИдентификаторОбъекта);

            Если Ид = "КХ_OperaState" ИЛИ Ид = "КХ_СЕState" Тогда
                Данные = КХ_ОбменШиныОпера.ИзJSON(
                    Запись.СтроковыйОбъект);

                Значение = Ложь;

                Если Данные.Свойство("full_active", Значение)
                    И Значение Тогда

                    ВызватьИсключение "Есть активная full-сессия";
                КонецЕсли;

                Запросы = Неопределено;

                Если Данные.Свойство("catalog_requests", Запросы) Тогда
                    Если Запросы.Количество() > 0 Тогда
                        ВызватьИсключение "Есть запросы каталога";
                    КонецЕсли;
                КонецЕсли;

                Если Ид = "КХ_СЕState" Тогда
                    Источник = КХ_ОбменШиныОпера.СтроковоеПоле(
                        Данные, "source_node");

                    Если НЕ ПустаяСтрока(Источник) Тогда
                        ВызватьИсключение
                            "База настроена источником справочника; переход согласуйте со старым обратным маршрутом";
                    КонецЕсли;
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    Для Каждого Имя Из СтрРазделить(
        "ExchOperaPC,ExchPriceChecker", ",") Цикл

        Если Метаданные.СервисыИнтеграции.Найти(Имя) =
            Неопределено Тогда

            ВызватьИсключение "Нет сервиса " + Имя;
        КонецЕсли;

        Если СервисыИнтеграции[Имя].ПолучитьАктивность() Тогда
            ВызватьИсключение "Перед переходом выключите "
                + Имя + " и проверьте остановку подключения";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

// Получает токен, не выводя ответ авторизации и секрет.
Функция Токен(Идентификатор, Секрет)
    Если ПустаяСтрока(Идентификатор) ИЛИ ПустаяСтрока(Секрет) Тогда
        ВызватьИсключение "Ключ не заполнен";
    КонецЕсли;

    Basic = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(
        Идентификатор + ":" + Секрет));

    Basic = СтрЗаменить(
        СтрЗаменить(Basic, Символы.ПС, ""), Символы.ВК, "");

    Запрос = Новый HTTPЗапрос("/auth/oidc/token");
    Запрос.Заголовки.Вставить("Authorization", "Basic " + Basic);
    Запрос.Заголовки.Вставить(
        "Content-Type", "application/x-www-form-urlencoded");
    Запрос.УстановитьТелоИзСтроки("grant_type=client_credentials");

    Соединение = Новый HTTPСоединение(
        "program58", 9090, , , , 30);

    Ответ = Соединение.ОтправитьДляОбработки(Запрос);

    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "Авторизация HTTP "
            + Строка(Ответ.КодСостояния);
    КонецЕсли;

    Возврат КХ_ОбменШиныОпера.ИзJSON(
        Ответ.ПолучитьТелоКакСтроку()).id_token;
КонецФункции

// Выполняет один запрос; ошибочный POST автоматически не повторяет.
Функция HTTP(Путь, Токен, Тело = Неопределено)
    Запрос = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);

    Соединение = Новый HTTPСоединение(
        "program58", 9090, , , , 30);

    Если Тело = Неопределено Тогда
        Ответ = Соединение.Получить(Запрос);
    Иначе
        Запрос.Заголовки.Вставить(
            "Content-Type", "application/json; charset=utf-8");
        Запрос.УстановитьТелоИзСтроки(
            КХ_ОбменШиныОпера.ВJSON(Тело), КодировкаТекста.UTF8);
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
    КонецЕсли;

    Если Ответ.КодСостояния <> 200 Тогда
        Сообщить("HTTP " + Строка(Ответ.КодСостояния));
        Сообщить(Лев(Ответ.ПолучитьТелоКакСтроку(), 3000));

        ВызватьИсключение "HTTP "
            + Строка(Ответ.КодСостояния)
            + "; POST не повторять до проверки состояния";
    КонецЕсли;

    Возврат КХ_ОбменШиныОпера.ИзJSON(
        Ответ.ПолучитьТелоКакСтроку());
КонецФункции

// Показывает существующие ИС и учётки без регистрации.
Процедура Диагностика(АдминID, АдминСекрет) Экспорт
    Контекст = Контекст();

    Данные = HTTP(
        "/applications/Opera-PC/api/infobases/pilot-status?kod="
        + Контекст.Код + "&name=" + Контекст.Наименование,
        Токен(АдминID, АдминСекрет));

    Сообщить(КХ_ОбменШиныОпера.ВJSON(Данные));
КонецПроцедуры

// Регистрирует пилот и сохраняет обычный ключ во временном хранилище.
Функция Зарегистрировать(
    АдминID, АдминСекрет, ОжидаемыйUserID = "") Экспорт

    ПроверитьПереход();
    Контекст = Контекст();

    Заявка = Новый Структура(
        "Код,Наименование,ОжидаемыйПользователь",
        Контекст.Код, Контекст.Наименование, ОжидаемыйUserID);

    Данные = HTTP(
        "/applications/Opera-PC/api/infobases/pilot-enroll",
        Токен(АдминID, АдминСекрет), Заявка);

		Если Данные.code <> Контекст.Код ИЛИ НЕ Данные.created Тогда
			
			ВызватьИсключение
			"Получен неполный ответ регистрации; ключ не применяется";
		КонецЕсли; 
		Сообщить("Создана ИС: " + Данные.node_code);
		Сообщить("Новые пользователи и ключи не создавались.");

    Возврат ПоместитьВоВременноеХранилище(
        Данные, Новый УникальныйИдентификатор);
КонецФункции

// Проверяет принадлежность временного результата своей базе.
Функция ДанныеРегистрации(Адрес)
    Данные = ПолучитьИзВременногоХранилища(Адрес);

    Если ТипЗнч(Данные) <> Тип("Структура") Тогда
        ВызватьИсключение "Нет ответа в этом сеансе/базе";
    КонецЕсли;

    Если Данные.code <> Контекст().Код Тогда
        ВызватьИсключение "Ответ другого магазина";
    КонецЕсли;
	
	КодУчастника = "";
	
	Если НЕ Данные.Свойство("node_code", КодУчастника) Тогда
		ВызватьИсключение
		"Нет node_code: проверьте публикацию точечной правки HTTP";
	КонецЕсли;
	
	Если КодУчастника <> "S" + СтрЗаменить(Данные.code, "-", "") Тогда
		ВызватьИсключение
		"Код участника не соответствует магазину; настройки не применяются";
	КонецЕсли;
	
	Если ПустаяСтрока(Данные.clientid)
		ИЛИ ПустаяСтрока(Данные.clientsecret) Тогда
		
		ВызватьИсключение
		"Сейчас создана только ИС. Подключение общим ключом проверяем отдельно";
	КонецЕсли;
	
    Возврат Данные;
КонецФункции

// Принимает обычный ключ проверенной существующей GUID-ИС.
// Сам ключей не выпускает.
Функция ПринятьКлюч(Идентификатор, Секрет) Экспорт
    ПроверитьПереход();

    Если ПустаяСтрока(Идентификатор) ИЛИ ПустаяСтрока(Секрет) Тогда
		ВызватьИсключение "Пустой магазинный ключ";
	КонецЕсли;
	
	GUID = Контекст().Код;
	
	Данные = Новый Структура(
	"code,node_code,clientid,clientsecret",
	GUID,
	"S" + СтрЗаменить(GUID, "-", ""),
	Идентификатор,
	Секрет);

    Возврат ПоместитьВоВременноеХранилище(
        Данные, Новый УникальныйИдентификатор);
КонецФункции

// Показывает разрешённые каналы обычного магазинного ключа.
Процедура Каналы(Адрес) Экспорт
    Данные = ДанныеРегистрации(Адрес);

    Список = HTTP(
        "/applications/Opera-PC/sys/esb/runtime/channels",
        Токен(Данные.clientid, Данные.clientsecret));

    Каналы = Новый Соответствие;

    Для Каждого Канал Из Список.items Цикл
        Если ПустаяСтрока(Канал.destination) Тогда
            ВызватьИсключение "Пустой destination";
		КонецЕсли;
		
		Ключ = Канал.process + "|" + Канал.channel;
		
		Старый = Каналы.Получить(Ключ);
		
		Если Старый <> Неопределено И Старый <> Канал.destination Тогда
			ВызватьИсключение "Разные destination для канала " + Ключ;
		КонецЕсли;
		
		Каналы.Вставить(Ключ, Канал.destination);
		Сообщить(Ключ + " -> " + Канал.destination);
        Сообщить(Канал.channel + " -> " + Канал.destination);
    КонецЦикла;

    Если Каналы.Количество() < 4 Тогда
        ВызватьИсключение
            "Недостаточно каналов для двух процессов; проверьте участие/группы/запуск";
    КонецЕсли;
КонецПроцедуры

// Записывает подключения последовательно, оставляя сервисы выключенными.
Процедура Применить(
    АдресХранилища, АдресOpera = "", АдресPC = "",
    ЛокальныйПользователь = "") Экспорт

    ПроверитьПереход();
    Данные = ДанныеРегистрации(АдресХранилища);
    Подготовленные = Новый Массив;

    Для Каждого Имя Из СтрРазделить(
        "ExchOperaPC,ExchPriceChecker", ",") Цикл

        Настройки = СервисыИнтеграции[Имя].ПолучитьНастройки();
        НовыйАдрес = ?(Имя = "ExchOperaPC", АдресOpera, АдресPC);

        Если НЕ ПустаяСтрока(НовыйАдрес) Тогда
            Настройки.АдресВнешнегоСервисаИнтеграции = НовыйАдрес;
        КонецЕсли;

        Если ПустаяСтрока(
            Настройки.АдресВнешнегоСервисаИнтеграции) Тогда

            ВызватьИсключение
                "Заполните проверенный адрес сервиса " + Имя;
        КонецЕсли;

        Если НЕ ПустаяСтрока(ЛокальныйПользователь) Тогда
            Настройки.ИмяПользователя = ЛокальныйПользователь;
        КонецЕсли;

        Если ПустаяСтрока(Настройки.ИмяПользователя) Тогда
            ВызватьИсключение
                "Заполните локального пользователя выполнения " + Имя;
        КонецЕсли;

        Настройки.ИмяПользователяВнешнегоСервисаИнтеграции = Данные.clientid;
        Настройки.ПарольПользователяВнешнегоСервисаИнтеграции = Данные.clientsecret;

        Подготовленные.Добавить(Новый Структура("Имя,Настройки", Имя, Настройки));
    КонецЦикла;

    Для Каждого Пункт Из Подготовленные Цикл
        СервисыИнтеграции[Пункт.Имя].УстановитьНастройки(Пункт.Настройки);
    КонецЦикла;

	КХ_ОбменШиныОпера.НастроитьМаршрутПрайсЧекеров(Данные.node_code, "S4093310384ba4d00ab50ce9efa15eda8");
	
	КХ_ОбменШиныОпера.НастроитьПолучателяОпера("BackendOpera");
	
	КХ_ОбменШиныОпера.УстановитьКодУзлаОтправителя(Данные.node_code);
	
	Сообщить("Запись завершена. Сервисы выключены. Через 20 секунд выполните ПроверитьНастройку().");
	
КонецПроцедуры

// Проверяет оба постоянных подключения перед удалением временной копии.
Процедура ПроверитьНастройку(Адрес) Экспорт
    Данные = ДанныеРегистрации(Адрес);

    Для Каждого Имя Из СтрРазделить(
        "ExchOperaPC,ExchPriceChecker", ",") Цикл

        Настройки = СервисыИнтеграции[Имя].ПолучитьНастройки();

        Если Настройки.ИмяПользователяВнешнегоСервисаИнтеграции <>
            Данные.clientid
            ИЛИ Настройки.ПарольПользователяВнешнегоСервисаИнтеграции <>
            Данные.clientsecret Тогда

            ВызватьИсключение "Не подтверждена запись ключа "
                + Имя + "; временную копию сохраните";
        КонецЕсли;
    КонецЦикла;

	Маршрут = КХ_ОбменШиныОпера.ПараметрыМаршрутаПрайсЧекеров();
	
	Если КХ_ОбменШиныОпера.КодУзлаОтправителя() <> Данные.node_code
		ИЛИ Маршрут.КодОтправителя <> Данные.node_code
		ИЛИ Маршрут.КодПолучателя <> "S4093310384ba4d00ab50ce9efa15eda8" Тогда
		
		ВызватьИсключение "Не совпали маршруты";
	КонецЕсли;       
	
    УдалитьИзВременногоХранилища(Адрес);

    Сообщить("Настройки проверены. Временная копия удалена. Доставка ещё не проверена."); 
	
КонецПроцедуры

// Продолжает одну full-сессию и готовит максимум две очередные порции.
Процедура ПодготовитьFull() Экспорт
    Контекст();

    Сессия = КХ_ОбменШиныОпера.НачатьПолнуюВыгрузку(200);

    Если Сессия <>
        КХ_ОбменШиныОпера.НачатьПолнуюВыгрузку(200) Тогда

        ВызватьИсключение "Повтор создал другую full-сессию";
    КонецЕсли;

    Для Индекс = 1 По 2 Цикл
        Если НЕ КХ_ОбменШиныОпера.ПодготовитьСледующийПолныйПакет() Тогда
            Прервать;
        КонецЕсли;
    КонецЦикла;

    Сообщить("FULL session=" + Сессия
        + "; две подготовки используют одну сессию");
КонецПроцедуры

// Отправляет реальные пакеты обоим бэкам без очистки подтверждённых строк.
Процедура Отправить() Экспорт
    Контекст();

    КХ_ОбменШиныОпера.ОтправитьПорциюПакетов("Opera", 20);
    КХ_ОбменШиныОпера.ОтправитьПорциюПакетов("PriceCheker", 20);

    Сообщить(
        "Попытки отправки завершены. Результат проверяется по данным бэков и реальным ACK.");
КонецПроцедуры

// Проверяет отказ чужому магазину, не подтверждая реальные пакеты.
Процедура ТестЧужогоACK() Экспорт
    Контекст();
    Снимок = ЗначениеВСтрокуВнутр(Очередь());

    ЧужойМагазин = Строка(Новый УникальныйИдентификатор);

    Если ЧужойМагазин = Контекст().Код Тогда
        ВызватьИсключение "Повторите генерацию тестового ID";
    КонецЕсли;

    Для Каждого Система Из СтрРазделить(
        "Opera,PriceCheker", ",") Цикл

        ACK = Новый Структура(
            "message_type,store_id,batch_id,status",
            "ack", ЧужойМагазин,
            Строка(Новый УникальныйИдентификатор), "processed");

        Отклонен = Ложь;

        Попытка
            КХ_ОбменШиныОпера.ОбработатьПодтверждение(ACK, Система);
        Исключение
            Отклонен = СтрНайти(
                ОписаниеОшибки(), "другому магазину") > 0;
        КонецПопытки;

        Если НЕ Отклонен Тогда
            ВызватьИсключение
                "FAIL: не подтвержден ожидаемый отказ чужому магазину "
                + Система;
        КонецЕсли;
    КонецЦикла;

    Если Снимок <> ЗначениеВСтрокуВнутр(Очередь()) Тогда
        ВызватьИсключение
            "Очередь изменилась во время теста; проверьте фоновые задания";
    КонецЕсли;

    Сообщить(
        "PASS: чужой магазин отклонён обоими проектами, очередь не изменилась");
КонецПроцедуры

// Проверяет выбор сервиса, прежний PC-канал и запрет подмены проекта.
Процедура ТестМаршрутов() Экспорт
    Opera = "Основной_ExchangeOpera_FromOpera";
    PC = "Основной_PC_FromShops";
    СтарыйPC = "Основной_PriceChekerExc_FromShops";

    Проверки = Новый Массив;

    Проверки.Добавить(Новый Структура(
        "Система,Канал,Проект,Сервис",
        "Opera", Opera + "   ", "", "ExchOperaPC"));

    Проверки.Добавить(Новый Структура(
        "Система,Канал,Проект,Сервис",
        "PriceCheker", PC, "", "ExchPriceChecker"));

    Проверки.Добавить(Новый Структура(
        "Система,Канал,Проект,Сервис",
        "PriceCheker", СтарыйPC + "  ", "", "ExchPriceChecker"));

    Проверки.Добавить(Новый Структура(
        "Система,Канал,Проект,Сервис",
        "StructuralUnits", PC, "pricechecker", "ExchPriceChecker"));

    Для Каждого Проверка Из Проверки Цикл
        Сохраненный = Проверка.Канал;

        Результат = КХ_ОбменШиныОпера.МаршрутКаналаОтправки(
            Проверка.Система, Проверка.Канал, Проверка.Проект);

        Если Результат.СервисИнтеграции <> Проверка.Сервис
            ИЛИ Проверка.Канал <> Сохраненный Тогда

            ВызватьИсключение
                "FAIL: неверный сервис либо изменился сохранённый канал";
        КонецЕсли;
    КонецЦикла;

    Отклонен = Ложь;

    Попытка
        КХ_ОбменШиныОпера.МаршрутКаналаОтправки("Opera", PC);
    Исключение
        Отклонен = СтрНайти(
            ОписаниеОшибки(), "не соответствует проекту Opera") > 0;
    КонецПопытки;

    Если НЕ Отклонен Тогда
        ВызватьИсключение "FAIL: PC-канал принят как Opera";
    КонецЕсли;

    Сообщить(
        "PASS: четыре допустимых маршрута, пробелы и отказ подмене проекта");
КонецПроцедуры

// Проверяет ожидаемый 409 повторного POST уже существующей ИС.
Процедура ТестПовторногоPOST(АдминID, АдминСекрет) Экспорт
    Контекст = Контекст();
    Токен = Токен(АдминID, АдминСекрет);

    Путь = "/applications/Opera-PC/api/infobases/pilot-status?kod="
        + Контекст.Код + "&name=" + Контекст.Наименование;

    До = HTTP(Путь, Токен);
                                                       
    Если До.count <> 1 Тогда
        ВызватьИсключение
            "Тест повтора только для уже существующей единственной ИС";
    КонецЕсли;

    Отклонен = Ложь;

    Попытка
        HTTP("/applications/Opera-PC/api/infobases/pilot-enroll",
            Токен, Новый Структура(
                "Код,Наименование",
                Контекст.Код, Контекст.Наименование));
    Исключение
        Отклонен = СтрНайти(ОписаниеОшибки(), "HTTP 409") > 0;
    КонецПопытки;

    После = HTTP(Путь, Токен);

    Если НЕ Отклонен
        ИЛИ До.count <> После.count
        ИЛИ До.user_id <> После.user_id
        ИЛИ До.credential_id <> После.credential_id Тогда

        ВызватьИсключение
            "FAIL: повтор регистрации не соответствует контракту";
    КонецЕсли;

    Сообщить(
        "PASS: повтор POST вернул 409; ИС, пользователь приложения и ID записанного ключа не изменились");
КонецПроцедуры

