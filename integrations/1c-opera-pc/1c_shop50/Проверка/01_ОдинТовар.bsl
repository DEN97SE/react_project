Штрихкод = "ЗАМЕНИТЕ_НА_ШТРИХКОД_ТЕСТОВОГО_ТОВАРА";
Номенклатура = КХ_ДанныеОпера.НайтиНоменклатуруПоШтрихкоду(Штрихкод);
Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
	ВызватьИсключение "Тестовый товар не найден";
КонецЕсли;

Карточка = КХ_ДанныеПрайсЧекеры.ПолучитьКарточкуМагазина(
	КХ_ОбменШиныОпера.ИдентификаторМагазина(), Штрихкод);
Сообщить(КХ_ОбменШиныОпера.ВJSON(Карточка));

// Следующие команды уже СОЗДАЮТ записи и отправляют тестовый пакет.
// Выполнять после проверки тестовых участников и сервера Шины.
КХ_ОбменШиныОпера.ЗарегистрироватьНоменклатуру(Номенклатура);
КХ_ОбменШиныОпера.РегламентнаяОбработкаОчередиОпера();

