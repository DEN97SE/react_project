// Добавить в существующий модуль InfoBases с импортом Основной.
// POST /shared-test-setup, доступ только администраторам.
// {{ semidockij - 28.10.2026 - Вторая ИС с пользователем первой тестовой ИС
структура ИтогОбщегоПилота
    пер stage: Строка = ""
    пер created: Булево = Ложь
    пер error: Строка = ""
;

// Создаёт только TEST_SHARED_410 с пользователем TEST_SHARED_50.
// Первую ИС и отдельного тестового бэкенда создают штатным интерфейсом Шины.
метод ПодготовитьОбщийПилот(Запрос: HttpСервисЗапрос)
    пер Итог = новый ИтогОбщегоПилота()
    пер ОбщийПользователь: Пользователи.Ссылка? = Неопределено
    пер ПользовательБэка: Пользователи.Ссылка? = Неопределено
    пер Найдено50 = 0
    пер НайденоБэков = 0
    Итог.stage = "Чтение TEST_SHARED_50 и TEST_BACKEND"
    попытка
        пер Данные = Запрос{
            ВЫБРАТЬ Т.Код, Т.Наименование, Т.ПользовательПоУмолчанию КАК Пользователь
            ИЗ Exch КАК Т
        }
        для СтрокаИС из Данные.Выполнить()
            если СтрокаИС.Код == "00000000-0000-4000-8000-000000000050"
                Найдено50 = Найдено50 + 1
                если СтрокаИС.Наименование == "TEST_SHARED_50"
                    ОбщийПользователь = СтрокаИС.Пользователь
                ;
            ;
            если СтрокаИС.Код == "00000000-0000-4000-8000-000000000003"
                НайденоБэков = НайденоБэков + 1
                если СтрокаИС.Наименование == "TEST_BACKEND"
                    ПользовательБэка = СтрокаИС.Пользователь
                ;
            ;
        ;
        если Найдено50 != 1 или ОбщийПользователь == Неопределено
            ОтветитьОшибкой(Запрос, 409, "Создайте TEST_SHARED_50 с кодом 00000000-0000-4000-8000-000000000050 и обычным пользователем; включите в Shops")
            возврат
        ;
        если НайденоБэков != 1 или ПользовательБэка == Неопределено или ПользовательБэка == ОбщийПользователь
            ОтветитьОшибкой(Запрос, 409, "Создайте TEST_BACKEND с кодом 00000000-0000-4000-8000-000000000003 и другим обычным пользователем; включите в Backend")
            возврат
        ;
    поймать Искл: Исключение
        Итог.error = Искл.Описание
        Запрос.Ответ.КодСтатуса = 500
        УстановитьЗаголовкиОтвета(Запрос)
        Запрос.Ответ.УстановитьТело(СериализацияJson.ЗаписатьОбъект(Итог))
        возврат
    ;

    исп Транзакция = Транзакции.Начать()
    попытка
        Итог.stage = "Проверка TEST_SHARED_410"
        пер Найдено410 = 0
        пер Участники = Запрос{
            ВЫБРАТЬ Т.Код, Т.Описание, Т.ПользовательПоУмолчанию КАК Пользователь
            ИЗ Exch КАК Т
        }
        для СтрокаИС из Участники.Выполнить()
            если СтрокаИС.Код == "00000000-0000-4000-8000-000000000410"
                Найдено410 = Найдено410 + 1
                если СтрокаИС.Описание != "shared-user-test-20261028" или СтрокаИС.Пользователь != ОбщийПользователь
                    Транзакция.Откатить()
                    ОтветитьОшибкой(Запрос, 409, "Код TEST_SHARED_410 занят другой ИС или другим пользователем")
                    возврат
                ;
            ;
        ;
        если Найдено410 > 1
            Транзакция.Откатить()
            ОтветитьОшибкой(Запрос, 409, "Дубли кода TEST_SHARED_410")
            возврат
        ;
        если Найдено410 == 0
            пер ИС = новый Exch.Объект()
            ИС.Код = "00000000-0000-4000-8000-000000000410"
            ИС.Наименование = "TEST_SHARED_410"
            ИС.Описание = "shared-user-test-20261028"
            ИС.ПользовательПоУмолчанию = ОбщийПользователь
            Итог.stage = "Запись TEST_SHARED_410"
            ИС.Записать()
            Итог.stage = "ДобавитьУчастника TEST_SHARED_410 с общим пользователем"
            SharedUserTest.ДобавитьУчастника(ИС, ИС.ПользовательПоУмолчанию)
            Итог.stage = "Добавить TEST_SHARED_410 в Shops"
            SharedUserTest.ДобавитьУчастниковВГруппы("Shops", ИС)
            Итог.created = Истина
        ;
        Итог.stage = "Фиксация"
        Транзакция.Фиксировать()
        если Итог.created
            Итог.stage = "Вызовы добавления TEST_SHARED_410 завершены; требуется проверка доставки"
        иначе
            Итог.stage = "TEST_SHARED_410 существует; членство Shops повторно не проверено; требуется проверка каналов и доставки"
        ;
    поймать Искл: Исключение
        Транзакция.Откатить()
        Итог.created = Ложь
        Итог.error = Искл.Описание
        Запрос.Ответ.КодСтатуса = 500
    ;
    УстановитьЗаголовкиОтвета(Запрос)
    Запрос.Ответ.УстановитьТело(СериализацияJson.ЗаписатьОбъект(Итог))
;
// }} semidockij - 28.10.2026
