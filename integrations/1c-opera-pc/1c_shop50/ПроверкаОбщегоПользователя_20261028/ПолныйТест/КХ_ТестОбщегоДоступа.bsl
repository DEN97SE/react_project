// Общий модуль: Сервер=Да, ВызовСервера=Да, ВнешнееСоединение=Да.
// Глобальный=Нет, Привилегированный=Нет, повторное использование=Не использовать.
// {{ semidockij - 28.10.2026 - Эксперимент двух ИС с одним пользователем
// Не является приёмкой рабочего обмена. ВыполнитьОбработку действует на все активные сервисы области.

// Определяет роль базы по текущей СЕ Астора; внешний GUID только читает.
Функция Магазин()
    СЕ = ОбщиеПроцедурыИФункцииПовтИсп.ТекущаяСтруктурнаяЕдиница();
    Если НЕ ЗначениеЗаполнено(СЕ) Тогда ВызватьИсключение "Не определена текущая СЕ"; КонецЕсли;
    Номер = Число(СЕ.НомерМагазина);
    Если Номер <> 50 И Номер <> 410 Тогда
        ВызватьИсключение "Пилот разрешен только для текущей СЕ №50 или №410";
    КонецЕсли;
    GUID = Строка(Новый УникальныйИдентификатор(СокрЛП(Строка(СЕ.СтроковыйИдентификатор))));
    Возврат Новый Структура("number,guid,code", Номер, GUID, КодУчастника(Номер));
КонецФункции

// Возвращает отдельный тестовый адрес; адреса действующих магазинов не меняются.
Функция КодУчастника(Номер)
    Если Номер = 50 Тогда Возврат "00000000-0000-4000-8000-000000000050"; КонецЕсли;
    Если Номер = 410 Тогда Возврат "00000000-0000-4000-8000-000000000410"; КонецЕсли;
    Если Номер = 0 Тогда Возврат "00000000-0000-4000-8000-000000000003"; КонецЕсли;
    ВызватьИсключение "Неизвестный тестовый магазин";
КонецФункции

// Настраивает только отдельный тестовый сервис одинаковым обычным API-ключом в обеих базах.
Процедура Настроить(ИдентификаторКлюча, СекретКлиента, Адрес = "") Экспорт
    Контекст = Магазин();
    НастроитьСервис("КХ_ТестОбщегоДоступа", ИдентификаторКлюча, СекретКлиента, Адрес);
    Если Контекст.number = 410 И Метаданные.СервисыИнтеграции.Найти("КХ_ТестОбщегоДоступаБэк") <> Неопределено Тогда
        СервисыИнтеграции["КХ_ТестОбщегоДоступаБэк"].УстановитьАктивность(Ложь);
    КонецЕсли;
    Сообщить("Настроен тест базы №" + Строка(Контекст.number) + "; GUID=" + Контекст.guid);
КонецПроцедуры

// В базе №50 включает отдельный тестовый ответчик с ключом TEST_BACKEND.
Процедура НастроитьБэк(ИдентификаторКлюча, СекретКлиента, Адрес = "") Экспорт
    Контекст = Магазин();
    Если Контекст.number <> 50 Тогда ВызватьИсключение "Тестовый бэкенд включается только в базе №50"; КонецЕсли;
    НастроитьСервис("КХ_ТестОбщегоДоступаБэк", ИдентификаторКлюча, СекретКлиента, Адрес);
КонецПроцедуры

// Сохраняет ключ в одном из двух тестовых сервисов; действующие сервисы читает только для адреса.
Процедура НастроитьСервис(ИмяСервиса, ИдентификаторКлюча, СекретКлиента, Адрес)
    Если ПустаяСтрока(ИдентификаторКлюча) ИЛИ ПустаяСтрока(СекретКлиента) Тогда
        ВызватьИсключение "Заполни обычный API-ключ соответствующей тестовой ИС";
    КонецЕсли;
    Настройки = СервисыИнтеграции[ИмяСервиса].ПолучитьНастройки();
    Если ПустаяСтрока(Адрес) Тогда
        Если Метаданные.СервисыИнтеграции.Найти("ExchOperaPC") <> Неопределено Тогда
            Адрес = СервисыИнтеграции["ExchOperaPC"].ПолучитьНастройки().АдресВнешнегоСервисаИнтеграции;
        КонецЕсли;
    КонецЕсли;
    Если ПустаяСтрока(Адрес) Тогда
        ВызватьИсключение "Укажи третьим параметром адрес из работающего ExchOperaPC базы №50";
    КонецЕсли;
    Настройки.АдресВнешнегоСервисаИнтеграции = Адрес;
    Если ПустаяСтрока(Настройки.ИмяПользователя) Тогда
        Настройки.ИмяПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
    КонецЕсли;
    Настройки.ИмяПользователяВнешнегоСервисаИнтеграции = ИдентификаторКлюча;
    Настройки.ПарольПользователяВнешнегоСервисаИнтеграции = СекретКлиента;
    СервисыИнтеграции[ИмяСервиса].УстановитьНастройки(Настройки);
    СервисыИнтеграции[ИмяСервиса].УстановитьАктивность(Истина);
    Сообщить("Кэш настроек обновляется до 20 секунд. Затем выполняй Отправить().");
КонецПроцедуры

// Просит тестовый бэкенд отправить receipt указанному магазину; по умолчанию ответ предназначен своей базе.
Функция Отправить(Кому = 0) Экспорт
    Контекст = Магазин();
    Если Кому = 0 Тогда Кому = Контекст.number; КонецЕсли;
    КодУчастника(Кому);
    Пакет = Новый Структура("message_type,test_id,from_store,to_store,from_guid",
        "shared_user_probe", Строка(Новый УникальныйИдентификатор),
        Контекст.number, Кому, Контекст.guid);
    СервисыИнтеграции.ВыполнитьОбработку();
    ОтправитьПакет(Пакет, "КХ_ТестОбщегоДоступа", Контекст.code, КодУчастника(0),
        "Komandor_Opera_PC_Основной_SharedUserTest_FromShops");
    Сообщить("ОТПРАВЛЕН ТЕСТ " + Пакет.test_id + ": "
        + Строка(Контекст.number) + " -> тестовый бэкенд -> " + Строка(Кому));
    Возврат Пакет.test_id;
КонецФункции

// Записывает тестовый JSON в штатный сервис интеграции и задаёт явные адреса двух ИС.
Процедура ОтправитьПакет(Пакет, ИмяСервиса, Отправитель, Получатель, Канал)
    Сервис = СервисыИнтеграции[ИмяСервиса];
    Сообщение = Сервис.СоздатьСообщение();
    Сообщение.КодОтправителя = Отправитель;
    Сообщение.КодПолучателя = Получатель;
    Сообщение.Параметры.Вставить("Content-Type", "application/json; charset=utf-8");
    Поток = Сообщение.ПолучитьТелоКакПоток();
    Писатель = Новый ЗаписьДанных(Поток, КодировкаТекста.UTF8);
    Писатель.ЗаписатьСтроку(ВJSON(Пакет));
    Писатель.Закрыть();
    Поток.Закрыть();
    Сервис[Канал].ОтправитьСообщение(Сообщение);
    ЗаписьЖурналаРегистрации("КХ.SharedUserTest.SENT", УровеньЖурналаРегистрации.Информация, , , ВJSON(Пакет));
КонецПроцедуры

// Проверяет текущую СЕ сеанса, адресата и отправителя. Чужой ответ фиксирует как FAIL и отклоняет.
// Получение в магазине проверяет адрес и пишет PASS/FAIL; товарные ACK не создаёт.
Процедура Принять(Сообщение, Отказ) Экспорт
    Попытка
        Контекст = Магазин();
        Пакет = ИзJSON(ПрочитатьТело(Сообщение));
        Если ТипЗнч(Пакет) <> Тип("Структура") Тогда ВызватьИсключение "Тело теста не является объектом JSON"; КонецЕсли;
        Если Пакет.message_type <> "shared_user_receipt" Тогда
            ВызватьИсключение "Неизвестный вид тестового сообщения";
        КонецЕсли;
        Успех = Пакет.to_store = Контекст.number
            И Сообщение.КодПолучателя = Контекст.code
            И Сообщение.КодОтправителя = КодУчастника(0);
        ЗаписьЖурналаРегистрации(?(Успех, "КХ.SharedUserTest.PASS", "КХ.SharedUserTest.FAIL"),
            ?(Успех, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка), , ,
            "База=" + Строка(Контекст.number)
            + "; sender=" + Сообщение.КодОтправителя
            + "; recipient=" + Сообщение.КодПолучателя + "; " + ВJSON(Пакет));
        Если НЕ Успех Тогда
            Отказ = Истина;
            Возврат;
        КонецЕсли;
    Исключение
        Отказ = Истина;
        ЗаписьЖурналаРегистрации("КХ.SharedUserTest.ERROR", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// Имитирует только тестовый бэкенд: принимает probe и адресует новый receipt указанному магазину.
Процедура ПринятьНаБэке(Сообщение, Отказ) Экспорт
    Попытка
        Пакет = ИзJSON(ПрочитатьТело(Сообщение));
        Если Пакет.message_type <> "shared_user_probe" Тогда ВызватьИсключение "Ожидался тестовый probe"; КонецЕсли;
        Успех = Сообщение.КодПолучателя = КодУчастника(0)
            И Сообщение.КодОтправителя = КодУчастника(Пакет.from_store);
        ЗаписьЖурналаРегистрации(?(Успех, "КХ.SharedUserTest.BACKEND", "КХ.SharedUserTest.FAIL"),
            ?(Успех, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка), , ,
            "Тестовый бэкенд; sender=" + Сообщение.КодОтправителя
            + "; recipient=" + Сообщение.КодПолучателя + "; " + ВJSON(Пакет));
        Если НЕ Успех Тогда
            Отказ = Истина;
            Возврат;
        КонецЕсли;
        Ответ = Новый Структура("message_type,test_id,to_store,origin_store,origin_guid",
            "shared_user_receipt", Пакет.test_id, Пакет.to_store, Пакет.from_store, Пакет.from_guid);
        ОтправитьПакет(Ответ, "КХ_ТестОбщегоДоступаБэк", КодУчастника(0), КодУчастника(Пакет.to_store),
            "Komandor_Opera_PC_Основной_SharedUserTest_FromBackend");
    Исключение
        Отказ = Истина;
        ЗаписьЖурналаРегистрации("КХ.SharedUserTest.ERROR", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// Управляет только тестовым получателем для проверки недоступной базы.
Процедура Активность(ЗначениеАктивности) Экспорт
    СервисыИнтеграции.КХ_ТестОбщегоДоступа.УстановитьАктивность(ЗначениеАктивности);
КонецПроцедуры

// Выключает только тестовый ответчик после завершения пилота.
Процедура АктивностьБэка(ЗначениеАктивности) Экспорт
    СервисыИнтеграции["КХ_ТестОбщегоДоступаБэк"].УстановитьАктивность(ЗначениеАктивности);
КонецПроцедуры

// Один раз создаёт вторую тестовую ИС с пользователем первой ИС; ключи не выпускает.
Процедура ПодготовитьИС(АдминClientID, АдминClientSecret) Экспорт
    Токен = ПолучитьТокен(АдминClientID, АдминClientSecret);
    ЗапросHTTP = Новый HTTPЗапрос("/applications/Opera-PC/api/infobases/shared-test-setup");
    ЗапросHTTP.Заголовки.Вставить("Authorization", "Bearer " + Токен);
    ЗапросHTTP.УстановитьТелоИзСтроки("");
    Соединение = Новый HTTPСоединение("program58", 9090, , , , 30);
    ОтветHTTP = Соединение.ОтправитьДляОбработки(ЗапросHTTP);
    Сообщить("Подготовка ИС HTTP: " + Строка(ОтветHTTP.КодСостояния));
    Сообщить(ОтветHTTP.ПолучитьТелоКакСтроку());
    Если ОтветHTTP.КодСостояния <> 200 Тогда ВызватьИсключение "Подготовка тестовых ИС не завершена; причина выведена выше"; КонецЕсли;
КонецПроцедуры

// Показывает реальные каналы и останавливает настройку при неоднозначном destination одного имени.
// Клиент пилота не реализует выбор участника среди нескольких адресов одного канала.
Процедура Каналы(ИдентификаторКлюча, СекретКлиента) Экспорт
    Токен = ПолучитьТокен(ИдентификаторКлюча, СекретКлиента);
    ЗапросHTTP = Новый HTTPЗапрос("/applications/Opera-PC/sys/esb/runtime/channels");
    ЗапросHTTP.Заголовки.Вставить("Authorization", "Bearer " + Токен);
    Соединение = Новый HTTPСоединение("program58", 9090, , , , 30);
    ОтветHTTP = Соединение.Получить(ЗапросHTTP);
    Если ОтветHTTP.КодСостояния <> 200 Тогда
        ВызватьИсключение "Получение каналов HTTP " + Строка(ОтветHTTP.КодСостояния);
    КонецЕсли;
    Данные = ИзJSON(ОтветHTTP.ПолучитьТелоКакСтроку());
    Найдено = 0;
    АдресаКаналов = Новый Соответствие;
    Неоднозначные = Новый Соответствие;
    Для Каждого Канал Из Данные.items Цикл
        Если СтрНайти(Канал.channel, "SharedUserTest") > 0 Тогда
            Если ПустаяСтрока(Канал.destination) Тогда
                ВызватьИсключение "Пустой destination тестового канала " + Канал.channel;
            КонецЕсли;
            Найдено = Найдено + 1;
            Сообщить(Канал.channel + " -> " + Канал.destination);
            ПредыдущийАдрес = АдресаКаналов.Получить(Канал.channel);
            Если ПредыдущийАдрес <> Неопределено И ПредыдущийАдрес <> Канал.destination Тогда
                Неоднозначные.Вставить(Канал.channel, Истина);
            КонецЕсли;
            АдресаКаналов.Вставить(Канал.channel, Канал.destination);
        КонецЕсли;
    КонецЦикла;
    Если Найдено = 0 Тогда ВызватьИсключение "Нет доступных каналов SharedUserTest: проверь запуск процесса, ключ и группы"; КонецЕсли;
    Если Неоднозначные.Количество() > 0 Тогда
        ВызватьИсключение "Одному имени канала соответствуют разные destination. Автонастройка пилота остановлена: выбор адреса участника здесь не реализован";
    КонецЕсли;
КонецПроцедуры

// Получает токен по API-ключу, не выводя секрет или тело ответа авторизации.
Функция ПолучитьТокен(ИдентификаторКлюча, СекретКлиента)
    Если ПустаяСтрока(ИдентификаторКлюча) ИЛИ ПустаяСтрока(СекретКлиента) Тогда ВызватьИсключение "API-ключ не заполнен"; КонецЕсли;
    КодировкаBasic = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(ИдентификаторКлюча + ":" + СекретКлиента));
    КодировкаBasic = СтрЗаменить(СтрЗаменить(КодировкаBasic, Символы.ПС, ""), Символы.ВК, "");
    ЗапросHTTP = Новый HTTPЗапрос("/auth/oidc/token");
    ЗапросHTTP.Заголовки.Вставить("Authorization", "Basic " + КодировкаBasic);
    ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
    ЗапросHTTP.УстановитьТелоИзСтроки("grant_type=client_credentials");
    Соединение = Новый HTTPСоединение("program58", 9090, , , , 30);
    ОтветHTTP = Соединение.ОтправитьДляОбработки(ЗапросHTTP);
    Если ОтветHTTP.КодСостояния <> 200 Тогда ВызватьИсключение "Авторизация HTTP " + Строка(ОтветHTTP.КодСостояния); КонецЕсли;
    Данные = ИзJSON(ОтветHTTP.ПолучитьТелоКакСтроку());
    Возврат Данные.id_token;
КонецФункции

// Читает только тело маленького тестового сообщения; поток считывается однократно.
Функция ПрочитатьТело(Сообщение)
    Поток = Сообщение.ПолучитьТелоКакПоток();
    Тело = Новый БуферДвоичныхДанных(0);
    Суммарно = 0;
    Буфер = Новый БуферДвоичныхДанных(4096);
    Попытка
        Пока Истина Цикл
            Прочитано = Поток.Прочитать(Буфер, 0, 4096);
            Если Прочитано = 0 Тогда Прервать; КонецЕсли;
            Суммарно = Суммарно + Прочитано;
            Если Суммарно > 16384 Тогда ВызватьИсключение "Тело теста больше 16 КиБ"; КонецЕсли;
            Тело = Тело.Соединить(Буфер.ПолучитьСрез(0, Прочитано));
        КонецЦикла;
        Поток.Закрыть();
    Исключение
        Поток.Закрыть(); ВызватьИсключение;
    КонецПопытки;
    Возврат ПолучитьСтрокуИзБуфераДвоичныхДанных(Тело, КодировкаТекста.UTF8);
КонецФункции

// Сериализует только диагностические структуры, не настройки доступа.
Функция ВJSON(Значение)
    Писатель = Новый ЗаписьJSON;
    Писатель.УстановитьСтроку();
    ЗаписатьJSON(Писатель, Значение);
    Возврат Писатель.Закрыть();
КонецФункции

// Разбирает объект JSON средствами платформы.
Функция ИзJSON(Текст)
    Читатель = Новый ЧтениеJSON;
    Читатель.УстановитьСтроку(Текст);
    Результат = ПрочитатьJSON(Читатель);
    Читатель.Закрыть();
    Возврат Результат;
КонецФункции
