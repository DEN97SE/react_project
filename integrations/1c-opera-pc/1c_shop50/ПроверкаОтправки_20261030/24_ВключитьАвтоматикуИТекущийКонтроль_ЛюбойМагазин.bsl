// ШАГ 2. Один алгоритм для обеих настроенных тестовых баз.
// Перед запуском применить три настройки из 24_ПодготовкаКонфигурации.md и F7.
// Подключения/ключи сохраняются. Включается только общее товарное задание.
// Первое выполнение штатного задания может начать первоначальную full.
// Повтор этого же кода через 30–60 секунд показывает историю и очереди.
// Метод обмена, регистрация товара и отправка вручную не вызываются.

Этап = "Начало";
СкрываемыеКлючи = Новый Массив;
МетодЗадания = "КХ_ОбменШиныОпера.РегламентнаяОбработкаОчередиОпера";
МетодПрежнегоPC = "КХ_ОбменШиныПрайсЧекеры.РегламентнаяОбработкаОчередиPriceCheker";

Попытка
    Сообщить("===== ШАГ 2. ВКЛЮЧЕНИЕ И КОНТРОЛЬ АВТОМАТИКИ =====");

    // 1. Проверяем базу, каналы и сохранённые маршруты до записи настроек.
    Этап = "1. Текущая база и маршруты";
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "Запустите вне транзакции"; КонецЕсли;
    СЕ = КХ_ОбменШиныОпера.ТекущаяСЕ();
    Магазин = КХ_ОбменШиныОпера.ИдентификаторМагазина();
    СвойУзел = "S" + СтрЗаменить(Магазин, "-", "");
    Сообщить("[1] Магазин=" + Строка(СЕ) + "; store_id=" + Магазин);
    Сообщить("    Участник=" + СвойУзел);
    Параметры = КХ_ОбменШиныОпера.ПараметрыОбмена();
    Если Параметры.КаналОпера <> "Основной_ExchangeOpera_FromOpera"
        ИЛИ Параметры.КаналПрайсЧекеры <> "Основной_PC_FromShops" Тогда
        ВызватьИсключение "Неактуальные имена каналов в ПараметрыОбмена";
    КонецЕсли;
    Если Параметры.ДнейХраненияПодтвержденных < 1 Тогда
        ВызватьИсключение "Сначала установите хранение подтверждённых 1 день в тестовой конфигурации, F7 и обновите сеанс";
    КонецЕсли;
    ЗапросКорня = Новый Запрос(
    "ВЫБРАТЬ СтроковыйОбъект ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема = ""OperaState"" И ИдентификаторОбъекта = ""КХ_OperaState""
    | И УзелПолучатель = """" И КаналСервисаИнтеграции = """"");
    Корни = ЗапросКорня.Выполнить().Выгрузить();
    Если Корни.Количество() <> 1 Тогда ВызватьИсключение "Нет единственного состояния обмена"; КонецЕсли;
    Состояние = КХ_ОбменШиныОпера.ИзJSON(Корни[0].СтроковыйОбъект);
    Для Каждого ПолеМаршрута Из СтрРазделить(
        "node_code|" + СвойУзел + ";pc_store_id|" + Магазин + ";pc_node_code|" + СвойУзел
        + ";pc_backend_node|" + СвойУзел + ";opera_backend_node|BackendOpera", ";") Цикл
        Части = СтрРазделить(ПолеМаршрута, "|");
        Если КХ_ОбменШиныОпера.СтроковоеПоле(Состояние, Части[0]) <> Части[1] Тогда
            ВызватьИсключение "Не соответствует текущему магазину маршрут " + Части[0];
        КонецЕсли;
    КонецЦикла;
    Для Каждого ПолеФлага Из СтрРазделить("full_active,catalog_bootstrap_started,catalog_full_requested", ",") Цикл
        ЗначениеФлага = Неопределено;
        Если НЕ Состояние.Свойство(ПолеФлага, ЗначениеФлага) ИЛИ ТипЗнч(ЗначениеФлага) <> Тип("Булево") Тогда
            ВызватьИсключение "Неполная текущая редакция состояния: " + ПолеФлага;
        КонецЕсли;
    КонецЦикла;

    // 2. Подключения уже настроены: читаем и проверяем, значения не заменяем.
    Этап = "2. Готовность обоих сервисов";
    Для Каждого ИмяСервиса Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
        Сервис = СервисыИнтеграции[ИмяСервиса];
        Настройки = Сервис.ПолучитьНастройки();
        Если НЕ ПустаяСтрока(Настройки.ИмяПользователяВнешнегоСервисаИнтеграции) Тогда
            СкрываемыеКлючи.Добавить(Настройки.ИмяПользователяВнешнегоСервисаИнтеграции);
        КонецЕсли;
        Если НЕ ПустаяСтрока(Настройки.ПарольПользователяВнешнегоСервисаИнтеграции) Тогда
            СкрываемыеКлючи.Добавить(Настройки.ПарольПользователяВнешнегоСервисаИнтеграции);
        КонецЕсли;
        Если НЕ Сервис.ПолучитьАктивность() Тогда ВызватьИсключение "Выключен сервис " + ИмяСервиса; КонецЕсли;
        Если ПустаяСтрока(Настройки.АдресВнешнегоСервисаИнтеграции)
            ИЛИ ПустаяСтрока(Настройки.ИмяПользователяВнешнегоСервисаИнтеграции)
            ИЛИ ПустаяСтрока(Настройки.ПарольПользователяВнешнегоСервисаИнтеграции) Тогда
            ВызватьИсключение "Неполные настройки " + ИмяСервиса;
        КонецЕсли;
        Сообщить("[2 ОК] " + ИмяСервиса + " включён; подключение заполнено");
    КонецЦикла;

    // 3. Выбираем ровно одно общее товарное задание и существующего пользователя.
    Этап = "3. Товарное задание и пользователь";
    НашиЗадания = Новый Массив;
    Для Каждого ПроверяемоеЗадание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл
        Метод = НРег(СтрЗаменить(Строка(ПроверяемоеЗадание.Метаданные.ИмяМетода), "ОбщийМодуль.", ""));
        Если Метод = НРег(МетодПрежнегоPC) Тогда
            ПоследнееПрежнее = ПроверяемоеЗадание.ПоследнееЗадание;
            ПрежнееВыполняется = Ложь;
            Если ПоследнееПрежнее <> Неопределено Тогда
                ПрежнееВыполняется = ПоследнееПрежнее.Состояние = СостояниеФоновогоЗадания.Активно;
            КонецЕсли;
            Если ПроверяемоеЗадание.Использование ИЛИ ПрежнееВыполняется Тогда
                ВызватьИсключение "Отдельный старый PC-job ещё работает; сначала завершите его использование";
            КонецЕсли;
        КонецЕсли;
        Если Метод = НРег(МетодЗадания) Тогда НашиЗадания.Добавить(ПроверяемоеЗадание); КонецЕсли;
    КонецЦикла;
    Если НашиЗадания.Количество() <> 1 Тогда
        ВызватьИсключение "Ожидалось одно существующее товарное задание; найдено=" + Строка(НашиЗадания.Количество());
    КонецЕсли;
    Задание = НашиЗадания[0];
    ПользовательЗадания = Задание.ИмяПользователя;
    Если ПустаяСтрока(ПользовательЗадания) Тогда ПользовательЗадания = ИмяПользователя(); КонецЕсли;
    Если ПустаяСтрока(ПользовательЗадания)
        ИЛИ ПользователиИнформационнойБазы.НайтиПоИмени(ПользовательЗадания) = Неопределено Тогда
        ВызватьИсключение "Не найден пользователь ИБ для товарного задания";
    КонецЕсли;
    Сообщить("[3] " + Задание.Метаданные.Имя + "; ID=" + Строка(Задание.УникальныйИдентификатор));
    Сообщить("    Пользователь задания=" + ПользовательЗадания);

    // 4. Ежедневное расписание с интервалом 10 секунд для тестовых баз.
    // Поля расписания сравниваются целиком, включая ограничения времени/дней.
    Этап = "4. Включение расписания";
    НовоеРасписание = Новый РасписаниеРегламентногоЗадания;
    НовоеРасписание.ПериодПовтораДней = 1;
    НовоеРасписание.ПериодПовтораВТечениеДня = 10;
    ПоляРасписания = "ВремяЗавершения,ВремяКонца,ВремяНачала,ДатаКонца,ДатаНачала,ДеньВМесяце,ДеньНеделиВМесяце,"
        + "ДниНедели,ИнтервалЗавершения,Месяцы,ПаузаПовтора,ПериодНедель,ПериодПовтораВТечениеДня,ПериодПовтораДней";
    СтароеРасписание = Задание.Расписание;
    СтарыеПоля = Новый Структура(ПоляРасписания);
    НовыеПоля = Новый Структура(ПоляРасписания);
    ЗаполнитьЗначенияСвойств(СтарыеПоля, СтароеРасписание, ПоляРасписания);
    ЗаполнитьЗначенияСвойств(НовыеПоля, НовоеРасписание, ПоляРасписания);
    НужнаЗапись = НЕ Задание.Использование ИЛИ Задание.ИмяПользователя <> ПользовательЗадания
        ИЛИ ЗначениеВСтрокуВнутр(СтарыеПоля) <> ЗначениеВСтрокуВнутр(НовыеПоля)
        ИЛИ СтароеРасписание.ДетальныеРасписанияДня.Количество() > 0;
    Последнее = Задание.ПоследнееЗадание;
    Выполняется = Ложь;
    Если Последнее <> Неопределено Тогда Выполняется = Последнее.Состояние = СостояниеФоновогоЗадания.Активно; КонецЕсли;
    Если НужнаЗапись И Выполняется Тогда
        Если Задание.Использование Тогда
            Задание.Использование = Ложь;
            Задание.Записать();
        КонецЕсли;
        Сообщить("[ПАУЗА] Предыдущий товарный цикл ещё выполняется; повторите этот код после его завершения");
    Иначе
        Если НужнаЗапись Тогда
            Задание.ИмяПользователя = ПользовательЗадания;
            Задание.Расписание = НовоеРасписание;
            Задание.Использование = Истина;
            Задание.Записать();
            Сообщить("[4 ОК] Товарное задание включено: ежедневно каждые 10 секунд");
        Иначе
            Сообщить("[4 ОК] Задание уже включено с нужным расписанием; настройки сохранены");
        КонецЕсли;
        Сообщить("    При первом штатном цикле начнётся или продолжится первоначальная загрузка");
        Сообщить("    Повторите ЭТОТ ЖЕ алгоритм через 30–60 секунд для контроля реального запуска");
    КонецЕсли;

    // 5. Читаем настоящую историю планировщика. Метод обмена вручную не вызываем.
    Этап = "5. История автоматического запуска";
    Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Задание.УникальныйИдентификатор);
    Последнее = Задание.ПоследнееЗадание;
    Сообщить("[5] Использование=" + Строка(Задание.Использование) + "; расписание=" + Строка(Задание.Расписание));
    Если Последнее = Неопределено Тогда
        Сообщить("[ОЖИДАНИЕ] Истории запуска пока нет");
        Сообщить("Если она не появится после ожидания — проверить блокировку регламентных заданий этой тестовой базы на сервере");
    Иначе
        Сообщить("[ИСТОРИЯ] Начало=" + Строка(Последнее.Начало)
            + "; конец=" + Строка(Последнее.Конец) + "; состояние=" + Строка(Последнее.Состояние));
        Если Последнее.ИнформацияОбОшибке <> Неопределено Тогда
            ТекстОшибки = ПодробноеПредставлениеОшибки(Последнее.ИнформацияОбОшибке);
            Для Каждого Скрываемое Из СкрываемыеКлючи Цикл
                ТекстОшибки = СтрЗаменить(ТекстОшибки, Скрываемое, "[ключ скрыт]");
            КонецЦикла;
            Сообщить("[ОШИБКА ЗАДАНИЯ] " + Лев(ТекстОшибки, 3000));
        КонецЕсли;
    КонецЕсли;

    // 6. Сессия и логические очереди. full_active=false не заменяет ACK всех пакетов.
    Этап = "6. Текущий результат";
    Корни = ЗапросКорня.Выполнить().Выгрузить();
    Если Корни.Количество() = 1 Тогда
        Состояние = КХ_ОбменШиныОпера.ИзJSON(Корни[0].СтроковыйОбъект);
        Сообщить("[6] full_active=" + Строка(Состояние.full_active));
        Если Состояние.full_active Тогда
            Сообщить("    Сессия=" + Состояние.full.session_id + "; следующая порция=" + Строка(Состояние.full.next_sequence)
                + "; всего порций=" + Строка(Состояние.full.total_batches));
        КонецЕсли;
        Сообщить("    catalog_bootstrap_started=" + Строка(Состояние.catalog_bootstrap_started));
    КонецЕсли;
    ЗапросОчереди = Новый Запрос(
    "ВЫБРАТЬ ВнешняяСистема, СтатусСообщения, КОЛИЧЕСТВО(*) КАК Количество
    |ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема В (""Opera"", ""PriceCheker"", ""OperaChange"")
    |СГРУППИРОВАТЬ ПО ВнешняяСистема, СтатусСообщения
    |УПОРЯДОЧИТЬ ПО ВнешняяСистема, СтатусСообщения");
    Для Каждого СтрокаОчереди Из ЗапросОчереди.Выполнить().Выгрузить() Цикл
        Сообщить("[ОЧЕРЕДЬ] " + СтрокаОчереди.ВнешняяСистема + " | " + Строка(СтрокаОчереди.СтатусСообщения)
            + " | количество=" + Строка(СтрокаОчереди.Количество));
    КонецЦикла;
    ОшибкиПакетов = Новый Запрос(
    "ВЫБРАТЬ ПЕРВЫЕ 5 ВнешняяСистема, ИдентификаторОбъекта, ТекстОшибки
    |ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема В (""Opera"", ""PriceCheker"") И СтатусСообщения = &Ошибка
    |УПОРЯДОЧИТЬ ПО ДатаОтправки УБЫВ, ДатаРегистрации УБЫВ");
    ОшибкиПакетов.УстановитьПараметр("Ошибка", Перечисления.СтатусыСообщенийШины.Ошибка);
    Для Каждого ОшибкаПакета Из ОшибкиПакетов.Выполнить().Выгрузить() Цикл
        ТекстОшибки = ОшибкаПакета.ТекстОшибки;
        Для Каждого Скрываемое Из СкрываемыеКлючи Цикл
            ТекстОшибки = СтрЗаменить(ТекстОшибки, Скрываемое, "[ключ скрыт]");
        КонецЦикла;
        Сообщить("[ОШИБКА ПАКЕТА] " + ОшибкаПакета.ВнешняяСистема
            + " | batch_id=" + ОшибкаПакета.ИдентификаторОбъекта + " | " + Лев(ТекстОшибки, 1500));
    КонецЦикла;
    Сообщить("Для прикладных ошибок подготовки: журнал регистрации, события КХ.Шина");
    Сообщить("===== КОНЕЦ ШАГА 2 =====");
Исключение
    ТекстОшибки = ОписаниеОшибки();
    Для Каждого Скрываемое Из СкрываемыеКлючи Цикл
        ТекстОшибки = СтрЗаменить(ТекстОшибки, Скрываемое, "[ключ скрыт]");
    КонецЦикла;
    Сообщить("[ОСТАНОВЛЕНО] Этап=" + Этап);
    Сообщить(ТекстОшибки);
КонецПопытки;
