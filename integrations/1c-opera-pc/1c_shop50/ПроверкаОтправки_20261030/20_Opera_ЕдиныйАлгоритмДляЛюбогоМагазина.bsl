// Вставить целиком в консоль. Один алгоритм для Opera любого магазина.
// Сначала должен быть успешно настроен PC этого же магазина.
// Внешние ключи и адрес берутся из его проверенного подключения PC.
// Обработчик ExchOperaPC/Основной_ExchangeOpera_ToBackend должен вызывать
// КХ_ОбменШиныОпера.ОбработатьВходящееСообщение(Сообщение, Отказ).
// Автоматические задания подготовки/отправки на время теста остановлены.

ШтрихкодНовогоТовара = ""; // Пусто: первый товар текущего каталога.
ИмяСервиса = "ExchOperaPC";
КаналОтправки = "Основной_ExchangeOpera_FromOpera";
КаналПриема = "Основной_ExchangeOpera_ToBackend";
БэкOpera = "BackendOpera";
ИдентификаторКлюча = "";
СекретКлюча = "";
Этап = "Начало";

Попытка
    Сообщить("===== КОНТРОЛЬ ОБМЕНА OPERA =====");

    // 1. Магазин определяется автоматически, без ограничения 50/410.
    Этап = "1. Определение магазина";
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "Выполняйте алгоритм вне транзакции";
    КонецЕсли;
    СЕ = КХ_ОбменШиныОпера.ТекущаяСЕ();
    Магазин = КХ_ОбменШиныОпера.ИдентификаторМагазина();
    СвойУзел = "S" + СтрЗаменить(Магазин, "-", "");
    Сообщить("[1 ОК] СЕ=" + Строка(СЕ) + "; store_id=" + Магазин);
    Сообщить("        Участник=" + СвойУзел);

    // 2. Проверяем метаданные и адреса обоих участников Opera.
    Этап = "2. Каналы и маршрут Opera";
    Если Метаданные.СервисыИнтеграции.Найти(ИмяСервиса) = Неопределено Тогда
        ВызватьИсключение "В конфигурации отсутствует ExchOperaPC";
    КонецЕсли;
    Если Метаданные.СервисыИнтеграции.Найти("ExchPriceChecker") = Неопределено Тогда
        ВызватьИсключение "Отсутствует проверенное подключение ExchPriceChecker";
    КонецЕсли;
    МДКаналы = Метаданные.СервисыИнтеграции[ИмяСервиса].КаналыСервисаИнтеграции;
    Если МДКаналы.Найти(КаналОтправки) = Неопределено
        ИЛИ МДКаналы.Найти(КаналПриема) = Неопределено Тогда
        ВызватьИсключение "В ExchOperaPC отсутствуют каналы Основной_ExchangeOpera_FromOpera / Основной_ExchangeOpera_ToBackend";
    КонецЕсли;
    ПараметрыОбмена = КХ_ОбменШиныОпера.ПараметрыОбмена();
    Если ПараметрыОбмена.КаналОпера <> КаналОтправки Тогда
        ВызватьИсключение "В ПараметрыОбмена указан неверный канал Opera: " + ПараметрыОбмена.КаналОпера;
    КонецЕсли;
    МаршрутPC = КХ_ОбменШиныОпера.ПараметрыМаршрутаПрайсЧекеров();
    Если НЕ МаршрутPC.Настроен ИЛИ МаршрутPC.КодОтправителя <> СвойУзел
        ИЛИ МаршрутPC.КодПолучателя <> СвойУзел Тогда
        ВызватьИсключение "Сначала настройте и проверьте PC именно текущего магазина";
    КонецЕсли;
    КХ_ОбменШиныОпера.НастроитьПолучателяОпера(БэкOpera);
    Если КХ_ОбменШиныОпера.КодУзлаОтправителя() <> СвойУзел Тогда
        КХ_ОбменШиныОпера.УстановитьКодУзлаОтправителя(СвойУзел);
    КонецЕсли;
    Сообщить("[2 ОК] Opera: " + СвойУзел + " -> " + БэкOpera);

    // 3. Используем актуальные ключи магазина из рабочего подключения PC.
    // ИмяПользователя самой базы 1С в настройках Opera сохраняется.
    Этап = "3. Настройки подключения Opera";
    СервисOpera = СервисыИнтеграции[ИмяСервиса];
    СервисPC = СервисыИнтеграции["ExchPriceChecker"];
    НастройкиPC = СервисPC.ПолучитьНастройки();
    НастройкиOpera = СервисOpera.ПолучитьНастройки();
    Адрес = НастройкиPC.АдресВнешнегоСервисаИнтеграции;
    ИдентификаторКлюча = НастройкиPC.ИмяПользователяВнешнегоСервисаИнтеграции;
    СекретКлюча = НастройкиPC.ПарольПользователяВнешнегоСервисаИнтеграции;
    Если ПустаяСтрока(Адрес) ИЛИ ПустаяСтрока(ИдентификаторКлюча)
        ИЛИ ПустаяСтрока(СекретКлюча) Тогда
        ВызватьИсключение "В подключении PC не заполнены адрес или ключи текущего магазина";
    КонецЕсли;
    ПодключениеИзменилось = Ложь;
    Если НастройкиOpera.АдресВнешнегоСервисаИнтеграции <> Адрес
        ИЛИ НастройкиOpera.ИмяПользователяВнешнегоСервисаИнтеграции <> ИдентификаторКлюча
        ИЛИ НастройкиOpera.ПарольПользователяВнешнегоСервисаИнтеграции <> СекретКлюча Тогда
        Если СервисOpera.ПолучитьАктивность() Тогда
            СервисOpera.УстановитьАктивность(Ложь);
        КонецЕсли;
        НастройкиOpera.АдресВнешнегоСервисаИнтеграции = Адрес;
        НастройкиOpera.ИмяПользователяВнешнегоСервисаИнтеграции = ИдентификаторКлюча;
        НастройкиOpera.ПарольПользователяВнешнегоСервисаИнтеграции = СекретКлюча;
        СервисOpera.УстановитьНастройки(НастройкиOpera);
        ПодключениеИзменилось = Истина;
        Сообщить("[3 ОК] Opera получила актуальные ключи этого магазина из PC");
    Иначе
        Сообщить("[3 ОК] Настройки Opera уже соответствуют проверенному PC");
    КонецЕсли;

    // 4. На этом тесте работает только сервис Opera.
    Этап = "4. Активность сервисов";
    Если СервисPC.ПолучитьАктивность() Тогда
        СервисPC.УстановитьАктивность(Ложь);
        ПодключениеИзменилось = Истина;
        Сообщить("[4 ОК] PC выключен на время теста Opera");
    КонецЕсли;
    Если НЕ СервисOpera.ПолучитьАктивность() Тогда
        СервисOpera.УстановитьАктивность(Истина);
        ПодключениеИзменилось = Истина;
        Сообщить("[4 ОК] Opera включена");
    КонецЕсли;

    Если ПодключениеИзменилось Тогда
        Сообщить("[ПАУЗА] Подождите 20 секунд и запустите ЭТОТ ЖЕ алгоритм");
        Сообщить("         Подготовка и отправка на этом запуске ещё не выполнялись");
    Иначе
        // 5. Платформа принимает реальные сообщения от бэка.
        Этап = "5. Приём поступивших ответов Opera";
        ВходящийКанал = СервисOpera[КаналПриема];
        Сообщить("[5] Входящих до обработки: "
            + Строка(ВходящийКанал.ВыбратьСообщения().Количество()));
        СервисыИнтеграции.ВыполнитьОбработку();
        Сообщить("[5 ОК] Обработка сервисов запущена");

        // 6. Используем последний товарный Opera-пакет, включая уже подтверждённый.
        // Поэтому каждый повторный запуск не регистрирует новую пачку.
        Этап = "6. Выбор контрольной пачки Opera";
        ЗапросПакетов = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 20
        | ИдентификаторОбъекта, УзелПолучатель, КаналСервисаИнтеграции,
        | СтатусСообщения, СтроковыйОбъект
        |ИЗ РегистрСведений.ОчередьШины
        |ГДЕ ВнешняяСистема = ""Opera""
        |УПОРЯДОЧИТЬ ПО ДатаРегистрации УБЫВ, ИдентификаторОбъекта УБЫВ");
        Пакет = Неопределено;
        ПоследниеПакеты = ЗапросПакетов.Выполнить().Выгрузить();
        Для Каждого СтрокаПакета Из ПоследниеПакеты Цикл
            ДанныеПакета = КХ_ОбменШиныОпера.ИзJSON(СтрокаПакета.СтроковыйОбъект);
            Если КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеПакета, "message_type") = "products" Тогда
                Пакет = СтрокаПакета;
                Прервать;
            КонецЕсли;
        КонецЦикла;

        Если Пакет = Неопределено Тогда
            Этап = "6. Подготовка одной delta";
            ЗапросСостояния = Новый Запрос(
            "ВЫБРАТЬ СтроковыйОбъект ИЗ РегистрСведений.ОчередьШины
            |ГДЕ ВнешняяСистема = ""OperaState""
            | И ИдентификаторОбъекта = ""КХ_OperaState""
            | И УзелПолучатель = """" И КаналСервисаИнтеграции = """"");
            Состояния = ЗапросСостояния.Выполнить().Выгрузить();
            Если Состояния.Количество() <> 1 Тогда
                ВызватьИсключение "Не найдено единственное состояние обмена";
            КонецЕсли;
            Состояние = КХ_ОбменШиныОпера.ИзJSON(Состояния[0].СтроковыйОбъект);
            Если Состояние.full_active ИЛИ Состояние.catalog_requests.Количество() > 0 Тогда
                ВызватьИсключение "Есть подготовка full/запросов; новую delta сейчас не создаём";
            КонецЕсли;
            Если ПустаяСтрока(ШтрихкодНовогоТовара) Тогда
                // Читаем состав каталога; полная выгрузка не запускается.
                Каталог = КХ_ДанныеОпера.ПолучитьНоменклатуруДляПолнойВыгрузки(СЕ);
                Если Каталог.Количество() = 0 Тогда ВызватьИсключение "Каталог магазина пуст"; КонецЕсли;
                Номенклатура = Каталог[0];
            Иначе
                Номенклатура = КХ_ДанныеОпера.НайтиНоменклатуруПоШтрихкоду(ШтрихкодНовогоТовара);
            КонецЕсли;
            Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда ВызватьИсключение "Товар не найден"; КонецЕсли;
            Ссылки = Новый Массив;
            Ссылки.Добавить(Номенклатура);
            Карточки = КХ_ДанныеОпера.СформироватьСостояниеКаталога(СЕ, Ссылки);
            Если Карточки.products.Количество() <> 1
                ИЛИ Карточки.deleted_nomenclature_ids.Количество() <> 0 Тогда
                ВызватьИсключение "Для теста нужна одна действующая карточка";
            КонецЕсли;
            КХ_ОбменШиныОпера.ЗарегистрироватьНоменклатуру(Номенклатура);
            Если НЕ КХ_ОбменШиныОпера.ПодготовитьДельту(Номенклатура) Тогда
                ВызватьИсключение "Не удалось подготовить delta";
            КонецЕсли;
            Сообщить("[6 ОК] Подготовлена карточка: " + Строка(Номенклатура));
            Сообщить("         Созданы отдельные Opera/PC-пакеты; сейчас работает Opera");
            ПоследниеПакеты = ЗапросПакетов.Выполнить().Выгрузить();
            Для Каждого СтрокаПакета Из ПоследниеПакеты Цикл
                ДанныеПакета = КХ_ОбменШиныОпера.ИзJSON(СтрокаПакета.СтроковыйОбъект);
                Если КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеПакета, "message_type") = "products" Тогда
                    Пакет = СтрокаПакета;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Если Пакет = Неопределено Тогда ВызватьИсключение "Товарная пачка Opera не найдена"; КонецЕсли;
        ДанныеПакета = КХ_ОбменШиныОпера.ИзJSON(Пакет.СтроковыйОбъект);
        ИдПакета = Пакет.ИдентификаторОбъекта;
        Если КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеПакета, "store_id") <> Магазин
            ИЛИ КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеПакета, "source_node") <> СвойУзел
            ИЛИ КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеПакета, "project") <> "opera"
            ИЛИ КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеПакета, "batch_id") <> ИдПакета
            ИЛИ СокрЛП(Пакет.УзелПолучатель) <> БэкOpera Тогда
            ВызватьИсключение "Заголовки выбранной пачки не соответствуют Opera текущего магазина";
        КонецЕсли;
        МаршрутОтправки = КХ_ОбменШиныОпера.МаршрутКаналаОтправки("Opera", Пакет.КаналСервисаИнтеграции);
        Сообщить("[6 ОК] Opera batch_id=" + ИдПакета);
        Сообщить("        Статус до отправки=" + Строка(Пакет.СтатусСообщения));

        // 7. Отправляем одну ожидающую пачку. Sent/Error автоматически не повторяем.
        Этап = "7. Отправка Opera";
        Если Пакет.СтатусСообщения = Перечисления.СтатусыСообщенийШины.ОжидаетОтправки Тогда
            Кандидаты = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 1 ИдентификаторОбъекта, УзелПолучатель, КаналСервисаИнтеграции
            |ИЗ РегистрСведений.ОчередьШины
            |ГДЕ ВнешняяСистема = ""Opera""
            | И (СтатусСообщения = &Ожидает
            | ИЛИ (СтатусСообщения = &Ошибка И ДатаОтправки <= &ПовторОшибки)
            | ИЛИ (СтатусСообщения = &Отправлено И ДатаОтправки <= &ПовторACK))
            |УПОРЯДОЧИТЬ ПО ДатаОтправки, ДатаРегистрации, ИдентификаторОбъекта");
            Кандидаты.УстановитьПараметр("Ожидает", Перечисления.СтатусыСообщенийШины.ОжидаетОтправки);
            Кандидаты.УстановитьПараметр("Ошибка", Перечисления.СтатусыСообщенийШины.Ошибка);
            Кандидаты.УстановитьПараметр("Отправлено", Перечисления.СтатусыСообщенийШины.Отправлено);
            Кандидаты.УстановитьПараметр("ПовторОшибки", ТекущаяДатаСеанса() - ПараметрыОбмена.ПовторОшибкиСекунд);
            Кандидаты.УстановитьПараметр("ПовторACK", ТекущаяДатаСеанса() - ПараметрыОбмена.ОжиданиеПодтвержденияСекунд);
            Готовые = Кандидаты.Выполнить().Выгрузить();
            Если Готовые.Количество() = 0 Тогда
                Сообщить("[7 ОЖИДАНИЕ] Отправитель пока не выбрал пачку");
            ИначеЕсли Готовые[0].ИдентификаторОбъекта <> ИдПакета
                ИЛИ Готовые[0].УзелПолучатель <> Пакет.УзелПолучатель
                ИЛИ Готовые[0].КаналСервисаИнтеграции <> Пакет.КаналСервисаИнтеграции Тогда
                Сообщить("[7 ПРОПУСК] Первым в очереди идёт другой batch_id=" + Готовые[0].ИдентификаторОбъекта);
                Сообщить("            Контрольная отправка не выполнялась; приём продолжается");
            Иначе
                Сообщить("[7] Отправляем Opera batch_id=" + ИдПакета);
                КХ_ОбменШиныОпера.ОтправитьПорциюПакетов("Opera", 1);
                Сообщить("[7 ОК] Вызов отправителя завершён; итог читаем из регистра");
            КонецЕсли;
        ИначеЕсли Пакет.СтатусСообщения = Перечисления.СтатусыСообщенийШины.ДоставкаПодтверждена Тогда
            Сообщить("[7 ОК] Пачка уже подтверждена");
        Иначе
            Сообщить("[7 ОЖИДАНИЕ] Пачка уже проходила отправку; проверяем ответ без повторной отправки");
        КонецЕсли;

        // 8. Для Opera бэк общий, но ответ адресуется конкретному магазину.
        Этап = "8. Приём ACK Opera";
        Сообщить("Бэку: читать процесс Opera, канал ToOpera");
        Сообщить("ACK публиковать: процесс Opera, канал FromBackend");
        Сообщить("SenderCode=" + БэкOpera + "; RecipientCode=" + СвойУзел);
        Сообщить("JSON ACK: message_type=ack; store_id=" + Магазин
            + "; batch_id=" + ИдПакета + "; status=processed после сохранения");
        СервисыИнтеграции.ВыполнитьОбработку();
        Сообщить("[8 ОК] Приём запущен; входящих в локальном канале="
            + Строка(ВходящийКанал.ВыбратьСообщения().Количество()));

        // 9. Успехом считаем только бизнес-подтверждение конкретного batch_id.
        Этап = "9. Фактический результат Opera";
        Проверка = Новый Запрос(
        "ВЫБРАТЬ СтатусСообщения, ИдентификаторСообщения, ДатаОтправки, ДатаЗагрузки, ТекстОшибки
        |ИЗ РегистрСведений.ОчередьШины
        |ГДЕ ВнешняяСистема = ""Opera"" И ИдентификаторОбъекта = &Ид");
        Проверка.УстановитьПараметр("Ид", ИдПакета);
        Итог = Проверка.Выполнить().Выгрузить();
        Если Итог.Количество() <> 1 Тогда ВызватьИсключение "Ожидалась одна запись Opera batch_id"; КонецЕсли;
        СтрокаИтога = Итог[0];
        Сообщить("[9 ИТОГ] Opera batch_id=" + ИдПакета);
        Сообщить("          Статус=" + Строка(СтрокаИтога.СтатусСообщения));
        Сообщить("          Транспортный ID=" + Строка(СтрокаИтога.ИдентификаторСообщения));
        Сообщить("          Отправка=" + Строка(СтрокаИтога.ДатаОтправки)
            + "; загрузка=" + Строка(СтрокаИтога.ДатаЗагрузки));
        Сообщить("          Текст=" + СтрокаИтога.ТекстОшибки);
        Если СтрокаИтога.СтатусСообщения = Перечисления.СтатусыСообщенийШины.ДоставкаПодтверждена Тогда
            Сообщить("[ГОТОВО] Полный цикл Opera подтверждён для этой пачки");
        ИначеЕсли СтрокаИтога.СтатусСообщения = Перечисления.СтатусыСообщенийШины.Ошибка Тогда
            Сообщить("[ОШИБКА ПАКЕТА] Смотрите текст выше и журнал КХ.Шина.Подтверждение.Опера");
        Иначе
            Сообщить("[ОЖИДАНИЕ] После ответа бэка повторите ЭТОТ ЖЕ алгоритм через несколько секунд");
            Сообщить("Если ответ не применяется: журнал КХ.Шина.Подтверждение.Опера и обработчик получения ExchOperaPC");
        КонецЕсли;
    КонецЕсли;
    Сообщить("===== КОНЕЦ АЛГОРИТМА OPERA =====");
Исключение
    ТекстОшибки = ОписаниеОшибки();
