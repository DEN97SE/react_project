// Модуль процесса Opera в Шине. Редакция 2: JSON читается в соответствие.
// Метод сохраняет прежнее имя для существующей привязки транслятора.
// Обратная ветка: FromBackend -> транслятор -> ToBackend.

метод АдресОтветаPCПреобразование(
    Контекст: КонтекстВызоваИнтеграции,
    Сообщение: Opera.Сообщение): СообщениеИнтеграции

    если Сообщение.Отправитель.Код != "BackendOpera"
        выбросить новый ИсключениеНедопустимоеСостояние(
            Описание = "Opera: обратный транслятор ожидает отправителя BackendOpera")
    ;

    если Сообщение.Получатели.Размер() > 1
        выбросить новый ИсключениеНедопустимоеСостояние(
            Описание = "Opera: ответ должен иметь одного получателя")
    ;

    // Явный адрес магазина сохраняем. BackendOpera адресом магазина не является.
    если Сообщение.Получатели.Размер() == 1
        если Сообщение.Получатели[0].Код != "BackendOpera"
            и не Сообщение.Получатели[0].Код.Пусто()
            возврат Сообщение
        ;
    ;

    // Сохраняем полный исходный JSON, включая неизвестные поля ACK.
    исп ИсходноеТело = Сообщение.ПолучитьТелоКакПоток()
    пер ТекстТела = ИсходноеТело.ПрочитатьКакСтроку()
    пер ПотокРазбора = новый ВременныйПотокЗаписи()
    ПотокРазбора.Записать(ТекстТела)
    исп ЧтениеТела = ПотокРазбора.ОткрытьПотокЧтения()
    // Соответствие не требует присутствия всех возможных полей ACK.
    пер Данные = СериализацияJson.ПрочитатьОбъект(
        ЧтениеТела,
        Тип<Соответствие<Строка, Объект?>>,
        новый НастройкиЧтенияОбъектовJson())

    пер ПолеАдреса = "store_id"
    если Данные.СодержитКлюч("dataset")
        если Данные.Получить("dataset") == "structural_units"
            ПолеАдреса = "source_id"
        ;
    ;
    если Данные.СодержитКлюч("message_type")
        если Данные.Получить("message_type") == "structural_units_request"
            ПолеАдреса = "source_id"
        ;
    ;

    если не Данные.СодержитКлюч(ПолеАдреса)
        выбросить новый ИсключениеНедопустимоеСостояние(
            Описание = "Opera: для адресации ответа отсутствует поле " + ПолеАдреса)
    ;
    пер ЗначениеАдреса = Данные.Получить(ПолеАдреса)
    если ЗначениеАдреса это не Строка
        выбросить новый ИсключениеНедопустимоеСостояние(
            Описание = "Opera: поле " + ПолеАдреса + " должно содержать строку UUID")
    ;
    пер ВнешнийИд = ЗначениеАдреса как Строка
    если ВнешнийИд.Пусто()
        выбросить новый ИсключениеНедопустимоеСостояние(
            Описание = "Opera: пустой UUID в поле " + ПолеАдреса)
    ;

    пер КодПолучателя = ""
    попытка
        пер НормальныйИд = (новый Ууид(ВнешнийИд)).ВСтроку()
        если НормальныйИд == "00000000-0000-0000-0000-000000000000"
            выбросить новый ИсключениеНедопустимоеСостояние(
                Описание = "Нулевой UUID получателя")
        ;
        КодПолучателя = "S" + НормальныйИд.Заменить("-", "")
    поймать Ошибка: Исключение
        выбросить новый ИсключениеНедопустимоеСостояние(
            Описание = "Opera: некорректный UUID получателя: " + ВнешнийИд)
    ;

    // Возвращаем исходное тело целиком и один явный код получателя.
    пер ТелоДляОтправки = новый ВременныйПотокЗаписи()
    ТелоДляОтправки.Записать(ТекстТела)
    возврат Сообщение
        .УстановитьКодыПолучателей([КодПолучателя])
        .УстановитьТелоИзПотока(ТелоДляОтправки.ОткрытьПотокЧтения())
;
