// Только база 50. Автоматические задания подготовки/отправки на время теста остановлены.
// ExchPriceChecker включён, ExchOperaPC выключен.
// Продолжает текущий пакет; при отсутствии любых PC-пакетов создаёт одну delta.
// Повторный запуск при Отправлено принимает ACK, без новой регистрации/повторной отправки.
К = КХ_ПилотШины.Контекст();
Если К.Номер <> 50
    ИЛИ К.Код <> "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
    ВызватьИсключение "Выполнять только в магазине 50";
КонецЕсли;
Если ТранзакцияАктивна() Тогда
    ВызватьИсключение "Запустите вне транзакции";
КонецЕсли;

Если СервисыИнтеграции.ExchOperaPC.ПолучитьАктивность()
    ИЛИ НЕ СервисыИнтеграции.ExchPriceChecker.ПолучитьАктивность() Тогда
    ВызватьИсключение "Для теста включите ExchPriceChecker и выключите ExchOperaPC";
КонецЕсли;

СвойУзел = "S3370588b074211e0b9c1001a64c3f566";
Маршрут = КХ_ОбменШиныОпера.ПараметрыМаршрутаПрайсЧекеров();
Если НЕ Маршрут.Настроен
    ИЛИ Маршрут.КодОтправителя <> СвойУзел
    ИЛИ Маршрут.КодПолучателя <> СвойУзел Тогда
    ВызватьИсключение "Маршрут PC должен быть S337... -> S337...; текущий маршрут не изменён";
КонецЕсли;

// Сначала приём уже отправленных бэком ответов.
СервисыИнтеграции.ВыполнитьОбработку();

ИдПакета = "3f45925e-9fc3-4156-918e-c453407d2775";
Цель = Неопределено;
ВсеPC = Новый Массив;
Для Каждого Запись Из КХ_ПилотШины.Очередь() Цикл
    Если СокрЛП(Запись.ВнешняяСистема) = "PriceCheker" Тогда
        ВсеPC.Добавить(Запись);
        Если Запись.ИдентификаторОбъекта = ИдПакета Тогда
            Если Цель <> Неопределено Тогда
                ВызватьИсключение "Один batch_id найден в нескольких строках очереди";
            КонецЕсли;
            Цель = Запись;
        КонецЕсли;
    КонецЕсли;
КонецЦикла;

Если Цель = Неопределено Тогда
    Если ВсеPC.Количество() = 1 Тогда
        Цель = ВсеPC[0];
    ИначеЕсли ВсеPC.Количество() > 1 Тогда
        ВызватьИсключение "Текущий batch_id отсутствует, но есть другие PC-пакеты; пришлите их ID";
    Иначе
        // Одна новая карточка; ПодготовитьДельту создаёт пакеты Opera и PC.
        Если КХ_ОбменШиныОпера.КодУзлаОтправителя() <> СвойУзел Тогда
            ВызватьИсключение "Отправитель Opera не соответствует магазину 50";
        КонецЕсли;
        Для Каждого Запись Из КХ_ПилотШины.Очередь() Цикл
            Если СокрЛП(Запись.ВнешняяСистема) = "Opera"
                И Запись.СтатусСообщения <>
                    Перечисления.СтатусыСообщенийШины.ДоставкаПодтверждена Тогда
                ВызватьИсключение "Есть незавершённый пакет Opera; повторную пару пакетов не создаём";
            КонецЕсли;
        КонецЦикла;
        Номенклатура = КХ_ДанныеОпера.НайтиНоменклатуруПоШтрихкоду("4607174577787");
        Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
            ВызватьИсключение "Товар по штрихкоду не найден в базе 50";
        КонецЕсли;
        Ссылки = Новый Массив;
        Ссылки.Добавить(Номенклатура);
        Данные = КХ_ДанныеОпера.СформироватьСостояниеКаталога(
            КХ_ОбменШиныОпера.ТекущаяСЕ(), Ссылки);
        Если Данные.products.Количество() <> 1
            ИЛИ Данные.deleted_nomenclature_ids.Количество() <> 0 Тогда
            ВызватьИсключение "Для теста нужна одна действующая карточка";
        КонецЕсли;
        КХ_ОбменШиныОпера.ЗарегистрироватьНоменклатуру(Номенклатура);
        Если НЕ КХ_ОбменШиныОпера.ПодготовитьДельту(Номенклатура) Тогда
            ВызватьИсключение "Не удалось подготовить delta";
        КонецЕсли;
        Для Каждого Запись Из КХ_ПилотШины.Очередь() Цикл
            Если СокрЛП(Запись.ВнешняяСистема) = "PriceCheker" Тогда
                Если Цель <> Неопределено Тогда
                    ВызватьИсключение "После подготовки найдено несколько PC-пакетов; отправка не выполнялась";
                КонецЕсли;
                Цель = Запись;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
КонецЕсли;
Если Цель = Неопределено Тогда
    ВызватьИсключение "PC-пакет не найден после подготовки";
КонецЕсли;

ИдПакета = Цель.ИдентификаторОбъекта;
Тело = КХ_ОбменШиныОпера.ИзJSON(Цель.СтроковыйОбъект);
Если КХ_ОбменШиныОпера.СтроковоеПоле(Тело, "batch_id") <> ИдПакета
    ИЛИ КХ_ОбменШиныОпера.СтроковоеПоле(Тело, "store_id") <> К.Код
    ИЛИ КХ_ОбменШиныОпера.СтроковоеПоле(Тело, "project") <> "pricechecker"
    ИЛИ КХ_ОбменШиныОпера.СтроковоеПоле(Тело, "message_type") <> "products"
    ИЛИ КХ_ОбменШиныОпера.СтроковоеПоле(Тело, "source_node") <> СвойУзел
    ИЛИ СокрЛП(Цель.УзелПолучатель) <> СвойУзел
    ИЛИ СокрЛП(Цель.КаналСервисаИнтеграции) <> "Основной_PC_FromShops" Тогда
    ВызватьИсключение "Тело или адреса выбранного PC-пакета не соответствуют тесту 50";
КонецЕсли;

Сообщить("PC50 | batch_id=" + ИдПакета + " | получатель=" + Цель.УзелПолучатель);
Если Цель.СтатусСообщения = Перечисления.СтатусыСообщенийШины.ОжидаетОтправки Тогда
    // Отправитель выбирает из всей очереди; исключаем выбор другого пакета.
    Для Каждого Запись Из КХ_ПилотШины.Очередь() Цикл
        Если СокрЛП(Запись.ВнешняяСистема) = "PriceCheker"
            И Запись.ИдентификаторОбъекта <> ИдПакета
            И Запись.СтатусСообщения <>
                Перечисления.СтатусыСообщенийШины.ДоставкаПодтверждена Тогда
            ВызватьИсключение "Есть другой незавершённый PC-пакет; автоматический выбор неоднозначен";
        КонецЕсли;
    КонецЦикла;
    КХ_ОбменШиныОпера.ОтправитьПорциюПакетов("PriceCheker", 1);
Иначе
    Сообщить("Повторная отправка не выполняется; статус до проверки: "
        + Строка(Цель.СтатусСообщения));
КонецЕсли;

СервисыИнтеграции.ВыполнитьОбработку();
Запрос = Новый Запрос(
"ВЫБРАТЬ СтатусСообщения, ТекстОшибки, ДатаОтправки, ДатаЗагрузки
|ИЗ РегистрСведений.ОчередьШины
|ГДЕ ВнешняяСистема = ""PriceCheker""
| И ИдентификаторОбъекта = &Ид");
Запрос.УстановитьПараметр("Ид", ИдПакета);
Строки = Запрос.Выполнить().Выгрузить();
Если Строки.Количество() <> 1 Тогда
    ВызватьИсключение "Для проверяемого batch_id ожидалась одна строка очереди";
КонецЕсли;
Для Каждого Запись Из Строки Цикл
    Сообщить("Статус: " + Строка(Запись.СтатусСообщения));
    Сообщить("Текст: " + Запись.ТекстОшибки);
    Сообщить("Дата отправки: " + Строка(Запись.ДатаОтправки));
    Сообщить("Дата загрузки: " + Строка(Запись.ДатаЗагрузки));
КонецЦикла;
// Приём асинхронный: после реального ACK повторить этот же скрипт через несколько секунд.
