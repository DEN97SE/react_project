// Тело существующего события ОбработкаПолученияСообщения
// канала Основной_PC_ToBackend сервиса ExchPriceChecker в базе 50.
// Сохранить имя/сигнатуру процедуры из конфигуратора и привязку события.
// Не читать тело сообщения перед вызовом общего обработчика.
ОжидаемыйОтправитель =
    КХ_ОбменШиныОпера.ПараметрыМаршрутаПрайсЧекеров().КодПолучателя;
Если СокрЛП(Сообщение.КодОтправителя) <> ОжидаемыйОтправитель Тогда
    Отказ = Истина;
    КХ_ОбменШиныОпера.ЗаписатьОшибку(
        "Входящее.PC.Отправитель",
        "Ожидался " + ОжидаемыйОтправитель
        + "; получен " + СокрЛП(Сообщение.КодОтправителя));
    Возврат;
КонецЕсли;
КХ_ОбменШиныПрайсЧекеры.ОбработатьВходящееСообщение(Сообщение, Отказ);
