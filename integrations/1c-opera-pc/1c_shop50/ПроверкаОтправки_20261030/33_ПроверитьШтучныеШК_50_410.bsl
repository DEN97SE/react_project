ВызватьИсключение "Проверка33 отменена: теперь необходимо сохранять и шт, и кор. Используйте диагностику34";
// Консоль кода в тестовых базах 50/410 ПОСЛЕ обновления КХ_ДанныеОпера.
// Только чтение текущих карточек штатным сборщиком, без отправки и записи.

СЕ = ОбщиеПроцедурыИФункцииПовтИсп.ТекущаяСтруктурнаяЕдиница();
ИдМагазина = КХ_ДанныеОпера.ПолучитьИдентификаторМагазина(СЕ);
Проверки = Новый Массив;

Если ИдМагазина = "40933103-84ba-4d00-ab50-ce9efa15eda8" Тогда
	Проверки.Добавить(Новый Структура("ШтрихКод,ИдТовара,ДругойШтучныйШК",
		"2000452859001", "3a7f0a8d-56f7-11f0-9682-6eae8b1e8f89", "2210000274648"));
ИначеЕсли ИдМагазина = "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
	Проверки.Добавить(Новый Структура("ШтрихКод,ИдТовара,ДругойШтучныйШК",
		"4620000130321", "ace5bf53-5c12-11e8-a448-5ef3fd3615c3", "4620000130314"));
	Проверки.Добавить(Новый Структура("ШтрихКод,ИдТовара,ДругойШтучныйШК",
		"4620000130369", "657b3be5-2162-11e6-b1b8-5ef3fd361d6b", "4620000130352"));
Иначе
	ВызватьИсключение "Проверка подготовлена только для магазинов 50 и 410";
КонецЕсли;

Для Каждого Проверка Из Проверки Цикл
	Карточка = КХ_ДанныеОпера.ПолучитьКарточкуПоШтрихкоду(СЕ, Проверка.ШтрихКод);
	Если Карточка = Неопределено Тогда
		ВызватьИсключение "Не найдена карточка по ШК " + Проверка.ШтрихКод;
	КонецЕсли;
	Если Карточка.nomenclature_id <> Проверка.ИдТовара Тогда
		ВызватьИсключение "По ШК найден другой товар: " + Проверка.ШтрихКод;
	КонецЕсли;

	КоличествоПроверяемогоШК = 0;
	ДругойШКСохранен = Ложь;
	Для Каждого ЗаписьШК Из Карточка.barcodes Цикл
		Если ЗаписьШК.barcode = Проверка.ШтрихКод Тогда
			КоличествоПроверяемогоШК = КоличествоПроверяемогоШК + 1;
			Если ЗаписьШК.unit <> "шт" Или ЗаписьШК.quantity_in_package <> "1" Тогда
				ВызватьИсключение "Остался конфликт упаковки: " + Проверка.ШтрихКод;
			КонецЕсли;
		КонецЕсли;
		Если ЗаписьШК.barcode = Проверка.ДругойШтучныйШК Тогда
			Если ЗаписьШК.unit = "шт" И ЗаписьШК.quantity_in_package = "1" Тогда
				ДругойШКСохранен = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоПроверяемогоШК <> 1 Тогда
		ВызватьИсключение "Проверяемый ШК должен остаться один раз: " + Проверка.ШтрихКод;
	КонецЕсли;
	Если НЕ ДругойШКСохранен Тогда
		ВызватьИсключение "Потерян другой штучный ШК: " + Проверка.ДругойШтучныйШК;
	КонецЕсли;

	Сообщить("[ОК] " + Карточка.nomenclature_id + " | " + Карточка.name);
	Сообщить(КХ_ОбменШиныОпера.ВJSON(Карточка.barcodes));
КонецЦикла;

Сообщить("Проверка штучных ШК пройдена. Сообщения не отправлялись, очередь не менялась.");
