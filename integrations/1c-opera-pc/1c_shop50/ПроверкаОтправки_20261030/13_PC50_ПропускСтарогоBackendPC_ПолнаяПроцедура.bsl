// Пользователь разрешил снять старые сообщения с обработки.
// Временный порог очистки ФИКСИРОВАН: до 30.10.2026, не текущая дата сеанса.
// Только база с ожидаемым адресом S50 и старый отправитель Backend_PC.
// Свежие сообщения, другие отправители и база 410 под очистку не попадают.
// Товарные бизнес-статусы здесь не выставляются; тело разрешённых сообщений не читается заранее.
Процедура Основной_PC_ToBackendОбработкаПолученияСообщения(Сообщение, Отказ)

    ОжидаемыйОтправитель =
        КХ_ОбменШиныОпера.ПараметрыМаршрутаПрайсЧекеров().КодПолучателя;
    Отправитель = СокрЛП(Сообщение.КодОтправителя);

    Если ОжидаемыйОтправитель = "S3370588b074211e0b9c1001a64c3f566"
        И НРег(Отправитель) = "backend_pc"
        И ЗначениеЗаполнено(Сообщение.ДатаОтправки)
        И Сообщение.ДатаОтправки < Дата(2026, 10, 30) Тогда

        ЗаписьЖурналаРегистрации(
            "КХ.Шина.ПропущеноСтароеPC50",
            УровеньЖурналаРегистрации.Информация, , ,
            "Отправитель=" + Отправитель
            + "; дата отправки=" + Строка(Сообщение.ДатаОтправки)
            + "; ID=" + Строка(Сообщение.Идентификатор));

        Отказ = Ложь;
        Возврат;
    КонецЕсли;

    Если Отправитель <> ОжидаемыйОтправитель Тогда
        Отказ = Истина;
        КХ_ОбменШиныОпера.ЗаписатьОшибку(
            "Входящее.PC.Отправитель",
            "Ожидался " + ОжидаемыйОтправитель + "; получен " + Отправитель);
        Возврат;
    КонецЕсли;

    // Обязательная обработка актуальных ACK и запросов PC.
    КХ_ОбменШиныПрайсЧекеры.ОбработатьВходящееСообщение(Сообщение, Отказ);

КонецПроцедуры
