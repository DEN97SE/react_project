// Только чтение регистра исходящих пакетов. Не читает локальную очередь ответов.
// Показывает последние10 записей вне зависимости от batch_id/статуса.
К = КХ_ПилотШины.Контекст();
Если К.Номер <> 50
    ИЛИ К.Код <> "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
    ВызватьИсключение "Выполнять только в магазине 50";
КонецЕсли;

Запрос = Новый Запрос(
"ВЫБРАТЬ ПЕРВЫЕ 10
| ИдентификаторОбъекта, СтатусСообщения, УзелПолучатель,
| КаналСервисаИнтеграции, ДатаРегистрации, ДатаОтправки,
| ДатаЗагрузки, ТекстОшибки
|ИЗ РегистрСведений.ОчередьШины
|ГДЕ ВнешняяСистема = ""PriceCheker""
|УПОРЯДОЧИТЬ ПО ДатаРегистрации УБЫВ, ИдентификаторОбъекта");

Строки = Запрос.Выполнить().Выгрузить();
Сообщить("Магазин=50; найдено PC-записей в выборке: "
    + Строка(Строки.Количество()));

Для Каждого Запись Из Строки Цикл
    Сообщить("batch_id=" + Запись.ИдентификаторОбъекта
        + " | статус=" + Строка(Запись.СтатусСообщения)
        + " | получатель=" + Запись.УзелПолучатель
        + " | канал=" + Запись.КаналСервисаИнтеграции);
    Сообщить("Регистрация=" + Строка(Запись.ДатаРегистрации)
        + " | отправка=" + Строка(Запись.ДатаОтправки)
        + " | загрузка=" + Строка(Запись.ДатаЗагрузки)
        + " | текст=" + Запись.ТекстОшибки);
КонецЦикла;
