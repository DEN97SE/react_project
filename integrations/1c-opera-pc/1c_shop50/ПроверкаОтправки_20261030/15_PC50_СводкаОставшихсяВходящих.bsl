// Только чтение локальной очереди PC базы50. Сервис оставить выключенным.
// Разбор тела выполняется у выбранных сообщений, без передачи их обработчику/удаления.
К = КХ_ПилотШины.Контекст();
Если К.Номер <> 50
    ИЛИ К.Код <> "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
    ВызватьИсключение "Выполнять только в базе магазина 50";
КонецЕсли;

Канал = СервисыИнтеграции.ExchPriceChecker.Основной_PC_ToBackend;
Сообщения = Канал.ВыбратьСообщения();
Сводка = Новый Соответствие;

Для Каждого Сообщение Из Сообщения Цикл
    Период = "дата не заполнена";
    Если ЗначениеЗаполнено(Сообщение.ДатаОтправки) Тогда
        Период = ?(Сообщение.ДатаОтправки < Дата(2026, 10, 30),
            "до 30.10", "30.10 и новее");
    КонецЕсли;

    Магазин = "";
    Вид = "";
    Попытка
        Данные = КХ_ОбменШиныОпера.ИзJSON(
            КХ_ОбменШиныОпера.ТелоСообщенияВСтроку(Сообщение));
        Магазин = КХ_ОбменШиныОпера.СтроковоеПоле(Данные, "store_id");
        Вид = КХ_ОбменШиныОпера.СтроковоеПоле(Данные, "message_type");
    Исключение
        Вид = "ошибка чтения JSON";
    КонецПопытки;

    Ключ = "отправитель=" + СокрЛП(Сообщение.КодОтправителя)
        + " | store_id=" + Магазин
        + " | тип=" + Вид + " | " + Период;
    Количество = Сводка.Получить(Ключ);
    Если Количество = Неопределено Тогда Количество = 0; КонецЕсли;
    Сводка.Вставить(Ключ, Количество + 1);
КонецЦикла;

Сообщить("Всего в локальном канале: " + Строка(Сообщения.Количество()));
Для Каждого Группа Из Сводка Цикл
    Сообщить(Группа.Ключ + " | сообщений=" + Строка(Группа.Значение));
КонецЦикла;
