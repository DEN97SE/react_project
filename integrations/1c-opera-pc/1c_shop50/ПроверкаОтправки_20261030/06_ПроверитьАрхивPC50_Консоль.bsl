К = КХ_ПилотШины.Контекст();
Если К.Номер <> 50 ИЛИ К.Код <> "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
    ВызватьИсключение "Выполнять только в магазине 50";
КонецЕсли;
Запрос = Новый Запрос(
"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Архивировано
|ИЗ РегистрСведений.ОчередьШины
|ГДЕ ВнешняяСистема = ""OperaState""
| И УзелПолучатель = ""КХ_АрхивACK50_PriceCheker""
| И КаналСервисаИнтеграции = """"");
Сообщить("Архив чужих ACK PC в базе 50: "
    + Строка(Запрос.Выполнить().Выгрузить()[0].Архивировано));
Сообщить("Текущие товарные пакеты:");
Для Каждого Запись Из КХ_ПилотШины.Очередь() Цикл
    Если СокрЛП(Запись.ВнешняяСистема) = "Opera"
        ИЛИ СокрЛП(Запись.ВнешняяСистема) = "PriceCheker" Тогда
        Сообщить(Запись.ВнешняяСистема + " | " + Запись.ИдентификаторОбъекта
            + " | " + Строка(Запись.СтатусСообщения));
    КонецЕсли;
КонецЦикла;
