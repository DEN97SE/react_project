// ЛОКАЛЬНАЯ очередь полученных сообщений платформы 1С.
// API подтверждён в kodmis/messages-1c-shina-viewer:
// commit 280b72072c5d418e94175e5ec821af34961a2772,
// ObjectModule.bsl:12, Forms/Форма/Module.bsl:369–374.
// Канал в Шине, товарный регистр и бизнес-статусы не изменяются.
// Удаляются только сообщения Backend_PC с заполненной датой до 30.10.2026.
// Перед запуском продолжить текущую остановку отладчика, отключить ExchPriceChecker
// и дождаться завершения его обработки. Выполнить вне транзакции в базе 50.

К = КХ_ПилотШины.Контекст();
Если К.Номер <> 50
    ИЛИ К.Код <> "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
    ВызватьИсключение "Выполнять только в базе магазина 50";
КонецЕсли;
Если ТранзакцияАктивна() Тогда
    ВызватьИсключение "Запустите вне транзакции";
КонецЕсли;
Если СервисыИнтеграции.ExchPriceChecker.ПолучитьАктивность() Тогда
    ВызватьИсключение "Сначала выключите ExchPriceChecker и дождитесь завершения обработки";
КонецЕсли;

Канал = СервисыИнтеграции.ExchPriceChecker.Основной_PC_ToBackend;
Сообщения = Канал.ВыбратьСообщения();
КУдалению = Новый Массив;

Для Каждого Сообщение Из Сообщения Цикл
    Если НРег(СокрЛП(Сообщение.КодОтправителя)) = "backend_pc"
        И ЗначениеЗаполнено(Сообщение.ДатаОтправки)
        И Сообщение.ДатаОтправки < Дата(2026, 10, 30) Тогда

        КУдалению.Добавить(Сообщение.Идентификатор);
        Сообщить("Удаляем старое входящее: "
            + Строка(Сообщение.Идентификатор)
            + " | " + Строка(Сообщение.ДатаОтправки));
    КонецЕсли;
КонецЦикла;

Если КУдалению.Количество() > 0 Тогда
    Канал.УдалитьСообщения(КУдалению);
КонецЕсли;

Сообщить("Удалено старых сообщений Backend_PC: "
    + Строка(КУдалению.Количество()));
Сообщить("Сообщений в локальном канале после удаления: "
    + Строка(Канал.ВыбратьСообщения().Количество()));
