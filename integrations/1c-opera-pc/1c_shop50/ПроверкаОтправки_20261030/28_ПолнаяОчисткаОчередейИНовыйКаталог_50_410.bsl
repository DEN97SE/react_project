// ОДИН алгоритм для консоли тестовых баз №50 и №410.
// Очищает все сообщения нашего обмена в1С, включая старые сообщения СЕ.
// Заново выгружает только товарные карточки в Opera и PC.
// Сохраняет подключения, ключи, маршруты, source_epoch и directory_epoch.
// При повторе этого же кода очистка не повторяется: включение/контроль продолжаются.

КодОчистки = "TEST_PRODUCTS_20261102_01";
Этап = "Начало";
СкрываемыеКлючи = Новый Массив;

Попытка
    Сообщить("===== ПОЛНАЯ ОЧИСТКА СООБЩЕНИЙ И НОВЫЙ ТОВАРНЫЙ КАТАЛОГ =====");
    Этап = "1. Проверка тестовой базы и подключений";
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "Запустите вне транзакции"; КонецЕсли;
    Магазин = КХ_ОбменШиныОпера.ИдентификаторМагазина();
    Если Магазин = "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
        ИмяТестовойБазы = "AstorK50_Semidockiy";
    ИначеЕсли Магазин = "40933103-84ba-4d00-ab50-ce9efa15eda8" Тогда
        ИмяТестовойБазы = "Astor_k410_Semidockiy";
    Иначе
        ВызватьИсключение "Очистка предназначена только для тестовых №50 и №410";
    КонецЕсли;
    СтрокаИБ = СтрЗаменить(НРег(СтрокаСоединенияИнформационнойБазы()), """", "") + ";";
    Если СтрНайти(СтрокаИБ, "ref=" + НРег(ИмяТестовойБазы) + ";") = 0 Тогда
        ВызватьИсключение "Имя ИБ не совпадает с разрешённой тестовой базой: " + ИмяТестовойБазы;
    КонецЕсли;
    Сообщить("[1] " + ИмяТестовойБазы + "; store_id=" + Магазин);
    СвойУзел = "S" + СтрЗаменить(Магазин, "-", "");
    ЗапросКорня = Новый Запрос(
    "ВЫБРАТЬ СтроковыйОбъект ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема = ""OperaState"" И ИдентификаторОбъекта = ""КХ_OperaState""
    | И УзелПолучатель = """" И КаналСервисаИнтеграции = """"");
    Корни = ЗапросКорня.Выполнить().Выгрузить();
    Если Корни.Количество() <> 1 Тогда ВызватьИсключение "Нет единственного состояния товарного обмена"; КонецЕсли;
    Состояние = КХ_ОбменШиныОпера.ИзJSON(Корни[0].СтроковыйОбъект);
    Для Каждого Описание Из СтрРазделить("node_code|" + СвойУзел + ";pc_store_id|" + Магазин
        + ";pc_node_code|" + СвойУзел + ";pc_backend_node|" + СвойУзел
        + ";opera_backend_node|BackendOpera", ";") Цикл
        Части = СтрРазделить(Описание, "|");
        Если КХ_ОбменШиныОпера.СтроковоеПоле(Состояние, Части[0]) <> Части[1] Тогда
            ВызватьИсключение "Не соответствует магазину маршрут " + Части[0];
        КонецЕсли;
    КонецЦикла;
    Если ПустаяСтрока(КХ_ОбменШиныОпера.СтроковоеПоле(Состояние, "source_epoch")) Тогда
        ВызватьИсключение "Не заполнена товарная эпоха; очистка остановлена";
    КонецЕсли;
    Очищено = Ложь;
    Отметка = Неопределено;
    Если Состояние.Свойство("test_products_reload", Отметка) Тогда
        Если ТипЗнч(Отметка) = Тип("Структура") Тогда
            Очищено = КХ_ОбменШиныОпера.СтроковоеПоле(Отметка, "id") = КодОчистки;
        КонецЕсли;
    КонецЕсли;
    Каналы = СтрРазделить("ExchOperaPC|Основной_ExchangeOpera_FromOpera;"
        + "ExchOperaPC|Основной_ExchangeOpera_ToBackend;"
        + "ExchPriceChecker|Основной_PC_FromShops;"
        + "ExchPriceChecker|Основной_PC_ToBackend", ";");
    Для Каждого Описание Из Каналы Цикл
        Части = СтрРазделить(Описание, "|");
        Если Метаданные.СервисыИнтеграции[Части[0]].КаналыСервисаИнтеграции.Найти(Части[1]) = Неопределено Тогда
            ВызватьИсключение "Не найден канал " + Части[1];
        КонецЕсли;
    КонецЦикла;
    Для Каждого ИмяСервиса Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
        Настройки = СервисыИнтеграции[ИмяСервиса].ПолучитьНастройки();
        Если НЕ ПустаяСтрока(Настройки.ИмяПользователяВнешнегоСервисаИнтеграции) Тогда
            СкрываемыеКлючи.Добавить(Настройки.ИмяПользователяВнешнегоСервисаИнтеграции);
        КонецЕсли;
        Если НЕ ПустаяСтрока(Настройки.ПарольПользователяВнешнегоСервисаИнтеграции) Тогда
            СкрываемыеКлючи.Добавить(Настройки.ПарольПользователяВнешнегоСервисаИнтеграции);
        КонецЕсли;
        Если ПустаяСтрока(Настройки.АдресВнешнегоСервисаИнтеграции)
            ИЛИ ПустаяСтрока(Настройки.ИмяПользователяВнешнегоСервисаИнтеграции)
            ИЛИ ПустаяСтрока(Настройки.ПарольПользователяВнешнегоСервисаИнтеграции) Тогда
            ВызватьИсключение "Не заполнено подключение " + ИмяСервиса;
        КонецЕсли;
    КонецЦикла;

    // 2. Выбираем только наши задания; остальные задания базы не затрагиваются.
    Этап = "2. Наши регламентные задания";
    МетодТоваров = НРег("КХ_ОбменШиныОпера.РегламентнаяОбработкаОчередиОпера");
    Методы = СтрРазделить(МетодТоваров + ";"
        + НРег("КХ_ОбменШиныПрайсЧекеры.РегламентнаяОбработкаОчередиPriceCheker") + ";"
        + НРег("КХ_ОбменСтруктурныхЕдиниц.РегламентнаяОбработкаСправочника"), ";");
    НашиЗадания = Новый Массив;
    ТоварныеЗадания = Новый Массив;
    Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл
        Метод = НРег(СтрЗаменить(Строка(Задание.Метаданные.ИмяМетода), "ОбщийМодуль.", ""));
        Если Методы.Найти(Метод) <> Неопределено Тогда НашиЗадания.Добавить(Задание); КонецЕсли;
        Если Метод = МетодТоваров Тогда ТоварныеЗадания.Добавить(Задание); КонецЕсли;
    КонецЦикла;
    Если ТоварныеЗадания.Количество() <> 1 Тогда ВызватьИсключение "Ожидается одно общее товарное задание"; КонецЕсли;
    ТоварноеЗадание = ТоварныеЗадания[0];
    ПользовательЗадания = ТоварноеЗадание.ИмяПользователя;
    Если ПустаяСтрока(ПользовательЗадания) Тогда ПользовательЗадания = ИмяПользователя(); КонецЕсли;
    Если ПустаяСтрока(ПользовательЗадания)
        ИЛИ ПользователиИнформационнойБазы.НайтиПоИмени(ПользовательЗадания) = Неопределено Тогда
        ВызватьИсключение "Не найден пользователь товарного задания";
    КонецЕсли;

    Если НЕ Очищено Тогда
        // 3. Остановка именно нашего обмена до удаления сообщений.
        Этап = "3. Остановка обмена перед очисткой";
        Для Каждого Задание Из НашиЗадания Цикл
            Если Задание.Использование Тогда
                Задание.Использование = Ложь;
                Задание.Записать();
            КонецЕсли;
        КонецЦикла;
        Для Каждого ИмяСервиса Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
            Если СервисыИнтеграции[ИмяСервиса].ПолучитьАктивность() Тогда
                СервисыИнтеграции[ИмяСервиса].УстановитьАктивность(Ложь);
            КонецЕсли;
        КонецЦикла;
        ЕстьАктивные = Ложь;
        Для Каждого Задание Из НашиЗадания Цикл
            // Фильтр ограничен конкретным регламентным заданием нашего обмена.
            Для Каждого Фоновое Из ФоновыеЗадания.ПолучитьФоновыеЗадания(
                Новый Структура("РегламентноеЗадание", Задание)) Цикл
                Если Фоновое.Состояние = СостояниеФоновогоЗадания.Активно Тогда
                    ЕстьАктивные = Истина;
                    Фоновое.Отменить();
                    Сообщить("[ОСТАНОВКА] " + Задание.Метаданные.Имя
                        + "; фоновый ID=" + Строка(Фоновое.УникальныйИдентификатор));
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;

        Если ЕстьАктивные Тогда
            Сообщить("[ОЖИДАНИЕ] Запрошена отмена наших активных циклов. Сообщения пока не удалялись");
            Сообщить("Повторите ЭТОТ ЖЕ алгоритм через 5–10 секунд после завершения остановки");
        Иначе
            // 4. Все локальные сообщения четырёх каналов платформы.
            Этап = "4. Очистка локальных каналов платформы";
            Для Каждого Описание Из Каналы Цикл
                Части = СтрРазделить(Описание, "|");
                Канал = СервисыИнтеграции[Части[0]][Части[1]];
                Удалено = 0;
                ПредыдущийПервый = "";
                Пока Истина Цикл
                    Сообщения = Канал.ВыбратьСообщения(, 1000);
                    Если Сообщения.Количество() = 0 Тогда Прервать; КонецЕсли;
                    Идентификаторы = Новый Массив;
                    Для Каждого Сообщение Из Сообщения Цикл
                        Идентификаторы.Добавить(Сообщение.Идентификатор);
                    КонецЦикла;
                    Если Строка(Идентификаторы[0]) = ПредыдущийПервый Тогда
                        ВызватьИсключение "Сообщения канала не удалились: " + Части[1];
                    КонецЕсли;
                    ПредыдущийПервый = Строка(Идентификаторы[0]);
                    Канал.УдалитьСообщения(Идентификаторы);
                    Удалено = Удалено + Идентификаторы.Количество();
                КонецЦикла;
                Сообщить("[КАНАЛ ОЧИЩЕН] " + Части[0] + "/" + Части[1]
                    + "; удалено=" + Строка(Удалено) + "; осталось=0");
            КонецЦикла;

            // 5. Удаляем сообщения/старые сессии; сохраняем два корня настроек.
            Этап = "5. Очистка регистра и запрос нового товарного full";
            НачатьТранзакцию();
            Попытка
                Блокировка = Новый БлокировкаДанных;
                Для Каждого Система Из СтрРазделить("Opera,PriceCheker,StructuralUnits,OperaChange,OperaState", ",") Цикл
                    Элемент = Блокировка.Добавить("РегистрСведений.ОчередьШины");
                    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
                    Элемент.УстановитьЗначение("ВнешняяСистема", Система);
                КонецЦикла;
                Блокировка.Заблокировать();
                Для Каждого Система Из СтрРазделить("Opera,PriceCheker,StructuralUnits,OperaChange", ",") Цикл
                    Набор = РегистрыСведений.ОчередьШины.СоздатьНаборЗаписей();
                    Набор.ОбменДанными.Загрузка = Истина;
                    Набор.Отбор.ВнешняяСистема.Установить(Система);
                    Набор.Прочитать();
                    Удалено = Набор.Количество();
                    Набор.Очистить();
                    Набор.Записать(Истина);
                    Сообщить("[ПОДГОТОВЛЕНО К УДАЛЕНИЮ] " + Система + "; строк=" + Строка(Удалено));
                КонецЦикла;
                НаборСостояний = РегистрыСведений.ОчередьШины.СоздатьНаборЗаписей();
                НаборСостояний.ОбменДанными.Загрузка = Истина;
                НаборСостояний.Отбор.ВнешняяСистема.Установить("OperaState");
                НаборСостояний.Прочитать();
                УдаленоТехнических = 0;
                ТоварныхКорней = 0;
                Индекс = НаборСостояний.Количество() - 1;
                Пока Индекс >= 0 Цикл
                    СтрокаСостояния = НаборСостояний[Индекс];
                    КореньТоваров = СокрЛП(СтрокаСостояния.ИдентификаторОбъекта) = "КХ_OperaState"
                        И ПустаяСтрока(СтрокаСостояния.УзелПолучатель)
                        И ПустаяСтрока(СтрокаСостояния.КаналСервисаИнтеграции);
                    КореньСЕ = СокрЛП(СтрокаСостояния.ИдентификаторОбъекта) = "КХ_СЕState"
                        И ПустаяСтрока(СтрокаСостояния.УзелПолучатель)
                        И ПустаяСтрока(СтрокаСостояния.КаналСервисаИнтеграции);
                    Если КореньТоваров Тогда
                        ТоварныхКорней = ТоварныхКорней + 1;
                        Состояние = КХ_ОбменШиныОпера.ИзJSON(СтрокаСостояния.СтроковыйОбъект);
                        Состояние.full_active = Ложь;
                        Состояние.full = Новый Структура;
                        Состояние.catalog_requests = Новый Массив;
                        Состояние.Вставить("test_products_reload", Новый Структура("id,time",
                            КодОчистки, Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss")));
                        СтрокаСостояния.СтроковыйОбъект = КХ_ОбменШиныОпера.ВJSON(Состояние);
                    ИначеЕсли КореньСЕ Тогда
                        СостояниеСЕ = КХ_ОбменШиныОпера.ИзJSON(СтрокаСостояния.СтроковыйОбъект);
                        СостояниеСЕ.enabled = Ложь;
                        СостояниеСЕ.full_active = Ложь;
                        СостояниеСЕ.full_requested = Ложь;
                        СостояниеСЕ.full = Новый Структура;
                        СтрокаСостояния.СтроковыйОбъект = КХ_ОбменШиныОпера.ВJSON(СостояниеСЕ);
                    Иначе
                        НаборСостояний.Удалить(Индекс);
                        УдаленоТехнических = УдаленоТехнических + 1;
                    КонецЕсли;
                    Индекс = Индекс - 1;
                КонецЦикла;
                Если ТоварныхКорней <> 1 Тогда
                    ВызватьИсключение "Состояние товарного обмена изменилось во время подготовки; транзакция отменена";
                КонецЕсли;
                НаборСостояний.Записать(Истина);
                КХ_ОбменШиныОпера.ЗапроситьПовторнуюПолнуюВыгрузку();
                ЗафиксироватьТранзакцию();
                Очищено = Истина;
                Сообщить("[ОЧИСТКА ГОТОВА] Старых технических строк удалено=" + Строка(УдаленоТехнических));
                Сообщить("[НОВЫЙ СТАРТ] Запрошен товарный full для Opera и PC; ключи, маршруты и эпохи сохранены");
            Исключение
                ОтменитьТранзакцию();
                Сообщить("[ОТКАТ] Изменения регистра отменены. Локальные каналы могли быть уже очищены");
                ВызватьИсключение;
            КонецПопытки;
        КонецЕсли;
    Иначе
        Сообщить("[КОНТРОЛЬ] Очистка " + КодОчистки + " уже выполнена; продолжаем новый цикл");
    КонецЕсли;

    Если Очищено Тогда
        // 6. Возобновляем только товарный обмен. Повтор не удаляет новые сообщения.
        Этап = "6. Включение товарной автоматики";
        Для Каждого ИмяСервиса Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
            Если НЕ СервисыИнтеграции[ИмяСервиса].ПолучитьАктивность() Тогда
                СервисыИнтеграции[ИмяСервиса].УстановитьАктивность(Истина);
            КонецЕсли;
        КонецЦикла;
        ТоварноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(
            ТоварноеЗадание.УникальныйИдентификатор);
        Если НЕ ТоварноеЗадание.Использование Тогда
            Расписание = Новый РасписаниеРегламентногоЗадания;
            Расписание.ПериодПовтораДней = 1;
            Расписание.ПериодПовтораВТечениеДня = 10;
            ТоварноеЗадание.ИмяПользователя = ПользовательЗадания;
            ТоварноеЗадание.Расписание = Расписание;
            ТоварноеЗадание.Использование = Истина;
            ТоварноеЗадание.Записать();
        КонецЕсли;
        Сообщить("[АВТОМАТИКА] Товарное задание включено; " + Строка(ТоварноеЗадание.Расписание));
        Сообщить("[СЕ] Сообщения очищены; публикация и задание СЕ выключены");
        Корни = ЗапросКорня.Выполнить().Выгрузить();
        Состояние = КХ_ОбменШиныОпера.ИзJSON(Корни[0].СтроковыйОбъект);
        Сообщить("[ТОВАРЫ] source_epoch=" + Состояние.source_epoch
            + "; full_requested=" + Строка(Состояние.catalog_full_requested)
            + "; full_active=" + Строка(Состояние.full_active));
        Если Состояние.full_active Тогда
            Сообщить("    Новая сессия=" + Состояние.full.session_id
                + "; следующая порция=" + Строка(Состояние.full.next_sequence)
                + "; всего порций=" + Строка(Состояние.full.total_batches));
        КонецЕсли;
        Последнее = ТоварноеЗадание.ПоследнееЗадание;
        Если Последнее <> Неопределено Тогда
            Сообщить("[ИСТОРИЯ] Начало=" + Строка(Последнее.Начало)
                + "; состояние=" + Строка(Последнее.Состояние));
        КонецЕсли;
        Запрос = Новый Запрос(
        "ВЫБРАТЬ ВнешняяСистема, СтатусСообщения, КОЛИЧЕСТВО(*) КАК Количество
        |ИЗ РегистрСведений.ОчередьШины
        |ГДЕ ВнешняяСистема В (""Opera"", ""PriceCheker"", ""StructuralUnits"")
        |СГРУППИРОВАТЬ ПО ВнешняяСистема, СтатусСообщения");
        Для Каждого СтрокаОчереди Из Запрос.Выполнить().Выгрузить() Цикл
            Сообщить("[НОВАЯ ОЧЕРЕДЬ] " + СтрокаОчереди.ВнешняяСистема
                + " | " + Строка(СтрокаОчереди.СтатусСообщения)
                + " | " + Строка(СтрокаОчереди.Количество));
        КонецЦикла;
