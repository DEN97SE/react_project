// Только локальные сообщения сервисов интеграции тестовых №50/№410.
// Регистр ОчередьШины, его сессии, настройки и ключи сохраняются.
// На время очистки останавливаются только наши задания и два наших сервиса.
// После очистки включаются сервисы и общее товарное задание.
// При ОЖИДАНИИ повторить через5–10секунд; каждый успешный запуск чистит каналы.

Этап = "Начало";
СкрываемыеКлючи = Новый Массив;
Попытка
    Сообщить("===== ОЧИСТКА ТОЛЬКО СООБЩЕНИЙ СЕРВИСОВ ИНТЕГРАЦИИ =====");
    Этап = "1. Тестовая база";
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "Запустите вне транзакции"; КонецЕсли;
    Магазин = КХ_ОбменШиныОпера.ИдентификаторМагазина();
    Базы = Новый Соответствие;
    Базы.Вставить("3370588b-0742-11e0-b9c1-001a64c3f566", "AstorK50_Semidockiy");
    Базы.Вставить("40933103-84ba-4d00-ab50-ce9efa15eda8", "Astor_k410_Semidockiy");
    ИмяБазы = Базы.Получить(Магазин);
    Если ИмяБазы = Неопределено Тогда ВызватьИсключение "Только тестовые №50 и №410"; КонецЕсли;
    СтрокаИБ = СтрЗаменить(НРег(СтрокаСоединенияИнформационнойБазы()), """", "") + ";";
    Если СтрНайти(СтрокаИБ, "ref=" + НРег(ИмяБазы) + ";") = 0 Тогда
        ВызватьИсключение "Это не разрешённая тестовая база " + ИмяБазы;
    КонецЕсли;

    Этап = "2. Подготовка остановки нашего обмена";
    МетодТоваров = НРег("КХ_ОбменШиныОпера.РегламентнаяОбработкаОчередиОпера");
    Методы = СтрРазделить(МетодТоваров + ";"
        + НРег("КХ_ОбменШиныПрайсЧекеры.РегламентнаяОбработкаОчередиPriceCheker") + ";"
        + НРег("КХ_ОбменСтруктурныхЕдиниц.РегламентнаяОбработкаСправочника"), ";");
    НашиЗадания = Новый Массив;
    ТоварныеЗадания = Новый Массив;
    Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл
        Метод = НРег(СтрЗаменить(Строка(Задание.Метаданные.ИмяМетода), "ОбщийМодуль.", ""));
        Если Методы.Найти(Метод) <> Неопределено Тогда НашиЗадания.Добавить(Задание); КонецЕсли;
        Если Метод = МетодТоваров Тогда ТоварныеЗадания.Добавить(Задание); КонецЕсли;
    КонецЦикла;
    Если ТоварныеЗадания.Количество() <> 1 Тогда ВызватьИсключение "Ожидается одно общее товарное задание"; КонецЕсли;
    ТоварноеЗадание = ТоварныеЗадания[0];
    ПользовательЗадания = ТоварноеЗадание.ИмяПользователя;
    Если ПустаяСтрока(ПользовательЗадания) Тогда ПользовательЗадания = ИмяПользователя(); КонецЕсли;
    Если ПустаяСтрока(ПользовательЗадания)
        ИЛИ ПользователиИнформационнойБазы.НайтиПоИмени(ПользовательЗадания) = Неопределено Тогда
        ВызватьИсключение "Не найден пользователь товарного задания";
    КонецЕсли;
    Для Каждого ИмяСервиса Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
        Настройки = СервисыИнтеграции[ИмяСервиса].ПолучитьНастройки();
        Если НЕ ПустаяСтрока(Настройки.ИмяПользователяВнешнегоСервисаИнтеграции) Тогда
            СкрываемыеКлючи.Добавить(Настройки.ИмяПользователяВнешнегоСервисаИнтеграции);
        КонецЕсли;
        Если НЕ ПустаяСтрока(Настройки.ПарольПользователяВнешнегоСервисаИнтеграции) Тогда
            СкрываемыеКлючи.Добавить(Настройки.ПарольПользователяВнешнегоСервисаИнтеграции);
        КонецЕсли;
    КонецЦикла;
    Для Каждого Задание Из НашиЗадания Цикл
        Если Задание.Использование Тогда
            Задание.Использование = Ложь;
            Задание.Записать();
        КонецЕсли;
    КонецЦикла;
    Для Каждого ИмяСервиса Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
        Если СервисыИнтеграции[ИмяСервиса].ПолучитьАктивность() Тогда
            СервисыИнтеграции[ИмяСервиса].УстановитьАктивность(Ложь);
        КонецЕсли;
    КонецЦикла;
    ЕстьАктивные = Ложь;
    Для Каждого Задание Из НашиЗадания Цикл
        Для Каждого Фоновое Из ФоновыеЗадания.ПолучитьФоновыеЗадания(
            Новый Структура("РегламентноеЗадание", Задание)) Цикл
            Если Фоновое.Состояние = СостояниеФоновогоЗадания.Активно Тогда
                ЕстьАктивные = Истина;
                Фоновое.Отменить();
                Сообщить("[ОСТАНОВКА] " + Задание.Метаданные.Имя);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Если ЕстьАктивные Тогда
        Сообщить("[ОЖИДАНИЕ] Дождитесь завершения остановки и повторите этот код через5–10секунд");
    Иначе
        Этап = "3. Удаление локальных сообщений";
        Каналы = СтрРазделить("ExchOperaPC|Основной_ExchangeOpera_FromOpera;"
            + "ExchOperaPC|Основной_ExchangeOpera_ToBackend;"
            + "ExchPriceChecker|Основной_PC_FromShops;"
            + "ExchPriceChecker|Основной_PC_ToBackend", ";");
        Для Каждого Описание Из Каналы Цикл
            Части = СтрРазделить(Описание, "|");
            Канал = СервисыИнтеграции[Части[0]][Части[1]];
            Удалено = 0;
            ПредыдущийПервый = "";
            Пока Истина Цикл
                Сообщения = Канал.ВыбратьСообщения(, 1000);
                Если Сообщения.Количество() = 0 Тогда Прервать; КонецЕсли;
                Идентификаторы = Новый Массив;
                Для Каждого Сообщение Из Сообщения Цикл
                    Идентификаторы.Добавить(Сообщение.Идентификатор);
                КонецЦикла;
                Если Строка(Идентификаторы[0]) = ПредыдущийПервый Тогда
                    ВызватьИсключение "Сообщения не удалились из канала " + Части[1];
                КонецЕсли;
                ПредыдущийПервый = Строка(Идентификаторы[0]);
                Канал.УдалитьСообщения(Идентификаторы);
                Удалено = Удалено + Идентификаторы.Количество();
            КонецЦикла;
            Сообщить("[ОЧИЩЕНО] " + Части[0] + "/" + Части[1]
                + "; удалено=" + Строка(Удалено) + "; осталось=0");
        КонецЦикла;

        Этап = "4. Возобновление товарного обмена";
        Для Каждого ИмяСервиса Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
            СервисыИнтеграции[ИмяСервиса].УстановитьАктивность(Истина);
        КонецЦикла;
        Расписание = Новый РасписаниеРегламентногоЗадания;
        Расписание.ПериодПовтораДней = 1;
        Расписание.ПериодПовтораВТечениеДня = 10;
        ТоварноеЗадание.ИмяПользователя = ПользовательЗадания;
        ТоварноеЗадание.Расписание = Расписание;
        ТоварноеЗадание.Использование = Истина;
        ТоварноеЗадание.Записать();
        Сообщить("[ГОТОВО] Старые локальные сообщения удалены; сервисы и общее товарное задание включены");
        Сообщить("Регистр и сессии сохранены. Задание СЕ и старое отдельное задание PC выключены");
    КонецЕсли;
    Сообщить("===== КОНЕЦ ОЧИСТКИ СЕРВИСОВ =====");
Исключение
    ТекстОшибки = ОписаниеОшибки();
    Для Каждого Скрываемое Из СкрываемыеКлючи Цикл
        ТекстОшибки = СтрЗаменить(ТекстОшибки, Скрываемое, "[ключ скрыт]");
    КонецЦикла;
    Сообщить("[ОСТАНОВЛЕНО] Этап=" + Этап);
    Сообщить(ТекстОшибки);
КонецПопытки;
