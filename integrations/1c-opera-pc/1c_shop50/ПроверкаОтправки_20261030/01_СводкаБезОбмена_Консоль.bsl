// Выполнить отдельно в консоли каждой базы: 410 и 50.
// Только чтение: без отправки, приёма, удаления и подготовки full.
К = КХ_ПилотШины.Контекст();
Сообщить("Магазин=" + Строка(К.Номер) + "; store_id=" + К.Код);
Сообщить("Ожидаемый узел PC=S" + СтрЗаменить(К.Код, "-", ""));

Для Каждого Имя Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
    Сообщить(Имя + ": активность="
        + Строка(СервисыИнтеграции[Имя].ПолучитьАктивность()));
КонецЦикла;

Запрос = Новый Запрос(
"ВЫБРАТЬ
| Очередь.ВнешняяСистема КАК Система,
| Очередь.УзелПолучатель КАК Получатель,
| Очередь.КаналСервисаИнтеграции КАК Канал,
| Очередь.СтатусСообщения КАК Статус,
| КОЛИЧЕСТВО(*) КАК Записей
|ИЗ РегистрСведений.ОчередьШины КАК Очередь
|ГДЕ Очередь.ВнешняяСистема В (""Opera"", ""PriceCheker"")
|СГРУППИРОВАТЬ ПО
| Очередь.ВнешняяСистема, Очередь.УзелПолучатель,
| Очередь.КаналСервисаИнтеграции, Очередь.СтатусСообщения
|УПОРЯДОЧИТЬ ПО Система, Получатель, Канал, Статус");

Таблица = Запрос.Выполнить().Выгрузить();
Для Каждого СтрокаИтога Из Таблица Цикл
    Сообщить(СтрокаИтога.Система
        + " | " + Строка(СтрокаИтога.Статус)
        + " | записей=" + Строка(СтрокаИтога.Записей)
        + " | получатель=" + СтрокаИтога.Получатель
        + " | канал=" + СтрокаИтога.Канал);
КонецЦикла;
Если Таблица.Количество() = 0 Тогда
    Сообщить("В локальном регистре нет записей Opera/PriceCheker.");
КонецЕсли;
