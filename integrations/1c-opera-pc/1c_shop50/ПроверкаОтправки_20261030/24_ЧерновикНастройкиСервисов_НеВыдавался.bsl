// ШАГ 2. Одна и та же серверная консоль для обеих тестовых баз.
// Сначала применить подготовку конфигурации из 24_ПодготовкаКонфигурации.md.
// При настройке: общее задание выключается, оба сервиса настраиваются/включаются.
// После сообщения ПАУЗА повторить этот же код через 20 секунд.
// При повторе: включается расписание. Ещё через 30 секунд повторить для контроля.
// Товары вручную не регистрируются, full вручную не начинается, очередь не очищается.

Этап = "Начало";
СкрываемыеКлючи = Новый Массив;
МетодЗадания = "КХ_ОбменШиныОпера.РегламентнаяОбработкаОчередиОпера";
МетодПрежнегоPC = "КХ_ОбменШиныПрайсЧекеры.РегламентнаяОбработкаОчередиPriceCheker";

Попытка
    Сообщить("===== ШАГ 2. АВТОМАТИКА OPERA + PC =====");
    Этап = "1. Проверка текущей базы";
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "Запустите вне транзакции"; КонецЕсли;
    СЕ = КХ_ОбменШиныОпера.ТекущаяСЕ();
    Магазин = КХ_ОбменШиныОпера.ИдентификаторМагазина();
    СвойУзел = "S" + СтрЗаменить(Магазин, "-", "");
    Сообщить("[1] Магазин=" + Строка(СЕ) + "; store_id=" + Магазин);
    Сообщить("    Участник=" + СвойУзел);
    Параметры = КХ_ОбменШиныОпера.ПараметрыОбмена();
    Если Параметры.КаналОпера <> "Основной_ExchangeOpera_FromOpera"
        ИЛИ Параметры.КаналПрайсЧекеры <> "Основной_PC_FromShops" Тогда
        ВызватьИсключение "Неактуальные имена каналов в ПараметрыОбмена";
    КонецЕсли;
    Если Параметры.ДнейХраненияПодтвержденных < 1 Тогда
        ВызватьИсключение "Сначала установите хранение подтверждённых пакетов 1 день в тестовой конфигурации, F7 и обновите сеанс";
    КонецЕсли;
    ЗапросКорня = Новый Запрос(
    "ВЫБРАТЬ СтроковыйОбъект ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема = ""OperaState"" И ИдентификаторОбъекта = ""КХ_OperaState""
    | И УзелПолучатель = """" И КаналСервисаИнтеграции = """"");
    Корни = ЗапросКорня.Выполнить().Выгрузить();
    Если Корни.Количество() <> 1 Тогда ВызватьИсключение "Нет единственного состояния обмена"; КонецЕсли;
    Состояние = КХ_ОбменШиныОпера.ИзJSON(Корни[0].СтроковыйОбъект);
    Для Каждого ПолеМаршрута Из СтрРазделить(
        "node_code|" + СвойУзел + ";pc_store_id|" + Магазин + ";pc_node_code|" + СвойУзел
        + ";pc_backend_node|" + СвойУзел + ";opera_backend_node|BackendOpera", ";") Цикл
        Части = СтрРазделить(ПолеМаршрута, "|");
        Если КХ_ОбменШиныОпера.СтроковоеПоле(Состояние, Части[0]) <> Части[1] Тогда
            ВызватьИсключение "Маршрут " + Части[0] + " не соответствует текущему магазину; активация не выполнена";
        КонецЕсли;
    КонецЦикла;
    Для Каждого ПолеФлага Из СтрРазделить("full_active,catalog_bootstrap_started,catalog_full_requested", ",") Цикл
        ЗначениеФлага = Неопределено;
        Если НЕ Состояние.Свойство(ПолеФлага, ЗначениеФлага) ИЛИ ТипЗнч(ЗначениеФлага) <> Тип("Булево") Тогда
            ВызватьИсключение "Неполная текущая редакция состояния: " + ПолеФлага;
        КонецЕсли;
    КонецЦикла;

    // 2. Проверяем существующее задание; дубли автоматически не удаляем.
    Этап = "2. Задание и пользователь";
    НашиЗадания = Новый Массив;
    ПрежниеPC = Новый Массив;
    Для Каждого ПроверяемоеЗадание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл
        Метод = НРег(СтрЗаменить(Строка(ПроверяемоеЗадание.Метаданные.ИмяМетода), "ОбщийМодуль.", ""));
        Если Метод = НРег(МетодЗадания) Тогда НашиЗадания.Добавить(ПроверяемоеЗадание); КонецЕсли;
        Если Метод = НРег(МетодПрежнегоPC) Тогда ПрежниеPC.Добавить(ПроверяемоеЗадание); КонецЕсли;
    КонецЦикла;
    Если НашиЗадания.Количество() <> 1 Тогда
        ВызватьИсключение "Ожидалось одно существующее товарное задание; найдено=" + Строка(НашиЗадания.Количество());
    КонецЕсли;
    Задание = НашиЗадания[0];
    СервисPC = СервисыИнтеграции.ExchPriceChecker;
    СервисOpera = СервисыИнтеграции.ExchOperaPC;
    НастройкиPC = СервисPC.ПолучитьНастройки();
    НастройкиOpera = СервисOpera.ПолучитьНастройки();
    ИдентификаторКлюча = НастройкиPC.ИмяПользователяВнешнегоСервисаИнтеграции;
    СекретКлюча = НастройкиPC.ПарольПользователяВнешнегоСервисаИнтеграции;
    Если НЕ ПустаяСтрока(ИдентификаторКлюча) Тогда СкрываемыеКлючи.Добавить(ИдентификаторКлюча); КонецЕсли;
    Если НЕ ПустаяСтрока(СекретКлюча) Тогда СкрываемыеКлючи.Добавить(СекретКлюча); КонецЕсли;
    Если НЕ ПустаяСтрока(НастройкиOpera.ИмяПользователяВнешнегоСервисаИнтеграции) Тогда
        СкрываемыеКлючи.Добавить(НастройкиOpera.ИмяПользователяВнешнегоСервисаИнтеграции);
    КонецЕсли;
    Если НЕ ПустаяСтрока(НастройкиOpera.ПарольПользователяВнешнегоСервисаИнтеграции) Тогда
        СкрываемыеКлючи.Добавить(НастройкиOpera.ПарольПользователяВнешнегоСервисаИнтеграции);
    КонецЕсли;
    Если ПустаяСтрока(НастройкиPC.АдресВнешнегоСервисаИнтеграции)
        ИЛИ ПустаяСтрока(ИдентификаторКлюча) ИЛИ ПустаяСтрока(СекретКлюча) Тогда
        ВызватьИсключение "Неполные настройки рабочего подключения PC";
    КонецЕсли;
    ИмяПользователяЗадания = Задание.ИмяПользователя;
    Если ПустаяСтрока(ИмяПользователяЗадания) Тогда
        ИмяПользователяЗадания = НастройкиPC.ИмяПользователя;
    КонецЕсли;
    Если ПустаяСтрока(ИмяПользователяЗадания) Тогда ИмяПользователяЗадания = ИмяПользователя(); КонецЕсли;
    Если ПустаяСтрока(ИмяПользователяЗадания)
        ИЛИ ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователяЗадания) = Неопределено Тогда
        ВызватьИсключение "Не найден пользователь ИБ для товарного задания";
    КонецЕсли;
    Сообщить("[2] Задание=" + Задание.Метаданные.Имя + "; пользователь=" + ИмяПользователяЗадания);

    // 3. Каноническое расписание тестовых баз: ежедневно каждые 10 секунд.
    // Сравниваем все стандартные поля, включая ограничения дней/времени.
    Этап = "3. План настройки";
    НовоеРасписание = Новый РасписаниеРегламентногоЗадания;
    НовоеРасписание.ПериодПовтораДней = 1;
    НовоеРасписание.ПериодПовтораВТечениеДня = 10;
    ПоляРасписания = "ВремяЗавершения,ВремяКонца,ВремяНачала,ДатаКонца,ДатаНачала,ДеньВМесяце,ДеньНеделиВМесяце,"
        + "ДниНедели,ИнтервалЗавершения,Месяцы,ПаузаПовтора,ПериодНедель,ПериодПовтораВТечениеДня,ПериодПовтораДней";
    СтароеРасписание = Задание.Расписание;
    СтарыеПоля = Новый Структура(ПоляРасписания);
    НовыеПоля = Новый Структура(ПоляРасписания);
    ЗаполнитьЗначенияСвойств(СтарыеПоля, СтароеРасписание, ПоляРасписания);
    ЗаполнитьЗначенияСвойств(НовыеПоля, НовоеРасписание, ПоляРасписания);
    МеняетсяРасписание = ЗначениеВСтрокуВнутр(СтарыеПоля) <> ЗначениеВСтрокуВнутр(НовыеПоля)
        ИЛИ СтароеРасписание.ДетальныеРасписанияДня.Количество() > 0;
    МеняютсяНастройкиPC = ПустаяСтрока(НастройкиPC.ИмяПользователя);
    МеняютсяНастройкиOpera = НастройкиOpera.АдресВнешнегоСервисаИнтеграции <> НастройкиPC.АдресВнешнегоСервисаИнтеграции
        ИЛИ НастройкиOpera.ИмяПользователяВнешнегоСервисаИнтеграции <> ИдентификаторКлюча
        ИЛИ НастройкиOpera.ПарольПользователяВнешнегоСервисаИнтеграции <> СекретКлюча
        ИЛИ ПустаяСтрока(НастройкиOpera.ИмяПользователя);
    НужнаНастройка = МеняетсяРасписание ИЛИ МеняютсяНастройкиPC ИЛИ МеняютсяНастройкиOpera
        ИЛИ Задание.ИмяПользователя <> ИмяПользователяЗадания
        ИЛИ НЕ СервисPC.ПолучитьАктивность() ИЛИ НЕ СервисOpera.ПолучитьАктивность();
    Для Каждого Прежнее Из ПрежниеPC Цикл
        Если Прежнее.Использование Тогда НужнаНастройка = Истина; КонецЕсли;
        ПоследнееПрежнее = Прежнее.ПоследнееЗадание;
        Если ПоследнееПрежнее <> Неопределено Тогда
            Если ПоследнееПрежнее.Состояние = СостояниеФоновогоЗадания.Активно Тогда НужнаНастройка = Истина; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если НЕ Задание.Использование Тогда
        ПоследнийТоварный = Задание.ПоследнееЗадание;
        Если ПоследнийТоварный <> Неопределено Тогда
            Если ПоследнийТоварный.Состояние = СостояниеФоновогоЗадания.Активно Тогда НужнаНастройка = Истина; КонецЕсли;
        КонецЕсли;
    КонецЕсли;

    Если НужнаНастройка Тогда
        // 4А. Отключаем будущие старты только наших товарных заданий.
        // Уже выполняющиеся задания не отменяем: ждём завершения отдельным запуском этого кода.
        Этап = "4А. Настройка автоматического режима";
        Если Задание.Использование Тогда
            Задание.Использование = Ложь;
            Задание.Записать();
        КонецЕсли;
        ЕстьВыполняющееся = Ложь;
        Проверяемые = Новый Массив;
        Проверяемые.Добавить(Задание);
        Для Каждого Прежнее Из ПрежниеPC Цикл
            Если Прежнее.Использование Тогда
                Прежнее.Использование = Ложь;
                Прежнее.Записать();
                Сообщить("[4А] Выключен отдельный старый PC-job: " + Прежнее.Метаданные.Имя);
            КонецЕсли;
            Проверяемые.Добавить(Прежнее);
        КонецЦикла;
        Для Каждого Проверяемое Из Проверяемые Цикл
            Последнее = Проверяемое.ПоследнееЗадание;
            Если Последнее <> Неопределено Тогда
                Если Последнее.Состояние = СостояниеФоновогоЗадания.Активно Тогда ЕстьВыполняющееся = Истина; КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        Если ЕстьВыполняющееся Тогда
            Сообщить("[ПАУЗА] Предыдущий товарный цикл ещё выполняется; повторите этот код после его завершения");
        Иначе
            Задание.ИмяПользователя = ИмяПользователяЗадания;
            Задание.Расписание = НовоеРасписание;
            Задание.Использование = Ложь;
            Задание.Записать();
            Если МеняютсяНастройкиPC Тогда
                Если СервисPC.ПолучитьАктивность() Тогда СервисPC.УстановитьАктивность(Ложь); КонецЕсли;
                НастройкиPC.ИмяПользователя = ИмяПользователяЗадания;
                СервисPC.УстановитьНастройки(НастройкиPC);
            КонецЕсли;
            Если МеняютсяНастройкиOpera Тогда
                Если СервисOpera.ПолучитьАктивность() Тогда СервисOpera.УстановитьАктивность(Ложь); КонецЕсли;
                НастройкиOpera.АдресВнешнегоСервисаИнтеграции = НастройкиPC.АдресВнешнегоСервисаИнтеграции;
                НастройкиOpera.ИмяПользователяВнешнегоСервисаИнтеграции = ИдентификаторКлюча;
                НастройкиOpera.ПарольПользователяВнешнегоСервисаИнтеграции = СекретКлюча;
                Если ПустаяСтрока(НастройкиOpera.ИмяПользователя) Тогда
                    НастройкиOpera.ИмяПользователя = НастройкиPC.ИмяПользователя;
                КонецЕсли;
                СервисOpera.УстановитьНастройки(НастройкиOpera);
            КонецЕсли;
            Если НЕ СервисPC.ПолучитьАктивность() Тогда СервисPC.УстановитьАктивность(Истина); КонецЕсли;
            Если НЕ СервисOpera.ПолучитьАктивность() Тогда СервисOpera.УстановитьАктивность(Истина); КонецЕсли;
            Сообщить("[4А ОК] Оба сервиса включены; Opera использует ключи текущего магазина из PC");
            Сообщить("[4А ОК] Пользователь и расписание задания сохранены: ежедневно каждые 10 секунд");
            Сообщить("[ПАУЗА] Подождите 20 секунд и повторите ЭТОТ ЖЕ код для включения расписания");
        КонецЕсли;
    Иначе
        // 4Б. После обновления настроек включаем планировщик. Метод обмена вручную не вызываем.
        Этап = "4Б. Включение расписания и контроль";
        Если НЕ Задание.Использование Тогда
            Задание.Использование = Истина;
            Задание.Записать();
            Сообщить("[4Б ОК] Общее товарное задание включено; запуск выполнит планировщик");
        Иначе
            Сообщить("[4Б ОК] Общее товарное задание уже включено");
        КонецЕсли;
        Сообщить("    Opera активна=" + Строка(СервисOpera.ПолучитьАктивность())
            + "; PC активен=" + Строка(СервисPC.ПолучитьАктивность()));
        Сообщить("    Расписание=" + Строка(Задание.Расписание));
        Последнее = Задание.ПоследнееЗадание;
        Если Последнее = Неопределено Тогда
            Сообщить("[ОЖИДАНИЕ] Истории запуска пока нет. Повторите этот же код через 30 секунд");
            Сообщить("При отсутствии запуска проверьте блокировку регламентных заданий этой тестовой базы на сервере");
        Иначе
            Сообщить("[ИСТОРИЯ] Начало=" + Строка(Последнее.Начало)
                + "; конец=" + Строка(Последнее.Конец) + "; состояние=" + Строка(Последнее.Состояние));
            Если Последнее.ИнформацияОбОшибке <> Неопределено Тогда
                ТекстОшибки = ПодробноеПредставлениеОшибки(Последнее.ИнформацияОбОшибке);
                Для Каждого Скрываемое Из СкрываемыеКлючи Цикл
                    ТекстОшибки = СтрЗаменить(ТекстОшибки, Скрываемое, "[ключ скрыт]");
                КонецЦикла;
                Сообщить("[ОШИБКА ЗАДАНИЯ] " + Лев(ТекстОшибки, 3000));
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;

    // 5. Состояние загрузки и очередей после текущего шага. Full/ACK вручную не подставляем.
    Этап = "5. Текущий результат";
    Корни = ЗапросКорня.Выполнить().Выгрузить();
    Если Корни.Количество() = 1 Тогда
        Состояние = КХ_ОбменШиныОпера.ИзJSON(Корни[0].СтроковыйОбъект);
        Сообщить("[5] full_active=" + Строка(Состояние.full_active));
        Если Состояние.full_active Тогда
            Сообщить("    Сессия=" + Состояние.full.session_id + "; следующая порция=" + Строка(Состояние.full.next_sequence)
                + "; всего порций=" + Строка(Состояние.full.total_batches));
        КонецЕсли;
        Сообщить("    catalog_bootstrap_started=" + Строка(Состояние.catalog_bootstrap_started));
        Если НЕ Состояние.catalog_bootstrap_started Тогда
            Сообщить("    [ПЕРВИЧНАЯ ЗАГРУЗКА] Первый штатный цикл начнёт подготовку каталога обоим бэкам");
        КонецЕсли;
    КонецЕсли;
    ЗапросОчереди = Новый Запрос(
    "ВЫБРАТЬ ВнешняяСистема, СтатусСообщения, КОЛИЧЕСТВО(*) КАК Количество
    |ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема В (""Opera"", ""PriceCheker"", ""OperaChange"")
    |СГРУППИРОВАТЬ ПО ВнешняяСистема, СтатусСообщения
    |УПОРЯДОЧИТЬ ПО ВнешняяСистема, СтатусСообщения");
    Для Каждого СтрокаОчереди Из ЗапросОчереди.Выполнить().Выгрузить() Цикл
        Сообщить("[ОЧЕРЕДЬ] " + СтрокаОчереди.ВнешняяСистема + " | " + Строка(СтрокаОчереди.СтатусСообщения)
            + " | количество=" + Строка(СтрокаОчереди.Количество));
    КонецЦикла;
    ОшибкиПакетов = Новый Запрос(
    "ВЫБРАТЬ ПЕРВЫЕ 5 ВнешняяСистема, ИдентификаторОбъекта, ТекстОшибки
    |ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема В (""Opera"", ""PriceCheker"") И СтатусСообщения = &Ошибка
    |УПОРЯДОЧИТЬ ПО ДатаОтправки УБЫВ, ДатаРегистрации УБЫВ");
    ОшибкиПакетов.УстановитьПараметр("Ошибка", Перечисления.СтатусыСообщенийШины.Ошибка);
    Для Каждого ОшибкаПакета Из ОшибкиПакетов.Выполнить().Выгрузить() Цикл
        ТекстОшибки = ОшибкаПакета.ТекстОшибки;
        Для Каждого Скрываемое Из СкрываемыеКлючи Цикл
            ТекстОшибки = СтрЗаменить(ТекстОшибки, Скрываемое, "[ключ скрыт]");
