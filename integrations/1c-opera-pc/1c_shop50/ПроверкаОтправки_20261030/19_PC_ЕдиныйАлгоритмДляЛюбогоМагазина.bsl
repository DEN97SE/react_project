// Единый алгоритм консоли: подключение PC, одна пачка, отправка, приём и отчёт.
// Магазин определяется по текущей СЕ. КХ_ПилотШины не используется.
// После ответа бэка запускайте этот же алгоритм повторно.
// Обработчик получения ExchPriceChecker должен быть установлен в конфигурации.
// Автоматические задания подготовки/отправки на время ручного теста остановлены.

ШтрихкодНовогоТовара = ""; // Пусто: выбрать первый товар текущего каталога.
АдресПоУмолчанию = "http://program58:9090/applications/Opera-PC";
ИмяPC = "ExchPriceChecker";
КаналОтправки = "Основной_PC_FromShops";
КаналПриема = "Основной_PC_ToBackend";
ИдентификаторКлюча = "";
СекретКлюча = "";
Этап = "Начало";

Попытка
    Сообщить("===== КОНТРОЛЬ ОБМЕНА PC =====");
    Этап = "1. Определение магазина";
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "Алгоритм нужно выполнять вне транзакции";
    КонецЕсли;
    СЕ = КХ_ОбменШиныОпера.ТекущаяСЕ();
    Магазин = КХ_ОбменШиныОпера.ИдентификаторМагазина();
    СвойУзел = "S" + СтрЗаменить(Магазин, "-", "");
    Сообщить("[1 ОК] СЕ=" + Строка(СЕ) + "; store_id=" + Магазин);
    Сообщить("        Код участника=" + СвойУзел);

    Этап = "2. Проверка сервиса и маршрута";
    Если Метаданные.СервисыИнтеграции.Найти(ИмяPC) = Неопределено Тогда
        ВызватьИсключение "В конфигурации отсутствует ExchPriceChecker";
    КонецЕсли;
    МДКаналы = Метаданные.СервисыИнтеграции[ИмяPC].КаналыСервисаИнтеграции;
    Если МДКаналы.Найти(КаналОтправки) = Неопределено
        ИЛИ МДКаналы.Найти(КаналПриема) = Неопределено Тогда
        ВызватьИсключение "В ExchPriceChecker отсутствуют каналы Основной_PC_FromShops / Основной_PC_ToBackend";
    КонецЕсли;
    ПараметрыОбмена = КХ_ОбменШиныОпера.ПараметрыОбмена();
    Если ПараметрыОбмена.КаналПрайсЧекеры <> КаналОтправки Тогда
        ВызватьИсключение "В КХ_ОбменШиныОпера.ПараметрыОбмена указан канал ["
            + ПараметрыОбмена.КаналПрайсЧекеры + "], требуется Основной_PC_FromShops";
    КонецЕсли;
    СервисPC = СервисыИнтеграции[ИмяPC];
    ПодключениеИзменилось = Ложь;
    Маршрут = КХ_ОбменШиныОпера.ПараметрыМаршрутаПрайсЧекеров();
    Если НЕ Маршрут.Настроен ИЛИ Маршрут.КодОтправителя <> СвойУзел
        ИЛИ Маршрут.КодПолучателя <> СвойУзел Тогда
        Если СервисPC.ПолучитьАктивность() Тогда
            СервисPC.УстановитьАктивность(Ложь);
        КонецЕсли;
        // Штатная функция запрещает менять маршрут незавершённых чужих пакетов.
        КХ_ОбменШиныОпера.НастроитьМаршрутПрайсЧекеров(СвойУзел, СвойУзел);
        ПодключениеИзменилось = Истина;
        Сообщить("[2 ОК] Маршрут PC сохранён для текущего магазина");
    Иначе
        Сообщить("[2 ОК] Маршрут PC уже настроен");
    КонецЕсли;
    Сообщить("        PC: " + СвойУзел + " -> " + СвойУзел);

    Этап = "3. Настройки подключения";
    // Выбор актуальных ключей строго по store_id, а не номеру или названию базы.
    Если Магазин = "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
        ИдентификаторКлюча = "REDACTED_CREDENTIAL_4";
        СекретКлюча = "REDACTED_CREDENTIAL_1";
    ИначеЕсли Магазин = "40933103-84ba-4d00-ab50-ce9efa15eda8" Тогда
        ИдентификаторКлюча = "REDACTED_CREDENTIAL_3";
        СекретКлюча = "REDACTED_CREDENTIAL_2";
    КонецЕсли;

    НастройкиPC = СервисPC.ПолучитьНастройки();
    АдресPC = НастройкиPC.АдресВнешнегоСервисаИнтеграции;
    Если ПустаяСтрока(АдресPC) Тогда АдресPC = АдресПоУмолчанию; КонецЕсли;
    Если ПустаяСтрока(ИдентификаторКлюча) Тогда
        // Для других магазинов используются их уже сохранённые ключи.
        ИдентификаторКлюча = НастройкиPC.ИмяПользователяВнешнегоСервисаИнтеграции;
        СекретКлюча = НастройкиPC.ПарольПользователяВнешнегоСервисаИнтеграции;
    КонецЕсли;
    Если ПустаяСтрока(ИдентификаторКлюча) ИЛИ ПустаяСтрока(СекретКлюча) Тогда
        ВызватьИсключение "Для этого магазина не заполнены ключи подключения PC";
    КонецЕсли;
    Если НастройкиPC.АдресВнешнегоСервисаИнтеграции <> АдресPC
        ИЛИ НастройкиPC.ИмяПользователяВнешнегоСервисаИнтеграции <> ИдентификаторКлюча
        ИЛИ НастройкиPC.ПарольПользователяВнешнегоСервисаИнтеграции <> СекретКлюча Тогда
        Если СервисPC.ПолучитьАктивность() Тогда
            СервисPC.УстановитьАктивность(Ложь);
        КонецЕсли;
        НастройкиPC.АдресВнешнегоСервисаИнтеграции = АдресPC;
        НастройкиPC.ИмяПользователяВнешнегоСервисаИнтеграции = ИдентификаторКлюча;
        НастройкиPC.ПарольПользователяВнешнегоСервисаИнтеграции = СекретКлюча;
        СервисPC.УстановитьНастройки(НастройкиPC);
        ПодключениеИзменилось = Истина;
        Сообщить("[3 ОК] Актуальные ключи PC сохранены");
    Иначе
        Сообщить("[3 ОК] Настройки PC уже соответствуют выбранным ключам");
    КонецЕсли;

    Этап = "4. Активность сервисов";
    Если Метаданные.СервисыИнтеграции.Найти("ExchOperaPC") <> Неопределено Тогда
        Если СервисыИнтеграции["ExchOperaPC"].ПолучитьАктивность() Тогда
            СервисыИнтеграции["ExchOperaPC"].УстановитьАктивность(Ложь);
            ПодключениеИзменилось = Истина;
            Сообщить("[4 ОК] Opera выключена на время теста PC");
        КонецЕсли;
    КонецЕсли;
    Если НЕ СервисPC.ПолучитьАктивность() Тогда
        СервисPC.УстановитьАктивность(Истина);
        ПодключениеИзменилось = Истина;
        Сообщить("[4 ОК] PC включён");
    КонецЕсли;

    Если ПодключениеИзменилось Тогда
        Сообщить("[ПАУЗА] Настройки/активность изменены. Подождите 20 секунд и запустите ЭТОТ ЖЕ алгоритм");
        Сообщить("         Подготовка и отправка на этом запуске ещё не выполнялись");
    Иначе
        Сообщить("[4 ОК] PC включён; настройки подключения не менялись");
        Этап = "5. Приём уже поступивших ответов";
        ВходящийКанал = СервисPC[КаналПриема];
        Сообщить("[5] Входящих до запуска обработки: "
            + Строка(ВходящийКанал.ВыбратьСообщения().Количество()));
        СервисыИнтеграции.ВыполнитьОбработку();
        Сообщить("[5 ОК] Обработка активных сервисов запущена");

        Этап = "6. Выбор контрольного пакета";
        // Последний товарный PC-пакет становится контрольным и после подтверждения.
        // Поэтому повторный запуск не создаёт ещё одну пачку автоматически.
        ЗапросПакетов = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 20
        | ИдентификаторОбъекта, УзелПолучатель, КаналСервисаИнтеграции,
        | СтатусСообщения, СтроковыйОбъект, ДатаОтправки, ИдентификаторСообщения
        |ИЗ РегистрСведений.ОчередьШины
        |ГДЕ ВнешняяСистема = ""PriceCheker""
        |УПОРЯДОЧИТЬ ПО ДатаРегистрации УБЫВ, ИдентификаторОбъекта УБЫВ");
        ПоследниеПакеты = ЗапросПакетов.Выполнить().Выгрузить();
        Пакет = Неопределено;
        Для Каждого СтрокаПакета Из ПоследниеПакеты Цикл
            ДанныеПакета = КХ_ОбменШиныОпера.ИзJSON(СтрокаПакета.СтроковыйОбъект);
            Если КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеПакета, "message_type") = "products" Тогда
                Пакет = СтрокаПакета;
                Прервать;
            КонецЕсли;
        КонецЦикла;

        Если Пакет = Неопределено Тогда
            Этап = "6. Подготовка одной новой delta";
            // Проверяем сохранённое состояние, не запуская новую full.
            ЗапросСостояния = Новый Запрос(
            "ВЫБРАТЬ СтроковыйОбъект ИЗ РегистрСведений.ОчередьШины
            |ГДЕ ВнешняяСистема = ""OperaState""
            | И ИдентификаторОбъекта = ""КХ_OperaState""
            | И УзелПолучатель = """" И КаналСервисаИнтеграции = """"");
            СтрокиСостояния = ЗапросСостояния.Выполнить().Выгрузить();
            Если СтрокиСостояния.Количество() <> 1 Тогда
                ВызватьИсключение "Не найдено единственное состояние обмена";
            КонецЕсли;
            СостояниеОбмена = КХ_ОбменШиныОпера.ИзJSON(СтрокиСостояния[0].СтроковыйОбъект);
            Если СостояниеОбмена.full_active ИЛИ СостояниеОбмена.catalog_requests.Количество() > 0 Тогда
                ВызватьИсключение "Есть активная подготовка full/запросов; новая delta этим алгоритмом не создаётся";
            КонецЕсли;
            // Штатный сборщик создаёт пару Opera+PC. Сохраняем корректные адреса обоих.
            КХ_ОбменШиныОпера.НастроитьПолучателяОпера("BackendOpera");
            Если КХ_ОбменШиныОпера.КодУзлаОтправителя() <> СвойУзел Тогда
                КХ_ОбменШиныОпера.УстановитьКодУзлаОтправителя(СвойУзел);
            КонецЕсли;
            Если ПустаяСтрока(ШтрихкодНовогоТовара) Тогда
                Каталог = КХ_ДанныеОпера.ПолучитьНоменклатуруДляПолнойВыгрузки(СЕ);
                Если Каталог.Количество() = 0 Тогда
                    ВызватьИсключение "В каталоге текущего магазина нет товаров";
                КонецЕсли;
                Номенклатура = Каталог[0];
            Иначе
                Номенклатура = КХ_ДанныеОпера.НайтиНоменклатуруПоШтрихкоду(ШтрихкодНовогоТовара);
            КонецЕсли;
            Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
                ВызватьИсключение "Тестовый товар не найден";
            КонецЕсли;
            Ссылки = Новый Массив;
            Ссылки.Добавить(Номенклатура);
            Карточки = КХ_ДанныеОпера.СформироватьСостояниеКаталога(СЕ, Ссылки);
            Если Карточки.products.Количество() <> 1
                ИЛИ Карточки.deleted_nomenclature_ids.Количество() <> 0 Тогда
                ВызватьИсключение "Для контрольной delta нужна одна действующая карточка";
            КонецЕсли;
            КХ_ОбменШиныОпера.ЗарегистрироватьНоменклатуру(Номенклатура);
            Если НЕ КХ_ОбменШиныОпера.ПодготовитьДельту(Номенклатура) Тогда
                ВызватьИсключение "Не удалось подготовить delta";
            КонецЕсли;
            Сообщить("[6 ОК] Подготовлена карточка: " + Строка(Номенклатура));
            Сообщить("         Созданы отдельные пачки PC и Opera; сейчас отправляем PC");
            ПоследниеПакеты = ЗапросПакетов.Выполнить().Выгрузить();
            Для Каждого СтрокаПакета Из ПоследниеПакеты Цикл
                ДанныеПакета = КХ_ОбменШиныОпера.ИзJSON(СтрокаПакета.СтроковыйОбъект);
                Если КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеПакета, "message_type") = "products" Тогда
                    Пакет = СтрокаПакета;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Если Пакет = Неопределено Тогда ВызватьИсключение "Товарный PC-пакет не найден"; КонецЕсли;
        ДанныеПакета = КХ_ОбменШиныОпера.ИзJSON(Пакет.СтроковыйОбъект);
        ИдПакета = Пакет.ИдентификаторОбъекта;
        Если КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеПакета, "store_id") <> Магазин
            ИЛИ КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеПакета, "source_node") <> СвойУзел
            ИЛИ КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеПакета, "batch_id") <> ИдПакета
            ИЛИ СокрЛП(Пакет.УзелПолучатель) <> СвойУзел Тогда
            ВызватьИсключение "Контрольный пакет содержит чужой магазин/отправителя/получателя";
        КонецЕсли;
        КХ_ОбменШиныОпера.МаршрутКаналаОтправки("PriceCheker", Пакет.КаналСервисаИнтеграции);
        Сообщить("[6 ОК] Контрольный batch_id=" + ИдПакета);
        Сообщить("         Статус до отправки: " + Строка(Пакет.СтатусСообщения));

        Этап = "7. Одна отправка или ожидание ACK";
        Если Пакет.СтатусСообщения = Перечисления.СтатусыСообщенийШины.ОжидаетОтправки Тогда
            // Повторяем отбор штатного отправителя, чтобы не отправить другой пакет.
            Кандидаты = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 1 ИдентификаторОбъекта, УзелПолучатель, КаналСервисаИнтеграции
            |ИЗ РегистрСведений.ОчередьШины
            |ГДЕ ВнешняяСистема = ""PriceCheker""
            | И (СтатусСообщения = &Ожидает
            | ИЛИ (СтатусСообщения = &Ошибка И ДатаОтправки <= &ПовторОшибки)
            | ИЛИ (СтатусСообщения = &Отправлено И ДатаОтправки <= &ПовторACK))
            |УПОРЯДОЧИТЬ ПО ДатаОтправки, ДатаРегистрации, ИдентификаторОбъекта");
            Кандидаты.УстановитьПараметр("Ожидает", Перечисления.СтатусыСообщенийШины.ОжидаетОтправки);
            Кандидаты.УстановитьПараметр("Ошибка", Перечисления.СтатусыСообщенийШины.Ошибка);
            Кандидаты.УстановитьПараметр("Отправлено", Перечисления.СтатусыСообщенийШины.Отправлено);
            Кандидаты.УстановитьПараметр("ПовторОшибки", ТекущаяДатаСеанса() - ПараметрыОбмена.ПовторОшибкиСекунд);
            Кандидаты.УстановитьПараметр("ПовторACK", ТекущаяДатаСеанса() - ПараметрыОбмена.ОжиданиеПодтвержденияСекунд);
            Готовые = Кандидаты.Выполнить().Выгрузить();
            Если Готовые.Количество() = 0 Тогда
                Сообщить("[7 ОЖИДАНИЕ] Повтор отправки пока не наступил; принимаем ACK");
            ИначеЕсли Готовые[0].ИдентификаторОбъекта <> ИдПакета
                ИЛИ Готовые[0].УзелПолучатель <> Пакет.УзелПолучатель
                ИЛИ Готовые[0].КаналСервисаИнтеграции <> Пакет.КаналСервисаИнтеграции Тогда
                Сообщить("[7 ПРОПУСК] Первым в очереди идёт другой batch_id=" + Готовые[0].ИдентификаторОбъекта);
                Сообщить("            Контрольная отправка не выполнялась; приём продолжается");
            Иначе
                Сообщить("[7] Отправляем одну сохранённую пачку: " + ИдПакета);
                КХ_ОбменШиныОпера.ОтправитьПорциюПакетов("PriceCheker", 1);
                Сообщить("[7 ОК] Вызов отправителя завершён; результат читаем из регистра ниже");
            КонецЕсли;
        ИначеЕсли Пакет.СтатусСообщения = Перечисления.СтатусыСообщенийШины.ДоставкаПодтверждена Тогда
            Сообщить("[7 ОК] Пакет уже подтверждён; повторная отправка не требуется");
        Иначе
            Сообщить("[7 ОЖИДАНИЕ] Пакет уже проходил отправку. Повторно его не отправляем; проверяем приём и итог");
        КонецЕсли;

        Этап = "8. Приём ответа бэка";
        СервисыИнтеграции.ВыполнитьОбработку();
        Сообщить("[8 ОК] Обработка сервисов повторно запущена");
        Сообщить("        Входящих в локальном канале: "
            + Строка(ВходящийКанал.ВыбратьСообщения().Количество()));

        Этап = "9. Фактический результат";
        Проверка = Новый Запрос(
        "ВЫБРАТЬ СтатусСообщения, ИдентификаторСообщения, ДатаОтправки, ДатаЗагрузки, ТекстОшибки
        |ИЗ РегистрСведений.ОчередьШины
        |ГДЕ ВнешняяСистема = ""PriceCheker"" И ИдентификаторОбъекта = &Ид");
        Проверка.УстановитьПараметр("Ид", ИдПакета);
        Итог = Проверка.Выполнить().Выгрузить();
        Если Итог.Количество() <> 1 Тогда ВызватьИсключение "Ожидалась одна запись контрольного batch_id"; КонецЕсли;
        СтрокаИтога = Итог[0];
        Сообщить("[9 ИТОГ] batch_id=" + ИдПакета);
        Сообщить("          Статус=" + Строка(СтрокаИтога.СтатусСообщения));
        Сообщить("          Транспортный ID=" + Строка(СтрокаИтога.ИдентификаторСообщения));
        Сообщить("          Отправка=" + Строка(СтрокаИтога.ДатаОтправки)
            + "; загрузка=" + Строка(СтрокаИтога.ДатаЗагрузки));
        Сообщить("          Текст=" + СтрокаИтога.ТекстОшибки);
        Если СтрокаИтога.СтатусСообщения = Перечисления.СтатусыСообщенийШины.ДоставкаПодтверждена Тогда
            Сообщить("[ГОТОВО] Прикладное подтверждение применено к контрольному пакету");
        ИначеЕсли СтрокаИтога.СтатусСообщения = Перечисления.СтатусыСообщенийШины.Ошибка Тогда
            Сообщить("[ОШИБКА ПАКЕТА] Смотрите текст выше и журнал регистрации КХ.Шина.*");
        Иначе
            Сообщить("[ОЖИДАНИЕ] Прикладное подтверждение ещё не применено");
            Сообщить("Бэку: store_id=" + Магазин + "; batch_id=" + ИдПакета);
            Сообщить("Ответ PC: отправитель=" + СвойУзел + "; получатель=" + СвойУзел);
            Сообщить("После реального ACK повторите ЭТОТ ЖЕ алгоритм через несколько секунд");
            Сообщить("Если ACK уже доставлен, проверьте журнал КХ.Шина.Входящее.ПрайсЧекеры и обработчик получения PC");
        КонецЕсли;
    КонецЕсли;
    Сообщить("===== КОНЕЦ АЛГОРИТМА PC =====");
Исключение
    // Не выводим значения ключей даже если исключение платформы включило их в текст.
    ТекстОшибки = ОписаниеОшибки();
    Если НЕ ПустаяСтрока(ИдентификаторКлюча) Тогда
        ТекстОшибки = СтрЗаменить(ТекстОшибки, ИдентификаторКлюча, "[идентификатор скрыт]");
    КонецЕсли;
    Если НЕ ПустаяСтрока(СекретКлюча) Тогда
        ТекстОшибки = СтрЗаменить(ТекстОшибки, СекретКлюча, "[секрет скрыт]");
    КонецЕсли;
    Сообщить("[ОСТАНОВЛЕНО] Этап: " + Этап);
    Сообщить(ТекстОшибки);
КонецПопытки;
