// Фактический код, присланный пользователем02.11.2026. НЕ исправление.
// На обратной ветке Opera отправительBackendOpera; fallback на него ошибочен.
метод АдресОтветаPCПреобразование(Контекст: КонтекстВызоваИнтеграции, Сообщение: Opera.Сообщение): СообщениеИнтеграции
    если Сообщение.Получатели.Размер() == 0
        возврат Сообщение.УстановитьКодыПолучателей(
            [Сообщение.Отправитель.Код])
    ;
    возврат Сообщение
;
