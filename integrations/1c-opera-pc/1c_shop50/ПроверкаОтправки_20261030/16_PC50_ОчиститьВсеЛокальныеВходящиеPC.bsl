// Пользователь явно разрешил удалить ВСЕ сообщения выбранного локального канала.
// Только база50 / ExchPriceChecker / Основной_PC_ToBackend.
// Без фильтров sender, даты или JSON. Товарный регистр и канал сервера не меняются.
// Перед запуском продолжить текущую остановку отладчика, отключить ExchPriceChecker
// и дождаться завершения обработки. Выполнить вне транзакции.
К = КХ_ПилотШины.Контекст();
Если К.Номер <> 50
    ИЛИ К.Код <> "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
    ВызватьИсключение "Выполнять только в базе магазина 50";
КонецЕсли;

Если ТранзакцияАктивна() Тогда
    ВызватьИсключение "Запустите вне транзакции";
КонецЕсли;

Если СервисыИнтеграции.ExchPriceChecker.ПолучитьАктивность() Тогда
    ВызватьИсключение "Сначала выключите ExchPriceChecker и дождитесь завершения обработки";
КонецЕсли;

Канал = СервисыИнтеграции.ExchPriceChecker.Основной_PC_ToBackend;
Сообщения = Канал.ВыбратьСообщения();
Идентификаторы = Новый Массив;

Для Каждого Сообщение Из Сообщения Цикл
    Идентификаторы.Добавить(Сообщение.Идентификатор);
КонецЦикла;

Сообщить("До очистки: " + Строка(Сообщения.Количество()));

Если Идентификаторы.Количество() > 0 Тогда
    Канал.УдалитьСообщения(Идентификаторы);
КонецЕсли;

Сообщить("После очистки: "
    + Строка(Канал.ВыбратьСообщения().Количество()));
