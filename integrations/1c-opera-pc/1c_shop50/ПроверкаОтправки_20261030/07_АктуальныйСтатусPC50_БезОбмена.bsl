// Только чтение БД 50: исключает устаревшее отображение списка.
Если КХ_ПилотШины.Контекст().Номер <> 50 Тогда
    ВызватьИсключение "Выполнять только в 50";
КонецЕсли;
Запрос = Новый Запрос(
"ВЫБРАТЬ СтатусСообщения, ТекстОшибки, ДатаЗагрузки
|ИЗ РегистрСведений.ОчередьШины
|ГДЕ ВнешняяСистема = ""PriceCheker""
| И ИдентификаторОбъекта = &Ид");
Запрос.УстановитьПараметр("Ид", "aaaec85a-d078-4001-8350-7a486e854979");
Строки = Запрос.Выполнить().Выгрузить();
Если Строки.Количество() = 0 Тогда
    Сообщить("Строка указанного PC-пакета не найдена.");
КонецЕсли;
Для Каждого Запись Из Строки Цикл
    Сообщить("Статус: " + Строка(Запись.СтатусСообщения));
    Сообщить("Текст: " + Запись.ТекстОшибки);
    Сообщить("Дата загрузки: " + Строка(Запись.ДатаЗагрузки));
КонецЦикла;
