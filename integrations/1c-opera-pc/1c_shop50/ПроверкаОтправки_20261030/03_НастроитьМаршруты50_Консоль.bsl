// Только база магазина 50; задания обмена остановлены, оба сервиса выключены.
// Существующие ключи, пакеты, эпоха и состояние full не переписываются.
К = КХ_ПилотШины.Контекст();
Если К.Номер <> 50 ИЛИ К.Код <> "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
    ВызватьИсключение "Выполнять только в базе магазина 50";
КонецЕсли;
Если ТранзакцияАктивна() Тогда
    ВызватьИсключение "Запустите блок вне транзакции";
КонецЕсли;
Для Каждого Имя Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
    Если СервисыИнтеграции[Имя].ПолучитьАктивность() Тогда
        ВызватьИсключение "Сначала выключите " + Имя;
    КонецЕсли;
КонецЦикла;
Для Каждого Запись Из КХ_ПилотШины.Очередь() Цикл
    Система = СокрЛП(Запись.ВнешняяСистема);
    Если (Система = "Opera" ИЛИ Система = "PriceCheker"
        ИЛИ Система = "StructuralUnits")
        И Запись.СтатусСообщения <>
            Перечисления.СтатусыСообщенийШины.ДоставкаПодтверждена Тогда
        ВызватьИсключение "Есть незавершённые исходящие пакеты; маршрут не изменён";
    КонецЕсли;
КонецЦикла;

СвойУзел = "S3370588b074211e0b9c1001a64c3f566";
НачатьТранзакцию();
Попытка
    КХ_ОбменШиныОпера.НастроитьМаршрутПрайсЧекеров(СвойУзел, СвойУзел);
    КХ_ОбменШиныОпера.НастроитьПолучателяОпера("BackendOpera");
    КХ_ОбменШиныОпера.УстановитьКодУзлаОтправителя(СвойУзел);
    ЗафиксироватьТранзакцию();
Исключение
    ОтменитьТранзакцию();
    ВызватьИсключение;
КонецПопытки;

Маршрут = КХ_ОбменШиныОпера.ПараметрыМаршрутаПрайсЧекеров();
Сообщить("Магазин=50; PC отправитель=" + Маршрут.КодОтправителя
    + "; PC получатель=" + Маршрут.КодПолучателя);
Сообщить("Opera отправитель=" + КХ_ОбменШиныОпера.КодУзлаОтправителя());
Сообщить("Маршруты настроены. Отправка и приём не запускались.");
