// Контрольный шаг отправки: бэк50 приостановил чтение PC/ToShops.
// ExchPriceChecker включён, ExchOperaPC выключен; после смены активности выждать20сек.
// Подготовка/отправка по расписанию остаются остановленными.
// Использует единственный незавершённый исходящий PC-пакет, новую delta/full не создаёт.
К = КХ_ПилотШины.Контекст();
Если К.Номер <> 50
    ИЛИ К.Код <> "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
    ВызватьИсключение "Выполнять только в магазине 50";
КонецЕсли;
Если ТранзакцияАктивна() Тогда
    ВызватьИсключение "Запустите вне транзакции";
КонецЕсли;
Если НЕ СервисыИнтеграции.ExchPriceChecker.ПолучитьАктивность()
    ИЛИ СервисыИнтеграции.ExchOperaPC.ПолучитьАктивность() Тогда
    ВызватьИсключение "Включите ExchPriceChecker, выключите ExchOperaPC";
КонецЕсли;

Пакеты = Новый Массив;
Для Каждого Запись Из КХ_ПилотШины.Очередь() Цикл
    Если СокрЛП(Запись.ВнешняяСистема) = "PriceCheker"
        И Запись.СтатусСообщения <>
            Перечисления.СтатусыСообщенийШины.ДоставкаПодтверждена Тогда
        Пакеты.Добавить(Запись);
        Сообщить("PC | batch_id=" + Запись.ИдентификаторОбъекта
            + " | статус=" + Строка(Запись.СтатусСообщения));
    КонецЕсли;
КонецЦикла;

Если Пакеты.Количество() <> 1 Тогда
    ВызватьИсключение "Ожидался один незавершённый PC-пакет, найдено: "
        + Строка(Пакеты.Количество());
КонецЕсли;
Пакет = Пакеты[0];
Если СокрЛП(Пакет.УзелПолучатель) <> "S3370588b074211e0b9c1001a64c3f566"
    ИЛИ СокрЛП(Пакет.КаналСервисаИнтеграции) <> "Основной_PC_FromShops" Тогда
    ВызватьИсключение "Адрес или канал пакета не соответствует PC50";
КонецЕсли;

КХ_ОбменШиныОпера.ОтправитьПорциюПакетов("PriceCheker", 1);
Сообщить("Вызов отправки завершён для проверки batch_id="
    + Пакет.ИдентификаторОбъекта);
// Реальную доставку проверять по счётчикам Шины: FromShops50 +1; ToShops50 в канале1.
// Уже Отправлено повторяется только после установленного таймаута (по текущим параметрам300сек).
