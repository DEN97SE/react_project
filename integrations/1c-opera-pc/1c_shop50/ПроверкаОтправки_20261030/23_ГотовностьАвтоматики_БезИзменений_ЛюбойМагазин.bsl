// Этап 1 подготовки тестовых баз. Вставить целиком в серверную консоль.
// Любой магазин: UUID и S-код определяются из текущей СЕ.
// Только чтение. Настройки, задания и очередь не изменяются, обмен не запускается.
// В выводе нет значений ключей. Проверка настроек не заменяет приёмку обмена.

Этап = "Начало";
Замечания = Новый Массив;
СекретыДляСкрытия = Новый Массив;
МетодТоварногоЗадания = "КХ_ОбменШиныОпера.РегламентнаяОбработкаОчередиОпера";

Попытка
    Сообщить("===== ЭТАП 1. ГОТОВНОСТЬ АВТОМАТИЧЕСКОГО ОБМЕНА =====");
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "Выполняйте вне транзакции"; КонецЕсли;

    // 1. Паспорт базы: из строки соединения выводим только сервер/базу/каталог.
    Этап = "1. Паспорт базы";
    СЕ = КХ_ОбменШиныОпера.ТекущаяСЕ();
    Магазин = КХ_ОбменШиныОпера.ИдентификаторМагазина();
    СвойУзел = "S" + СтрЗаменить(Магазин, "-", "");
    Сообщить("[1] Время=" + Строка(ТекущаяДатаСеанса()) + "; магазин=" + Строка(СЕ));
    Сообщить("    store_id=" + Магазин + "; участник=" + СвойУзел);
    Сообщить("    Конфигурация=" + Метаданные.Имя + "; версия=" + Метаданные.Версия);
    Для Каждого ЧастьСоединения Из СтрРазделить(СтрокаСоединенияИнформационнойБазы(), ";", Ложь) Цикл
        Позиция = Найти(ЧастьСоединения, "=");
        Если Позиция > 0 Тогда
            ИмяПараметра = НРег(СокрЛП(Лев(ЧастьСоединения, Позиция - 1)));
            Если ИмяПараметра = "srvr" ИЛИ ИмяПараметра = "ref" ИЛИ ИмяПараметра = "file" Тогда
                Сообщить("    База: " + СокрЛП(ЧастьСоединения));
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    // 2. Оба сервиса нужны для постоянной работы. Их активность только читаем.
    Этап = "2. Сервисы и каналы";
    Для Каждого ИмяМодуля Из СтрРазделить(
        "КХ_ОбменШиныОпера,КХ_ДанныеОпера,КХ_ОбменШиныПрайсЧекеры,КХ_РегистрацияИзмененийОбмена", ",") Цикл
        Если Метаданные.ОбщиеМодули.Найти(ИмяМодуля) = Неопределено Тогда
            Замечания.Добавить("Отсутствует общий модуль " + ИмяМодуля);
        КонецЕсли;
    КонецЦикла;
    Для Каждого ОписаниеСервиса Из СтрРазделить(
        "ExchOperaPC|Основной_ExchangeOpera_FromOpera|Основной_ExchangeOpera_ToBackend;ExchPriceChecker|Основной_PC_FromShops|Основной_PC_ToBackend", ";") Цикл
        Части = СтрРазделить(ОписаниеСервиса, "|");
        ИмяСервиса = Части[0];
        МДСервиса = Метаданные.СервисыИнтеграции.Найти(ИмяСервиса);
        Если МДСервиса = Неопределено Тогда
            Замечания.Добавить("Нет сервиса " + ИмяСервиса);
            Продолжить;
        КонецЕсли;
        Сервис = СервисыИнтеграции[ИмяСервиса];
        Настройки = Сервис.ПолучитьНастройки();
        ИдентификаторКлюча = Настройки.ИмяПользователяВнешнегоСервисаИнтеграции;
        СекретКлюча = Настройки.ПарольПользователяВнешнегоСервисаИнтеграции;
        Если НЕ ПустаяСтрока(ИдентификаторКлюча) Тогда СекретыДляСкрытия.Добавить(ИдентификаторКлюча); КонецЕсли;
        Если НЕ ПустаяСтрока(СекретКлюча) Тогда СекретыДляСкрытия.Добавить(СекретКлюча); КонецЕсли;
        Активен = Сервис.ПолучитьАктивность();
        Сообщить("[2] " + ИмяСервиса + ": активность=" + Строка(Активен));
        Сообщить("    Адрес заполнен=" + Строка(НЕ ПустаяСтрока(Настройки.АдресВнешнегоСервисаИнтеграции))
            + "; ключ заполнен=" + Строка(НЕ ПустаяСтрока(ИдентификаторКлюча))
            + "; секрет заполнен=" + Строка(НЕ ПустаяСтрока(СекретКлюча)));
        Если НЕ Активен Тогда Замечания.Добавить("Выключен сервис " + ИмяСервиса); КонецЕсли;
        Если ПустаяСтрока(Настройки.АдресВнешнегоСервисаИнтеграции)
            ИЛИ ПустаяСтрока(ИдентификаторКлюча) ИЛИ ПустаяСтрока(СекретКлюча) Тогда
            Замечания.Добавить("Неполные настройки " + ИмяСервиса);
        КонецЕсли;
        Для ИндексКанала = 1 По 2 Цикл
            Если МДСервиса.КаналыСервисаИнтеграции.Найти(Части[ИндексКанала]) = Неопределено Тогда
                Замечания.Добавить("Нет канала " + ИмяСервиса + "." + Части[ИндексКанала]);
            КонецЕсли;
        КонецЦикла;
        Если МДСервиса.КаналыСервисаИнтеграции.Найти(Части[2]) <> Неопределено Тогда
            Попытка
                Канал = Сервис[Части[2]];
                Сообщить("    Приём: " + Части[2] + "; состояние=" + Строка(Канал.ПолучитьСостояние())
                    + "; выбрано входящих (не более 5)=" + Строка(Канал.ВыбратьСообщения(, 5).Количество()));
            Исключение
                Замечания.Добавить("Не удалось прочитать состояние входящего канала " + ИмяСервиса);
            КонецПопытки;
        КонецЕсли;
    КонецЦикла;
    ПараметрыОбмена = КХ_ОбменШиныОпера.ПараметрыОбмена();
    Если ПараметрыОбмена.КаналОпера <> "Основной_ExchangeOpera_FromOpera"
        ИЛИ ПараметрыОбмена.КаналПрайсЧекеры <> "Основной_PC_FromShops" Тогда
        Замечания.Добавить("ПараметрыОбмена содержат неактуальные имена товарных каналов");
    КонецЕсли;
    Сообщить("    Хранение подтверждённых, дней=" + Строка(ПараметрыОбмена.ДнейХраненияПодтвержденных));

    // 3. Читаем состояние запросом: не вызываем getters, создающие технический корень.
    Этап = "3. Маршруты и состояние full";
    Корень = Новый Запрос(
    "ВЫБРАТЬ СтроковыйОбъект ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема = ""OperaState"" И ИдентификаторОбъекта = ""КХ_OperaState""
    | И УзелПолучатель = """" И КаналСервисаИнтеграции = """"");
    СтрокиСостояния = Корень.Выполнить().Выгрузить();
    Если СтрокиСостояния.Количество() <> 1 Тогда
        Замечания.Добавить("Не найден единственный технический корень обмена");
    Иначе
        Состояние = КХ_ОбменШиныОпера.ИзJSON(СтрокиСостояния[0].СтроковыйОбъект);
        Для Каждого ОписаниеПоля Из СтрРазделить(
            "node_code|" + СвойУзел + ";pc_store_id|" + Магазин + ";pc_node_code|" + СвойУзел
            + ";pc_backend_node|" + СвойУзел + ";opera_backend_node|BackendOpera", ";") Цикл
            Части = СтрРазделить(ОписаниеПоля, "|");
            ЗначениеПоля = КХ_ОбменШиныОпера.СтроковоеПоле(Состояние, Части[0]);
            Сообщить("[3] " + Части[0] + "=" + ЗначениеПоля);
            Если ЗначениеПоля <> Части[1] Тогда Замечания.Добавить("Не совпадает маршрут " + Части[0]); КонецЕсли;
        КонецЦикла;
        Для Каждого ИмяПоля Из СтрРазделить("full_active,catalog_bootstrap_started,catalog_full_requested", ",") Цикл
            ЗначениеПоля = Неопределено;
            Если Состояние.Свойство(ИмяПоля, ЗначениеПоля) Тогда
                Сообщить("    " + ИмяПоля + "=" + Строка(ЗначениеПоля));
                Если ИмяПоля = "catalog_bootstrap_started" И ЗначениеПоля = Ложь Тогда
                    Сообщить("    [ВАЖНО] Первый штатный товарный цикл может начать первоначальную full");
                КонецЕсли;
            Иначе
                Замечания.Добавить("Нет поля текущей редакции " + ИмяПоля);
            КонецЕсли;
        КонецЦикла;
        ЗапросыКаталога = Неопределено;
        Если Состояние.Свойство("catalog_requests", ЗапросыКаталога) Тогда
            Сообщить("    Сохранённых запросов каталога=" + Строка(ЗапросыКаталога.Количество()));
        Иначе
            Замечания.Добавить("Нет поля catalog_requests");
        КонецЕсли;
    КонецЕсли;

    // 4. Инвентаризация подписок по подтверждённым свойствам метаданных.
    // Наличие источника не доказывает правильность обработчика: это проверяем реальным изменением.
    Этап = "4. Источники подписок";
    Источники = СтрРазделить(
        "СправочникОбъект.Номенклатура;РегистрСведенийНаборЗаписей.ЦеныНоменклатуры;"
        + "РегистрНакопленияНаборЗаписей.ПартииНоменклатуры;РегистрСведенийНаборЗаписей.ШтриховыеКоды;"
        + "РегистрСведенийНаборЗаписей.РекламныеАкцииЦены;РегистрСведенийНаборЗаписей.ЗначенияСвойствОбъектов;"
        + "РегистрСведенийНаборЗаписей.ЗначенияСвойствТоваров;РегистрСведенийНаборЗаписей.АссортиментныеМикроматрицы;"
        + "РегистрСведенийНаборЗаписей.НазначениеМикроматрицВСтруктурныхЕдиницах;"
        + "СправочникОбъект.СтруктурныеЕдиницы;СправочникОбъект.Склады;"
        + "СправочникОбъект.КлассификаторСтранМира;СправочникОбъект.КлассификаторЕдиницИзмерения;"
        + "СправочникОбъект.ЕдиницыИзмерения", ";");
    Для Каждого ИмяИсточника Из Источники Цикл
        ТипИсточника = Тип(ИмяИсточника);
        СписокПодписок = "";
        Для Каждого ПодпискаМД Из Метаданные.ПодпискиНаСобытия Цикл
            Если ПодпискаМД.Источник.СодержитТип(ТипИсточника) Тогда
                СписокПодписок = СписокПодписок + ?(ПустаяСтрока(СписокПодписок), "", ", ") + ПодпискаМД.Имя;
            КонецЕсли;
        КонецЦикла;
        Сообщить("[4] " + ИмяИсточника + " | подписки=" + СписокПодписок);
        Если ПустаяСтрока(СписокПодписок) Тогда
            Замечания.Добавить("У источника не найдено подписок: " + ИмяИсточника);
        КонецЕсли;
    КонецЦикла;
    Сообщить("    Имена и источники прочитаны; нужные обработчики подтверждаем тестом реального изменения");

    // 5. Настоящие экземпляры заданий и их история. Задания не запускаем и не включаем.
    Этап = "5. Регламентное задание";
    ЧислоТоварных = 0;
    Попытка
        ЧислоМДЗаданий = 0;
        Для Каждого МДЗадания Из Метаданные.РегламентныеЗадания Цикл
            Если НРег(СтрЗаменить(Строка(МДЗадания.ИмяМетода), "ОбщийМодуль.", "")) = НРег(МетодТоварногоЗадания) Тогда
                ЧислоМДЗаданий = ЧислоМДЗаданий + 1;
                Сообщить("[5] Объект конфигурации: " + МДЗадания.Имя);
            КонецЕсли;
        КонецЦикла;
        Если ЧислоМДЗаданий <> 1 Тогда
            Замечания.Добавить("Объектов метаданных товарного задания найдено=" + Строка(ЧислоМДЗаданий));
        КонецЕсли;
        Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл
            ИмяМетода = СтрЗаменить(Строка(Задание.Метаданные.ИмяМетода), "ОбщийМодуль.", "");
            Если НРег(ИмяМетода) = НРег("КХ_ОбменШиныПрайсЧекеры.РегламентнаяОбработкаОчередиPriceCheker") Тогда
                Если Задание.Использование Тогда Замечания.Добавить("Включён отдельный старый PC-job: " + Задание.Метаданные.Имя); КонецЕсли;
            КонецЕсли;
            Если НРег(ИмяМетода) <> НРег(МетодТоварногоЗадания) Тогда Продолжить; КонецЕсли;
            ЧислоТоварных = ЧислоТоварных + 1;
            Сообщить("[5] " + Задание.Метаданные.Имя + "; ID=" + Строка(Задание.УникальныйИдентификатор));
            Сообщить("    Использование=" + Строка(Задание.Использование) + "; пользователь=" + Задание.ИмяПользователя);
            Сообщить("    Расписание=" + Строка(Задание.Расписание));
            Если НЕ Задание.Использование Тогда Замечания.Добавить("Выключено общее товарное задание"); КонецЕсли;
            Последнее = Задание.ПоследнееЗадание;
            Если Последнее = Неопределено Тогда
                Замечания.Добавить("У товарного задания нет сохранённой истории выполнения");
            Иначе
                Сообщить("    Последнее: начало=" + Строка(Последнее.Начало)
                    + "; конец=" + Строка(Последнее.Конец) + "; состояние=" + Строка(Последнее.Состояние));
                Если Задание.Использование И ЗначениеЗаполнено(Последнее.Конец)
                    И ТекущаяДатаСеанса() - Последнее.Конец > 900 Тогда
                    Замечания.Добавить("Последнее выполнение завершено более 15 минут назад; проверьте расписание и блокировку заданий");
                КонецЕсли;
                Если Последнее.ИнформацияОбОшибке <> Неопределено Тогда
                    Замечания.Добавить("Последний товарный запуск содержит ошибку; смотрите историю задания");
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        Если ЧислоТоварных <> 1 Тогда
            Замечания.Добавить("Ожидался один экземпляр общего товарного задания, найдено=" + Строка(ЧислоТоварных));
        КонецЕсли;
    Исключение
        Замечания.Добавить("История заданий не проверена; нужен серверный контекст и права чтения регламентных заданий");
    КонецПопытки;

    // 6. Только наши логические очереди, без удаления и разбора тел товаров.
    Этап = "6. Сводка очередей";
    ЗапросОчереди = Новый Запрос(
    "ВЫБРАТЬ ВнешняяСистема, СтатусСообщения, КОЛИЧЕСТВО(*) КАК Количество,
    | МИНИМУМ(ДатаРегистрации) КАК Первая, МАКСИМУМ(ДатаРегистрации) КАК Последняя
    |ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема В (""Opera"", ""PriceCheker"", ""StructuralUnits"", ""OperaChange"")
    |СГРУППИРОВАТЬ ПО ВнешняяСистема, СтатусСообщения
    |УПОРЯДОЧИТЬ ПО ВнешняяСистема, СтатусСообщения");
    Для Каждого СтрокаОчереди Из ЗапросОчереди.Выполнить().Выгрузить() Цикл
        Сообщить("[6] " + СтрокаОчереди.ВнешняяСистема + " | " + Строка(СтрокаОчереди.СтатусСообщения)
            + " | количество=" + Строка(СтрокаОчереди.Количество)
            + " | первая=" + Строка(СтрокаОчереди.Первая) + " | последняя=" + Строка(СтрокаОчереди.Последняя));
    КонецЦикла;

    Сообщить("[ИТОГ ЭТАПА 1] Замечаний=" + Строка(Замечания.Количество()));
    Для Каждого Замечание Из Замечания Цикл Сообщить("[ПРОВЕРИТЬ] " + Замечание); КонецЦикла;
    Если Замечания.Количество() = 0 Тогда
        Сообщить("[БАЗОВЫЕ ПАРАМЕТРЫ ОК] Далее проверяем реальные подписки и автоматический ACK обоих проектов");
    Иначе
        Сообщить("[НУЖНА НАСТРОЙКА] Дальнейший шаг определяем по замечаниям и состоянию full выше");
    КонецЕсли;
    Сообщить("Проверка только читала данные. Готовность к передаче требует следующих приёмочных тестов");
    Сообщить("===== КОНЕЦ ЭТАПА 1 =====");
Исключение
    ТекстОшибки = ОписаниеОшибки();
    Для Каждого Скрываемое Из СекретыДляСкрытия Цикл
        ТекстОшибки = СтрЗаменить(ТекстОшибки, Скрываемое, "[ключ скрыт]");
    КонецЦикла;
    Сообщить("[ОСТАНОВЛЕНО] Этап=" + Этап);
    Сообщить(ТекстОшибки);
КонецПопытки;
