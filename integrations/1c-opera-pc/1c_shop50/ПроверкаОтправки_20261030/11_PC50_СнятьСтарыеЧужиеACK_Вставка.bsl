    И СокрЛП(Сообщение.КодОтправителя) = "Backend_PC"
    И КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеACK, "message_type") = "ack"
    И КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеACK, "store_id") =
        "40933103-84ba-4d00-ab50-ce9efa15eda8"
    И КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеACK, "dataset") = "" Тогда

    ЗаписьЖурналаРегистрации(
        "КХ.Шина.ОчисткаСтарыхACK50",
        УровеньЖурналаРегистрации.Информация, , ,
        "Снят старый чужой ACK: отправитель=Backend_PC; магазин=410; batch_id="
        + КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеACK, "batch_id"));

    Отказ = Ложь;
    Возврат;
КонецЕсли;
