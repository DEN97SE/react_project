// ШАГ 3. Выполнять только в тестовой базе №50, выбранной единственным источником СЕ.
// №410 вторым источником не включаем. СЕ публикуются только в Opera.
// Первый запуск сохраняет первоначальную настройку и включает задание СЕ.
// Повтор через 30–60 секунд читает прогресс; настроенный full заново не запрашивается.
// Пользователь берётся из сохранённых настроек общего товарного задания этой базы.
// Включённость товарного задания не требуется; его состояние не меняется.
// Товарные настройки, сессии и подключения этим алгоритмом не записываются.

Этап = "Начало";
СкрываемыеКлючи = Новый Массив;

Попытка
    Сообщить("===== ШАГ 3. СЕ ИЗ ТЕСТОВОГО ЦО50 ТОЛЬКО В OPERA =====");

    // 1. Проверяем источник и существующий транспортный маршрут.
    Этап = "1. Проверка источника";
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "Запустите вне транзакции"; КонецЕсли;
    Источник50 = "3370588b-0742-11e0-b9c1-001a64c3f566";
    Магазин410 = "40933103-84ba-4d00-ab50-ce9efa15eda8";
    Источник = КХ_ОбменШиныОпера.ИдентификаторМагазина();
    УзелИсточника = "S" + СтрЗаменить(Источник50, "-", "");
    Если Источник <> Источник50 Тогда
        ВызватьИсключение "Этот алгоритм предназначен для тестового источника №50, а не №410";
    КонецЕсли;
    Если НЕ ОбщиеПроцедурыИФункцииПовтИсп.ЭтоБазаЦентральногоОфиса() Тогда
        ВызватьИсключение "База должна определяться как ЦО";
    КонецЕсли;
    Запрос = Новый Запрос(
    "ВЫБРАТЬ СтроковыйОбъект ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема = ""OperaState"" И ИдентификаторОбъекта = ""КХ_OperaState""
    | И УзелПолучатель = """" И КаналСервисаИнтеграции = """"");
    КорниТоваров = Запрос.Выполнить().Выгрузить();
    Если КорниТоваров.Количество() <> 1 Тогда
        ВызватьИсключение "Не найдено единственное настроенное состояние товарного обмена №50";
    КонецЕсли;
    ТоварноеСостояние = КХ_ОбменШиныОпера.ИзJSON(КорниТоваров[0].СтроковыйОбъект);
    Если КХ_ОбменШиныОпера.СтроковоеПоле(ТоварноеСостояние, "node_code") <> УзелИсточника
        ИЛИ КХ_ОбменШиныОпера.СтроковоеПоле(ТоварноеСостояние, "opera_backend_node") <> "BackendOpera" Тогда
        ВызватьИсключение "Маршрут Opera не соответствует проверенной схеме №50";
    КонецЕсли;
    Сообщить("[1 ОК] Источник=" + Строка(КХ_ОбменШиныОпера.ТекущаяСЕ()) + "; source_id=" + Источник);
    Сообщить("    source_node=" + УзелИсточника + "; получатель СЕ=BackendOpera");

    // 2. Для справочника требуется только готовое подключение Opera.
    Этап = "2. Подключение Opera";
    Сервис = СервисыИнтеграции.ExchOperaPC;
    Настройки = Сервис.ПолучитьНастройки();
    Если НЕ ПустаяСтрока(Настройки.ИмяПользователяВнешнегоСервисаИнтеграции) Тогда
        СкрываемыеКлючи.Добавить(Настройки.ИмяПользователяВнешнегоСервисаИнтеграции);
    КонецЕсли;
    Если НЕ ПустаяСтрока(Настройки.ПарольПользователяВнешнегоСервисаИнтеграции) Тогда
        СкрываемыеКлючи.Добавить(Настройки.ПарольПользователяВнешнегоСервисаИнтеграции);
    КонецЕсли;
    Если НЕ Сервис.ПолучитьАктивность()
        ИЛИ ПустаяСтрока(Настройки.АдресВнешнегоСервисаИнтеграции)
        ИЛИ ПустаяСтрока(Настройки.ИмяПользователяВнешнегоСервисаИнтеграции)
        ИЛИ ПустаяСтрока(Настройки.ПарольПользователяВнешнегоСервисаИнтеграции) Тогда
        ВызватьИсключение "ExchOperaPC должен быть включён с заполненным подключением";
    КонецЕсли;
    Параметры = КХ_ОбменШиныОпера.ПараметрыОбмена();
    Если Параметры.КаналОпера <> "Основной_ExchangeOpera_FromOpera" Тогда
        ВызватьИсключение "Не соответствует канал отправки Opera";
    КонецЕсли;
    Сообщить("[2 ОК] Подключение Opera готово; ключи сохранены");

    // 3. Читаем весь справочник тем же сборщиком, который использует публикация.
    Этап = "3. Наличие магазинов в справочнике";
    ДанныеСЕ = КХ_ДанныеСтруктурныхЕдиниц.ПолучитьСостояниеМагазинов();
    Есть50 = Ложь;
    Есть410 = Ложь;
    Для Каждого Карточка Из ДанныеСЕ.structural_units Цикл
        Если Карточка.id = Источник50 Тогда Есть50 = Истина; КонецЕсли;
        Если Карточка.id = Магазин410 Тогда Есть410 = Истина; КонецЕсли;
    КонецЦикла;
    Сообщить("[3] Карточек магазинов=" + Строка(ДанныеСЕ.structural_units.Количество())
        + "; удалений=" + Строка(ДанныеСЕ.deleted_structural_unit_ids.Количество()));
    Сообщить("    Магазин50 найден=" + Строка(Есть50) + "; магазин410 найден=" + Строка(Есть410));
    Если НЕ Есть50 ИЛИ НЕ Есть410 Тогда
        ВызватьИсключение "В справочнике источника должны присутствовать обе действующие карточки 50/410 с проверенными внешними ID";
    КонецЕсли;

    // 4. Повторная проверка не должна создавать новую эпоху или новый запрос full.
    Этап = "4. Состояние публикации СЕ";
    Запрос = Новый Запрос(
    "ВЫБРАТЬ СтроковыйОбъект ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема = ""OperaState"" И ИдентификаторОбъекта = ""КХ_СЕState""
    | И УзелПолучатель = """" И КаналСервисаИнтеграции = """"");
    КорниСЕ = Запрос.Выполнить().Выгрузить();
    Если КорниСЕ.Количество() > 1 Тогда ВызватьИсключение "Дубли состояния публикации СЕ"; КонецЕсли;
    ПерваяНастройка = КорниСЕ.Количество() = 0;
    Если ПерваяНастройка Тогда
        СтарыеПакеты = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 ИдентификаторОбъекта ИЗ РегистрСведений.ОчередьШины
        |ГДЕ ВнешняяСистема = ""StructuralUnits""");
        Если НЕ СтарыеПакеты.Выполнить().Пустой() Тогда
            ВызватьИсключение "Есть пакеты СЕ без состояния источника; первоначальная настройка остановлена";
        КонецЕсли;
    Иначе
        Публикация = КХ_ОбменСтруктурныхЕдиниц.ПараметрыПубликации();
        Если НЕ Публикация.enabled ИЛИ Публикация.source_id <> Источник50
            ИЛИ Публикация.source_node <> УзелИсточника ИЛИ Публикация.opera_node <> "BackendOpera"
            ИЛИ НЕ ПустаяСтрока(Публикация.pc_directory_node) ИЛИ Публикация.pc_routes.Количество() <> 0 Тогда
            ВызватьИсключение "Существующая публикация отличается от схемы ЦО50 -> Opera. Её состояние не перезаписано";
        КонецЕсли;
    КонецЕсли;

    // 5. Берём задание СЕ и сохранённого пользователя товарного задания.
    Этап = "5. Задание и пользователь";
    ЗаданияСЕ = Новый Массив;
    ТоварныеЗадания = Новый Массив;
    Для Каждого Проверяемое Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл
        Метод = НРег(СтрЗаменить(Строка(Проверяемое.Метаданные.ИмяМетода), "ОбщийМодуль.", ""));
        Если Метод = НРег("КХ_ОбменСтруктурныхЕдиниц.РегламентнаяОбработкаСправочника") Тогда
            ЗаданияСЕ.Добавить(Проверяемое);
        КонецЕсли;
        Если Метод = НРег("КХ_ОбменШиныОпера.РегламентнаяОбработкаОчередиОпера") Тогда
            ТоварныеЗадания.Добавить(Проверяемое);
        КонецЕсли;
    КонецЦикла;
    Если ЗаданияСЕ.Количество() <> 1 ИЛИ ТоварныеЗадания.Количество() <> 1 Тогда
        ВызватьИсключение "Ожидается по одному экземпляру задания СЕ и общего товарного задания";
    КонецЕсли;
    Задание = ЗаданияСЕ[0];
    ПользовательЗадания = ТоварныеЗадания[0].ИмяПользователя;
    Если ПустаяСтрока(ПользовательЗадания)
        ИЛИ ПользователиИнформационнойБазы.НайтиПоИмени(ПользовательЗадания) = Неопределено Тогда
        ВызватьИсключение "Не найден сохранённый пользователь товарного задания";
    КонецЕсли;
    Сообщить("    Использование товарного задания=" + Строка(ТоварныеЗадания[0].Использование)
        + "; для публикации СЕ включать его не требуется");
    НовоеРасписание = Новый РасписаниеРегламентногоЗадания;
    НовоеРасписание.ПериодПовтораДней = 1;
    НовоеРасписание.ПериодПовтораВТечениеДня = 10;
    ПоляРасписания = "ВремяЗавершения,ВремяКонца,ВремяНачала,ДатаКонца,ДатаНачала,ДеньВМесяце,ДеньНеделиВМесяце,"
        + "ДниНедели,ИнтервалЗавершения,Месяцы,ПаузаПовтора,ПериодНедель,ПериодПовтораВТечениеДня,ПериодПовтораДней";
    СтароеРасписание = Задание.Расписание;
    СтарыеПоля = Новый Структура(ПоляРасписания);
    НовыеПоля = Новый Структура(ПоляРасписания);
    ЗаполнитьЗначенияСвойств(СтарыеПоля, СтароеРасписание, ПоляРасписания);
    ЗаполнитьЗначенияСвойств(НовыеПоля, НовоеРасписание, ПоляРасписания);
    НужнаЗапись = НЕ Задание.Использование ИЛИ Задание.ИмяПользователя <> ПользовательЗадания
        ИЛИ ЗначениеВСтрокуВнутр(СтарыеПоля) <> ЗначениеВСтрокуВнутр(НовыеПоля)
        ИЛИ СтароеРасписание.ДетальныеРасписанияДня.Количество() > 0;
    Последнее = Задание.ПоследнееЗадание;
    Выполняется = Ложь;
    Если Последнее <> Неопределено Тогда Выполняется = Последнее.Состояние = СостояниеФоновогоЗадания.Активно; КонецЕсли;
    Если Выполняется И (ПерваяНастройка ИЛИ НужнаЗапись) Тогда
        ВызватьИсключение "Предыдущий цикл СЕ ещё выполняется; повторите этот же алгоритм после его завершения";
    КонецЕсли;
    Сообщить("[5] " + Задание.Метаданные.Имя + "; пользователь=" + ПользовательЗадания);

    // 6. Единственное первоначальное включение. Оба параметра PC заданы явно пустыми.
    Этап = "6. Включение публикации и расписания";
    Если ПерваяНастройка Тогда
        КХ_ОбменСтруктурныхЕдиниц.НастроитьПубликацию(Истина, "BackendOpera", Новый Массив, "");
        Сообщить("[6 ОК] Публикация СЕ включена только для Opera; запрошен первоначальный full справочника");
    Иначе
        Сообщить("[6 ОК] Публикация уже настроена; новая полная выгрузка не запрошена");
    КонецЕсли;
    Если НужнаЗапись Тогда
        Задание.ИмяПользователя = ПользовательЗадания;
        Задание.Расписание = НовоеРасписание;
        Задание.Использование = Истина;
        Задание.Записать();
        Сообщить("[6 ОК] Задание СЕ включено: ежедневно каждые 10 секунд");
    Иначе
        Сообщить("[6 ОК] Задание уже включено с нужным расписанием");
    КонецЕсли;

    // 7. Реальная история планировщика и состояние справочника.
    Этап = "7. Контроль автоматического запуска";
    Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Задание.УникальныйИдентификатор);
    Сообщить("[7] Использование=" + Строка(Задание.Использование) + "; расписание=" + Строка(Задание.Расписание));
    Последнее = Задание.ПоследнееЗадание;
    Если Последнее = Неопределено Тогда
        Сообщить("[ОЖИДАНИЕ] Истории задания ещё нет");
    Иначе
        Сообщить("[ИСТОРИЯ ПОСЛЕДНЕГО ЗАПУСКА] Начало=" + Строка(Последнее.Начало) + "; конец=" + Строка(Последнее.Конец)
            + "; состояние=" + Строка(Последнее.Состояние));
        Если Последнее.ИнформацияОбОшибке <> Неопределено Тогда
            ТекстОшибки = ПодробноеПредставлениеОшибки(Последнее.ИнформацияОбОшибке);
            Для Каждого Скрываемое Из СкрываемыеКлючи Цикл
                ТекстОшибки = СтрЗаменить(ТекстОшибки, Скрываемое, "[ключ скрыт]");
            КонецЦикла;
            Сообщить("[ОШИБКА ЗАДАНИЯ] " + Лев(ТекстОшибки, 2000));
        КонецЕсли;
    КонецЕсли;
    Публикация = КХ_ОбменСтруктурныхЕдиниц.ПараметрыПубликации();
    Сообщить("[СЕ] enabled=" + Строка(Публикация.enabled) + "; source_node=" + Публикация.source_node
        + "; opera_node=" + Публикация.opera_node + "; directory_epoch=" + Публикация.directory_epoch);
    Сообщить("    full_requested=" + Строка(Публикация.full_requested) + "; full_active=" + Строка(Публикация.full_active));
    Если Публикация.full_active Тогда
        Сообщить("    Сессия=" + Публикация.full.session_id + "; следующая порция=" + Строка(Публикация.full.next_sequence)
            + "; всего порций=" + Строка(Публикация.full.total_batches));
    КонецЕсли;
    Сообщить("    Адрес PC для СЕ=" + Публикация.pc_directory_node + "; маршрутов PC=" + Строка(Публикация.pc_routes.Количество()));

    // 8. Считаем только пакеты справочника; это не товарные порции.
    Этап = "8. Очередь справочника и ошибки";
    Запрос = Новый Запрос(
    "ВЫБРАТЬ УзелПолучатель, КаналСервисаИнтеграции, СтатусСообщения, КОЛИЧЕСТВО(*) КАК Количество
    |ИЗ РегистрСведений.ОчередьШины ГДЕ ВнешняяСистема = ""StructuralUnits""
    |СГРУППИРОВАТЬ ПО УзелПолучатель, КаналСервисаИнтеграции, СтатусСообщения");
    ОчередьСЕ = Запрос.Выполнить().Выгрузить();
    Если ОчередьСЕ.Количество() = 0 Тогда Сообщить("[ОЧЕРЕДЬ СЕ] Сохранённых исходящих пакетов пока нет"); КонецЕсли;
    Для Каждого СтрокаОчереди Из ОчередьСЕ Цикл
        Сообщить("[ОЧЕРЕДЬ СЕ] " + СтрокаОчереди.УзелПолучатель + " | " + СтрокаОчереди.КаналСервисаИнтеграции
            + " | " + Строка(СтрокаОчереди.СтатусСообщения) + " | количество=" + Строка(СтрокаОчереди.Количество));
    КонецЦикла;
    Ошибки = Новый Запрос(
    "ВЫБРАТЬ ПЕРВЫЕ 3 ИдентификаторОбъекта, ТекстОшибки
    |ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема = ""StructuralUnits"" И СтатусСообщения = &Ошибка
    |УПОРЯДОЧИТЬ ПО ДатаОтправки УБЫВ, ДатаРегистрации УБЫВ");
    Ошибки.УстановитьПараметр("Ошибка", Перечисления.СтатусыСообщенийШины.Ошибка);
    Для Каждого ОшибкаПакета Из Ошибки.Выполнить().Выгрузить() Цикл
        ТекстОшибки = ОшибкаПакета.ТекстОшибки;
        Для Каждого Скрываемое Из СкрываемыеКлючи Цикл
            ТекстОшибки = СтрЗаменить(ТекстОшибки, Скрываемое, "[ключ скрыт]");
        КонецЦикла;
        Сообщить("[ОШИБКА СЕ] batch_id=" + ОшибкаПакета.ИдентификаторОбъекта + " | " + Лев(ТекстОшибки, 1500));
    КонецЦикла;
    Сообщить("Повторите ЭТОТ ЖЕ алгоритм через 30–60 секунд для контроля штатного запуска");
    Сообщить("Прикладные ошибки подготовки: журнал регистрации, события КХ.Шина.СправочникСЕ");
    Сообщить("Для приёмки СЕ магазины50/410 должны быть сохранены в Opera, а настоящий ACK должен вернуться в ЦО50");
    Сообщить("ACK справочника от PC не требуется. Статус Отправлено ещё не подтверждает приёмку Opera");
    Сообщить("===== КОНЕЦ ШАГА 3 =====");
Исключение
    ТекстОшибки = ОписаниеОшибки();
    Для Каждого Скрываемое Из СкрываемыеКлючи Цикл
        ТекстОшибки = СтрЗаменить(ТекстОшибки, Скрываемое, "[ключ скрыт]");
    КонецЦикла;
    Сообщить("[ОСТАНОВЛЕНО] Этап=" + Этап);
    Сообщить(ТекстОшибки);
КонецПопытки;
