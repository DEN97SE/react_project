// {{ semidockij - 27.10.2026 - Пояснения к методам
// Назначение: группирует штрихкоды по ссылке товара для быстрой сборки карточек.
// Как работает: преобразует строки в структуры штрихкода, сохраняя только одно одинаковое представление для каждого товара.
// Возвращает соответствие; пустые штрихкоды, для которых сборщик вернул Неопределено, пропускаются.
// }} semidockij - 27.10.2026
Функция ПодготовитьШтрихКоды(ТаблицаШтрихКодов)

	Результат = Новый Соответствие;
	// {{ semidockij - 29.10.2026 - Удаление только полностью одинаковых записей внутри карточки
	УникальныеШтрихКоды = Новый Соответствие;
	// }} semidockij - 29.10.2026

	Для Каждого СтрокаШтрихКода Из ТаблицаШтрихКодов Цикл

		МассивШтрихКодов = Результат.Получить(СтрокаШтрихКода.Номенклатура);

		Если МассивШтрихКодов = Неопределено Тогда
			МассивШтрихКодов = Новый Массив;
			Результат.Вставить(СтрокаШтрихКода.Номенклатура, МассивШтрихКодов);
		КонецЕсли;

		ДанныеШтрихКода = СформироватьШтрихкод(СтрокаШтрихКода);

		Если ДанныеШтрихКода <> Неопределено Тогда
			// {{ semidockij - 29.10.2026 - Сравниваются товар и вся экспортируемая структура
			// Разные единицы и коэффициенты сохраняются для проверки, а не выбираются произвольно.
			КлючШтрихКода = ЗначениеВСтрокуВнутр(Новый Структура(
				"Номенклатура,Данные", СтрокаШтрихКода.Номенклатура, ДанныеШтрихКода));
			Если УникальныеШтрихКоды.Получить(КлючШтрихКода) = Неопределено Тогда
				УникальныеШтрихКоды.Вставить(КлючШтрихКода, Истина);
				МассивШтрихКодов.Добавить(ДанныеШтрихКода);
			КонецЕсли;
			// }} semidockij - 29.10.2026
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

