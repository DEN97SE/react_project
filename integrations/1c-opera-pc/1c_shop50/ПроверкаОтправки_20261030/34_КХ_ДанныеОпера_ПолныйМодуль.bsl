// {{ semidockij - 27.10.2026 - Пояснения к методам
// Назначение: формирует раздел stock товарной карточки.
// Как работает: заменяет отрицательный итоговый остаток нулём, записывает количество строкой с тремя знаками и время снимка в UTC.
// Возвращает структуру quantity,updated_at; количество в выгрузке не бывает отрицательным.
// }} semidockij - 27.10.2026
Функция СформироватьДанныеОстатка(Количество, МоментВыгрузки)

	Результат = Новый Структура;
	Результат.Вставить("quantity", ФорматDecimal(Макс(Количество, 0), 3));
	Результат.Вставить("updated_at", ФорматДатаJSON(МоментВыгрузки));

	Возврат Результат;

