// Выполнить ОДИН РАЗ отдельно в 410 и 50 при остановленных заданиях обмена.
// Создаёт одну свежую delta Opera и одну PC штатным сборщиком; сеть не вызывает.
К = КХ_ПилотШины.Контекст();
Сообщить("Магазин=" + Строка(К.Номер));
Для Каждого Имя Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
    Если СервисыИнтеграции[Имя].ПолучитьАктивность() Тогда
        ВызватьИсключение "Сначала выключите " + Имя;
    КонецЕсли;
КонецЦикла;

СвойУзел = "S" + СтрЗаменить(К.Код, "-", "");
Маршрут = КХ_ОбменШиныОпера.ПараметрыМаршрутаПрайсЧекеров();
Если НЕ Маршрут.Настроен ИЛИ Маршрут.КодОтправителя <> СвойУзел
    ИЛИ Маршрут.КодПолучателя <> СвойУзел Тогда
    ВызватьИсключение "Маршрут PC не настроен на ИС своего магазина. Подготовка не запускалась";
КонецЕсли;
Если КХ_ОбменШиныОпера.КодУзлаОтправителя() <> СвойУзел Тогда
    ВызватьИсключение "Отправитель Opera не соответствует своему магазину";
КонецЕсли;

Для Каждого Запись Из КХ_ПилотШины.Очередь() Цикл
    Если (СокрЛП(Запись.ВнешняяСистема) = "Opera"
        ИЛИ СокрЛП(Запись.ВнешняяСистема) = "PriceCheker")
        И Запись.СтатусСообщения = Перечисления.СтатусыСообщенийШины.ОжидаетОтправки Тогда
        ВызватьИсключение "Уже есть ожидающий пакет. Повторную подготовку не выполняем";
    КонецЕсли;
КонецЦикла;

Штрихкод = "4607174577787"; // Палпи: для 410 карточка уже проверена.
Номенклатура = КХ_ДанныеОпера.НайтиНоменклатуруПоШтрихкоду(Штрихкод);
Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
    ВызватьИсключение "Товар по указанному штрихкоду не найден в этой базе";
КонецЕсли;
Ссылки = Новый Массив;
Ссылки.Добавить(Номенклатура);
Данные = КХ_ДанныеОпера.СформироватьСостояниеКаталога(
    КХ_ОбменШиныОпера.ТекущаяСЕ(), Ссылки);
Если Данные.products.Количество() <> 1
    ИЛИ Данные.deleted_nomenclature_ids.Количество() <> 0 Тогда
    ВызватьИсключение "Для теста требуется одна действующая карточка текущего каталога";
КонецЕсли;

КХ_ОбменШиныОпера.ЗарегистрироватьНоменклатуру(Номенклатура);
Если НЕ КХ_ОбменШиныОпера.ПодготовитьДельту(Номенклатура) Тогда
    ВызватьИсключение "Не удалось подготовить delta выбранного товара";
КонецЕсли;

Для Каждого Запись Из КХ_ПилотШины.Очередь() Цикл
    Если (СокрЛП(Запись.ВнешняяСистема) = "Opera"
        ИЛИ СокрЛП(Запись.ВнешняяСистема) = "PriceCheker")
        И Запись.СтатусСообщения = Перечисления.СтатусыСообщенийШины.ОжидаетОтправки Тогда
        Сообщить(Запись.ВнешняяСистема
            + " | batch_id=" + Запись.ИдентификаторОбъекта
            + " | получатель=" + Запись.УзелПолучатель
            + " | канал=" + Запись.КаналСервисаИнтеграции);
    КонецЕсли;
КонецЦикла;
Сообщить("Подготовлены отдельные пакеты Opera и PC. Отправка не выполнялась.");
