// Одна проверка для выбранного источника справочника и магазинных копий.
// Действующая схема: справочник СЕ только из одного ЦО в Opera; PC справочник не получает.
// Только чтение. Публикация, задания, товарные сессии и очередь не изменяются.
// Отсутствие истории в данной базе не доказывает отсутствие отправки из другого ЦО.

Этап = "Начало";
Попытка
    Сообщить("===== СПРАВОЧНИК МАГАЗИНОВ: ПРОВЕРКА БЕЗ ОТПРАВКИ =====");
    Сообщить("Схема: СЕ из выбранного ЦО -> Opera / BackendOpera; публикация СЕ в PC не требуется");
    Этап = "1. База и отдельное состояние публикации";
    Сообщить("[1] СЕ=" + Строка(КХ_ОбменШиныОпера.ТекущаяСЕ()));
    Сообщить("    Признак базы ЦО=" + Строка(ОбщиеПроцедурыИФункцииПовтИсп.ЭтоБазаЦентральногоОфиса()));
    ЗапросКорня = Новый Запрос(
    "ВЫБРАТЬ СтроковыйОбъект ИЗ РегистрСведений.ОчередьШины
    |ГДЕ ВнешняяСистема = ""OperaState"" И ИдентификаторОбъекта = ""КХ_СЕState""
    | И УзелПолучатель = """" И КаналСервисаИнтеграции = """"");
    Корни = ЗапросКорня.Выполнить().Выгрузить();
    Сообщить("    Сохранённых состояний публикации=" + Строка(Корни.Количество()));
    Если Корни.Количество() > 1 Тогда ВызватьИсключение "Дубли состояния публикации СЕ"; КонецЕсли;
    Публикация = КХ_ОбменСтруктурныхЕдиниц.ПараметрыПубликации();
    Для Каждого ИмяПоля Из СтрРазделить("enabled,source_id,source_node,opera_node,pc_directory_node,revision,full_active,full_requested", ",") Цикл
        ЗначениеПоля = Неопределено;
        Если Публикация.Свойство(ИмяПоля, ЗначениеПоля) Тогда
            Сообщить("    " + ИмяПоля + "=" + Строка(ЗначениеПоля));
        КонецЕсли;
    КонецЦикла;
    Если Корни.Количество() = 0 Тогда
        Сообщить("[1] На этой базе публикация не настраивалась: показаны исходные выключенные параметры в памяти");
    Иначе
        Сообщить("    directory_epoch=" + Публикация.directory_epoch);
    КонецЕсли;
    Сообщить("    Маршрутов PC именно для СЕ=" + Строка(Публикация.pc_routes.Количество()));
    Если ПустаяСтрока(Публикация.pc_directory_node) И Публикация.pc_routes.Количество() = 0 Тогда
        Сообщить("[1 ОК] Адреса PC для справочника пусты: соответствует схеме только Opera");
    Иначе
        Сообщить("[ПРОВЕРИТЬ] В настройках СЕ сохранены адреса PC; действующая схема предусматривает только Opera");
        Сообщить("    Настройки и ранее созданные пакеты эта проверка не меняет");
    КонецЕсли;
    Сообщить("    Эти параметры СЕ не относятся к товарному маршруту PC своего магазина");

    // 2. Проверяем именно задание справочника, а не товарный обработчик.
    Этап = "2. Задание публикации СЕ";
    НайденоЗаданий = 0;
    Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл
        Метод = НРег(СтрЗаменить(Строка(Задание.Метаданные.ИмяМетода), "ОбщийМодуль.", ""));
        Если Метод <> НРег("КХ_ОбменСтруктурныхЕдиниц.РегламентнаяОбработкаСправочника") Тогда Продолжить; КонецЕсли;
        НайденоЗаданий = НайденоЗаданий + 1;
        Сообщить("[2] " + Задание.Метаданные.Имя + "; использование=" + Строка(Задание.Использование)
            + "; пользователь=" + Задание.ИмяПользователя + "; расписание=" + Строка(Задание.Расписание));
        Последнее = Задание.ПоследнееЗадание;
        Если Последнее = Неопределено Тогда
            Сообщить("    Истории выполнения нет");
        Иначе
            Сообщить("    Начало=" + Строка(Последнее.Начало) + "; конец=" + Строка(Последнее.Конец)
                + "; состояние=" + Строка(Последнее.Состояние));
            Сообщить("    Ошибка фонового запуска=" + Строка(Последнее.ИнформацияОбОшибке <> Неопределено));
        КонецЕсли;
    КонецЦикла;
    Сообщить("    Экземпляров задания справочника=" + Строка(НайденоЗаданий));

    // 3. Считаем собственные исходящие StructuralUnits по адресам/каналам/статусам.
    Этап = "3. Исходящие пакеты справочника";
    Запрос = Новый Запрос(
    "ВЫБРАТЬ УзелПолучатель, КаналСервисаИнтеграции, СтатусСообщения, КОЛИЧЕСТВО(*) КАК Количество
    |ИЗ РегистрСведений.ОчередьШины ГДЕ ВнешняяСистема = ""StructuralUnits""
    |СГРУППИРОВАТЬ ПО УзелПолучатель, КаналСервисаИнтеграции, СтатусСообщения");
    Строки = Запрос.Выполнить().Выгрузить();
    Если Строки.Количество() = 0 Тогда Сообщить("[3] Сохранённых исходящих StructuralUnits нет"); КонецЕсли;
    Для Каждого СтрокаОчереди Из Строки Цикл
        Сообщить("[3] " + СтрокаОчереди.УзелПолучатель + " | " + СтрокаОчереди.КаналСервисаИнтеграции
            + " | " + Строка(СтрокаОчереди.СтатусСообщения) + " | количество=" + Строка(СтрокаОчереди.Количество));
    КонецЦикла;
    Сообщить("Для справочника ожидаем ACK Opera обратно на source_node ЦО; ACK справочника от PC не требуется");
    Сообщить("Пустая очередь может быть результатом прежней очистки. Приёмку подтверждаем также данными бэка");
    Сообщить("Проверка не включала публикацию и не вызывала отправку");
    Сообщить("===== КОНЕЦ ПРОВЕРКИ СПРАВОЧНИКА =====");
Исключение
    Сообщить("[ОСТАНОВЛЕНО] Этап=" + Этап);
    Сообщить(ОписаниеОшибки());
КонецПопытки;
