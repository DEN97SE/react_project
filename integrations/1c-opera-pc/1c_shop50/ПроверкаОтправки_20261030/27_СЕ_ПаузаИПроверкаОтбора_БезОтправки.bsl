// Единственный алгоритм проверки отбора СЕ в тестовом источнике50.
// Приостанавливает будущие запуски только задания СЕ, текущий запуск не отменяет.
// Читает настройки и уже созданные пакеты. Новая выгрузка и отправка не вызываются.
// До изменения сборщика покажет прежние исключённые карточки/ID в результате.
// После обновления сборщика и сеанса повторить этот же алгоритм.

Этап = "Начало";
Попытка
    Сообщить("===== СЕ: ПАУЗА И ПРОВЕРКА ОТБОРА БЕЗ ОТПРАВКИ =====");
    Этап = "1. Источник и пауза задания СЕ";
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "Запустите вне транзакции"; КонецЕсли;
    Если КХ_ОбменШиныОпера.ИдентификаторМагазина() <> "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
        ВызватьИсключение "Проверка предназначена для тестового источника №50";
    КонецЕсли;
    ЗаданияСЕ = Новый Массив;
    Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл
        Метод = НРег(СтрЗаменить(Строка(Задание.Метаданные.ИмяМетода), "ОбщийМодуль.", ""));
        Если Метод = НРег("КХ_ОбменСтруктурныхЕдиниц.РегламентнаяОбработкаСправочника") Тогда
            ЗаданияСЕ.Добавить(Задание);
        КонецЕсли;
    КонецЦикла;
    Если ЗаданияСЕ.Количество() <> 1 Тогда ВызватьИсключение "Ожидается одно задание СЕ"; КонецЕсли;
    Задание = ЗаданияСЕ[0];
    Если Задание.Использование Тогда
        Задание.Использование = Ложь;
        Задание.Записать();
        Сообщить("[1] Будущие запуски задания СЕ приостановлены для изменения отбора");
    Иначе
        Сообщить("[1] Задание СЕ уже на паузе");
    КонецЕсли;
    Последнее = Задание.ПоследнееЗадание;
    Если Последнее <> Неопределено Тогда
        Сообщить("    Последний запуск=" + Строка(Последнее.Начало) + "; состояние=" + Строка(Последнее.Состояние));
        Если Последнее.Состояние = СостояниеФоновогоЗадания.Активно Тогда
            Сообщить("[ОЖИДАНИЕ] Текущий цикл ещё выполняется; дождитесь его завершения перед обновлением конфигурации");
        КонецЕсли;
    КонецЕсли;

    // 2. Независимый список допустимых ID и проверка результата установленного сборщика.
    Этап = "2. Отбор работающих магазинов";
    Запрос = Новый Запрос(
    "ВЫБРАТЬ СЕ.СтроковыйИдентификатор КАК Идентификатор,
    | СЕ.ПометкаУдаления КАК ПометкаУдаления, СЕ.Работает КАК Работает
    |ИЗ Справочник.СтруктурныеЕдиницы КАК СЕ
    |ГДЕ НЕ СЕ.ЭтоГруппа И СЕ.ВидСтруктурнойЕдиницы = &Магазин");
    Запрос.УстановитьПараметр("Магазин", Перечисления.ВидыСтруктурныхЕдиниц.Магазин);
    ВсеМагазины = Запрос.Выполнить().Выгрузить();
    Допустимые = Новый Соответствие;
    Помеченных = 0;
    НеработающихБезПометки = 0;
    Для Каждого Магазин Из ВсеМагазины Цикл
        Если Магазин.ПометкаУдаления Тогда
            Помеченных = Помеченных + 1;
        ИначеЕсли НЕ Магазин.Работает Тогда
            НеработающихБезПометки = НеработающихБезПометки + 1;
        Иначе
            ID = СокрЛП(Строка(Магазин.Идентификатор));
            Если ПустаяСтрока(ID) ИЛИ Допустимые.Получить(ID) <> Неопределено Тогда
                ВызватьИсключение "В действующих магазинах пустой или повторяющийся внешний ID";
            КонецЕсли;
            Допустимые.Вставить(ID, Истина);
        КонецЕсли;
    КонецЦикла;
    Сообщить("[2] Всего магазинов=" + Строка(ВсеМагазины.Количество())
        + "; допустимых=" + Строка(Допустимые.Количество()));
    Сообщить("    Исключаем: с пометкой=" + Строка(Помеченных)
        + "; не работают без пометки=" + Строка(НеработающихБезПометки));
    Данные = КХ_ДанныеСтруктурныхЕдиниц.ПолучитьСостояниеМагазинов();
    ОшибокОтбора = 0;
    Полученные = Новый Соответствие;
    Для Каждого Карточка Из Данные.structural_units Цикл
        Если Допустимые.Получить(Карточка.id) = Неопределено ИЛИ НЕ Карточка.is_working
            ИЛИ Полученные.Получить(Карточка.id) <> Неопределено Тогда
            ОшибокОтбора = ОшибокОтбора + 1;
        КонецЕсли;
        Полученные.Вставить(Карточка.id, Истина);
    КонецЦикла;
    Для Каждого Допустимый Из Допустимые Цикл
        Если Полученные.Получить(Допустимый.Ключ) = Неопределено Тогда
            ОшибокОтбора = ОшибокОтбора + 1;
        КонецЕсли;
    КонецЦикла;
    ОшибокОтбора = ОшибокОтбора + Данные.deleted_structural_unit_ids.Количество();
    Сообщить("    Сборщик: карточек=" + Строка(Данные.structural_units.Количество())
        + "; удалений в полном списке=" + Строка(Данные.deleted_structural_unit_ids.Количество()));
    Если ОшибокОтбора = 0 Тогда
        Сообщить("[2 ОК] Полный список содержит только работающие магазины без пометки; удалений нет");
    Иначе
        Сообщить("[ПРОВЕРИТЬ] Несоответствий отбора=" + Строка(ОшибокОтбора)
            + "; нужен исправленный сборщик и обновлённый сеанс");
        Сообщить("    Если данные менялись во время чтения, повторите эту же проверку");
    КонецЕсли;
    Сообщить("    Магазин50 допускается=" + Строка(Допустимые.Получить("3370588b-0742-11e0-b9c1-001a64c3f566") <> Неопределено)
        + "; магазин410 допускается=" + Строка(Допустимые.Получить("40933103-84ba-4d00-ab50-ce9efa15eda8") <> Неопределено));

    // 3. Уже зарегистрированные тела не изменяются вслед за новым сборщиком.
    Этап = "3. Ранее созданные пакеты СЕ";
    Публикация = КХ_ОбменСтруктурныхЕдиниц.ПараметрыПубликации();
    Сообщить("[3] directory_epoch=" + Публикация.directory_epoch + "; full_active=" + Строка(Публикация.full_active));
    Запрос = Новый Запрос(
    "ВЫБРАТЬ ИдентификаторОбъекта, СтатусСообщения, СтроковыйОбъект
    |ИЗ РегистрСведений.ОчередьШины ГДЕ ВнешняяСистема = ""StructuralUnits""
    |УПОРЯДОЧИТЬ ПО ДатаРегистрации, ИдентификаторОбъекта");
    СтарыеПакеты = Запрос.Выполнить().Выгрузить();
    Сообщить("    Сохранённых пакетов СЕ=" + Строка(СтарыеПакеты.Количество()));
    Для Каждого СтрокаПакета Из СтарыеПакеты Цикл
        Пакет = КХ_ОбменШиныОпера.ИзJSON(СтрокаПакета.СтроковыйОбъект);
        ВнеТекущегоОтбора = 0;
        Для Каждого Карточка Из Пакет.structural_units Цикл
            Если Допустимые.Получить(Карточка.id) = Неопределено Тогда
                ВнеТекущегоОтбора = ВнеТекущегоОтбора + 1;
            КонецЕсли;
        КонецЦикла;
        Сообщить("[ПАКЕТ] batch_id=" + СтрокаПакета.ИдентификаторОбъекта
            + "; статус=" + Строка(СтрокаПакета.СтатусСообщения)
            + "; карточек=" + Строка(Пакет.structural_units.Количество())
            + "; вне текущего отбора=" + Строка(ВнеТекущегоОтбора)
            + "; ID удаления=" + Строка(Пакет.deleted_structural_unit_ids.Количество()));
    КонецЦикла;
    Сообщить("Задание СЕ оставлено на паузе. Тела, статусы, эпоха и подтверждения пакетов не менялись");
    Сообщить("Новая полная сессия не создавалась. Повтор этой проверки ничего не отправляет");
    Сообщить("===== КОНЕЦ ПРОВЕРКИ ОТБОРА СЕ =====");
Исключение
    Сообщить("[ОСТАНОВЛЕНО] Этап=" + Этап);
    Сообщить(ОписаниеОшибки());
КонецПопытки;
