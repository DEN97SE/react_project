ВызватьИсключение "Проверка34 отменена: нужен один ШК на единицу. Используйте проверку35";
// Консоль кода ПОСЛЕ установки полного модуля редакции34.
// Только чтение трёх контрольных карточек, без отправки и записи.

СЕ = ОбщиеПроцедурыИФункцииПовтИсп.ТекущаяСтруктурнаяЕдиница();
ИдМагазина = КХ_ДанныеОпера.ПолучитьИдентификаторМагазина(СЕ);
Проверки = Новый Массив;

Если ИдМагазина = "40933103-84ba-4d00-ab50-ce9efa15eda8" Тогда
	Проверки.Добавить(Новый Структура("ШтрихКод,ИдТовара,КоличествоВКоробке,ОсновнойШКНаСнимке",
		"2000452859001", "3a7f0a8d-56f7-11f0-9682-6eae8b1e8f89", "30", "2210000274648"));
ИначеЕсли ИдМагазина = "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
	Проверки.Добавить(Новый Структура("ШтрихКод,ИдТовара,КоличествоВКоробке,ОсновнойШКНаСнимке",
		"4620000130321", "ace5bf53-5c12-11e8-a448-5ef3fd3615c3", "100", ""));
	Проверки.Добавить(Новый Структура("ШтрихКод,ИдТовара,КоличествоВКоробке,ОсновнойШКНаСнимке",
		"4620000130369", "657b3be5-2162-11e6-b1b8-5ef3fd361d6b", "50", ""));
Иначе
	ВызватьИсключение "Проверка подготовлена только для магазинов 50 и 410";
КонецЕсли;

Сообщить("Регистр ОсновныеШтрихкоды: периодичность="
	+ Строка(Метаданные.РегистрыСведений.ОсновныеШтрихкоды.Периодичность));

Для Каждого Проверка Из Проверки Цикл
	Карточка = КХ_ДанныеОпера.ПолучитьКарточкуПоШтрихкоду(СЕ, Проверка.ШтрихКод);
	Если Карточка = Неопределено Тогда
		ВызватьИсключение "Нет карточки по ШК " + Проверка.ШтрихКод;
	КонецЕсли;
	Если Карточка.nomenclature_id <> Проверка.ИдТовара Тогда
		ВызватьИсключение "По ШК найден другой товар: " + Проверка.ШтрихКод;
	КонецЕсли;

	ИдШтучнойЕдиницы = "";
	ИдКоробки = "";
	ОсновнойНайден = ПустаяСтрока(Проверка.ОсновнойШКНаСнимке);
	ПарыШКЕдиница = Новый Соответствие;

	Для Каждого ЗаписьШК Из Карточка.barcodes Цикл
		ИдЕдиницы = "";
		Если НЕ ЗаписьШК.Свойство("unit_id", ИдЕдиницы) Тогда
			ВызватьИсключение "Нет unit_id: обновите весь модуль редакцией34";
		КонецЕсли;
		Если ПустаяСтрока(ИдЕдиницы) Тогда
			ВызватьИсключение "Пустая связь с единицей: " + ЗаписьШК.barcode;
		КонецЕсли;
		СсылкаЕдиницы = Справочники.ЕдиницыИзмерения.ПолучитьСсылку(
			Новый УникальныйИдентификатор(ИдЕдиницы));
		Если СсылкаЕдиницы.Наименование <> ЗаписьШК.unit Тогда
			ВызватьИсключение "unit_id не соответствует упаковке: " + ЗаписьШК.barcode;
		КонецЕсли;
		Если ТипЗнч(ЗаписьШК.is_primary) <> Тип("Булево")
			Или ТипЗнч(ЗаписьШК.is_base_unit) <> Тип("Булево") Тогда
			ВызватьИсключение "Признаки primary/base должны быть булевыми";
		КонецЕсли;

		КлючПары = ЗаписьШК.barcode + "|" + ИдЕдиницы;
		Если ПарыШКЕдиница.Получить(КлючПары) <> Неопределено Тогда
			ВызватьИсключение "Повтор одной пары ШК+unit_id: " + КлючПары;
		КонецЕсли;
		ПарыШКЕдиница.Вставить(КлючПары, Истина);

		Если ЗаписьШК.barcode = Проверка.ШтрихКод Тогда
			Если ЗаписьШК.unit = "шт" И ЗаписьШК.quantity_in_package = "1" Тогда
				Если НЕ ЗаписьШК.is_base_unit Тогда
					ВызватьИсключение "Штучная контрольная упаковка должна быть базовой";
				КонецЕсли;
				ИдШтучнойЕдиницы = ИдЕдиницы;
			ИначеЕсли ЗаписьШК.unit = "кор"
				И ЗаписьШК.quantity_in_package = Проверка.КоличествоВКоробке Тогда
				Если ЗаписьШК.is_base_unit Тогда
					ВызватьИсключение "Коробка ошибочно помечена базовой единицей";
				КонецЕсли;
				ИдКоробки = ИдЕдиницы;
			КонецЕсли;
		КонецЕсли;

		Если НЕ ПустаяСтрока(Проверка.ОсновнойШКНаСнимке) Тогда
			Если ЗаписьШК.barcode = Проверка.ОсновнойШКНаСнимке Тогда
				Если НЕ ЗаписьШК.is_primary Тогда
					ВызватьИсключение "Основной ШК на снимке не помечен primary; проверьте текущую запись регистра";
				КонецЕсли;
				ОсновнойНайден = Истина;
			ИначеЕсли ЗаписьШК.is_primary Тогда
				ВызватьИсключение "Другой код булочки помечен primary; проверьте текущую запись регистра";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(ИдШтучнойЕдиницы) Или ПустаяСтрока(ИдКоробки) Тогда
		ВызватьИсключение "Должны сохраниться обе упаковки: " + Проверка.ШтрихКод;
	КонецЕсли;
	Если ИдШтучнойЕдиницы = ИдКоробки Тогда
		ВызватьИсключение "У шт и кор должны быть разные UUID единиц";
	КонецЕсли;
	Если НЕ ОсновнойНайден Тогда
		ВызватьИсключение "Основной ШК булочки потерян";
	КонецЕсли;

	Сообщить("[ОК] " + Карточка.nomenclature_id + " | " + Карточка.name);
	Сообщить(КХ_ОбменШиныОпера.ВJSON(Карточка.barcodes));
КонецЦикла;

ТипОсновногоШК = Тип("РегистрСведенийНаборЗаписей.ОсновныеШтрихкоды");
ПодпискаНайдена = Ложь;
Для Каждого Подписка Из Метаданные.ПодпискиНаСобытия Цикл
	Если Подписка.Источник.СодержитТип(ТипОсновногоШК) Тогда
		ПодпискаНайдена = Истина;
		Сообщить("[ИСТОЧНИК ОСНОВНОГО ШК] " + Подписка.Имя);
	КонецЕсли;
КонецЦикла;
Если НЕ ПодпискаНайдена Тогда
	Сообщить("[ПОДПИСКА] Добавьте ОсновныеШтрихкоды в источник товарной подписки ПередЗаписью");
КонецЕсли;

Сообщить("Проверка сборщика завершена без отправки и изменения очереди. Привязку обработчика подписки проверьте в конфигураторе.");
