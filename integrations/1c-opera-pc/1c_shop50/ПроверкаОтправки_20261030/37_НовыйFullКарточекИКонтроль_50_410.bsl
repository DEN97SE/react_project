// ОДИН алгоритм для консоли тестовых баз50 и410.
// Первый запуск запрашивает новый full карточек в Opera и PC и включает товарный обмен.
// Повтор запускает только включение/контроль: новый full повторно не запрашивается.
// Очереди, ключи, маршруты и эпохи не сбрасываются; СЕ не перенастраивается.

КодОперации = "BARCODES_PRIMARY_LAST_20261103_01";
ПолеОтметки = "barcode_full_reload";
Этап = "Начало";
СкрываемыеКлючи = Новый Массив;

Попытка
	Сообщить("===== НОВЫЙ КАТАЛОГ С ВЫБРАННЫМИ ШК: OPERA + PC =====");
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Запустите алгоритм вне транзакции";
	КонецЕсли;

	Этап = "1. Тестовая база";
	Магазин = КХ_ОбменШиныОпера.ИдентификаторМагазина();
	Если Магазин = "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
		ИмяТестовойБазы = "AstorK50_Semidockiy";
	ИначеЕсли Магазин = "40933103-84ba-4d00-ab50-ce9efa15eda8" Тогда
		ИмяТестовойБазы = "Astor_k410_Semidockiy";
	Иначе
		ВызватьИсключение "Алгоритм предназначен только для тестовых50 и410";
	КонецЕсли;
	СтрокаИБ = СтрЗаменить(НРег(СтрокаСоединенияИнформационнойБазы()), """", "") + ";";
	Если СтрНайти(СтрокаИБ, "ref=" + НРег(ИмяТестовойБазы) + ";") = 0 Тогда
		ВызватьИсключение "Не совпадает имя тестовой ИБ: " + ИмяТестовойБазы;
	КонецЕсли;
	СвойУзел = "S" + СтрЗаменить(Магазин, "-", "");
	Сообщить("[БАЗА] " + ИмяТестовойБазы + "; store_id=" + Магазин);
	Параметры = КХ_ОбменШиныОпера.ПараметрыОбмена();
	Если Параметры.КаналОпера <> "Основной_ExchangeOpera_FromOpera"
		Или Параметры.КаналПрайсЧекеры <> "Основной_PC_FromShops" Тогда
		ВызватьИсключение "В ПараметрыОбмена неактуальные имена товарных каналов";
	КонецЕсли;

	Этап = "2. Подключения и товарное задание";
	Для Каждого ИмяСервиса Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
		Настройки = СервисыИнтеграции[ИмяСервиса].ПолучитьНастройки();
		Если НЕ ПустаяСтрока(Настройки.ИмяПользователяВнешнегоСервисаИнтеграции) Тогда
			СкрываемыеКлючи.Добавить(Настройки.ИмяПользователяВнешнегоСервисаИнтеграции);
		КонецЕсли;
		Если НЕ ПустаяСтрока(Настройки.ПарольПользователяВнешнегоСервисаИнтеграции) Тогда
			СкрываемыеКлючи.Добавить(Настройки.ПарольПользователяВнешнегоСервисаИнтеграции);
		КонецЕсли;
		Если ПустаяСтрока(Настройки.АдресВнешнегоСервисаИнтеграции)
			Или ПустаяСтрока(Настройки.ИмяПользователяВнешнегоСервисаИнтеграции)
			Или ПустаяСтрока(Настройки.ПарольПользователяВнешнегоСервисаИнтеграции) Тогда
			ВызватьИсключение "Не заполнено подключение " + ИмяСервиса;
		КонецЕсли;
	КонецЦикла;
	ТоварныеЗадания = Новый Массив;
	МетодТоваров = НРег("КХ_ОбменШиныОпера.РегламентнаяОбработкаОчередиОпера");
	МетодПрежнегоPC = НРег("КХ_ОбменШиныПрайсЧекеры.РегламентнаяОбработкаОчередиPriceCheker");
	Для Каждого ПроверяемоеЗадание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл
		Метод = НРег(СтрЗаменить(Строка(ПроверяемоеЗадание.Метаданные.ИмяМетода), "ОбщийМодуль.", ""));
		Если Метод = МетодТоваров Тогда
			ТоварныеЗадания.Добавить(ПроверяемоеЗадание);
		КонецЕсли;
		Если Метод = МетодПрежнегоPC Тогда
			Если ПроверяемоеЗадание.Использование Тогда
				ПроверяемоеЗадание.Использование = Ложь;
				ПроверяемоеЗадание.Записать();
			КонецЕсли;
			ПоследнееПрежнее = ПроверяемоеЗадание.ПоследнееЗадание;
			Если ПоследнееПрежнее <> Неопределено Тогда
				Если ПоследнееПрежнее.Состояние = СостояниеФоновогоЗадания.Активно Тогда
					ВызватьИсключение "Предыдущий отдельный PC-цикл ещё выполняется; повторите после его завершения";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если ТоварныеЗадания.Количество() <> 1 Тогда
		ВызватьИсключение "Ожидается одно существующее общее товарное задание";
	КонецЕсли;
	Задание = ТоварныеЗадания[0];
	ПользовательЗадания = Задание.ИмяПользователя;
	Если ПустаяСтрока(ПользовательЗадания) Тогда ПользовательЗадания = ИмяПользователя(); КонецЕсли;
	Если ПустаяСтрока(ПользовательЗадания)
		Или ПользователиИнформационнойБазы.НайтиПоИмени(ПользовательЗадания) = Неопределено Тогда
		ВызватьИсключение "Не найден пользователь товарного задания";
	КонецЕсли;
	Если НЕ Задание.Использование Тогда
		Последнее = Задание.ПоследнееЗадание;
		Если Последнее <> Неопределено Тогда
			Если Последнее.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				ВызватьИсключение "Товарный цикл ещё заканчивается после паузы; повторите после его завершения";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Этап = "3. Однократный запрос полной выгрузки";
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		КлючБлокировки = Блокировка.Добавить("РегистрСведений.ОчередьШины");
		КлючБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		КлючБлокировки.УстановитьЗначение("ИдентификаторОбъекта", "КХ_OperaState");
		КлючБлокировки.УстановитьЗначение("УзелПолучатель", "");
		КлючБлокировки.УстановитьЗначение("КаналСервисаИнтеграции", "");
		КлючБлокировки.УстановитьЗначение("ВнешняяСистема", "OperaState");
		Блокировка.Заблокировать();

		НаборКорня = РегистрыСведений.ОчередьШины.СоздатьНаборЗаписей();
		НаборКорня.ОбменДанными.Загрузка = Истина;
		НаборКорня.Отбор.ИдентификаторОбъекта.Установить("КХ_OperaState");
		НаборКорня.Отбор.УзелПолучатель.Установить("");
		НаборКорня.Отбор.КаналСервисаИнтеграции.Установить("");
		НаборКорня.Отбор.ВнешняяСистема.Установить("OperaState");
		НаборКорня.Прочитать();
		Если НаборКорня.Количество() <> 1 Тогда
			ВызватьИсключение "Не найдено единственное сохранённое состояние обмена";
		КонецЕсли;
		Состояние = КХ_ОбменШиныОпера.ИзJSON(НаборКорня[0].СтроковыйОбъект);
		Для Каждого ОписаниеМаршрута Из СтрРазделить("node_code|" + СвойУзел
			+ ";pc_store_id|" + Магазин + ";pc_node_code|" + СвойУзел
			+ ";pc_backend_node|" + СвойУзел + ";opera_backend_node|BackendOpera", ";") Цикл
			Части = СтрРазделить(ОписаниеМаршрута, "|");
			Если КХ_ОбменШиныОпера.СтроковоеПоле(Состояние, Части[0]) <> Части[1] Тогда
				ВызватьИсключение "Не соответствует магазину маршрут " + Части[0];
			КонецЕсли;
		КонецЦикла;
		Эпоха = КХ_ОбменШиныОпера.СтроковоеПоле(Состояние, "source_epoch");
		Если ПустаяСтрока(Эпоха) Тогда ВызватьИсключение "Не заполнена товарная эпоха"; КонецЕсли;

		Отметка = Неопределено;
		УжеЗапрошено = Ложь;
		Если Состояние.Свойство(ПолеОтметки, Отметка) Тогда
			Если ТипЗнч(Отметка) <> Тип("Структура") Тогда
				ВызватьИсключение "Неверный формат сохранённой отметки выгрузки";
			КонецЕсли;
			УжеЗапрошено = КХ_ОбменШиныОпера.СтроковоеПоле(Отметка, "id") = КодОперации;
			Если УжеЗапрошено Тогда
				Если КХ_ОбменШиныОпера.СтроковоеПоле(Отметка, "store_id") <> Магазин
					Или КХ_ОбменШиныОпера.СтроковоеПоле(Отметка, "source_epoch") <> Эпоха Тогда
					ВызватьИсключение "Отметка относится к другому магазину или другой эпохе";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Если НЕ УжеЗапрошено Тогда
			КХ_ОбменШиныОпера.ЗапроситьПовторнуюПолнуюВыгрузку();
			НаборКорня.Прочитать();
			Если НаборКорня.Количество() <> 1 Тогда
				ВызватьИсключение "Изменилось состояние обмена после запроса";
			КонецЕсли;
			Состояние = КХ_ОбменШиныОпера.ИзJSON(НаборКорня[0].СтроковыйОбъект);
			Отметка = Новый Структура("id,store_id,source_epoch,revision,time",
				КодОперации, Магазин, Эпоха, Состояние.catalog_full_request_revision,
				Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss"));
			Состояние.Вставить(ПолеОтметки, Отметка);
			НаборКорня[0].СтроковыйОбъект = КХ_ОбменШиныОпера.ВJSON(Состояние);
			НаборКорня.Записать(Истина);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если УжеЗапрошено Тогда
		Сообщить("[КОНТРОЛЬ] Этот новый full уже запрошен; повторный запрос не создаётся");
	Иначе
		Сообщить("[FULL ЗАПРОШЕН] Opera и PC; revision=" + Строка(Отметка.revision));
	КонецЕсли;

	Этап = "4. Возобновление товарного обмена";
	Для Каждого ИмяСервиса Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
		Если НЕ СервисыИнтеграции[ИмяСервиса].ПолучитьАктивность() Тогда
			СервисыИнтеграции[ИмяСервиса].УстановитьАктивность(Истина);
		КонецЕсли;
	КонецЦикла;
	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Задание.УникальныйИдентификатор);
	Если НЕ Задание.Использование Тогда
		Расписание = Новый РасписаниеРегламентногоЗадания;
		Расписание.ПериодПовтораДней = 1;
		Расписание.ПериодПовтораВТечениеДня = 10;
		Задание.ИмяПользователя = ПользовательЗадания;
		Задание.Расписание = Расписание;
		Задание.Использование = Истина;
		Задание.Записать();
	КонецЕсли;
	Сообщить("[АВТОМАТИКА] Товарное задание=" + Строка(Задание.Использование)
		+ "; расписание=" + Строка(Задание.Расписание));

	Этап = "5. Состояние и история";
	Запрос = Новый Запрос(
	"ВЫБРАТЬ СтроковыйОбъект ИЗ РегистрСведений.ОчередьШины
	|ГДЕ ВнешняяСистема = ""OperaState"" И ИдентификаторОбъекта = ""КХ_OperaState""
	| И УзелПолучатель = """" И КаналСервисаИнтеграции = """"");
	Корни = Запрос.Выполнить().Выгрузить();
	Если Корни.Количество() <> 1 Тогда ВызватьИсключение "Нет единственного состояния обмена"; КонецЕсли;
	Состояние = КХ_ОбменШиныОпера.ИзJSON(Корни[0].СтроковыйОбъект);
	Сообщить("[СОСТОЯНИЕ] full_requested=" + Строка(Состояние.catalog_full_requested)
		+ "; full_active=" + Строка(Состояние.full_active));
	Полная = Состояние.full;
	ВерсияСессии = -1;
	Если ТипЗнч(Полная) = Тип("Структура") Тогда
		Если Полная.Свойство("source_revision", ВерсияСессии) Тогда
			Если ТипЗнч(ВерсияСессии) = Тип("Число") И ВерсияСессии >= Отметка.revision Тогда
				Сообщить("[НОВЫЙ FULL] session_id=" + Полная.session_id
					+ "; следующая порция=" + Строка(Полная.next_sequence)
					+ "; всего=" + Строка(Полная.total_batches));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Последнее = Задание.ПоследнееЗадание;
	Если Последнее <> Неопределено Тогда
		Сообщить("[ИСТОРИЯ] Начало=" + Строка(Последнее.Начало)
			+ "; состояние=" + Строка(Последнее.Состояние));
		Если Последнее.ИнформацияОбОшибке <> Неопределено Тогда
			ТекстОшибки = ПодробноеПредставлениеОшибки(Последнее.ИнформацияОбОшибке);
			Для Каждого Ключ Из СкрываемыеКлючи Цикл
				ТекстОшибки = СтрЗаменить(ТекстОшибки, Ключ, "[ключ скрыт]");
			КонецЦикла;
			Сообщить("[ОШИБКА ЗАДАНИЯ] " + Лев(ТекстОшибки, 2000));
		КонецЕсли;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ВнешняяСистема, СтатусСообщения, КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ РегистрСведений.ОчередьШины
	|ГДЕ ВнешняяСистема В (""Opera"", ""PriceCheker"")
	|СГРУППИРОВАТЬ ПО ВнешняяСистема, СтатусСообщения");
	Для Каждого СтрокаОчереди Из Запрос.Выполнить().Выгрузить() Цикл
		Сообщить("[ОБЩАЯ ОЧЕРЕДЬ] " + СтрокаОчереди.ВнешняяСистема
			+ " | " + Строка(СтрокаОчереди.СтатусСообщения) + " | " + Строка(СтрокаОчереди.Количество));
	КонецЦикла;
	Сообщить("Повторите ЭТОТ ЖЕ алгоритм через30–60 секунд. Новый full повторно не запрашивается");
	Сообщить("Статус Отправлено и full_active=Нет не заменяют приём бэком и настоящий ACK");
	Сообщить("===== КОНЕЦ =====");

Исключение
	ТекстОшибки = ОписаниеОшибки();
	Для Каждого Ключ Из СкрываемыеКлючи Цикл
		ТекстОшибки = СтрЗаменить(ТекстОшибки, Ключ, "[ключ скрыт]");
	КонецЦикла;
	Сообщить("[ОСТАНОВЛЕНО] Этап=" + Этап);
	Сообщить(ТекстОшибки);
КонецПопытки;
