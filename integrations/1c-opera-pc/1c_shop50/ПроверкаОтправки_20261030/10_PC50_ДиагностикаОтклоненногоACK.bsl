// Временная диагностика в существующем событии получения PC базы 50.
// JSON читается только для УЖЕ отклонённого по отправителю сообщения.
// Разрешённое сообщение передаётся общему обработчику без предварительного чтения.
// Не изменяет отправителя, бизнес-статусы, маршруты или тело сообщения.
Процедура Основной_PC_ToBackendОбработкаПолученияСообщения(Сообщение, Отказ)

    ОжидаемыйОтправитель =
        КХ_ОбменШиныОпера.ПараметрыМаршрутаПрайсЧекеров().КодПолучателя;

    Если СокрЛП(Сообщение.КодОтправителя) <> ОжидаемыйОтправитель Тогда
        Отказ = Истина;
        Подробности = "";

        Попытка
            ДанныеACK = КХ_ОбменШиныОпера.ИзJSON(
                КХ_ОбменШиныОпера.ТелоСообщенияВСтроку(Сообщение));
            Подробности = "; message_type="
                + КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеACK, "message_type")
                + "; batch_id="
                + КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеACK, "batch_id")
                + "; store_id="
                + КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеACK, "store_id")
                + "; status="
                + КХ_ОбменШиныОпера.СтроковоеПоле(ДанныеACK, "status");
        Исключение
            Подробности = "; ошибка чтения отклонённого сообщения: " + ОписаниеОшибки();
        КонецПопытки;

        КХ_ОбменШиныОпера.ЗаписатьОшибку(
            "Входящее.PC.Отправитель",
            "Ожидался " + ОжидаемыйОтправитель
            + "; получен " + СокрЛП(Сообщение.КодОтправителя)
            + Подробности);
        Возврат;
    КонецЕсли;

    КХ_ОбменШиныПрайсЧекеры.ОбработатьВходящееСообщение(Сообщение, Отказ);

КонецПроцедуры
