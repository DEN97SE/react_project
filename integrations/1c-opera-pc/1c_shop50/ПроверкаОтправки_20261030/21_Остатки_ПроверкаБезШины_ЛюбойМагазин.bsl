// Один алгоритм для любого магазина. Вставить целиком в консоль кода.
// Только чтение: реальные остатки -> штатный сборщик карточек -> JSON -> сравнение.
// Выборка: до трёх товаров с минусом, один с нулём и один с плюсом.
// Пакеты не регистрируются; сервисы интеграции не вызываются.

Этап = "Начало";
Попытка
    Сообщить("===== ПРОВЕРКА ОСТАТКОВ БЕЗ ШИНЫ =====");
    Этап = "1. Магазин и каталог";
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "Запустите проверку вне транзакции";
    КонецЕсли;
    СЕ = КХ_ОбменШиныОпера.ТекущаяСЕ();
    Сообщить("[1 ОК] Магазин: " + Строка(СЕ));
    // Этот метод читает состав каталога, полную выгрузку не запускает.
    Каталог = КХ_ДанныеОпера.ПолучитьНоменклатуруДляПолнойВыгрузки(СЕ);
    Если Каталог.Количество() = 0 Тогда
        ВызватьИсключение "Каталог текущего магазина пуст";
    КонецЕсли;
    Сообщить("[1 ОК] Товаров в каталоге: " + Строка(Каталог.Количество()));

    // 2. Суммируем партии по всем действующим складам именно этого магазина.
    Этап = "2. Чтение фактических остатков";
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Остатки.Номенклатура КАК Номенклатура,
    | СУММА(Остатки.КоличествоОстаток) КАК Количество
    |ПОМЕСТИТЬ ВТ_Остатки
    |ИЗ РегистрНакопления.ПартииНоменклатуры.Остатки(
    | &Момент, Номенклатура В (&Каталог)
    | И МестоХранения В (
    |  ВЫБРАТЬ Склады.Ссылка ИЗ Справочник.Склады КАК Склады
    |  ГДЕ Склады.Владелец = &СЕ И НЕ Склады.ПометкаУдаления)) КАК Остатки
    |СГРУППИРОВАТЬ ПО Остатки.Номенклатура
    |;
    |ВЫБРАТЬ Товары.Ссылка КАК Номенклатура,
    | Товары.СтроковыйИдентификатор КАК Идентификатор,
    | Товары.Наименование КАК Наименование,
    | ЕСТЬNULL(Остатки.Количество, 0) КАК Количество
    |ИЗ Справочник.Номенклатура КАК Товары
    | ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК Остатки
    | ПО Товары.Ссылка = Остатки.Номенклатура
    |ГДЕ Товары.Ссылка В (&Каталог)
    |УПОРЯДОЧИТЬ ПО Количество, Номенклатура");
    Запрос.УстановитьПараметр("СЕ", СЕ);
    Запрос.УстановитьПараметр("Момент", ТекущаяДатаСеанса());
    Запрос.УстановитьПараметр("Каталог", Каталог);
    Результаты = Запрос.ВыполнитьПакет();
    ОстаткиДо = Результаты[Результаты.Количество() - 1].Выгрузить();
    Образцы = Новый Массив;
    Ссылки = Новый Массив;
    Минусов = 0; Нулей = 0; Плюсов = 0;
    Для Каждого Остаток Из ОстаткиДо Цикл
        Взять = Ложь;
        Если Остаток.Количество < 0 Тогда
            Минусов = Минусов + 1;
            Взять = Минусов <= 3;
        ИначеЕсли Остаток.Количество = 0 Тогда
            Нулей = Нулей + 1;
            Взять = Нулей = 1;
        Иначе
            Плюсов = Плюсов + 1;
            Взять = Плюсов = 1;
        КонецЕсли;
        Если Взять Тогда
            Образцы.Добавить(Остаток);
            Ссылки.Добавить(Остаток.Номенклатура);
        КонецЕсли;
    КонецЦикла;
    Сообщить("[2 ОК] В каталоге: минус=" + Строка(Минусов)
        + "; ноль=" + Строка(Нулей) + "; плюс=" + Строка(Плюсов));

    // 3. Используем реальный установленный сборщик, общий для Opera и PC.
    // Сериализация проверяет именно JSON-представление stock.quantity.
    Этап = "3. Формирование свежих карточек";
    Данные = КХ_ДанныеОпера.СформироватьСостояниеКаталога(СЕ, Ссылки);
    Если Данные.deleted_nomenclature_ids.Количество() > 0 Тогда
        ВызватьИсключение "Состав каталога изменился во время проверки; повторите этот алгоритм";
    КонецЕсли;
    СвежийJSON = КХ_ОбменШиныОпера.ВJSON(Данные);
    ИзJSON = КХ_ОбменШиныОпера.ИзJSON(СвежийJSON);
    Карточки = Новый Соответствие;
    Для Каждого Товар Из ИзJSON.products Цикл
        Ид = КХ_ОбменШиныОпера.СтроковоеПоле(Товар, "nomenclature_id");
        Если ПустаяСтрока(Ид) ИЛИ Карточки.Получить(Ид) <> Неопределено Тогда
            ВызватьИсключение "Пустой или повторяющийся nomenclature_id в свежих карточках";
        КонецЕсли;
        Карточки.Вставить(Ид, Товар);
    КонецЦикла;
    Сообщить("[3 ОК] Свежих карточек для сравнения: " + Строка(Карточки.Количество()));

    // 4. Повторное чтение отделяет изменение реального остатка от ошибки выгрузки.
    Этап = "4. Сравнение базы и JSON";
    Запрос.УстановитьПараметр("Момент", ТекущаяДатаСеанса());
    Запрос.УстановитьПараметр("Каталог", Ссылки);
    Результаты = Запрос.ВыполнитьПакет();
    ОстаткиПосле = Результаты[Результаты.Количество() - 1].Выгрузить();
    Проверено = 0; Ошибок = 0; Изменилось = 0; ПровереноМинусов = 0;
    Для Каждого Образец Из Образцы Цикл
        После = ОстаткиПосле.Найти(Образец.Номенклатура, "Номенклатура");
        Если После = Неопределено Тогда
            Изменилось = Изменилось + 1;
            Сообщить("[ПОВТОР] Товар исчез из выборки: " + Образец.Наименование);
            Продолжить;
        КонецЕсли;
        Если После.Количество <> Образец.Количество Тогда
            Изменилось = Изменилось + 1;
            Сообщить("[ПОВТОР] Остаток изменился: " + Образец.Наименование
                + " | было=" + Строка(Образец.Количество)
                + " | стало=" + Строка(После.Количество));
            Продолжить;
        КонецЕсли;
        Ид = СокрЛП(Строка(Образец.Идентификатор));
        Товар = Карточки.Получить(Ид);
        Попытка
            Если Товар = Неопределено Тогда
                ВызватьИсключение "Карточка отсутствует в результате сборщика";
            КонецЕсли;
            ОстатокJSON = Неопределено;
            Если НЕ Товар.Свойство("stock", ОстатокJSON) Тогда
                ВызватьИсключение "Отсутствует stock";
            КонецЕсли;
            КоличествоJSON = Неопределено;
            Если НЕ ОстатокJSON.Свойство("quantity", КоличествоJSON)
                ИЛИ ТипЗнч(КоличествоJSON) <> Тип("Строка") Тогда
                ВызватьИсключение "stock.quantity должен быть строкой";
            КонецЕсли;
            Сообщить("[4] " + Образец.Наименование + " | id=" + Ид);
            Сообщить("    В базе=" + Строка(Образец.Количество)
                + "; stock.quantity=" + КоличествоJSON);
            // Разбор числа через JSON не зависит от десятичного разделителя сеанса.
            КоличествоЧислом = КХ_ОбменШиныОпера.ИзJSON(КоличествоJSON);
            Если ТипЗнч(КоличествоЧислом) <> Тип("Число") Тогда
                ВызватьИсключение "stock.quantity не содержит десятичное число";
            КонецЕсли;
            Если КоличествоЧислом <> Окр(Макс(Образец.Количество, 0), 3) Тогда
                ВызватьИсключение "Выгруженный остаток отличается от ожидаемого";
            КонецЕсли;
            Если СтрДлина(КоличествоJSON) < 5
                ИЛИ Найти(КоличествоJSON, ".") <> СтрДлина(КоличествоJSON) - 3 Тогда
                ВызватьИсключение "Ожидалась точка и ровно три знака после неё";
            КонецЕсли;
            Для НомерСимвола = 1 По СтрДлина(КоличествоJSON) Цикл
                Если Найти("0123456789.", Сред(КоличествоJSON, НомерСимвола, 1)) = 0 Тогда
                    ВызватьИсключение "В stock.quantity есть недопустимые символы";
                КонецЕсли;
            КонецЦикла;
            Если Образец.Количество <= 0 И КоличествоJSON <> "0.000" Тогда
                ВызватьИсключение "Для отрицательного или нулевого остатка ожидалось 0.000";
            КонецЕсли;
            Проверено = Проверено + 1;
            Если Образец.Количество < 0 Тогда
                ПровереноМинусов = ПровереноМинусов + 1;
            КонецЕсли;
            Сообщить("    [ОК] Остаток и формат совпали");
        Исключение
            Ошибок = Ошибок + 1;
            Сообщить("[ОШИБКА] " + Образец.Наименование + " | " + ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;

    // 5. Успех проверки минуса требует хотя бы одного реального отрицательного остатка.
    Сообщить("[ИТОГ] Проверено=" + Строка(Проверено) + "; ошибок=" + Строка(Ошибок)
        + "; изменилось при чтении=" + Строка(Изменилось));
    Если Ошибок > 0 Тогда
        Сообщить("[НЕ ПРОЙДЕНО] Смотрите конкретные расхождения выше");
        Сообщить("Общий форматтер: КХ_ДанныеОпера.СформироватьДанныеОстатка");
    ИначеЕсли ПровереноМинусов = 0 Тогда
        Сообщить("[МИНУС НЕ ПРОВЕРЕН] В выборке не было стабильного отрицательного остатка");
    ИначеЕсли Изменилось > 0 Тогда
        Сообщить("[ЧАСТИЧНО] Минус -> 0.000 подтверждён; для изменившихся товаров повторите алгоритм");
    Иначе
        Сообщить("[ГОТОВО] Реальный минус -> 0.000 подтверждён; остальные выбранные остатки корректны");
    КонецЕсли;
    Сообщить("===== КОНЕЦ ПРОВЕРКИ ОСТАТКОВ =====");
Исключение
    Сообщить("[ОСТАНОВЛЕНО] Этап: " + Этап);
    Сообщить(ОписаниеОшибки());
КонецПопытки;
