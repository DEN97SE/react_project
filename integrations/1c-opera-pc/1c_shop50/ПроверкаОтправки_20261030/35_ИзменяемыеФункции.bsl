// Все три функции заменяются вместе в общем модуле КХ_ДанныеОпера.

Функция ПолучитьДанныеДляВыгрузки(СтруктурнаяЕдиница, МоментВыгрузки, НоменклатураОтбор)

	КБЖУ = ПолучитьСсылкуНаСвойстваОбъектов();

	// 03.11.2026: имена регистра и поля подтверждены конфигуратором.
	ТаблицаОсновныхШтрихКодов = "РегистрСведений.ОсновныеШтрихкоды";
	ИмяПоляДатыШК = "ДатаИВремяЗаписи";

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.СтроковыйИдентификатор КАК Идентификатор,
	|	Номенклатура.Наименование КАК Наименование,
	|	// {{ semidockij - 22.10.2026 - Наименование для ценника из свойства товара
	|	ЗначенияСвойствНаименованиеДляЦенника.Значение КАК НаименованиеДляЦенника,
	|	// }} semidockij - 22.10.2026
	|	Номенклатура.БазоваяЕдиницаИзмерения КАК БазоваяЕдиницаИзмерения,
	|	Номенклатура.БазоваяЕдиницаИзмерения.Наименование КАК НаименованиеБазовойЕдиницыИзмерения,
	|	Номенклатура.СтранаПроисхождения КАК СтранаПроисхождения,
	|	Номенклатура.СтранаПроисхождения.Наименование КАК НаименованиеСтраныПроисхождения,
	|	ЗначенияСвойствПроизводитель.Значение КАК Производитель,
	|	Номенклатура.Родитель КАК ГруппаНоменклатуры,
	|	Номенклатура.Родитель.Наименование КАК НаименованиеГруппыНоменклатуры,
	|	Номенклатура.Состав КАК Состав,
	|	ЗначенияСвойствТоваровБелки.Значение КАК Белки,
	|	ЗначенияСвойствТоваровЖиры.Значение КАК Жиры,
	|	ЗначенияСвойствТоваровУглеводы.Значение КАК Углеводы,
	|	ЗначенияСвойствТоваровЭнергетическаяЦенность.Значение КАК Ккал
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|	// {{ semidockij - 22.10.2026 - Предопределённое свойство, проверенное в базе
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствНаименованиеДляЦенника
	|		ПО Номенклатура.Ссылка = ЗначенияСвойствНаименованиеДляЦенника.Объект
	|			И ЗначенияСвойствНаименованиеДляЦенника.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.НаименованиеДляЦенника)
	|	// }} semidockij - 22.10.2026
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствПроизводитель
	|		ПО Номенклатура.Ссылка = ЗначенияСвойствПроизводитель.Объект
	|			И ЗначенияСвойствПроизводитель.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.Производитель)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствТоваров КАК ЗначенияСвойствТоваровБелки
	|		ПО Номенклатура.Ссылка = ЗначенияСвойствТоваровБелки.Объект
	|			И ЗначенияСвойствТоваровБелки.Свойство = &Белки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствТоваров КАК ЗначенияСвойствТоваровЖиры
	|		ПО Номенклатура.Ссылка = ЗначенияСвойствТоваровЖиры.Объект
	|			И ЗначенияСвойствТоваровЖиры.Свойство = &Жиры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствТоваров КАК ЗначенияСвойствТоваровУглеводы
	|		ПО Номенклатура.Ссылка = ЗначенияСвойствТоваровУглеводы.Объект
	|			И ЗначенияСвойствТоваровУглеводы.Свойство = &Углеводы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствТоваров КАК ЗначенияСвойствТоваровЭнергетическаяЦенность
	|		ПО Номенклатура.Ссылка = ЗначенияСвойствТоваровЭнергетическаяЦенность.Объект
	|			И ЗначенияСвойствТоваровЭнергетическаяЦенность.Свойство = &ЭнергетическаяЦенность
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И Номенклатура.Ссылка В (&НоменклатураОтбор)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ШтриховыеКоды.Номенклатура КАК Номенклатура,
	|	ШтриховыеКоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ШтриховыеКоды.ЕдиницаИзмерения.Наименование КАК НаименованиеЕдиницыИзмерения,
	|	ШтриховыеКоды.ШтрихКод КАК ШтрихКод,
	|	ШтриховыеКоды.ЕдиницаИзмерения.Коэффициент КАК КоличествоВУпаковке,
	|	ЕСТЬNULL(ШтриховыеКоды." + ИмяПоляДатыШК + ", ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаУстановки,
	|	ЕСТЬNULL(ОсновныеШтрихкоды.ШтрихКод, """") КАК ОсновнойШтрихКод,
	|	ВЫБОР
	|		КОГДА ШтриховыеКоды.ЕдиницаИзмерения.ЕдиницаПоКлассификатору = ВТ_Номенклатура.БазоваяЕдиницаИзмерения
	|			И ШтриховыеКоды.ЕдиницаИзмерения.Коэффициент = 1
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоБазоваяЕдиница
	|ПОМЕСТИТЬ ВТ_ШтрихКоды
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтриховыеКоды КАК ШтриховыеКоды
	|		ПО ВТ_Номенклатура.Номенклатура = ШтриховыеКоды.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ " + ТаблицаОсновныхШтрихКодов + " КАК ОсновныеШтрихкоды
	|		ПО ШтриховыеКоды.Номенклатура = ОсновныеШтрихкоды.Номенклатура
	|ГДЕ
	|	ШтриховыеКоды.ШтрихКод <> """"
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЦеныНоменклатурыСрезПоследних.Период КАК ПериодЦены,
	|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	|ПОМЕСТИТЬ ВТ_Цены
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			СтруктурнаяЕдиница = &СтруктурнаяЕдиница
	|				И КатегорияЦен = &КатегорияЦенСЕ) КАК ЦеныНоменклатурыСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ПО ЦеныНоменклатурыСрезПоследних.Номенклатура = ВТ_Номенклатура.Номенклатура
	|			И ЦеныНоменклатурыСрезПоследних.ЕдиницаИзмерения.ЕдиницаПоКлассификатору = ВТ_Номенклатура.БазоваяЕдиницаИзмерения
	|ГДЕ
	|	ЦеныНоменклатурыСрезПоследних.КатегорияЦен.ПометкаУдаления = ЛОЖЬ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РекламныеАкцииЦеныСрезПоследних.Номенклатура КАК Номенклатура,
	|	РекламныеАкцииЦеныСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	РекламныеАкцииЦеныСрезПоследних.Период КАК ДатаНачала,
	|	РекламныеАкцииЦеныСрезПоследних.ДатаОкончания КАК ДатаОкончания,
	|	РекламныеАкцииЦеныСрезПоследних.Цена КАК ЦенаАкции,
	|	РекламныеАкцииЦеныСрезПоследних.ВидРекламнойАкции КАК ВидРекламнойАкции,
	|	РекламныеАкцииЦеныСрезПоследних.Скидка КАК Скидка,
	|	РекламныеАкцииЦеныСрезПоследних.КоличествоМ КАК КоличествоМ,
	|	РекламныеАкцииЦеныСрезПоследних.КоличествоН КАК КоличествоН
	|ПОМЕСТИТЬ ВТ_Акции
	|ИЗ
	|	РегистрСведений.РекламныеАкцииЦены.СрезПоследних(
	|			&Период,
	|			СтруктурнаяЕдиница = &СтруктурнаяЕдиница
	|				И КатегорияЦен = &КатегорияЦенСЕ) КАК РекламныеАкцииЦеныСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ПО РекламныеАкцииЦеныСрезПоследних.Номенклатура = ВТ_Номенклатура.Номенклатура
	|			И РекламныеАкцииЦеныСрезПоследних.ЕдиницаИзмерения.ЕдиницаПоКлассификатору = ВТ_Номенклатура.БазоваяЕдиницаИзмерения
	|ГДЕ
	|	РекламныеАкцииЦеныСрезПоследних.Активность
	|	И РекламныеАкцииЦеныСрезПоследних.ТипРекламнойАкции = &ТипРекламнойАкцииНазначение
	|	И РекламныеАкцииЦеныСрезПоследних.ДатаОкончания >= &Период
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	ВТ_Номенклатура.Идентификатор КАК Идентификатор,
	|	ВТ_Номенклатура.Наименование КАК Наименование,
	|	// {{ semidockij - 22.10.2026 - Передача свойства в сборщик полной карточки
	|	ВТ_Номенклатура.НаименованиеДляЦенника КАК НаименованиеДляЦенника,
	|	// }} semidockij - 22.10.2026
	|	ВТ_Номенклатура.БазоваяЕдиницаИзмерения КАК БазоваяЕдиницаИзмерения,
	|	ВТ_Номенклатура.НаименованиеБазовойЕдиницыИзмерения КАК НаименованиеБазовойЕдиницыИзмерения,
	|	ВТ_Номенклатура.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ВТ_Номенклатура.НаименованиеСтраныПроисхождения КАК НаименованиеСтраныПроисхождения,
	|	ВТ_Номенклатура.Производитель КАК Производитель,
	|	ВТ_Номенклатура.ГруппаНоменклатуры КАК ГруппаНоменклатуры,
	|	ВТ_Номенклатура.НаименованиеГруппыНоменклатуры КАК НаименованиеГруппыНоменклатуры,
	|	ВТ_Номенклатура.Состав КАК Состав,
	|	ВТ_Номенклатура.Белки КАК Белки,
	|	ВТ_Номенклатура.Жиры КАК Жиры,
	|	ВТ_Номенклатура.Углеводы КАК Углеводы,
	|	ВТ_Номенклатура.Ккал КАК Ккал
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ШтрихКоды.Номенклатура КАК Номенклатура,
	|	ВТ_ШтрихКоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_ШтрихКоды.НаименованиеЕдиницыИзмерения КАК НаименованиеЕдиницыИзмерения,
	|	ВТ_ШтрихКоды.ШтрихКод КАК ШтрихКод,
	|	ВТ_ШтрихКоды.КоличествоВУпаковке КАК КоличествоВУпаковке,
	|	ВТ_ШтрихКоды.ДатаУстановки КАК ДатаУстановки,
	|	ВТ_ШтрихКоды.ОсновнойШтрихКод КАК ОсновнойШтрихКод,
	|	ВТ_ШтрихКоды.ЭтоБазоваяЕдиница КАК ЭтоБазоваяЕдиница
	|ИЗ
	|	ВТ_ШтрихКоды КАК ВТ_ШтрихКоды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Цены.Номенклатура КАК Номенклатура,
	|	ВТ_Цены.ПериодЦены КАК ПериодЦены,
	|	ВТ_Цены.Цена КАК Цена
	|ИЗ
	|	ВТ_Цены КАК ВТ_Цены
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Акции.Номенклатура КАК Номенклатура,
	|	ВТ_Акции.ДатаНачала КАК ДатаНачала,
	|	ВТ_Акции.ДатаОкончания КАК ДатаОкончания,
	|	ВТ_Акции.ЦенаАкции КАК ЦенаАкции,
	|	ВТ_Акции.ВидРекламнойАкции КАК ВидРекламнойАкции,
	|	ВТ_Акции.Скидка КАК Скидка,
	|	ВТ_Акции.КоличествоМ КАК КоличествоМ,
	|	ВТ_Акции.КоличествоН КАК КоличествоН
	|ИЗ
	|	ВТ_Акции КАК ВТ_Акции
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	ДатаНачала УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ПартииНоменклатуры.Остатки(
	|			&Период,
	|			Номенклатура В (&НоменклатураОтбор)) КАК Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
	|		ПО Остатки.МестоХранения = Склады.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ПО Остатки.Номенклатура = ВТ_Номенклатура.Номенклатура
	|ГДЕ
	|	Склады.Владелец = &СтруктурнаяЕдиница
	|	И НЕ Склады.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура";

	Запрос.УстановитьПараметр("КатегорияЦенСЕ", СтруктурнаяЕдиница.КатегорияЦенРозницы);
	Запрос.УстановитьПараметр("Белки", КБЖУ.Белки);
	Запрос.УстановитьПараметр("Жиры", КБЖУ.Жиры);
	Запрос.УстановитьПараметр("Углеводы", КБЖУ.Углеводы);
	Запрос.УстановитьПараметр("ЭнергетическаяЦенность", КБЖУ.Ккал);
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", СтруктурнаяЕдиница);
	Запрос.УстановитьПараметр("Период", МоментВыгрузки);
	Запрос.УстановитьПараметр("НоменклатураОтбор", НоменклатураОтбор);
	Запрос.УстановитьПараметр("ТипРекламнойАкцииНазначение", Справочники.ТипыРекламныхАкций.Назначение);

	РезультатыЗапроса = Запрос.ВыполнитьПакет();

	ТаблицаНоменклатуры = РезультатыЗапроса[4].Выгрузить();
	ТаблицаШтрихКодов = РезультатыЗапроса[5].Выгрузить();
	ТаблицаЦен = РезультатыЗапроса[6].Выгрузить();
	ТаблицаАкций = РезультатыЗапроса[7].Выгрузить();
	ТаблицаОстатков = РезультатыЗапроса[8].Выгрузить();

	Возврат Новый Структура("Номенклатура,ШтрихКоды,Цены,Акции,Остатки,МоментВыгрузки", ТаблицаНоменклатуры, ТаблицаШтрихКодов, ТаблицаЦен, ТаблицаАкций, ТаблицаОстатков, МоментВыгрузки);

КонецФункции

Функция ПодготовитьШтрихКоды(ТаблицаШтрихКодов)

	Результат = Новый Соответствие;
	ГруппыЕдиниц = Новый Соответствие;
	ПорядокЕдиниц = Новый Массив;

	Для Каждого СтрокаШК Из ТаблицаШтрихКодов Цикл

		ШтрихКод = СокрЛП(Строка(СтрокаШК.ШтрихКод));
		Если ПустаяСтрока(ШтрихКод) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаШК.ЕдиницаИзмерения) Тогда
			ВызватьИсключение "ШК не связан с единицей измерения: " + ШтрихКод;
		КонецЕсли;

		ЕдиницаГруппировки = СтрокаШК.ЕдиницаИзмерения;
		Если СтрокаШК.ЭтоБазоваяЕдиница Тогда
			// Для базовой единицы товара нужен один основной ШК из всех её вариантов.
			ЕдиницаГруппировки = "БазоваяЕдиница";
		КонецЕсли;
		КлючЕдиницы = ЗначениеВСтрокуВнутр(Новый Структура(
			"Номенклатура,Единица", СтрокаШК.Номенклатура, ЕдиницаГруппировки));
		Группа = ГруппыЕдиниц.Получить(КлючЕдиницы);
		Если Группа = Неопределено Тогда
			ОсновнойШК = СокрЛП(Строка(СтрокаШК.ОсновнойШтрихКод));
			Если СтрокаШК.ЭтоБазоваяЕдиница И ПустаяСтрока(ОсновнойШК) Тогда
				ВызватьИсключение "Для базовой единицы товара не установлен основной ШК: "
					+ Строка(СтрокаШК.Номенклатура);
			КонецЕсли;
			ТребуетсяОсновной = СтрокаШК.ЭтоБазоваяЕдиница;
			Группа = Новый Структура(
				"Номенклатура,Единица,ТребуетсяОсновной,ОсновнойШК,Строка,ДатаУстановки,ШтрихКод,Неоднозначно",
				СтрокаШК.Номенклатура, СтрокаШК.ЕдиницаИзмерения, ТребуетсяОсновной,
				ОсновнойШК, Неопределено, Дата(1, 1, 1), "", Ложь);
			ГруппыЕдиниц.Вставить(КлючЕдиницы, Группа);
			ПорядокЕдиниц.Добавить(КлючЕдиницы);
		КонецЕсли;

		// У базовой единицы установленный основной код имеет приоритет над датой.
		Если Группа.ТребуетсяОсновной И ШтрихКод <> Группа.ОсновнойШК Тогда
			Продолжить;
		КонецЕсли;

		Если Группа.Строка = Неопределено Тогда
			Группа.Строка = СтрокаШК;
			Группа.ДатаУстановки = СтрокаШК.ДатаУстановки;
			Группа.ШтрихКод = ШтрихКод;
		ИначеЕсли СтрокаШК.ДатаУстановки > Группа.ДатаУстановки Тогда
			Группа.Строка = СтрокаШК;
			Группа.ДатаУстановки = СтрокаШК.ДатаУстановки;
			Группа.ШтрихКод = ШтрихКод;
			Группа.Неоднозначно = Ложь;
		ИначеЕсли СтрокаШК.ДатаУстановки = Группа.ДатаУстановки
			И (ШтрихКод <> Группа.ШтрихКод
				Или СтрокаШК.ЕдиницаИзмерения <> Группа.Строка.ЕдиницаИзмерения) Тогда
			Группа.Неоднозначно = Истина;
		КонецЕсли;

	КонецЦикла;

	Для Каждого КлючЕдиницы Из ПорядокЕдиниц Цикл
		Группа = ГруппыЕдиниц.Получить(КлючЕдиницы);
		Если Группа.Строка = Неопределено Тогда
			ВызватьИсключение "Основной ШК " + Группа.ОсновнойШК
				+ " не связан с базовой единицей товара " + Строка(Группа.Номенклатура);
		КонецЕсли;
		Если Группа.Неоднозначно Тогда
			ВызватьИсключение "У разных ШК единицы " + Строка(Группа.Единица)
				+ " товара " + Строка(Группа.Номенклатура)
				+ " одинаковая последняя дата записи; нужен однозначный последний код";
		КонецЕсли;

		МассивШтрихКодов = Результат.Получить(Группа.Номенклатура);
		Если МассивШтрихКодов = Неопределено Тогда
			МассивШтрихКодов = Новый Массив;
			Результат.Вставить(Группа.Номенклатура, МассивШтрихКодов);
		КонецЕсли;
		МассивШтрихКодов.Добавить(СформироватьШтрихкод(Группа.Строка));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СформироватьШтрихкод(СтрокаШтрихКода)

	ШтрихКод = СокрЛП(Строка(СтрокаШтрихКода.ШтрихКод));

	Если ПустаяСтрока(ШтрихКод) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("barcode", ШтрихКод);

	// ID именно упаковки товара, а не общей единицы классификатора.
	Если ЗначениеЗаполнено(СтрокаШтрихКода.ЕдиницаИзмерения) Тогда
		Результат.Вставить("unit_id",
			Строка(СтрокаШтрихКода.ЕдиницаИзмерения.УникальныйИдентификатор()));
	КонецЕсли;

	Если НЕ ПустаяСтрока(СокрЛП(Строка(СтрокаШтрихКода.НаименованиеЕдиницыИзмерения))) Тогда
		Результат.Вставить("unit", Строка(СтрокаШтрихКода.НаименованиеЕдиницыИзмерения));
	КонецЕсли;

	Если ЕстьЗначениеДляJSON(СтрокаШтрихКода.КоличествоВУпаковке) Тогда
		Результат.Вставить("quantity_in_package", ФорматDecimalБезНулей(СтрокаШтрихКода.КоличествоВУпаковке));
	КонецЕсли;

	// Регистр ОсновныеШтрихкоды хранит код товара, без единицы измерения.
	ОсновнойШтрихКод = СокрЛП(Строка(СтрокаШтрихКода.ОсновнойШтрихКод));
	Результат.Вставить("is_primary", ШтрихКод = ОсновнойШтрихКод);
	Результат.Вставить("is_base_unit", СтрокаШтрихКода.ЭтоБазоваяЕдиница);

	Возврат Результат;

КонецФункции
