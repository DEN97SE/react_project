// Выполнить целиком в консоли50, затем410.
// Проба одной текущей full-порции внутри внешней транзакции с обязательным откатом.
// Сетевую отправку и новый full не вызывает. Пакеты/прогресс пробы не сохраняются.

ПробнаяТранзакция = Ложь;
Попытка
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Запустите проверку вне транзакции";
	КонецЕсли;
	Магазин = КХ_ОбменШиныОпера.ИдентификаторМагазина();
	Если Магазин = "3370588b-0742-11e0-b9c1-001a64c3f566" Тогда
		ИмяТестовойБазы = "AstorK50_Semidockiy";
	ИначеЕсли Магазин = "40933103-84ba-4d00-ab50-ce9efa15eda8" Тогда
		ИмяТестовойБазы = "Astor_k410_Semidockiy";
	Иначе
		ВызватьИсключение "Проверка подготовлена только для тестовых50 и410";
	КонецЕсли;
	СтрокаИБ = СтрЗаменить(НРег(СтрокаСоединенияИнформационнойБазы()), """", "") + ";";
	Если СтрНайти(СтрокаИБ, "ref=" + НРег(ИмяТестовойБазы) + ";") = 0 Тогда
		ВызватьИсключение "Имя ИБ не соответствует тестовой базе";
	КонецЕсли;

	Сообщить("===== ПРИЧИНА ОСТАНОВКИ ТЕКУЩЕЙ FULL-ПОРЦИИ =====");
	Сообщить("[БАЗА] " + ИмяТестовойБазы + "; store_id=" + Магазин);
	НачатьТранзакцию();
	ПробнаяТранзакция = Истина;
	Подготовлено = КХ_ОбменШиныОпера.ПодготовитьСледующийПолныйПакет();
	ОтменитьТранзакцию();
	ПробнаяТранзакция = Ложь;
	Если Подготовлено Тогда
		Сообщить("[ПРОБА ОК] Текущая порция подготовилась; изменения пробы отменены");
	Иначе
		Сообщить("[ПРОБА] Порция не зарегистрирована; активная сессия могла уже измениться");
	КонецЕсли;
	Сообщить("Новый full не запрашивался. Сетевая отправка проверкой не вызывалась");
Исключение
	Подробности = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	Если ПробнаяТранзакция И ТранзакцияАктивна() Тогда
		ОтменитьТранзакцию();
	КонецЕсли;
	Сообщить("[ПРИЧИНА ОСТАНОВКИ]");
	Сообщить(Подробности);
КонецПопытки;
