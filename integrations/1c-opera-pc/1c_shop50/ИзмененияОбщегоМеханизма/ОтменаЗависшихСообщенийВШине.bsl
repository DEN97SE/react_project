// Заменить только этот метод в Интеграция1СШина.
Процедура ОтменаЗависшихСообщенийВШине() Экспорт 
	
	КоличествоДнейОтправки = Константы.КоличествоДнейПовторнойОтправкиСообщенияВШину.Получить();
	Если Не ЗначениеЗаполнено(КоличествоДнейОтправки) Тогда
		Возврат;
	КонецЕсли;
	
	ПериодОтправки = НачалоДня(ТекущаяДатаСеанса()) - КоличествоДнейОтправки * 86400;
	
	СписокСтатусов = Новый Массив;
	СписокСтатусов.Добавить(Перечисления.СтатусыСообщенийШины.Ошибка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОчередьШины.ИдентификаторОбъекта КАК ИдентификаторОбъекта,
		|	ОчередьШины.Объект КАК Объект,
		|	ОчередьШины.УзелПолучатель КАК УзелПолучатель,
		|	ОчередьШины.КаналСервисаИнтеграции КАК КаналСервисаИнтеграции,
		|	ОчередьШины.ВнешняяСистема КАК ВнешняяСистема,
		|	ОчередьШины.СтроковыйОбъект КАК СтроковыйОбъект,
		|	ОчередьШины.ДатаРегистрации КАК ДатаРегистрации,
		|	ОчередьШины.ДатаОтправки КАК ДатаОтправки,
		|	ОчередьШины.ТекстОшибки КАК ТекстОшибки
		|ИЗ
		|	РегистрСведений.ОчередьШины КАК ОчередьШины
		|ГДЕ
		|	ОчередьШины.СтатусСообщения В(&СтатусСообщения)
		|	// {{ semidockij - 21.10.2026 - Исключение записей Оперы и ПрайсЧекеров из штатной обработки
		|	И НЕ (ОчередьШины.ВнешняяСистема В (&КХ_СобственныеСистемы))
		|	// }} semidockij - 21.10.2026
		|	И ОчередьШины.ДатаРегистрации < &ПериодОтправки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОчередьШины.СтатусСообщения,
		|	ОчередьШины.ДатаРегистрации
		|АВТОУПОРЯДОЧИВАНИЕ";

	Запрос.УстановитьПараметр("СтатусСообщения", СписокСтатусов);
	Запрос.УстановитьПараметр("ПериодОтправки", ПериодОтправки);
	
	// {{ semidockij - 21.10.2026 - Исключение записей Оперы и ПрайсЧекеров из штатной обработки
	Запрос.УстановитьПараметр("КХ_СобственныеСистемы", КХ_ОбменШиныОпера.СистемыСобственнойОчереди());
	// }} semidockij - 21.10.2026
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.ОчередьШины.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдентификаторОбъекта.Установить(Выборка.ИдентификаторОбъекта);
		НаборЗаписей.Отбор.УзелПолучатель.Установить(Выборка.УзелПолучатель);
		
		НоваяСтрока = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.СтатусСообщения = Перечисления.СтатусыСообщенийШины.Отменено;
		
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
КонецПроцедуры
