Процедура ОбработатьКвитанцию(ИдентификаторСообщения, ДатаЗагрузки, ТекстОшибки = "") Экспорт  
	
	Если ИдентификаторСообщения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДатаЗагрузки = Неопределено Тогда
		ДатаЗагрузки = Дата("00010101000000");
	КонецЕсли;

    // {{ ОсиповМВ - 12.08.2026 - #обход TLOCK
    Запрос = Новый Запрос("ВЫБРАТЬ
                          | ОчередьШины.ИдентификаторОбъекта КАК ИдентификаторОбъекта,
                          | ОчередьШины.ИдентификаторСообщения КАК ИдентификаторСообщения,
                          | ОчередьШины.КаналСервисаИнтеграции КАК КаналСервисаИнтеграции,
                          | ОчередьШины.УзелПолучатель КАК УзелПолучатель,
                          | ОчередьШины.ВнешняяСистема КАК ВнешняяСистема,
                          | ОчередьШины.Объект КАК Объект,
                          | ОчередьШины.ДатаРегистрации КАК ДатаРегистрации,
                          | ОчередьШины.ДатаОтправки КАК ДатаОтправки,
                          | ОчередьШины.СтроковыйОбъект КАК СтроковыйОбъект
                          |ИЗ
                          | РегистрСведений.ОчередьШины КАК ОчередьШины
                          |ГДЕ
                          | ОчередьШины.ИдентификаторСообщения = &ИдентификаторСообщения
		|	// {{ semidockij - 21.10.2026 - Исключение записей Оперы и ПрайсЧекеров из штатной обработки
		|	И НЕ (ОчередьШины.ВнешняяСистема В (&КХ_СобственныеСистемы))
		|	// }} semidockij - 21.10.2026
		|	");
    
       
    Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщения);   
    
	// {{ semidockij - 21.10.2026 - Исключение записей Оперы и ПрайсЧекеров из штатной обработки
	Запрос.УстановитьПараметр("КХ_СобственныеСистемы", КХ_ОбменШиныОпера.СистемыСобственнойОчереди());
	// }} semidockij - 21.10.2026
    Результат = Запрос.Выполнить();

    Если Не Результат.Пустой() Тогда
        
        РезультатДетальныеЗаписи = Результат.Выбрать();   
        РезультатДетальныеЗаписи.Следующий();
        
        мз = РегистрыСведений.ОчередьШины.СоздатьМенеджерЗаписи();   
        
        мз.ИдентификаторОбъекта = РезультатДетальныеЗаписи.ИдентификаторОбъекта;
        мз.ИдентификаторСообщения = РезультатДетальныеЗаписи.ИдентификаторСообщения;
        мз.КаналСервисаИнтеграции = РезультатДетальныеЗаписи.КаналСервисаИнтеграции;
        мз.УзелПолучатель = РезультатДетальныеЗаписи.УзелПолучатель;
        мз.ВнешняяСистема = РезультатДетальныеЗаписи.ВнешняяСистема;
        мз.Объект  = РезультатДетальныеЗаписи.Объект;
        мз.ДатаРегистрации  = РезультатДетальныеЗаписи.ДатаРегистрации;
        мз.ДатаОтправки = РезультатДетальныеЗаписи.ДатаОтправки;
        мз.СтроковыйОбъект = РезультатДетальныеЗаписи.СтроковыйОбъект;
        
        мз.ТекстОшибки = ТекстОшибки;
        мз.ДатаЗагрузки = ДатаЗагрузки;
        
        Если Не ПустаяСтрока(ТекстОшибки) Тогда
            мз.СтатусСообщения  = Перечисления.СтатусыСообщенийШины.Ошибка;
        Иначе                       
            мз.СтатусСообщения  = Перечисления.СтатусыСообщенийШины.ДоставкаПодтверждена;
        КонецЕсли;
        
        мз.Записать(); 
        
    КонецЕсли; 
    // }} ОсиповМВ - 12.08.2026 - #обход TLOCK	КонецПроцедуры     
	
КонецПроцедуры
