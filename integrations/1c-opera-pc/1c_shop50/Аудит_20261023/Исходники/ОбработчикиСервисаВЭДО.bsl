// {{ ОсиповМВ - 29.05.2024 - #обработка ошибки приема 
Процедура ОтправитьСобытиеСерверуМониторинга(ИмяТриггера, Ошибка = Ложь) 
	  
	Таймаут = 10;
	Статус = 1;
	Если Ошибка Тогда
		Статус = 0;
	КонецЕсли;
	
	Попытка
		
		Соединение = Новый HTTPСоединение("zabbix.sm-komandor.ru", 80, , , , Таймаут);
		АдресЗапроса = "/zabbix-share/zabbix_sender/index.php?server=" + Нрег(ИмяКомпьютера()) + "&key=" + ИмяТриггера + "&value=" + Формат(Статус, "ЧН=");
		Запрос = Новый HTTPЗапрос(АдресЗапроса);
	 	Соединение.Записать(Запрос);

	Исключение
		
		ТекстОшибки = ОписаниеОшибки();
		
	КонецПопытки;
	
КонецПроцедуры
