
Процедура УниверсальнаяОбработкаПолученияСообщения(Сообщение, Отказ, КаналОтправкиКвитанции, ТриггерZabbix)

 	СобытиеЖурналаРегистрации = "Сервисы интеграции.ЗагрузкаВЭДО";
    ТекстСообщения = "Обрабатывается сообщение ID:" + Сообщение.Идентификатор + Символы.ВК + "  От : "
    + Сообщение.КодОтправителя;
    ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрации, УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
    
    Попытка
        
        РазмерСообщения = Сообщение.Параметры.Получить("РазмерСообщения");
        Если РазмерСообщения <> Неопределено Тогда
            РазмерБуфера = Число(РазмерСообщения);
        Иначе
            РазмерБуфера = 1024;
        КонецЕсли;
        
        Тело = Новый БуферДвоичныхДанных(0);
        Буфер = Новый БуферДвоичныхДанных(РазмерБуфера);
        Поток = Сообщение.ПолучитьТелоКакПоток();
        
        Пока Истина Цикл
            
            Прочитано = Поток.Прочитать(Буфер, 0, РазмерБуфера);
            Если Прочитано > 0 Тогда
                Тело = Тело.Соединить(Буфер);
            КонецЕсли;
            
            Если Прочитано < РазмерБуфера Тогда
                Прервать;
            КонецЕсли;  
            
        КонецЦикла;
        
        ВходящееСообщение = ПолучитьСтрокуИзБуфераДвоичныхДанных(Тело, КодировкаТекста.ANSI);
        
        // определяем типсообщения и выполняем обработку согласно команде
        ТипСообщения = Сообщение.Параметры.Получить("ТипСообщения");
        ОтправлятьОтветнуюКвитанцию = Истина;
        
        Если ТипСообщения = "receipt" Тогда // пришла квитанция
            
            ИдентификаторСообщения = Сообщение.Параметры.Получить("ИдентификаторСообщения");  
            ДатаЗагрузки = Сообщение.Параметры.Получить("ДатаЗагрузки");
            Интеграция1СШина.ОбработатьКвитанцию(ИдентификаторСообщения, ДатаЗагрузки, ВходящееСообщение);
            ОтправлятьОтветнуюКвитанцию = Ложь;
            СобытиеЖурналаРегистрации = "Сервисы интеграции.ЗагрузкаВЭДО";
            ТекстСообщения = "Загрузили сообщение ID(квитанция):" + Сообщение.Идентификатор
            + " от : " + Сообщение.КодОтправителя;
            ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрации, УровеньЖурналаРегистрации.Информация, , , ТекстСообщения); 
            
        Иначе
            
            РезультатЗагрузки = ОбменДаннымиЧерезСервисыИнтеграции.ЗагрузкаВходящегоСообщения(ТипСообщения, ВходящееСообщение); // возвращает структуру. поля Результат - булево, ТекстОшибки - текст
            
            Если РезультатЗагрузки.Результат = Ложь Тогда
                СобытиеЖурналаРегистрации = "Сервисы интеграции.ЗагрузкаВЭДО";
                ТекстСообщения = "Ошибка при обработке сообщения ID:" + Сообщение.Идентификатор
                + " от : " + Сообщение.КодОтправителя + "." + РезультатЗагрузки.ТекстОшибки;
                ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрации, УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения); 
            Иначе     
                СобытиеЖурналаРегистрации = "Сервисы интеграции.ЗагрузкаВЭДО";
                ТекстСообщения = "Загрузили сообщение ID:" + Сообщение.Идентификатор
                + " от : " + Сообщение.КодОтправителя;
                ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрации, УровеньЖурналаРегистрации.Информация, , , ТекстСообщения); 
            КонецЕсли;
            
        КонецЕсли;                                                                                                             
        
        // отправить квитанцию в систему отправителя
        Если ОтправлятьОтветнуюКвитанцию Тогда
            
            Интеграция1СШина.ОтправитьКвитанцию(Сообщение.КодОтправителя, Сообщение.Идентификатор, КаналОтправкиКвитанции, РезультатЗагрузки.ТекстОшибки);
            СобытиеЖурналаРегистрации = "Сервисы интеграции.ЗагрузкаВЭДО";
            ТекстСообщения = "Отправили квитанцию на сообщение ID:" + Сообщение.Идентификатор
            + " от : " + Сообщение.КодОтправителя;
            ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрации, УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
            
        КонецЕсли;  
        
        Если ТриггерZabbix <> "1C_bus_vedo_internal_load"  Тогда
            ОтправитьСобытиеСерверуМониторинга(ТриггерZabbix); // {{ ОсиповМВ - 29.05.2024 - #обработка ошибки приема}}
        КонецЕсли;
        
        
    Исключение
        
        Отказ = Истина;
        СобытиеЖурналаРегистрации = "Сервисы интеграции.ЗагрузкаВЭДО";
        ТекстСообщения = ОписаниеОшибки() + ". Не удалось обработать сообщение ID:" + Сообщение.Идентификатор
        + " от : " + Сообщение.КодОтправителя;
        ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрации, УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения); 
        ОтправитьСобытиеСерверуМониторинга(ТриггерZabbix, Истина); // {{ ОсиповМВ - 29.05.2024 - #обработка ошибки приема}}
        
	КонецПопытки;
	
КонецПроцедуры

