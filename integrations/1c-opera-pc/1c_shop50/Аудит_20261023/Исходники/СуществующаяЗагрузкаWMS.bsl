#Область СлужебныйПрограммныйИнтерфейс
//&НаСервере
Процедура ОбработатьВходящиеСообщенияОтШины(КодОтправителя, ПараметрыОбменаУзлаПолучателя = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
        |   Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С.ИдентификаторСообщения КАК ИдентификаторСообщения,
        |   Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С.КодОтправителя КАК КодОтправителя,
        |   Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С.КодПолучателя КАК КодПолучателя,
        |   Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С.НомерСообщенияВПланеОбмена КАК НомерСообщенияВПланеОбмена,
        |   Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С.ТекстСообщения КАК ТекстСообщения,
        |   Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С.ТипФайла КАК ТипФайла
        |ИЗ
        |   РегистрСведений.Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С КАК Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С
        |ГДЕ
        |   Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С.Обработано = ЛОЖЬ
        |   И Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С.ОтменитьЗагрузкуСообщения = ЛОЖЬ
        |   И Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С.КодОтправителя = &КодОтправителя
        |ИТОГИ ПО
        |   КодОтправителя";
	
	Если КодОтправителя = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С.КодОтправителя = &КодОтправителя", "");
	Иначе
		Запрос.УстановитьПараметр("КодОтправителя", Лев(СокрЛП(КодОтправителя), 20)); // Длина реквизита всего 20 символов
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();  
    
    Если РезультатЗапроса.Пустой() Тогда
        
        Если Не КодОтправителя = Неопределено И Не ПараметрыОбменаУзлаПолучателя = Неопределено Тогда
            
            ОтправитьСобытиеСерверуМониторинга("Sync_in_astor_rc");
            УдалитьУстаревшиеВходящиеСообщения(ПараметрыОбменаУзлаПолучателя, КодОтправителя);	
            
        КонецЕсли;
        
    Иначе
	
        ВыборкаКодОтправителя = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
        
        Пока ВыборкаКодОтправителя.Следующий() Цикл
            
            Если ПараметрыОбменаУзлаПолучателя = Неопределено Тогда
                
                ПараметрыОбменаУзлаПолучателя = ПараметрыУзлаОбменаПолучателя(ВыборкаКодОтправителя.КодОтправителя);
                
            КонецЕсли;
            
            Если ПараметрыОбменаУзлаПолучателя.ВключитьОбменЧерезШину1С = Ложь
                Или ПараметрыОбменаУзлаПолучателя.ОстановитьЗагрузкуСообщенийИзШины = Истина Тогда
                
                Продолжить;
                
            КонецЕсли;
            
            ВыборкаДетальныеЗаписи = ВыборкаКодОтправителя.Выбрать(); 
            
            Если ВыборкаКодОтправителя.Количество() = 0 Тогда
                
                ОтправитьСобытиеСерверуМониторинга("Sync_in_astor_rc");
                УдалитьУстаревшиеВходящиеСообщения(ПараметрыОбменаУзлаПолучателя, ВыборкаКодОтправителя.КодОтправителя);
                
            Иначе	
                
                Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
                    
                    СтруктураСообщения = Новый Структура;
                    СтруктураСообщения.Вставить("Обработано", Ложь);
                    СтруктураСообщения.Вставить("ИдентификаторСообщения", ВыборкаДетальныеЗаписи.ИдентификаторСообщения);
                    СтруктураСообщения.Вставить("КодОтправителя", ВыборкаДетальныеЗаписи.КодОтправителя);
                    СтруктураСообщения.Вставить("КодПолучателя", ВыборкаДетальныеЗаписи.КодПолучателя);
                    СтруктураСообщения.Вставить("ТекстСообщения", ВыборкаДетальныеЗаписи.ТекстСообщения);
                    СтруктураСообщения.Вставить("ОшибкаЗагрузки", Ложь);
                    СтруктураСообщения.Вставить("ТекстОшибки", ""); 
					// {{ Хаданович Роман - 17.09.2025 - Доработки Обмена Астор - WMS
					СтруктураСообщения.Вставить("НомерСообщенияВПланеОбмена", ВыборкаДетальныеЗаписи.НомерСообщенияВПланеОбмена);
					// }} Хаданович Роман - 17.09.2025 - Доработки Обмена Астор - WMS
                    
                    ТипФайла = Нрег(СокрЛП(ВыборкаДетальныеЗаписи.ТипФайла)); 
                    Если ТипФайла = "xml" Тогда
                        
                        Если ОбработатьВходящееСообщениеОтАстор(СтруктураСообщения, ПараметрыОбменаУзлаПолучателя) = Истина Тогда
                            
                            Прервать; // Останавливаем загрузку сообщений от этого узла, пока не разберутся с ошибкой
                            
                        КонецЕсли;   
                        
                    Иначе	
                        Если ТипФайла = "json" Тогда
                            
                            ЗагрузитьКвитанциюОтБазыПолучателя(СтруктураСообщения);	
                            
                        КонецЕсли;
                    КонецЕсли;
                    
                КонецЦикла;
            КонецЕсли;
            
            УдалитьУстаревшиеВходящиеСообщения(ПараметрыОбменаУзлаПолучателя, ВыборкаКодОтправителя.КодОтправителя);
            
        КонецЦикла; 
    КонецЕсли;
	
КонецПроцедуры // ОбработатьВходящиеСообщенияОтШины

// Может вызваться из формы записи РС Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С
//&НаСервере
Функция ОбработатьВходящееСообщениеОтАстор(СтруктураСообщения, ПараметрыОбменаУзлаПолучателя = Неопределено) Экспорт
	
	Если ПараметрыОбменаУзлаПолучателя = Неопределено Тогда
		
		ПараметрыОбменаУзлаПолучателя = ПараметрыУзлаОбменаПолучателя(СтруктураСообщения.КодОтправителя);
		
	КонецЕсли;
	
	ИмяСобытияМониторинга = Неопределено;
	ПараметрыОбменаУзлаПолучателя.Свойство("ИмяСобытияМониторингаПриемПакета", ИмяСобытияМониторинга);
	УзелОбмена = Неопределено;
	ПараметрыОбменаУзлаПолучателя.Свойство("УзелОбмена", УзелОбмена);
	
	#Если Клиент Тогда
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загружаем на Клиенте пакет для узла " + СокрЛП(УзелОбмена));
	СтруктураСообщения.Вставить("ОписаниеСпособаЗагрузкиПакета", "Клиент: " + СокрЛП(ТекущаяДата()));
	#Иначе
	СтруктураСообщения.Вставить("ОписаниеСпособаЗагрузкиПакета", "Сервер: " + СокрЛП(ТекущаяДатаСеанса()));
	#КонецЕсли
    
    Если Не ЗначениеЗаполнено(УзелОбмена) Тогда
        
        ТекстОшибки = "Не заданы настройки для кода отправителя: " + СокрЛП(СтруктураСообщения.КодОтправителя);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
        // {{ Хаданович Роман - 26.09.2024 - Перевод Обмена WMS - Астор с FTP на 1С Шину. Алыев Т.С.
        СтруктураСообщения.ОшибкаЗагрузки = Истина;
		СтруктураСообщения.ТекстОшибки = ТекстОшибки;   
        ЗаписатьИзмененияЗаписиВходящегоСообщения(СтруктураСообщения);
        // }} Хаданович Роман - 26.09.2024 - Перевод Обмена WMS - Астор с FTP на 1С Шину. Алыев Т.С.
        
		Возврат Истина;
		
	КонецЕсли;
    
	Если ПараметрыОбменаУзлаПолучателя.ОстановитьЗагрузкуСообщенийИзШины = Истина Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В настройках узла остановлена загрузка входящих сообщений из Шины");
		Возврат Истина;
		
	КонецЕсли;
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьТекста = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(СтруктураСообщения.ТекстСообщения);
	ЗаписьТекста.Закрыть();
	
	УниверсальныйОбменДаннымиXML = Обработки.Командор_УниверсальныйОбменДаннымиXML.Создать();
	УниверсальныйОбменДаннымиXML.ИмяФайлаОбмена = ВременныйФайл;
	УниверсальныйОбменДаннымиXML.РежимОбмена = "Загрузка"; 

    ИмяФайлаПротоколаОбмена = ПолучитьИмяВременногоФайла("txt"); 
    УниверсальныйОбменДаннымиXML.ИмяФайлаПротоколаОбмена = ИмяФайлаПротоколаОбмена;
	
	// {{ Хаданович Роман - 17.09.2025 - Доработки Обмена Астор - WMS
	УниверсальныйОбменДаннымиXML.ВыводВПротоколСообщенийОбОшибках = Истина;
	// }} Хаданович Роман - 17.09.2025 - Доработки Обмена Астор - WMS 
	
	// {{ Хаданович Роман - 21.10.2025 - Доработки Обмена Астор - WMS
	ДанныеБуфера = Новый Структура;
	ДанныеБуфера.Вставить("НомерСообщенияВПланеОбмена", СтруктураСообщения.НомерСообщенияВПланеОбмена);
	ДанныеБуфера.Вставить("УзелОбмена", УзелОбмена); 
	
	ОбщегоНазначения.СкопироватьВБуферОбмена(ДанныеБуфера, "ОбменВмс_Астор");
	
	// {{ Хаданович Роман - 13.01.2026 //итлОбменЛогистика.ПоместитьСообщениеВБуферОбмена("Старт загрузки");
	// }} Хаданович Роман - 21.10.2025 - Доработки Обмена Астор - WMS
		
    Попытка
        
        УниверсальныйОбменДаннымиXML.ВыполнитьЗагрузку();                
        
        СтруктураСообщения.ОшибкаЗагрузки = УниверсальныйОбменДаннымиXML.ФлагОшибки;   
        СтруктураСообщения.Обработано = Не УниверсальныйОбменДаннымиXML.ФлагОшибки;
		Если УниверсальныйОбменДаннымиXML.ФлагОшибки = Истина Тогда
			
			мФайлПротоколаДанных = Новый ЧтениеТекста(ИмяФайлаПротоколаОбмена, КодировкаТекста.ANSI);
			ТекстОшибкиОтЗагрузчикаXML = СокрЛП(мФайлПротоколаДанных.Прочитать()); 
			Если СтруктураСообщения.ТекстОшибки = "" Тогда   
				
				СтруктураСообщения.ТекстОшибки = ТекстОшибкиОтЗагрузчикаXML; 
				
			Иначе
				
				СтруктураСообщения.ТекстОшибки = СтруктураСообщения.ТекстОшибки + Символы.ПС + ТекстОшибкиОтЗагрузчикаXML;
				
			КонецЕсли;
			
			// +++tymko 22.12.2017 #
			ОтправитьСобытиеСерверуМониторинга("Sync_in_astor_rc", Ложь);
			// ---tymko 22.12.2017 # 
			
			// {{ Хаданович Роман - 12.09.2025 - Доработки Обмена Астор - WMS  
			ОписаниеУзла = СтрШаблон("Узел обмена = %1 (Код отправителя = %2)", СокрЛП(УзелОбмена), СокрЛП(СтруктураСообщения.КодОтправителя));
			ТекстСообщения = "Ошибка при загрузке вх пакета: " + СокрЛП(СтруктураСообщения.ИдентификаторСообщения) + " Текст ошибки " + СокрЛП(ТекстОшибкиОтЗагрузчикаXML);
			ЛогированиеКлиентСервер.ЗафиксироватьВGrayLogВызовМетода("ОбменАстор_ВМС", "РегистрСведений", "Кх_ВходящиеСообщенияОтАсторИзШины1С", "ОбработатьВходящееСообщениеОтАстор", ОписаниеУзла, ТекущаяДатаСеанса(), ТекстСообщения);
			
			СтруктураСообщения2 = Новый Структура;
			СтруктураСообщения2.Вставить("ТекстСообщения", ТекстОшибкиОтЗагрузчикаXML); 
			СтруктураСообщения2.Вставить("Комментарий",    "Ошибка загрузки XML в Обработке УниверсальныйОбменДаннымиXML");
			СоздатьЗаписьВКх_ЛогированиеОбменаАстор_ВМС(УзелОбмена, СтруктураСообщения.НомерСообщенияВПланеОбмена, СтруктураСообщения2);
			
			мФайлПротоколаДанных.Закрыть();
			// }} Хаданович Роман - 12.09.2025 - Доработки Обмена Астор - WMS
			
		Иначе
			// +++tymko 22.12.2017 #
			ОтправитьСобытиеСерверуМониторинга("Sync_in_astor_rc");
			// ---tymko 22.12.2017 # 
			
			//// {{ Хаданович Роман - 17.09.2025 - Доработки Обмена Астор - WMS
			//мФайлПротоколаДанных = Новый ЧтениеТекста(ИмяФайлаПротоколаОбмена, КодировкаТекста.ANSI);
			//ТекстОшибкиОтЗагрузчикаXML = СокрЛП(мФайлПротоколаДанных.Прочитать());
			//СтруктураСообщения2 = Новый Структура;
			//СтруктураСообщения2.Вставить("ТекстСообщения", ТекстОшибкиОтЗагрузчикаXML); 
			//СтруктураСообщения2.Вставить("Комментарий",    "Сообщения загрузки XML в Обработке УниверсальныйОбменДаннымиXML");
			//СоздатьЗаписьВКх_ЛогированиеОбменаАстор_ВМС(УзелОбмена, СтруктураСообщения.НомерСообщенияВПланеОбмена, СтруктураСообщения2);
			//// }} Хаданович Роман - 17.09.2025 - Доработки Обмена Астор - WMS
			
		КонецЕсли;  
		
		// {{ Хаданович Роман - 21.10.2025 - Доработки Обмена Астор - WMS
		ПеренестиСообщенияИзБуфераВРегистрЛогирования(); 
		// }} Хаданович Роман - 21.10.2025 - Доработки Обмена Астор - WMS
        
        СтруктураСообщения.Вставить("ЗагруженоОбъектов", УниверсальныйОбменДаннымиXML.мСчетчикЗагруженныхОбъектов);    
        
	Исключение
		
		// {{ ОсиповМВ - 12.04.2021 - #Запись ошибки в ЖР
		ТекстОшибки = ОписаниеОшибки();
		ТекстСообщения = СтрШаблон("Ошибка при загрузке пакета от %1. %2", Строка(УзелОбмена), ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		// +++tymko 22.12.2017 #
		ОтправитьСобытиеСерверуМониторинга("Sync_in_astor_rc", Ложь);
		// ---tymko 22.12.2017 #
		СтруктураСообщения.ОшибкаЗагрузки = Истина;
		СтруктураСообщения.ТекстОшибки = ТекстОшибки; 
		
		// {{ Хаданович Роман - 12.09.2025 - Доработки Обмена Астор - WMS  
		ОписаниеУзла = СтрШаблон("Узел обмена = %1 (Код отправителя = %2)", СокрЛП(УзелОбмена), СокрЛП(СтруктураСообщения.КодОтправителя));
		ЛогированиеКлиентСервер.ЗафиксироватьВGrayLogВызовМетода("ОбменАстор_ВМС", "РегистрСведений", "Кх_ВходящиеСообщенияОтАсторИзШины1С", "ОбработатьВходящееСообщениеОтАстор", ОписаниеУзла, ТекущаяДатаСеанса(), ТекстСообщения);
		// }} Хаданович Роман - 12.09.2025 - Доработки Обмена Астор - WMS 
		
		// {{ Хаданович Роман - 01.11.2025 - Доработки Обмена Астор - WMS
		СтруктураСообщения2 = Новый Структура;
		СтруктураСообщения2.Вставить("ТекстСообщения", ТекстСообщения); 
		СтруктураСообщения2.Вставить("Комментарий",    "Ошибка загрузки XML в Попытке Исключении Обработке УниверсальныйОбменДаннымиXML");
		СоздатьЗаписьВКх_ЛогированиеОбменаАстор_ВМС(УзелОбмена, СтруктураСообщения.НомерСообщенияВПланеОбмена, СтруктураСообщения2);
		// }} Хаданович Роман - 01.11.2025 - Доработки Обмена Астор - WMS
		
	КонецПопытки;   
	
	ЗаписатьИзмененияЗаписиВходящегоСообщения(СтруктураСообщения);
    УдалитьФайлы(ВременныйФайл); 
	
	// {{ Хаданович Роман - 22.10.2025 - Доработки Обмена Астор - WMS 
	// Если процедура отработала выше, то буфер уже пустой и ничего не запишется в Лог
	ПеренестиСообщенияИзБуфераВРегистрЛогирования(); 
	// }} Хаданович Роман - 22.10.2025 - Доработки Обмена Астор - WMS
	
КонецФункции // ОбработатьВходящееСообщениеОтАстор

//&НаСервере
Процедура ЗагрузитьСообщенияПоУзлуОбмена(УзелОбмена, ПараметрыОбменаУзлаПолучателя = Неопределено) Экспорт
	
	Если ПараметрыОбменаУзлаПолучателя = Неопределено Тогда
		
		ПараметрыОбменаУзлаПолучателя = ПараметрыУзлаОбменаПолучателя(Неопределено, УзелОбмена);
		
	КонецЕсли;
	
	Если ПараметрыОбменаУзлаПолучателя.ВключитьОбменЧерезШину1С = Ложь
		Или ПараметрыОбменаУзлаПолучателя.ОстановитьЗагрузкуСообщенийИзШины = Истина Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В настройках узла " + СокрЛП(УзелОбмена) + " остановлена загрузка входящих сообщений из Шины");
		Возврат;
	КонецЕсли;
	
	ОбработатьВходящиеСообщенияОтШины(ПараметрыОбменаУзлаПолучателя.КодУзлаWMSЛогистика, ПараметрыОбменаУзлаПолучателя);
	
КонецПроцедуры // ЗагрузитьСообщенияПоУзлуОбмена()

//&НаСервере
Функция ПараметрыУзлаОбменаПолучателя(КодУзлаWMSЛогистика, УзелОбмена = Неопределено) Экспорт
	
	ПараметрыОбмена = Новый Структура;
	ПараметрыОбмена.Вставить("ВключитьОбменЧерезШину1С", Ложь);
	ПараметрыОбмена.Вставить("СрокХранениеСообщенияПослеПолученияКвитанции", 0);
	ПараметрыОбмена.Вставить("СрокХранениеВходящихСообщения", 0);
	ПараметрыОбмена.Вставить("ОстановитьЗагрузкуСообщенийИзШины", Истина);
	ПараметрыОбмена.Вставить("УзелОбмена", Неопределено);
	ПараметрыОбмена.Вставить("КодУзлаWMSЛогистика", Неопределено); // нужен когда передают УзелОбмена
	ПараметрыОбмена.Вставить("КодУзлаАстор", Неопределено); // нужен при отправке
	ПараметрыОбмена.Вставить("ОстановитьЗагрузкуСообщенийСFTP", Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|   Кх_НастройкиОбменаАстор_ВМС.УзелОбмена КАК УзелОбмена,
		|   Кх_НастройкиОбменаАстор_ВМС.ВключитьОбменЧерезШину1С КАК ВключитьОбменЧерезШину1С,
		|   Кх_НастройкиОбменаАстор_ВМС.СрокХранениеСообщенияПослеПолученияКвитанции КАК СрокХранениеСообщенияПослеПолученияКвитанции,
		|   Кх_НастройкиОбменаАстор_ВМС.ОстановитьЗагрузкуСообщенийИзШины КАК ОстановитьЗагрузкуСообщенийИзШины,
		|   Кх_НастройкиОбменаАстор_ВМС.КодУзлаWMSЛогистика КАК КодУзлаWMSЛогистика,
		|   Кх_НастройкиОбменаАстор_ВМС.ОстановитьЗагрузкуСообщенийСFTP КАК ОстановитьЗагрузкуСообщенийСFTP,
		|   Кх_НастройкиОбменаАстор_ВМС.КодУзлаАстор КАК КодУзлаАстор,
		|   Кх_НастройкиОбменаАстор_ВМС.СрокХранениеВходящихСообщения КАК СрокХранениеВходящихСообщения
		|ИЗ
		|   РегистрСведений.Кх_НастройкиОбменаАстор_ВМС КАК Кх_НастройкиОбменаАстор_ВМС
		|ГДЕ
		|   Кх_НастройкиОбменаАстор_ВМС.КодУзлаWMSЛогистика = &КодУзлаWMSЛогистика";
	
	Если ЗначениеЗаполнено(УзелОбмена) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Кх_НастройкиОбменаАстор_ВМС.КодУзлаWMSЛогистика = &КодУзлаWMSЛогистика", "Кх_НастройкиОбменаАстор_ВМС.УзелОбмена = &УзелОбмена");
		Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
	Иначе
		Если СокрЛП(КодУзлаWMSЛогистика) = "" Тогда
			
			Возврат ПараметрыОбмена;
			
		КонецЕсли;
		Запрос.УстановитьПараметр("КодУзлаWMSЛогистика", Лев(СокрЛП(КодУзлаWMSЛогистика), 20)); // Длина реквизита всего 20 символов
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ПараметрыОбмена, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
	Возврат ПараметрыОбмена;
	
КонецФункции // НастройкиУзлаОбменаПолучателя()

//&НаСервере
Процедура ЗагрузитьКвитанциюОтБазыПолучателя(ЗаписьВходящая) Экспорт
	
