		ПараметрыСообщения.Вставить("ТекстСообщения", ТекстОшибкиДляЛога);
		ПараметрыСообщения.Вставить("Комментарий", "Квитанция");
		СоздатьЗаписьВКх_ЛогированиеОбменаАстор_ВМС(Неопределено, 0, ПараметрыСообщения);
		// }} Хаданович Роман - 01.11.2025 - Доработки Обмена Астор - WMS 
		
		// {{ Хаданович Роман - 03.12.2025
		ПометитьКвитанциюОбработанной(ЗаписьВходящая, 0, ТекстОшибкиДляЛога);
		// }} Хаданович Роман - 03.12.2025

