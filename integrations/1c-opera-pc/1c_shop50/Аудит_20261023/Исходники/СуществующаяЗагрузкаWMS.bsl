			ПараметрыСообщения.Вставить("Комментарий", "Квитанция");
			ПараметрыСообщения.Вставить("НомерСообщенияВПланеОбмена", НомерСообщенияВПланеОбмена);
			СоздатьЗаписьВКх_ЛогированиеОбменаАстор_ВМС(УзелОбмена, НомерСообщенияВПланеОбмена, ПараметрыСообщения);
