	Попытка
		
		СтруктураСообщения = СтрокаJsonВСтруктуруСДатами(ЗаписьВходящая.ТекстСообщения, МассивДат);
		
	Исключение
		
		ТекстОшибки = ОписаниеОшибки();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки); 
		
