КонецПроцедуры // ЗагрузитьКвитанциюОтБазыПолучателя()  

//&НаСервере
Функция ОтправитьКвитанциюВБазуПолучателя(СтруктураСообщения) Экспорт
	
	Если СтруктураСообщения.Обработано = Истина
		Или СтруктураСообщения.ОтменитьЗагрузкуСообщения = Истина Тогда
		
		СервисИнтеграции = "ExchangeAstor_WMS";
		КаналИнтеграции = "Основной_Exchange_FromAstor";
		// меняем местами отправителя и получателя
		КодОтправителя = СтруктураСообщения.КодПолучателя; // "wms_tb"
		КодПолучателя = СтруктураСообщения.КодОтправителя; // "astor100"
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ТипФайла", "JSON");
		ТипСообщения = "КвитанцияОПолученииСообщения";
		
		СтруктураКвитанции = Новый Структура;
		СтруктураКвитанции.Вставить("КодУзлаАстор", СокрЛП(СтруктураСообщения.КодПолучателя));
		
		// {{ Хаданович Роман - 27.10.2025 - Доработки Обмена Астор - WMS 
		ИдентификаторСообщения = СокрЛП(СтруктураСообщения.ИдентификаторСообщения);
		Если СтрЗаканчиваетсяНа(ИдентификаторСообщения, "_О") Тогда
		
			ДлинаСтроки = СтрДлина(ИдентификаторСообщения); 
			
			ИдентификаторСообщения = Лев(ИдентификаторСообщения, ДлинаСтроки - 2);
		
		КонецЕсли;
		// }} Хаданович Роман - 27.10.2025 - Доработки Обмена Астор - WMS
		
		СтруктураКвитанции.Вставить("ИдентификаторСообщения", ИдентификаторСообщения);
		СтруктураКвитанции.Вставить("НомерСообщенияВПланеОбмена", СокрЛП(СтруктураСообщения.НомерСообщенияВПланеОбмена));
		СтруктураКвитанции.Вставить("ДатаВремяОбработкиЗагрузки", СтруктураСообщения.ДатаВремяОбработкиЗагрузки);
		
		ТекстСообщения = ПреобразоватьСтруктуруВСтрокуJson(СтруктураКвитанции);
		
		Результат = Интеграция1СШина.ОтправитьИсходящееСообщениеВШину(СервисИнтеграции, КаналИнтеграции, ТипСообщения, КодОтправителя, ТекстСообщения, КодПолучателя, ДополнительныеПараметры);
		
		Возврат Результат; 
    Иначе
        
        Возврат Новый Структура("ЕстьОшибки", Истина);
	КонецЕсли;
	
КонецФункции // ОтправитьКвитанциюВБазуПолучателя
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура ОтправитьСобытиеСерверуМониторинга(ИмяСобытия, РезультатСобытия = Истина, ТекстСообщения = "") Экспорт
	
    Если РезультатСобытия = Истина Тогда
        
        РезультатСобытияТекст = "1";
    Иначе
        РезультатСобытияТекст = "0";
        
    КонецЕсли;   
    
	Попытка
		Соединение = Новый HTTPСоединение("zabbix.sm-komandor.ru", 80);
		АдресЗапроса = "/zabbix-share/zabbix_sender/index.php?server=" + Нрег(ИмяКомпьютера()) + "&key=" + ИмяСобытия + "&value=" + РезультатСобытияТекст;
		Запрос = Новый HTTPЗапрос(АдресЗапроса);
		Соединение.Записать(Запрос);
	Исключение
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось отправить запрос на zabbix.sm-komandor.ru");
		
	КонецПопытки;
	
КонецПроцедуры

//&НаСервере
Процедура ЗаписатьИзмененияЗаписиВходящегоСообщения(СтруктураСообщения)
	
	ИдентификаторСообщения = СокрЛП(СтруктураСообщения.ИдентификаторСообщения);
	КодОтправителя = СокрЛП(СтруктураСообщения.КодОтправителя);
		
	СтруктураСообщения.Вставить("ДатаВремяОбработкиЗагрузки", ТекущаяДатаСеанса()); // для передачи дальше в квитанцию
	Если СтруктураСообщения.Свойство("НомерСообщенияВПланеОбмена") = Ложь Тогда
		
		СтруктураСообщения.Вставить("НомерСообщенияВПланеОбмена", 0); // для передачи дальше в квитанцию	
		
	КонецЕсли;
	СтруктураСообщения.Вставить("ОтменитьЗагрузкуСообщения", Ложь); // для передачи дальше в квитанцию   
	
	ЗаписьРС = РегистрыСведений.Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С.СоздатьМенеджерЗаписи();
	ЗаписьРС.ИдентификаторСообщения = ИдентификаторСообщения;
	ЗаписьРС.КодОтправителя         = КодОтправителя;    
	
	ЗаписьРС.Прочитать();
	
	ЗаписьРС.ИдентификаторСообщения = ИдентификаторСообщения;
	ЗаписьРС.КодОтправителя  = КодОтправителя;
	ЗаписьРС.ДатаВремяОбработкиЗагрузки = ТекущаяДатаСеанса();
	ЗаписьРС.Обработано = СтруктураСообщения.Обработано;
	ЗаписьРС.ОшибкаЗагрузки = СтруктураСообщения.ОшибкаЗагрузки;  
	
	// {{ Хаданович Роман - 27.10.2025 - Доработки Обмена Астор - WMS
	Если Не СокрЛП(СтруктураСообщения.ТекстОшибки) = "" Тогда
		
		Если ЗаписьРС.ТекстОшибки = "" Тогда
		
			ЗаписьРС.ТекстОшибки = СтруктураСообщения.ТекстОшибки;
			
		Иначе
			
			ЗаписьРС.ТекстОшибки = ЗаписьРС.ТекстОшибки + Символы.ПС + "=== ДОБАВЛЕНО ПОЗЖЕ ===" + Символы.ПС + СтруктураСообщения.ТекстОшибки;
		
		КонецЕсли;	
		
	КонецЕсли;
	// }} Хаданович Роман - 27.10.2025 - Доработки Обмена Астор - WMS
	  
	СтруктураСообщения.Свойство("ЗагруженоОбъектов", ЗаписьРС.ЗагруженоОбъектов);
	
	СтруктураСообщения.НомерСообщенияВПланеОбмена = ЗаписьРС.НомерСообщенияВПланеОбмена; // для передачи дальше в квитанцию
	СтруктураСообщения.ОтменитьЗагрузкуСообщения  = ЗаписьРС.ОтменитьЗагрузкуСообщения; // для передачи дальше в квитанцию
	
	Результат = ОтправитьКвитанциюВБазуПолучателя(СтруктураСообщения);
	Если Результат.ЕстьОшибки = Ложь Тогда
		
		ЗаписьРС.ИдентификаторКвитанции = Результат.ИдентификаторСообщения;
		
	КонецЕсли;     
	
	Если ЗаписьРС.ОшибкаЗагрузки = Истина И Не СтрЗаканчиваетсяНа(ЗаписьРС.ИдентификаторСообщения, "_О") Тогда
		
		ЗаписьРС.ИдентификаторСообщения = ИдентификаторСообщения + "_О"; // Чтобы не затерлось при повторной загрузке из Шины	
		
	КонецЕсли;
	
	ЗаписьРС.Записать();
	
КонецПроцедуры // ЗаписатьИзмененияЗаписиВходящегоСообщения

//&НаСервере
Функция ПреобразоватьСтруктуруВСтрокуJson(ВхСтруктура)
	
	НастройкаСериализацииJSON = Новый НастройкиСериализацииJSON;
	НастройкаСериализацииJSON.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;
	НастройкаСериализацииJSON.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	
	тЗаписьJSON = Новый ЗаписьJSON;
	тПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, " ", Истина);
	тЗаписьJSON.УстановитьСтроку(тПараметрыJSON);
	ЗаписатьJSON(тЗаписьJSON, ВхСтруктура, НастройкаСериализацииJSON);
	strJSON = тЗаписьJSON.Закрыть();
	Возврат strJSON;
	
КонецФункции

//&НаСервере
Функция СтрокаJsonВСтруктуруСДатами(ТелоЗапроса, массивДат)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
	
	СтруктураJson = ПрочитатьJSON(ЧтениеJSON, , массивДат, ФорматДатыJSON.ISO);
	ЧтениеJSON.Закрыть();
	
	Возврат СтруктураJson;
	
КонецФункции

//&НаСервере
Процедура УдалитьУстаревшиеВходящиеСообщения(ПараметрыОбмена, КодОтправителя)
    
    СекундВСутках = 86400;
	ДатаУдаленияСообщений = НачалоДня(ТекущаяДата()) - (ПараметрыОбмена.СрокХранениеВходящихСообщения * СекундВСутках);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
        |   Кх_ВходящиеСообщенияОтВМСЛОгистикаИзШины1С.ИдентификаторСообщения КАК ИдентификаторСообщения,
        |   Кх_ВходящиеСообщенияОтВМСЛОгистикаИзШины1С.КодОтправителя КАК КодОтправителя
        |ИЗ
        |   РегистрСведений.Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С КАК Кх_ВходящиеСообщенияОтВМСЛОгистикаИзШины1С
        |ГДЕ
        |   Кх_ВходящиеСообщенияОтВМСЛОгистикаИзШины1С.ДатаОтправки <= &ДатаУдаленияСообщений
        |   И Кх_ВходящиеСообщенияОтВМСЛОгистикаИзШины1С.КодОтправителя = &КодОтправителя
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |   Кх_ВходящиеСообщенияОтВМСЛОгистикаИзШины1С.ИдентификаторСообщения КАК ИдентификаторСообщения,
        |   Кх_ВходящиеСообщенияОтВМСЛОгистикаИзШины1С.КодОтправителя КАК КодОтправителя
        |ИЗ
        |   РегистрСведений.Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С КАК Кх_ВходящиеСообщенияОтВМСЛОгистикаИзШины1С
        |ГДЕ
        |   Кх_ВходящиеСообщенияОтВМСЛОгистикаИзШины1С.ДатаОтправки > &ДатаУдаленияСообщений
        |   И Кх_ВходящиеСообщенияОтВМСЛОгистикаИзШины1С.КодОтправителя = &КодОтправителя";
	
	Запрос.УстановитьПараметр("ДатаУдаленияСообщений", ДатаУдаленияСообщений);
	Запрос.УстановитьПараметр("КодОтправителя", СокрЛП(КодОтправителя));
    
    РезультатЗапроса = Запрос.ВыполнитьПакет();
    
	РезультатЗапросаПоОстающимсяЗаписям = РезультатЗапроса[1]; 
    
    Если Не РезультатЗапросаПоОстающимсяЗаписям.Пустой() Тогда
        
        // Старые записи удаляем, только если останутся новые записи, чтобы была история
        ВыборкаДетальныеЗаписи = РезультатЗапроса[0].Выбрать();
        
        Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
            НаборЗаписей = РегистрыСведений.Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С.СоздатьНаборЗаписей();
            НаборЗаписей.Отбор.ИдентификаторСообщения.Установить(ВыборкаДетальныеЗаписи.ИдентификаторСообщения);
            НаборЗаписей.Отбор.КодОтправителя.Установить(ВыборкаДетальныеЗаписи.КодОтправителя); 
            НаборЗаписей.Записать();
        КонецЦикла;
    КонецЕсли;
    
КонецПроцедуры // УдалитьУстаревшиеСообщения

Процедура СоздатьЗаписьВКх_ЛогированиеОбменаАстор_ВМС(УзелОбмена, НомерСообщенияВПланеОбмена, СтруктураСообщения)
	
	ТекстСообщения = Неопределено;
	СтруктураСообщения.Свойство("ТекстСообщения", ТекстСообщения);
	
	Комментарий = Неопределено;
	СтруктураСообщения.Свойство("Комментарий", Комментарий);
	
	ТекДата = ТекущаяДатаСеанса();
	Идентификатор = СокрЛП(Новый УникальныйИдентификатор);
	
	НаборЗаписей = РегистрыСведений.Кх_ЛогированиеОбменаАстор_ВМС.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(ТекДата);
	НаборЗаписей.Отбор.НаправлениеСообщения.Установить(Перечисления.Кх_НаправлениеСообщения.Входящее);
	НаборЗаписей.Отбор.УзелОбмена.Установить(УзелОбмена);
	НаборЗаписей.Отбор.Идентификатор.Установить(Идентификатор);
	НаборЗаписей.Отбор.НомерСообщенияВПланеОбмена.Установить(НомерСообщенияВПланеОбмена);
	
	ЗаписьРС = НаборЗаписей.Добавить();
	
	ЗаписьРС.Период = ТекДата;
	ЗаписьРС.НаправлениеСообщения = Перечисления.Кх_НаправлениеСообщения.Входящее;
	ЗаписьРС.УзелОбмена = УзелОбмена;
	ЗаписьРС.Идентификатор = Идентификатор;
	ЗаписьРС.НомерСообщенияВПланеОбмена = НомерСообщенияВПланеОбмена;
	ЗаписьРС.СсылкаНаОбъект = Неопределено;   
	
	ЗаписьРС.ТекстСообщения = СокрЛП(ТекстСообщения);
	
	// {{ Хаданович Роман - 01.11.2025 - Доработки Обмена Астор - WMS
	ЗаписьРС.Комментарий  = Комментарий;
	// }} Хаданович Роман - 01.11.2025 - Доработки Обмена Астор - WMS
	
	НаборЗаписей.ДополнительныеСвойства.Вставить("РазрешенаЗаписьВКх_ЛогированиеОбменаАстор_ВМС", Истина);
	НаборЗаписей.Записать();
	
КонецПроцедуры 

Процедура ПеренестиСообщенияИзБуфераВРегистрЛогирования()
	
	БуферОбмена = ОбщегоНазначения.СтрокиИзБуфераОбмена(); 
	
	Если БуферОбмена.Источник = "ОбменВмс_Астор" Тогда
		
		ДанныеБуфера = БуферОбмена.Данные;
		
		Если ТипЗнч(ДанныеБуфера) = Тип("Структура") Тогда
			
			МассивСообщений = Неопределено;
			ДанныеБуфера.Свойство("МассивСообщений",  МассивСообщений);
			Если ТипЗнч(МассивСообщений) = Тип("Массив") Тогда
				
				НомерСообщенияВПланеОбмена = Неопределено;
				УзелОбмена = Неопределено;
				
				ДанныеБуфера.Свойство("НомерСообщенияВПланеОбмена", НомерСообщенияВПланеОбмена);
				ДанныеБуфера.Свойство("УзелОбмена",                 УзелОбмена);
				
				// {{ Хаданович Роман - 13.01.2026
				ТекстСообщенияДляРегистраЛогирования = "";
				КомментарийДляРегистраЛогирования = "";
				// }} Хаданович Роман - 13.01.2026
				
				Для каждого СтруктураСообщения Из МассивСообщений Цикл
					
					Если ТипЗнч(СтруктураСообщения) = Тип("Структура") Тогда  
						
						ТекстСообщения = СокрЛП(СтруктураСообщения.ТекстСообщения);
						Если Не ТекстСообщения = "" Тогда
							
							ТекстСообщенияДляРегистраЛогирования = ТекстСообщенияДляРегистраЛогирования + ТекстСообщения + Символы.ПС;
							
							Если Не СокрЛП(СтруктураСообщения.Комментарий) = "" Тогда
								
								КомментарийДляРегистраЛогирования = КомментарийДляРегистраЛогирования + СокрЛП(СтруктураСообщения.Комментарий) + Символы.ПС;    
								
							КонецЕсли;
							
						КонецЕсли;
						// }} Хаданович Роман - 13.01.2026
						
					КонецЕсли;
					
				КонецЦикла; 
				
				// {{ Хаданович Роман - 13.01.2026 				
				Идентификатор = СокрЛП(Новый УникальныйИдентификатор);
				
				НаборЗаписей = РегистрыСведений.Кх_ЛогированиеОбменаАстор_ВМС.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Период.Установить(СтруктураСообщения.ТекДата);
				НаборЗаписей.Отбор.НаправлениеСообщения.Установить(Перечисления.Кх_НаправлениеСообщения.Входящее);
				НаборЗаписей.Отбор.УзелОбмена.Установить(УзелОбмена);
				НаборЗаписей.Отбор.Идентификатор.Установить(Идентификатор);
				НаборЗаписей.Отбор.НомерСообщенияВПланеОбмена.Установить(НомерСообщенияВПланеОбмена);
				
				ЗаписьРС = НаборЗаписей.Добавить();
				
				ЗаписьРС.Период = СтруктураСообщения.ТекДата;
				ЗаписьРС.НаправлениеСообщения = Перечисления.Кх_НаправлениеСообщения.Входящее;
				ЗаписьРС.УзелОбмена = УзелОбмена;
				ЗаписьРС.Идентификатор = Идентификатор;
				ЗаписьРС.НомерСообщенияВПланеОбмена = НомерСообщенияВПланеОбмена;
				ЗаписьРС.СсылкаНаОбъект = Неопределено;
				ЗаписьРС.Комментарий    = КомментарийДляРегистраЛогирования;
				
				ЗаписьРС.ТекстСообщения = ТекстСообщенияДляРегистраЛогирования; 
				
				НаборЗаписей.ДополнительныеСвойства.Вставить("РазрешенаЗаписьВКх_ЛогированиеОбменаАстор_ВМС", Истина);
				НаборЗаписей.Записать();  
				// }} Хаданович Роман - 13.01.2026
				
			КонецЕсли;
			
		КонецЕсли;
		
		// Очистим буфер обмена
		ОбщегоНазначения.СкопироватьВБуферОбмена(Неопределено, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПометитьКвитанциюОбработанной(ЗаписьВходящая, НомерСообщенияВПланеОбмена = 0, ТекстОшибки = "")
	
	// Теперь помечаем саму квитанцию как обработанной
	НаборЗаписейВходящие = РегистрыСведений.Кх_ВходящиеСообщенияОтВМСЛогистикаИзШины1С.СоздатьНаборЗаписей();
	НаборЗаписейВходящие.Отбор.ИдентификаторСообщения.Установить(ЗаписьВходящая.ИдентификаторСообщения);
	НаборЗаписейВходящие.Отбор.КодОтправителя.Установить(ЗаписьВходящая.КодОтправителя); 
	
	ТекДата = ТекущаяДата();
	НаборЗаписейВходящие.Прочитать(); 
	Для каждого ЗаписьВходящаяИзНабора Из НаборЗаписейВходящие Цикл
		
		ЗаписьВходящаяИзНабора.ДатаВремяОбработкиЗагрузки = ТекДата;
		ЗаписьВходящаяИзНабора.Обработано = Истина; // чтобы больше к ней не возвращаться    
		
		Если НомерСообщенияВПланеОбмена > 0 Тогда
			
			ЗаписьВходящаяИзНабора.НомерСообщенияВПланеОбмена = НомерСообщенияВПланеОбмена;	
			
		КонецЕсли;
		
		Если Не СокрЛП(ТекстОшибки) = "" Тогда
		
			ЗаписьВходящаяИзНабора.ОшибкаЗагрузки = Истина;
			
			Если СокрЛП(ЗаписьВходящаяИзНабора.ТекстОшибки) = "" Тогда
				
				ЗаписьВходящаяИзНабора.ТекстОшибки = СокрЛП(ТекстОшибки);
				
			Иначе
				
				ЗаписьВходящаяИзНабора.ТекстОшибки = ЗаписьВходящаяИзНабора.ТекстОшибки + Символы.ПС + "==== Добавлено позже ====" + СокрЛП(ТекстОшибки) = "";
				
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЦикла;
	
	НаборЗаписейВходящие.Записать();
	
КонецПроцедуры

#КонецОбласти