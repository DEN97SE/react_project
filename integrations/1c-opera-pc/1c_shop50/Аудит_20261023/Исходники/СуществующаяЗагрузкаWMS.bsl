	СтруктураСообщения.Свойство("ИдентификаторСообщения", ИдентификаторСообщения);
	
	КодПолучателяИзТелаСообщения = Неопределено;
	СтруктураСообщения.Свойство("КодУзлаWMSЛогистика", КодПолучателяИзТелаСообщения); 
	
	// {{ Хаданович Роман - 01.11.2025 - Доработки Обмена Астор - WMS
	УзелОбмена = Неопределено;
	// }} Хаданович Роман - 01.11.2025 - Доработки Обмена Астор - WMS
	
	Если Не (НомерСообщенияВПланеОбмена = Неопределено
		Или НомерСообщенияВПланеОбмена = 0
		Или СокрЛП(КодПолучателяИзТелаСообщения) = "") Тогда
		
		Попытка
			
			НашлиНужнуюВходящуюЗапись = Ложь;
			НаборЗаписей = РегистрыСведений.Кх_ИсходящиеСообщенияДляВМСЛогистикаЧерезШину1С.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.КодПолучателя.Установить(КодПолучателяИзТелаСообщения);
			НаборЗаписей.Отбор.НомерСообщенияВПланеОбмена.Установить(НомерСообщенияВПланеОбмена);
			
			НаборЗаписей.Прочитать();
			Для каждого Запись Из НаборЗаписей Цикл
				
				Если СтрНачинаетсяС(ИдентификаторСообщения, СокрЛП(Запись.ИдентификаторСообщенияШины)) Тогда
					
					Запись.ДатаВремяЗагрузкиВПолучателя = СтруктураСообщения.ДатаВремяОбработкиЗагрузки;
					НашлиНужнуюВходящуюЗапись = ЗначениеЗаполнено(Запись.ДатаВремяЗагрузкиВПолучателя);
					// Важно! Здесь очищаются изменения в плане обмена. Чтобы не копились, т.к. в той базе-корреспонденте они уже загружены, 
					// а удастся ли и когда загрузить следующее сообщение в формате XML не понятно. В квитанции это произойдет оперативнее
					// Если не получится очистить изменения здесь, то вторая попытка будет при получении следующего входящего сообщения XML от базы-корреспондента
					ПланыОбмена.УдалитьРегистрациюИзменений(Запись.УзелОбмена, НомерСообщенияВПланеОбмена); // НомерОтправленногоРанееСообщения 
					
