		Исключение
			
			// Отмена транзакции здесь приводит к отмене транзакции по загрузке сообщения из Шины и в канале остаются незагруженных Сообщения
			ТекстСообщения = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("ЗагрузкаДанных", УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения); 
			
			// {{ Хаданович Роман - 01.11.2025 - Доработки Обмена Астор - WMS
			ПараметрыСообщения = Новый Структура;
