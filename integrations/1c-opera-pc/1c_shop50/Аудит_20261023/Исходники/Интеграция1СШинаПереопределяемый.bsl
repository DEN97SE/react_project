// Переопределяемы методы для сервиса интеграции 

#Область СлужебныйПрограммныйИнтерфейс

// отправляет данные в шину, для каждого типа
// учетной системы, его надо переопределить
Функция ОтправитьСообщениеВШину(Данные, Узлы, КаналСервисаИнтеграции, ДополнительныеПараметрыЗаголовкаСообщения = "") Экспорт 
	
	КодТекущегоУзла = КодТекущегоУзлаВШине();  
	Если ПустаяСтрока(КодТекущегоУзла) Тогда
		ВызватьИсключение "Не задан код системы в 1С:Шине";
	КонецЕсли;
	
	Возврат Интеграция1СШина.ОтправитьИсходящееСообщениеВШину("СервисИнтеграцииВЭДО",
		КаналСервисаИнтеграции, 
		Данные.ТипСообщения, КодТекущегоУзла, Данные.Данные, Узлы, ДополнительныеПараметрыЗаголовкаСообщения
	);

КонецФункции

// Код текущего узла
// Возвращаемое значение:
// Код текущей узла текущей информационной системы в шине, тип строка
Функция КодТекущегоУзлаВШине() 
	
	СЕ = ОбщиеПроцедурыИФункцииПовтИсп.ТекущаяСтруктурнаяЕдиница();
	
	Код = "astor" + Строка(СЕ.Код);      
	Возврат Код;

КонецФункции

#КонецОбласти	