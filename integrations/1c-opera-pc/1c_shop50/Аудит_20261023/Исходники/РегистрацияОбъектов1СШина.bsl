
#Область ОбработчикиПодписокНаСобытие

// Обработчик при записи объекта Справочник
//	Параметры:
//		Источник - СправочникСсылка
//      Отказ - Булево - Флаг отказа записи, по умолчанию Ложь
//
Процедура РегистрацияСправочниковВ1сШину_ПриЗаписи(Источник, Отказ = Ложь) Экспорт
	
	Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Источник)) Тогда
		ЭтоСсылкаСправочника = Истина;
		СсылкаНаОбъект = Источник;
		ОбменДаннымиЗагрузка = Ложь;
	Иначе
		ЭтоСсылкаСправочника = Ложь;
		СсылкаНаОбъект = Источник.Ссылка;   		
		ОбменДаннымиЗагрузка = Источник.ОбменДанными.Загрузка;
	КонецЕсли;
	
	Если Отказ ИЛИ ОбменДаннымиЗагрузка Тогда
		Возврат;
	КонецЕсли; 

	ЗарегистрироватьСправочникВОчередь(СсылкаНаОбъект);
	
КонецПроцедуры                               

// Обработчик при записи объекта Документ
//	Параметры:
//		Источник - ДокументСсылка
//      Отказ - Булево - Флаг отказа записи, по умолчанию Ложь
//
Процедура РегистрацияДокументовВ1сШину_ПриЗаписи(Источник, Отказ = Ложь) Экспорт
	
	Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Источник)) Тогда
		СсылкаНаОбъект = Источник;
		ОбменДаннымиЗагрузка = Ложь;
	Иначе
		СсылкаНаОбъект = Источник.Ссылка;
		ОбменДаннымиЗагрузка = Источник.ОбменДанными.Загрузка;
	КонецЕсли;
	
	Если Отказ ИЛИ ОбменДаннымиЗагрузка Тогда
		Возврат;
	КонецЕсли;	
	
	ЗарегистрироватьДокументВОчередь(СсылкаНаОбъект);

КонецПроцедуры
 
// Обработчик при записи Набора Регистра сведений
//	Параметры:
//		Источник - Набор записей регистра сведений
//      Отказ - Булево - Флаг отказа записи, по умолчанию Ложь
//      Замещение - Булево - Флаг режима записи набора, 
//      	Истина запись осуществляется с заменой существующих в базе данных записей набора.
Процедура РегистрацияЗаписейРегистровСведенийВ1сШину_ПриЗаписи(Источник, Отказ, Замещение) Экспорт

	Если Отказ Или Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ЗарегистрироватьРегистрСведенийВОчередь(Источник); 
		
КонецПроцедуры

#КонецОбласти                

#Область РегистрацияВОчередь

Процедура ЗарегистрироватьСправочникВОчередь(Источник)
	
	Если ТипЗнч(Источник) = Тип("СправочникСсылка.Склады")
		ИЛИ ТипЗнч(Источник) = Тип("СправочникСсылка.СтруктурныеЕдиницы") Тогда
		
		Если Не ЗначениеЗаполнено(Источник.GLN) Тогда
			Возврат;
		КонецЕсли;
		
		Если ТипЗнч(Источник) = Тип("СправочникСсылка.СтруктурныеЕдиницы") Тогда
			Владелец = Источник;
		Иначе
			Владелец = Источник.Владелец;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Владелец) 
			ИЛИ Владелец = Справочники.СтруктурныеЕдиницы.СобственноеПроизводство Тогда
			
			Возврат;
		КонецЕсли;
		
		Узлы = УзлыВыгрузкиВЭДО_АСТОР();
		КаналСервисаИнтеграции = КаналВыгрузкиАбонентам();
		Для Каждого Узел Из Узлы Цикл
			Интеграция1СШина.ЗарегистрироватьОбъектВОчереди(Источник, Узел, КаналСервисаИнтеграции);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗарегистрироватьДокументВОчередь(Источник)
	
	ДокументыДляВЭДО = Новый Массив;
	ДокументыДляВЭДО.Добавить(Метаданные.Документы.ЭлектроннаяТранспортнаяНакладная);
	ДокументыДляВЭДО.Добавить(Метаданные.Документы.Заказ);
	ДокументыДляВЭДО.Добавить(Метаданные.Документы.РасходнаяНакладная);
	ДокументыДляВЭДО.Добавить(Метаданные.Документы.ПриходнаяНакладная);
	ДокументыДляВЭДО.Добавить(Метаданные.Документы.ВозвратнаяНакладная);
	ДокументыДляВЭДО.Добавить(Метаданные.Документы.ПриходнаяНакладнаяEDI);
	// {{ kraevav - 05.09.2025 - # Краснокутский Н.Н. Доработка обмена между 1С Астор и УПП СП
	ДокументыДляВЭДО.Добавить(Метаданные.Документы.ПредварительныйЗаказ);
	// }} kraevav - 05.09.2025 - # Краснокутский Н.Н. Доработка обмена между 1С Астор и УПП СП
	
	// Обработаем документ в зависимости от типа
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Источник));
	Если ДокументыДляВЭДО.Найти(ОбъектМетаданных) <> Неопределено Тогда
		
		Если ОбъектМетаданных = Метаданные.Документы.Заказ Тогда
			Если НЕ ЗначениеЗаполнено(Источник.СтруктурнаяЕдиница.GLN) Тогда // централизованные заказы ЦО
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ЗарегистрироватьДокументДляВЭДО(Источник);	
	КонецЕсли;
	
КонецПроцедуры     

Процедура ЗарегистрироватьРегистрСведенийВОчередь(Источник)

	СтруктураЗаписиРегистра = Новый Структура;
	СтруктураЗаписиРегистра.Вставить("ИмяРегистра", Источник.Метаданные().Имя);  
	Для Каждого ЭлементОтбора Из Источник.Отбор Цикл
		СтруктураЗаписиРегистра.Вставить(ЭлементОтбора.Имя, ЭлементОтбора.Значение);
	КонецЦикла;
	
	КаналСервисаИнтеграции = КаналВыгрузкиАбонентам();
	ОбъектОбмена = ЗначениеВСтрокуВнутр(СтруктураЗаписиРегистра);
	
	Узлы = УзлыВыгрузкиВЭДО_АСТОР();
	Если ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.СтатусыЭлектронныхТранспортныхНакладных") Тогда
		Идентификатор = "StatusETRN" + Формат(СтруктураЗаписиРегистра.Период, "ДФ=yyMMddHHmmss") + СтруктураЗаписиРегистра.Документ.Номер;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.СоответствиеГоловногоИПодчиненногоGLN") Тогда
		Идентификатор = "GLN" + Формат(СтруктураЗаписиРегистра.Подчиненный.GLN, "ЧГ=") + Формат(СтруктураЗаписиРегистра.ТолькоДляРЦ, "БЛ=0; БИ=1");
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.РегистрацияЗапросовЭДО") Тогда
		
		Попытка
			Выгружать = Ложь;
			СтатусыВыгрузки = ОбменДаннымиЭДО.МассивСтатусовВходящихДокументовДляОбмена();
			
			Для Каждого ЗаписьРегистра Из Источник Цикл
				
				Если ЗаписьРегистра.ОтправленНаСерверЭДО
					ИЛИ СтатусыВыгрузки.Найти(ЗаписьРегистра.СтатусДокументаВЭДО) = Неопределено
					ИЛИ Не ЗначениеЗаполнено(ЗаписьРегистра.IdДокументаУПровайдера) 
					// {{ egaevsky - 15.06.2026 - #ЭДО. Возвраты по УКД, ТЗ Малышевой Н.Б.
					ИЛИ ЗаписьРегистра.ВыгрузитьВБП
					// }} egaevsky - 15.06.2026 - #ЭДО. Возвраты по УКД, ТЗ Малышевой Н.Б.
				Тогда
					Продолжить;
				КонецЕсли;
								
				ОжидаемаяПриемка = ЗаписьРегистра.ДокументАстор;
				Если ЗначениеЗаполнено(ОжидаемаяПриемка) Тогда
					Выгружать = Истина;
				КонецЕсли;
			КонецЦикла;
		Исключение
			Выгружать = Ложь;
		КонецПопытки;
		
		Если Выгружать = Ложь Тогда
			Возврат;
		КонецЕсли;
		
		Идентификатор = "EDO" + Формат(СтруктураЗаписиРегистра.Период, "ДФ=yyMMddHHmmss") 
					  + СтруктураЗаписиРегистра.НомерDESADV + Формат(СтруктураЗаписиРегистра.ДатаDESADV, "ДФ=yyMMdd");
					  
					  
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ИсходящиеДокументыЭДО") Тогда
		
		Попытка
			Выгружать = Ложь;
			
			ТипыДокументовДляУПД = Новый Массив;
			ТипыДокументовДляУПД.Добавить(Тип("ДокументСсылка.РасходнаяНакладная"));
			ТипыДокументовДляУПД.Добавить(Тип("ДокументСсылка.ВозвратнаяНакладная"));
			ТипыДокументовДляУПД.Добавить(Тип("ДокументСсылка.КорректировкаВозвратнойНакладной"));

			// {{ egaevsky - 10.07.2025 - #Перевод РН на УПД, ТЗ Малышевой Н.Б.
			// приемка с расхождением через ВЭДО
			ТипыДокументовДляУКД = Новый Массив;
			ТипыДокументовДляУКД.Добавить(Тип("ДокументСсылка.КорректировкаРеализации"));
			// }} egaevsky - 10.07.2025 - #Перевод РН на УПД, ТЗ Малышевой Н.Б.
			
			// {{ egaevsky - 23.05.2025 - #Неформализованные через ВЭДО
			ТипыДокументовНеформализованные = НеформализованныеДокументыЭДО.МассивТиповНеформализованныхДокументов();
			// }} egaevsky - 23.05.2025 - #Неформализованные через ВЭДО
			
			Для Каждого ЗаписьРегистра Из Источник Цикл
				
				// {{ egaevsky - 10.07.2025 - #Перевод РН на УПД, ТЗ Малышевой Н.Б.
				// Раздел ТЗ Астор. Обработка АРМ бухгалтера РЦ 2.0 ТЗ 1543 (код 000000751), подраздел Аннулирование
				// Из РС записи со статусом Подтверждено Аннулирование и Отказ аннулирования
				// выгружаются в вэдо, далее на сайт провайдера
				ТребуетсяВыгрузкаПоСтатусу = ЗаписьРегистра.СтатусДокумента = Перечисления.СтатусыДокументовЭДО.ТребуетсяПодпись
					ИЛИ ЗаписьРегистра.СтатусДокумента = Перечисления.СтатусыДокументовЭДО.ПодтвержденоАннулирование
					ИЛИ ЗаписьРегистра.СтатусДокумента = Перечисления.СтатусыДокументовЭДО.ОтказаноВАннулировании
					ИЛИ ЗаписьРегистра.СтатусДокумента = Перечисления.СтатусыДокументовЭДО.ОжидаетсяОтправкаЗапросаНаАннулирование;
					
				// также внутренние документы необходимо регистрировать в статусе "В подписи отказано"
				Если ОбменДаннымиЭДО.ЭтоРННаУПД(ЗаписьРегистра.Документ) Тогда
					Если ЗаписьРегистра.СтатусДокумента = Перечисления.СтатусыДокументовЭДО.ВПодписиОтказано Тогда
						ТребуетсяВыгрузкаПоСтатусу = Истина;
					// уберем для внутренних, т.к. для внутренних у нас запрос на аннулирование подтвтердится автоматически через рс регистрация запросов упд
					ИначеЕсли ЗаписьРегистра.СтатусДокумента = Перечисления.СтатусыДокументовЭДО.ПодтвержденоАннулирование Тогда
						ТребуетсяВыгрузкаПоСтатусу = Ложь;
					КонецЕсли;
				КонецЕсли;
				// }} egaevsky - 10.07.2025 - #Перевод РН на УПД, ТЗ Малышевой Н.Б.
				Если ТребуетсяВыгрузкаПоСтатусу Тогда
					
					ТипДокумента = ТипЗнч(ЗаписьРегистра.Документ);
					Если ТипыДокументовДляУПД.Найти(ТипДокумента) <> Неопределено Тогда
						Выгружать = Истина;
					КонецЕсли;
					
					// {{ egaevsky - 23.05.2025 - #Неформализованные через ВЭДО
					Если ТипыДокументовНеформализованные.Найти(ТипДокумента) <> Неопределено Тогда
						ЭтоВнутреннийНеформализованный = НеформализованныеДокументыЭДО.ЭтоВнутреннийНеформализованныйДокумент(ЗаписьРегистра.Документ);
						Если ЭтоВнутреннийНеформализованный Тогда
							КаналСервисаИнтеграции = КаналВыгрузкиАбонентам(Истина);
						КонецЕсли;
						Выгружать = Истина;
					КонецЕсли;
					// }} egaevsky - 23.05.2025 - #Неформализованные через ВЭДО
					
					// {{ egaevsky - 10.07.2025 - #Перевод РН на УПД, ТЗ Малышевой Н.Б.
					// приемка с расхождением через ВЭДО
					Если ТипыДокументовДляУКД.Найти(ТипДокумента) <> Неопределено Тогда
						Выгружать = Истина;
					КонецЕсли;
					// }} egaevsky - 10.07.2025 - #Перевод РН на УПД, ТЗ Малышевой Н.Б.
				КонецЕсли;
			КонецЦикла;
		Исключение
			Выгружать = Ложь;
		КонецПопытки;
		
		Если Выгружать = Ложь Тогда
			Возврат;
		КонецЕсли;
		
		Если ОбменДаннымиЭДО.ЕстьРеквизитОбъекта(СтруктураЗаписиРегистра.Документ, "Номер") Тогда
			Номер = СтруктураЗаписиРегистра.Документ.Номер;
		Иначе
			Номер = XMLСтрока(ЗаписьРегистра.Документ);
		КонецЕсли;
		
		Идентификатор = "EDO" + Формат(СтруктураЗаписиРегистра.Период, "ДФ=yyMMddHHmmss") + Номер;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.СтатусыЭДОРасходнойНакладной") Тогда
		
		Попытка
			Выгружать = Ложь;
			
			Для Каждого ЗаписьРегистра Из Источник Цикл
				
				Если ЗаписьРегистра.Статус = Перечисления.СтатусыЭДОРасходнойНакладной.Проверено Тогда
					
					ДокументОтгрузки = ЗаписьРегистра.РасходнаяНакладная;
					Исходящий = ЭтоИсходящийФормализованныйДокумент(ДокументОтгрузки);
					Если Не Исходящий Тогда
						КаналСервисаИнтеграции = КаналВыгрузкиАбонентам(Истина);
					КонецЕсли;
					
					Выгружать = Истина;
											
				КонецЕсли;
			КонецЦикла;
		Исключение
			Выгружать = Ложь;
		КонецПопытки;
		
		Если Выгружать = Ложь Тогда
			Возврат;
		КонецЕсли;
				
		Идентификатор = "EDO" + Формат(СтруктураЗаписиРегистра.Период, "ДФ=yyMMddHHmmss") + СтруктураЗаписиРегистра.РасходнаяНакладная.Номер;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Для Каждого Узел Из Узлы Цикл 
		Интеграция1СШина.ЗарегистрироватьОбъектВОчереди(ОбъектОбмена, Узел, КаналСервисаИнтеграции, Идентификатор);
	КонецЦикла;

КонецПроцедуры

Процедура ЗарегистрироватьДокументДляВЭДО(Источник)
	
	Узлы = УзлыВыгрузкиВЭДО_АСТОР();
	КаналСервисаИнтеграции = КаналВыгрузкиАбонентам();
	Для Каждого Узел Из Узлы Цикл
		Интеграция1СШина.ЗарегистрироватьОбъектВОчереди(Источник, Узел, КаналСервисаИнтеграции);
	КонецЦикла;
	
КонецПроцедуры

Функция ВыгрузитьСправочникВ1сШину(Источник) Экспорт

	РезультатВыполнения = ПереводВJSONДляШины.Справочник_Сообщение(Источник);
	Возврат РезультатВыполнения;

КонецФункции

Функция ВыгрузитьНаборЗаписейРегистраСведенийВ1сШину(Источник) Экспорт

	РезультатВыполнения = ОбменДаннымиЧерезСервисыИнтеграции.СтруктураЗаписиРегистраСведений(Источник);
	Возврат РезультатВыполнения;	

КонецФункции

Функция Документ_JSON_ТипСообщения(Источник) Экспорт

	Результат = Неопределено;
	
	МетаданныеИсточника = Источник.Метаданные();
	
	МетаданныеEDI = Новый Массив;
	МетаданныеEDI.Добавить(Метаданные.Документы.Заказ);
	МетаданныеEDI.Добавить(Метаданные.Документы.ПриходнаяНакладная);
	МетаданныеEDI.Добавить(Метаданные.Документы.РасходнаяНакладная);
	МетаданныеEDI.Добавить(Метаданные.Документы.ПриходнаяНакладнаяEDI);
	// {{ kraevav - 05.09.2025 - # Краснокутский Н.Н. Доработка обмена между 1С Астор и УПП СП
	МетаданныеEDI.Добавить(Метаданные.Документы.ПредварительныйЗаказ);
	// }} kraevav - 05.09.2025 - # Краснокутский Н.Н. Доработка обмена между 1С Астор и УПП СП
	
	Если МетаданныеИсточника = Метаданные.Документы.ЭлектроннаяТранспортнаяНакладная Тогда
    	Результат = ПереводВJSONДляШины.ЭТрН_JSON_ТипСообщения(Источник);
	ИначеЕсли МетаданныеEDI.Найти(МетаданныеИсточника) <> Неопределено Тогда
		Результат = ПереводВJSONДляШины.ДокументEDI_Сообщение(Источник); 
	ИначеЕсли МетаданныеИсточника = Метаданные.Документы.ВозвратнаяНакладная Тогда
    	Результат = ПереводВJSONДляШины.ВозвратнаяНакладнаяСообщениеJSON(Источник);
	Иначе
		Результат = Новый Структура("Ошибка", "Непредвиденный тип документа, для шины.");
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция КаналВыгрузкиАбонентам(Внутренний = Ложь) Экспорт
	
	Если Внутренний Тогда
		КаналВыгрузки = "ВнутреннийEDO_InternalDataEDO_ОтАбонентов";
	Иначе
		КаналВыгрузки = "Основной_ExchangeVEDO_ОтАбонентов";
	КонецЕсли;
	
	Возврат КаналВыгрузки;
	
КонецФункции

Функция УзлыВыгрузкиВЭДО_АСТОР() Экспорт	
	
	УзелСистемыПолучателя  = "vedo"; 
	
	МассивУзлов = Новый Массив;
	МассивУзлов.Добавить(УзелСистемыПолучателя);	
	
	Возврат МассивУзлов;
	
КонецФункции

Функция ЭтоИсходящийФормализованныйДокумент(ДокументОтгрузки) Экспорт
	
	Результат = Ложь;
	Если ТипЗнч(ДокументОтгрузки.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		Если СокрЛП(ДокументОтгрузки.Контрагент.ИНН) <> СокрЛП(ДокументОтгрузки.Фирма.ИНН) Тогда
			Результат = Истина;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

