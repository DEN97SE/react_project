// Обмен данными по выбранным параметрам
//
// Параметры:
//  КодПлощадки	 - 	 - 
//  ВидОперации	 - 	 - 
// 	ОбменССайтом -   - 
//
Процедура ОбменДаннымиПоКодуПлощадки(Знач КодПлощадки, Знач ВидОперации = "Полный", Знач ОбменССайтом = Ложь) // {{ pobotaev - 09.02.2021 - #Добавил параметр "ОбменССайтом" }}
	
	Площадка = Справочники.ПлощадкиОнлайнТорговли.НайтиПоКоду(КодПлощадки);
	Если Площадка.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("По коду %1 не определена площадка", КодПлощадки));
		Возврат;
	КонецЕсли;
	
	// {{ pobotaev - 09.02.2021 - #Интеграция с delivery.sm-komandor.ru. Онлайн продажи
	Если ОбменССайтом = Истина Тогда
		Обработчик = Обработки.ВыгрузкаДляОнлайнПродаж.Создать();
	Иначе
		// Было
		Обработчик = ОбработчикОбменОнлайнПлощадки(Площадка);
	КонецЕсли;
	// }} pobotaev - 09.02.2021 - #Интеграция с delivery.sm-komandor.ru. Онлайн продажи
	Если Обработчик = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("По площадке %1 не определен обработчик обмена", Площадка));
		Возврат;	
	КонецЕсли;
	
	Настройки = Обработчик.НастройкиОбмена(Площадка);	
	
	Если ВидОперации = "Полный" Тогда
		Обработчик.ПолныйОбмен(Настройки);	
	ИначеЕсли ВидОперации = "Оперативный" Тогда
		Обработчик.ОперативныйОбмен(Настройки);	
	Иначе
		ВызватьИсключение(СтрШаблон("Вид операции %1 не поддерживается", ВидОперации));	
	КонецЕсли;
	
КонецПроцедуры

