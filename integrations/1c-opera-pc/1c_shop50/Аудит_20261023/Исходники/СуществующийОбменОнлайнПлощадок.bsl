// Функция - Данные о остатках для онлайн продаж
//
// Параметры:
//  Период	 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция ДанныеТолькоООстаткахДляОнлайнПродаж(Знач Период, МассивНоменклатуры = Неопределено) Экспорт
	// {{ Хаданович Роман - 03.06.2022 - Выгрузка на Сайт
	Данные = Новый Структура("ЦеныИОстатки");
	
	СтруктурнаяЕдиница = ОбщиеПроцедурыИФункцииПовтИсп.ТекущаяСтруктурнаяЕдиница();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	НазначениеМикроматрицВСтруктурныхЕдиницах.Категория КАК Категория,
		|	НазначениеМикроматрицВСтруктурныхЕдиницах.Микроматрица КАК Микроматрица
		|ПОМЕСТИТЬ втНазначения
		|ИЗ
		|	РегистрСведений.НазначениеМикроматрицВСтруктурныхЕдиницах КАК НазначениеМикроматрицВСтруктурныхЕдиницах
		|ГДЕ
		|	НазначениеМикроматрицВСтруктурныхЕдиницах.СтруктурнаяЕдиница = &СтруктурнаяЕдиница
		|	И НазначениеМикроматрицВСтруктурныхЕдиницах.Назначено = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	АссортиментныеМикроматрицы.Номенклатура КАК НоменклатураАссортимента
		|ПОМЕСТИТЬ втТовары
		|ИЗ
		|	РегистрСведений.АссортиментныеМикроматрицы КАК АссортиментныеМикроматрицы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втНазначения КАК втНазначения
		|		ПО АссортиментныеМикроматрицы.Микроматрица = втНазначения.Микроматрица
		|			И АссортиментныеМикроматрицы.Номенклатура.Родитель = втНазначения.Категория
		|ГДЕ
		|	НЕ АссортиментныеМикроматрицы.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыНоменклатуры.ПустаяСсылка)
		|	И АссортиментныеМикроматрицы.Номенклатура в (&МассивНоменклатуры) 
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	НоменклатураАссортимента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УчетПартийОстатки.Номенклатура КАК Номенклатура,
		|	УчетПартийОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ втОстатки
		|ИЗ
		|	втТовары КАК втТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.УчетПартий.Остатки(&Период, МестоХранения = &Склад И Номенклатура В (&МассивНоменклатуры)) КАК УчетПартийОстатки
		|		ПО втТовары.НоменклатураАссортимента = УчетПартийОстатки.Номенклатура
		|			И (УчетПартийОстатки.КоличествоОстаток > 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТовары.НоменклатураАссортимента КАК Номенклатура
		|ПОМЕСТИТЬ втТоварыНеКонтролироватьОстаткиНаМагазине
		|ИЗ
		|	втТовары КАК втТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствТоваров КАК ЗначенияСвойствТоваров
		|		ПО втТовары.НоменклатураАссортимента = ЗначенияСвойствТоваров.Объект
		|			И (ЗначенияСвойствТоваров.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.ПринудительноВыгружатьДляОнлайнПродаж))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТоварыНеКонтролироватьОстаткиНаМагазине.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ Вт_НеКонтролироватьОстатковБезОстатков
		|ИЗ
		|	втТоварыНеКонтролироватьОстаткиНаМагазине КАК втТоварыНеКонтролироватьОстаткиНаМагазине
		|		ЛЕВОЕ СОЕДИНЕНИЕ втОстатки КАК втОстатки
		|		ПО втТоварыНеКонтролироватьОстаткиНаМагазине.Номенклатура = втОстатки.Номенклатура
		|ГДЕ
		|	(втОстатки.КоличествоОстаток ЕСТЬ NULL
		|			ИЛИ втОстатки.КоличествоОстаток <= 0)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втТоварыНеКонтролироватьОстаткиНаМагазине
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетПартийОбороты.Номенклатура КАК Номенклатура,
		// {{  11.10.23 KAjdanIT - Реализовать доработку обработки "Модуль сбермаркет" в части не меняющихся остатков. Вагин Р.Н. #рлз #астор
		|	999 - ДЕНЬНЕДЕЛИ(&Период) - ЧАС(&Период) КАК ФиктивныйОстаток
		// }}  11.10.23 KAjdanIT - Реализовать доработку обработки "Модуль сбермаркет" в части не меняющихся остатков. Вагин Р.Н. #рлз #астор
		|ПОМЕСТИТЬ ВТ_НоменклатураПоКоторойБылиПродажиВТеченииМесяца
		|ИЗ
		|	Вт_НеКонтролироватьОстатковБезОстатков КАК Вт_НеКонтролироватьОстатковБезОстатков
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.УчетПартий КАК УчетПартийОбороты
		|		ПО Вт_НеКонтролироватьОстатковБезОстатков.Номенклатура = УчетПартийОбороты.Номенклатура
		|			И (УчетПартийОбороты.МестоХранения = &Склад)
		|			И (УчетПартийОбороты.Период МЕЖДУ &ДатаМесяцНазад И &Период)
		|			И (УчетПартийОбороты.КодОперации В (&СписокКодовОперации))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ Вт_НеКонтролироватьОстатковБезОстатков
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТовары.НоменклатураАссортимента КАК Номенклатура,
		|	ЕСТЬNULL(ВТ_НоменклатураПоКоторойБылиПродажиВТеченииМесяца.ФиктивныйОстаток, ЕСТЬNULL(втОстатки.КоличествоОстаток, 0)) КАК Остаток
		|ПОМЕСТИТЬ втЦеныИтого
		|ИЗ
		|	втТовары КАК втТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ втОстатки КАК втОстатки
		|		ПО втТовары.НоменклатураАссортимента = втОстатки.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НоменклатураПоКоторойБылиПродажиВТеченииМесяца КАК ВТ_НоменклатураПоКоторойБылиПродажиВТеченииМесяца
		|		ПО втТовары.НоменклатураАссортимента = ВТ_НоменклатураПоКоторойБылиПродажиВТеченииМесяца.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втЦеныИтого.Номенклатура КАК Номенклатура,
		|	втЦеныИтого.Остаток КАК Остаток
		|ИЗ
		|	втЦеныИтого КАК втЦеныИтого
		|ГДЕ
		|	втЦеныИтого.Остаток > 0";
	
	Если ТипЗнч(МассивНоменклатуры) = тип("Массив") Тогда
		Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
		Данные.Вставить("ОтборПоНоменклатуре", Истина); // в этом случае В ЦО можно не соединять таблицу Номенклатуры и Остатков
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И АссортиментныеМикроматрицы.Номенклатура в (&МассивНоменклатуры)", "");
        Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Номенклатура В (&МассивНоменклатуры)", "");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", СтруктурнаяЕдиница);
	Запрос.УстановитьПараметр("Период", Период);
	
