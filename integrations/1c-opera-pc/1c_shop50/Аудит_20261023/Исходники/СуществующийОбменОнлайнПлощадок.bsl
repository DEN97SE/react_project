	Для Каждого СтрокаПолучателя Из КоллекцияПолучателей Цикл
		
		Результат = СтрокаПолучателя.Результат;
		
		Если Результат <> Неопределено И ТипЗнч(СтрокаПолучателя.Результат) = Тип("Структура") Тогда
			
			// {{ Хаданович Роман - 07.02.2022 Реализовать диагностику и исправление ошибки с некорректной выгрузкой остатков в сбермаркет. Онлайн продажи. Алыев Э. Крайний Д.
			СоответствиеМагазинов.Вставить(СтрокаПолучателя.Получатель, Истина);
			// }} Хаданович Роман - 07.02.2022 Реализовать диагностику и исправление ошибки с некорректной выгрузкой остатков в сбермаркет. Онлайн продажи. Алыев Э. Крайний Д.
			
			Для Каждого Строка Из Результат.ЦеныИОстатки Цикл
				НоваяСтрока = Таблица.Добавить();
				НоваяСтрока.Номенклатура = Строка.Номенклатура;
				НоваяСтрока.СтруктурнаяЕдиница = СтрокаПолучателя.Получатель;
				НоваяСтрока.Цена = Строка.Цена;
				НоваяСтрока.Остаток = Строка.Остаток;
			КонецЦикла;
			
			Для Каждого Строка Из Результат.АкционныеЦены Цикл
				НоваяСтрока = ТаблицаАкций.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				НоваяСтрока.СтруктурнаяЕдиница = СтрокаПолучателя.Получатель;
			КонецЦикла;
			
		Иначе
			
			// {{ Хаданович Роман - 07.02.2022 Реализовать диагностику и исправление ошибки с некорректной выгрузкой остатков в сбермаркет. Онлайн продажи. Алыев Э. Крайний Д.
			СоответствиеМагазинов.Вставить(СтрокаПолучателя.Получатель, Ложь);
			АдресЭлПочты = "online-trade@sm-komandor.ru";
			Если ЗначениеЗаполнено(ТекущаяПлощадка) Тогда
				ОписаниеПлощадки = СокрЛП(ТекущаяПлощадка);
			Иначе
				ОписаниеПлощадки = "<Интернет магазин не указан>";
			КонецЕсли;
			ТемаПисьма = "Выгрузка для " + ОписаниеПлощадки + ": Нет данных по " + СокрЛП(СтрокаПолучателя.Получатель);
			ТекстПисьма = СокрЛП(ТекущаяДатаСеанса()) + ": Веб запрос к магазину " + СокрЛП(СтрокаПолучателя.Получатель) + " вернул некорректный результат! Результат = """ + СокрЛП(Результат) + " "". <br>
				|Данные о ценах и остатках не выгружены по данному магазину!<br>
				|Данные по магазину были запрошены для Площадки: " + СокрЛП(ОписаниеПлощадки) + "<br>";
			ТекстПисьма = "<i>Письмо отправлено автоматически и ответа не требует.</i><br><br>" + ТекстПисьма;
			УведомленияПоЭлектроннойПочте.ДобавитьКорреспонденцию(ПочтовыйПрофильДляРассылки, АдресЭлПочты, ТемаПисьма, ТекстПисьма, , ТипТекстаПочтовогоСообщения.HTML);
			// }} Хаданович Роман - 07.02.2022 Реализовать диагностику и исправление ошибки с некорректной выгрузкой остатков в сбермаркет. Онлайн продажи. Алыев Э. Крайний Д.
			
		КонецЕсли;
		
	КонецЦикла;
	
	Таблица.Индексы.Добавить("СтруктурнаяЕдиница, Номенклатура");
	ТаблицаАкций.Индексы.Добавить("СтруктурнаяЕдиница, Номенклатура");
	
	// {{ Хаданович Роман - 07.02.2022 Реализовать диагностику и исправление ошибки с некорректной выгрузкой остатков в сбермаркет. Онлайн продажи. Алыев Э. Крайний Д.
	Возврат Новый Структура("ЦеныИОстатки, Акции, ЕстьОтветОтМагазина", Таблица, ТаблицаАкций, СоответствиеМагазинов);
	// }} Хаданович Роман - 07.02.2022 Реализовать диагностику и исправление ошибки с некорректной выгрузкой остатков в сбермаркет. Онлайн продажи. Алыев Э. Крайний Д.
	
