// Функция - Обработчик обмен онлайн площадки
//
// Параметры:
//  Площадка - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция ОбработчикОбменОнлайнПлощадки(Площадка)
	
	Перем Обработчик;
	
	ТипПлощадки = Площадка.Тип;
	Если ТипПлощадки = Перечисления.ТипыПлощадокОнлайнТорговли.ИнтернетМагазин Тогда
		Обработчик = Обработки.МодульБитриксМагазин.Создать();		
	ИначеЕсли ТипПлощадки = Перечисления.ТипыПлощадокОнлайнТорговли.Сбермаркет Тогда
		Обработчик = Обработки.МодульСбермаркета.Создать();
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обработчик обмена не определен");	
	КонецЕсли;	
	
	Возврат Обработчик;
	
КонецФункции

