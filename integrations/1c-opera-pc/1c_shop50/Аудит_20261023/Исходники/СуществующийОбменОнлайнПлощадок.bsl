Процедура ПроверкаИзмененияЦенИОстатковНоменклатуры() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		СтруктурнаяЕдиница = ОбщиеПроцедурыИФункцииПовтИсп.ТекущаяСтруктурнаяЕдиница();
		ДатаВПрошлом2месяца = ДобавитьМесяц(ТекущаяДатаСеанса(), -2);
		
		ДанныеОЦенахИОстатках = ОбменСОнлайнПлощадками.ДанныеОЦенахИОстаткахДляОнлайнПродаж(ТекущаяДатаСеанса());

		ЦеныИОстатки 	= ДанныеОЦенахИОстатках.ЦеныИОстатки;
		Акции 			= ДанныеОЦенахИОстатках.АкционныеЦены;
		
		МодульСбермаркета = Обработки.МодульСбермаркета.Создать();
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТекущиеДанныеЦенИОстатковНоменклатуры.Номенклатура) КАК Количество
		|ИЗ
		|	РегистрСведений.ТекущиеДанныеЦенИОстатковНоменклатуры КАК ТекущиеДанныеЦенИОстатковНоменклатуры";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() И Выборка.Количество = 0 Тогда
			Для Каждого Строка Из ЦеныИОстатки Цикл
				Запись = РегистрыСведений.ТекущиеДанныеЦенИОстатковНоменклатуры.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись, Строка);
				Запись.Записать(Истина);
			КонецЦикла;
			
			Возврат;
		КонецЕсли;
		
		Таблица 		= ПолучитьТаблицуНоменклатуры();
		ТаблицаМРЦ 		= МодульСбермаркета.ПолучитьМРЦ_АлкоПродукции(Неопределено); 
		ТаблицаКассы 	= МодульСбермаркета.ПолучитьТаблицуСКассы();
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТЗ", 				Таблица);
		Запрос.УстановитьПараметр("ТЗ_ЦеныИОстатки", 	ЦеныИОстатки);
		Запрос.УстановитьПараметр("ТЗ_ТаблицаКассы", 		ТаблицаКассы);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТЗ.Номенклатура КАК Номенклатура,
		|	ТЗ.GUIDНоменклатуры КАК GUIDНоменклатуры,
		|	ТЗ.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ вт_ВнешТаблица
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТЗ.Номенклатура КАК Номенклатура,
		|	ТЗ.Наименование КАК Наименование,
		|	ТЗ.НаименованиеДляСайта КАК НаименованиеДляСайта, 
		|	ТЗ.ЭтоВесовойТовар КАК ЭтоВесовойТовар,
		|	ТЗ.Идентификатор КАК Идентификатор, 
		|	ТЗ.ПринудительноОбнулятьОстатки КАК ПринудительноОбнулятьОстатки, 
		|	ТЗ.ТоварИндикатор КАК ТоварИндикатор,
		|	ТЗ.Цена КАК Цена,
		|	ТЗ.Остаток КАК Остаток
		|ПОМЕСТИТЬ вт_ЦеныИОстатки
		|ИЗ
		|	&ТЗ_ЦеныИОстатки КАК ТЗ
		|;
		|
		|ВЫБРАТЬ
		|	ТЗ.GUIDНоменклатуры КАК GUIDНоменклатуры,
		|	ТЗ.Количество КАК Количество
		|ПОМЕСТИТЬ вт_ДанныеКассы
		|ИЗ
		|	&ТЗ_ТаблицаКассы КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(вт_ВнешТаблица.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК втНоменклатура, 
		|	ЕСТЬNULL(вт_ВнешТаблица.GUIDНоменклатуры, """") КАК GUIDНоменклатуры,
		|	ЕСТЬNULL(вт_ВнешТаблица.Идентификатор, 0) КАК Идентификатор,
		|	ЕСТЬNULL(ТекущиеДанныеЦенИОстатковНоменклатуры.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК рсНоменклатура,
		|	ЕСТЬNULL(вт_ЦеныИОстатки.НаименованиеДляСайта, """") КАК НаименованиеДляСайта,
		|	ЕСТЬNULL(вт_ЦеныИОстатки.ЭтоВесовойТовар, ЛОЖЬ) КАК ЭтоВесовойТовар,
		|	ЕСТЬNULL(вт_ЦеныИОстатки.ПринудительноОбнулятьОстатки, ЛОЖЬ) КАК ПринудительноОбнулятьОстатки,
		|	ЕСТЬNULL(вт_ЦеныИОстатки.ТоварИндикатор, ЛОЖЬ) КАК ТоварИндикатор,
		|	ЕСТЬNULL(вт_ЦеныИОстатки.Цена, 0) КАК Цена,
		|	ЕСТЬNULL(вт_ЦеныИОстатки.Остаток, 0) - ЕСТЬNULL(вт_ДанныеКассы.Количество, 0) КАК Остаток,
		|	ЕСТЬNULL(ТекущиеДанныеЦенИОстатковНоменклатуры.Цена, 0) <> ЕСТЬNULL(вт_ЦеныИОстатки.Цена, 0) КАК ИзмененаЦена,
		|	ЕСТЬNULL(ТекущиеДанныеЦенИОстатковНоменклатуры.Остаток, 0) <> (ЕСТЬNULL(вт_ЦеныИОстатки.Остаток, 0) - ЕСТЬNULL(вт_ДанныеКассы.Количество, 0)) КАК ИзмененОстаток
		|ИЗ
		|	вт_ВнешТаблица КАК вт_ВнешТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеДанныеЦенИОстатковНоменклатуры КАК ТекущиеДанныеЦенИОстатковНоменклатуры
		|		ПО вт_ВнешТаблица.Номенклатура = ТекущиеДанныеЦенИОстатковНоменклатуры.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ЦеныИОстатки КАК вт_ЦеныИОстатки
		|		ПО вт_ВнешТаблица.Номенклатура = вт_ЦеныИОстатки.Номенклатура
		|			И вт_ВнешТаблица.Идентификатор = вт_ЦеныИОстатки.Идентификатор
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ДанныеКассы КАК вт_ДанныеКассы
		|		ПО вт_ВнешТаблица.GUIDНоменклатуры = вт_ДанныеКассы.GUIDНоменклатуры
		|ГДЕ
		|	(ЕСТЬNULL(ТекущиеДанныеЦенИОстатковНоменклатуры.Цена, 0) <> ЕСТЬNULL(вт_ЦеныИОстатки.Цена, 0)
		|			ИЛИ ЕСТЬNULL(ТекущиеДанныеЦенИОстатковНоменклатуры.Остаток, 0) <> (ЕСТЬNULL(вт_ЦеныИОстатки.Остаток, 0) - ЕСТЬNULL(вт_ДанныеКассы.Количество, 0)))";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		сЦены = Новый Структура("price_data", Новый Структура);
		сЦены.price_data.Вставить("store_id", СтруктурнаяЕдиница.Код); 
		сЦены.price_data.Вставить("offer", Новый Массив);
		
		сОстатки = Новый Структура("stock_data", Новый Структура);
		сОстатки.stock_data.Вставить("store_id", СтруктурнаяЕдиница.Код); 
		сОстатки.stock_data.Вставить("offer", Новый Массив);
		
		ЕстьИзмененияЦен = Ложь;
		ЕстьИзменениеОстатков = Ложь;
		
		Пока Выборка.Следующий() Цикл
			Если Не Выборка.ИзмененаЦена И Не Выборка.ИзмененОстаток Тогда
				Продолжить;
			КонецЕсли;
			
			Цена = Выборка.Цена;
			
			Если Выборка.ИзмененаЦена Тогда
				ЕстьИзмененияЦен = Истина;
				
				ОписаниеЦены = Новый Структура("discount_price,discount_from_date,discount_to_date", 0, 0, 0);
				ОписаниеЦены.Вставить("id", Выборка.Идентификатор);
				ОписаниеЦены.Вставить("name", ОбменСОнлайнПлощадками.НаименованиеДляСайта(Выборка.НаименованиеДляСайта, Выборка.втНоменклатура.Наименование, 250));
				
				Если Выборка.ЭтоВесовойТовар Тогда
					ОписаниеЦены.Вставить("type", "per_kilo");
				Иначе
					ОписаниеЦены.Вставить("type", "per_item");	
				КонецЕсли;
				
				Цена = Выборка.Цена;
				
				ОписаниеЦены.Вставить("regular_price", Цена);
				
				АкционноеПредложение = ОбменСОнлайнПлощадками.АкционноеПредложениеПоТовару(
					Акции, Выборка.втНоменклатура, СтруктурнаяЕдиница);
				МодульСбермаркета.ЗаполнитьАкционноеПредложениеВПрайсе(АкционноеПредложение, Цена, ОписаниеЦены);
				
				стрМРЦ = ТаблицаМРЦ.Найти(Выборка.втНоменклатура, "Номенклатура");

				Если Не стрМРЦ = Неопределено Тогда
					ОписаниеЦены.Вставить("minimum_retail_price", стрМРЦ.price);
				КонецЕсли;
				
				Если Выборка.втНоменклатура.ДатаСоздания >= ДатаВПрошлом2месяца Тогда
					ОписаниеЦены.Вставить("new", "yes");
				Иначе
					ОписаниеЦены.Вставить("new", "no");
				КонецЕсли;
				
				ОписаниеЦены.Вставить("indicator", Формат(Выборка.ТоварИндикатор, "БЛ=no; БИ=yes")); 
				
				сЦены.price_data.offer.Добавить(ОписаниеЦены);
			КонецЕсли;
			
			Остаток = Выборка.Остаток;
			
			Если Выборка.ИзмененОстаток Тогда 
				ВыгрузитьОстаток = Ложь;

				Если Выборка.ПринудительноОбнулятьОстатки = Истина Тогда
					Остаток = 0;
					ВыгрузитьОстаток = Истина;
				Иначе
					Если Остаток > 0 Тогда
						ВыгрузитьОстаток = Истина;
					КонецЕсли;
				КонецЕсли;

				Если ВыгрузитьОстаток Тогда
					ЕстьИзменениеОстатков = Истина;
					
					ОписаниеОстатка = Новый Структура;	
					ОписаниеОстатка.Вставить("id", Выборка.Идентификатор);
					ОписаниеОстатка.Вставить("shop_stocks", Остаток);

					ОписаниеОстатка.Вставить("last_sale_date", "");
					ОписаниеОстатка.Вставить("last_delivery_date", "");

					сОстатки.stock_data.offer.Добавить(ОписаниеОстатка);
				КонецЕсли;
			КонецЕсли;
			
			Запись = РегистрыСведений.ТекущиеДанныеЦенИОстатковНоменклатуры.СоздатьМенеджерЗаписи();
			Запись.Номенклатура = Выборка.втНоменклатура;
			Запись.Цена = Цена;
			Запись.Остаток = Остаток;
			Запись.Записать(Истина);
		КонецЦикла;
		
		Если ЕстьИзмененияЦен Тогда
			НомерМагазина = "k" + Формат(СтруктурнаяЕдиница.НомерМагазина, "ЧГ=0") + "_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss");
			Интеграция1СШина.ЗарегистрироватьОбъектВОчереди(ЗначениеВСтрокуВнутр(сЦены), "vedo", "Основной_ExchangeVEDO_ОтАбонентов", НомерМагазина, "АРМСупервайзера");
		КонецЕсли;
		
		Если ЕстьИзменениеОстатков Тогда
			НомерМагазина = "k" + Формат(СтруктурнаяЕдиница.НомерМагазина, "ЧГ=0") + "_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss");
			Интеграция1СШина.ЗарегистрироватьОбъектВОчереди(ЗначениеВСтрокуВнутр(сОстатки), "vedo", "Основной_ExchangeVEDO_ОтАбонентов", НомерМагазина, "АРМСупервайзера");
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Ошибка проверки изменения цен и остатков",
							УровеньЖурналаРегистрации.Ошибка,
							,
							,
							ТекстОшибки);
	КонецПопытки;
			
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры 

Функция ПолучитьТаблицуИдентификаторов()
	
	Попытка
		Возврат ХранилищеОбщихНастроек.Загрузить("МодульСбермаркета", "ТаблицаИдентификаторов",, "ОбменШина");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ПолучитьТаблицуНоменклатуры()
	
	ТаблицаИдентификаторов = ПолучитьТаблицуИдентификаторов();
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("GUIDНоменклатуры", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(36)));
	Таблица.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10,0)));
	
	Если ТаблицаИдентификаторов = Неопределено Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Для Каждого Элемент Из ТаблицаИдентификаторов Цикл
		нСтр = Таблица.Добавить();
		нСтр.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Элемент.Ключ));
		нСтр.GUIDНоменклатуры = Элемент.Ключ;
		нСтр.Идентификатор = Элемент.Значение;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

#КонецОбласти
