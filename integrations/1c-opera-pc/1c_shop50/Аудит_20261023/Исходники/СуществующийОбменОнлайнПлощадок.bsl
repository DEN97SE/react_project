	Запрос.УстановитьПараметр("Склад", СтруктураРеквизитов.СкладТорговогоЗала);
	
	Запрос.УстановитьПараметр("ДатаМесяцНазад", ДобавитьМесяц(Период, -1));
	СписокКодовОперации = Новый Массив;
	СписокКодовОперации.Добавить(ПредопределенноеЗначение("Перечисление.КодыОпераций.ПродажаРозница"));
	СписокКодовОперации.Добавить(ПредопределенноеЗначение("Перечисление.КодыОпераций.ПродажаОпт"));
