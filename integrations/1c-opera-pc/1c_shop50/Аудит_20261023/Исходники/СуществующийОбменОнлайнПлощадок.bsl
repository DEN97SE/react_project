// Остаток по товару из данные о ценах и остатках 
//
// Параметры:
//  ДанныеОЦенахИОстатках	 - 	 - 
//  Номенклатура			 - 	 - 
//  СтруктурнаяЕдиница		 - 	 - 
//  НеКонтролироватьОстатки	 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция ОстатокПоТовару(ДанныеОЦенахИОстатках, Номенклатура, СтруктурнаяЕдиница, НеКонтролироватьОстатки = Ложь) Экспорт

	Результат = 0;
	
	Если ДанныеОЦенахИОстатках = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("СтруктурнаяЕдиница", СтруктурнаяЕдиница);
	Отбор.Вставить("Номенклатура", Номенклатура);
	
	Строки = ДанныеОЦенахИОстатках.НайтиСтроки(Отбор);
	Если Строки.Количество() > 0 Тогда
		Результат = Строки[0].Остаток;	
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

// Цена по товару из данных о ценах и остатках
//
// Параметры:
//  ДанныеОЦенахИОстатках	 - 	 - 
//  Номенклатура			 - 	 - 
//  СтруктурнаяЕдиница		 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция ЦенаПоТовару(ДанныеОЦенахИОстатках, Номенклатура, СтруктурнаяЕдиница) Экспорт
	
	Цена = 0;
	
	Если ДанныеОЦенахИОстатках = Неопределено Тогда
		Возврат Цена;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("СтруктурнаяЕдиница", СтруктурнаяЕдиница);  
	Отбор.Вставить("Номенклатура", Номенклатура);
	РезультатПоиска = ДанныеОЦенахИОстатках.НайтиСтроки(Отбор);
	Если РезультатПоиска.Количество() > 0 Тогда
		Цена = РезультатПоиска[0].Цена;	
	КонецЕсли;
	
	Возврат Цена;
	
КонецФункции

// Корневая группа по торговой площадке 
//
// Параметры:
//  Владелец - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция КорневаяГруппаПоПлощадке(Владелец) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПользовательскиеГруппыТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПользовательскиеГруппыТоваров КАК ПользовательскиеГруппыТоваров
	|ГДЕ
	|	ПользовательскиеГруппыТоваров.Инфоблок
	|	И ПользовательскиеГруппыТоваров.Площадка = &Площадка
	|	И НЕ ПользовательскиеГруппыТоваров.ПометкаУдаления";
	Запрос.УстановитьПараметр("Площадка", Владелец);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Ссылка;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Акционное предложение по товару из данных об акциях
//
// Параметры:
//  Данные				 - 	 - 
//  Номенклатура		 - 	 - 
//  СтруктурнаяЕдиница	 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция АкционноеПредложениеПоТовару(Данные, Номенклатура, СтруктурнаяЕдиница) Экспорт
	
	Перем Результат;
	
	Если Данные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("СтруктурнаяЕдиница", СтруктурнаяЕдиница);
	Отбор.Вставить("Номенклатура", Номенклатура);
	
	Строки = Данные.НайтиСтроки(Отбор);
	Если Строки.Количество() > 0 Тогда
		
		Результат = Новый Структура("СтруктурнаяЕдиница, Номенклатура, Цена, ДатаНачала, ДатаОкончания");
		ЗаполнитьЗначенияСвойств(Результат, Строки[0]);	
		
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

// Наименование для сайта из двух значений. Наименование ограничивается длиной из параметра
//
// Параметры:
//  Значение			 - 	 - 
//  ЗначениеПоУмолчанию	 - 	 - 
//  ДлинаЗначения		 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция НаименованиеДляСайта(Знач Значение, Знач ЗначениеПоУмолчанию, Знач ДлинаЗначения = 100) Экспорт
	
	Перем Результат;
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Результат = Значение;
	Иначе
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Лев(Результат, ДлинаЗначения);
	
КонецФункции

// Запрос данных о ценах и остатках по торговой площадке
//
// Параметры:
//  ТекущаяПлощадка	 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция ДанныеОЦенахИОстатках(ТекущаяПлощадка, ТолькоОстатки = Ложь, МассивНоменклатуры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	ПлощадкиОнлайнТорговлиСтруктурныеЕдиницы.Ссылка КАК Площадка,
		|	ПлощадкиОнлайнТорговлиСтруктурныеЕдиницы.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница
		|ИЗ
		|	Справочник.ПлощадкиОнлайнТорговли.СтруктурныеЕдиницы КАК ПлощадкиОнлайнТорговлиСтруктурныеЕдиницы
		|ГДЕ
		|	ПлощадкиОнлайнТорговлиСтруктурныеЕдиницы.Ссылка = &Площадка";
	Запрос.УстановитьПараметр("Площадка", ТекущаяПлощадка);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнены структурные единицы в площадке");
		Возврат Неопределено;
	КонецЕсли;
	
	МассивСЕ = Результат.Выгрузить().ВыгрузитьКолонку("СтруктурнаяЕдиница");
	
	// инициализируем обработку
	Модуль = Обработки.ОтправляторСкриптов.Создать();
	Модуль.Таймаут = 300;
	КоллекцияПолучателей = Модуль.РезультатОбработкиКоллекцииПолучателей();
	
	// заполняем список СЕ, можно через консоль кода отдельно указать список через переменную
	// СписокПолучателей (предварительно закомментаровав код ниже)
	Запрос = Новый Запрос;
	Запрос.Текст = "
		|ВЫБРАТЬ
		|	ОбменДанными.Ссылка КАК Ссылка,
		|	ОбменДанными.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница
		|ИЗ
		|	ПланОбмена.ОбменДанными КАК ОбменДанными
		|ГДЕ
		|	НЕ ОбменДанными.СтруктурнаяЕдиница.ПометкаУдаления
		|	И ОбменДанными.СтруктурнаяЕдиница В (&МассивСЕ)";
	Запрос.УстановитьПараметр("МассивСЕ", МассивСЕ);
	Выборка = Запрос.Выполнить().Выгрузить();
	СписокПолучателей = Выборка.ВыгрузитьКолонку("СтруктурнаяЕдиница");
	
	// заполнение параметров отправки
	Для Каждого Получатель Из МассивСЕ Цикл
		ДанныеПодключения = Модуль.ПараметрыПодключенияКПолучателю(Получатель);
		Если ДанныеПодключения = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Нет данных о подключении в %1", Получатель));
			// {{ Хаданович Роман - 07.02.2022 Реализовать диагностику и исправление ошибки с некорректной выгрузкой остатков в сбермаркет. Онлайн продажи. Алыев Э. Крайний Д.
			ПочтовыйПрофильДляРассылки = Справочники.ПочтовыеПрофили.ПолучитьСсылку(Новый УникальныйИдентификатор("e527c3cd-85a0-11ec-969c-5ef3fd361d6b")); // error_online_export@sm-komandor.ru
			АдресЭлПочты = "online-trade@sm-komandor.ru";
			ТемаПисьма = "Выгрузка в интернет-магазин: Нет данных о подключении для " + СокрЛП(Получатель);
			ТекстПисьма = СокрЛП(ТекущаяДатаСеанса()) + ": В ЦО по магазину " + СокрЛП(Получатель) + " не указаны настройки для осуществления web запроса! <br>
				|Не задано имя Веб сервера и имя базы магазина. Обратитесь в тех поддержку. Данные о ценах и остатках не могут быть выгружены!
				|Данные по магазину были запрошены для Площадки: " + СокрЛП(ТекущаяПлощадка) + "<br>";
			ТекстПисьма = "<i>Письмо отправлено автоматически и ответа не требует.</i><br><br>" + ТекстПисьма;
			УведомленияПоЭлектроннойПочте.ДобавитьКорреспонденцию(ПочтовыйПрофильДляРассылки, АдресЭлПочты, ТемаПисьма, ТекстПисьма, , ТипТекстаПочтовогоСообщения.HTML);
			// }} Хаданович Роман - 07.02.2022 Реализовать диагностику и исправление ошибки с некорректной выгрузкой остатков в сбермаркет. Онлайн продажи. Алыев Э. Крайний Д.
			Продолжить;
		КонецЕсли;
		Модуль.ДобавитьЗаписьРезультатаОбработки(
			КоллекцияПолучателей,
			Получатель,
			ДанныеПодключения.ИмяСервера,
			ДанныеПодключения.Порт,
			ДанныеПодключения.ИмяБазы);
	КонецЦикла;
	
	// запуск выполнения скрипта в получателях.
	Если ТолькоОстатки = Ложь Тогда
		ТекстСкрипта = "Период = ТекущаяДата(); 
			|РезультатВыполнения = ОбменСОнлайнПлощадками.ДанныеОЦенахИОстаткахДляОнлайнПродаж(Период);";
	Иначе
		// {{ Хаданович Роман - 06.06.2022 - Оптимизация выгрузки на сайт
		Если МассивНоменклатуры = Неопределено Тогда
			ТекстСкрипта = "Период = ТекущаяДата(); 
				|РезультатВыполнения = ОбменСОнлайнПлощадками.ДанныеТолькоООстаткахДляОнлайнПродаж(Период);";
		Иначе
			СтрокаМассивНоменклатуры = ЗначениеВСтрокуВнутр(МассивНоменклатуры);
			СтрокаМассивНоменклатуры = СтрЗаменить(СтрокаМассивНоменклатуры, Символ(34), "Кавычка");
			СтрокаМассивНоменклатуры = СтрЗаменить(СтрокаМассивНоменклатуры, Символы.ПС, "ПереносСтроки");
			ТекстСкрипта = "Период = ТекущаяДата(); 
				|СтрокаМассивНоменклатуры = """ + СтрокаМассивНоменклатуры + """;
				|СтрокаМассивНоменклатуры = СтрЗаменить(СтрокаМассивНоменклатуры, ""Кавычка"",Символ(34));
				|СтрокаМассивНоменклатуры = СтрЗаменить(СтрокаМассивНоменклатуры, ""ПереносСтроки"",Символы.ПС);
				|МассивНоменклатуры = ЗначениеИзСтрокиВнутр(СтрокаМассивНоменклатуры); 
				|РезультатВыполнения = ОбменСОнлайнПлощадками.ДанныеТолькоООстаткахДляОнлайнПродаж(Период, МассивНоменклатуры);";
		КонецЕсли;
		// }} Хаданович Роман - 06.06.2022 - Оптимизация выгрузки на сайт
	КонецЕсли;
	
	// или последовательно (если какие проблемы с фоновыми заданиями)
	Модуль.ОпроситьПолучателейВОдномПотоке(КоллекцияПолучателей, ТекстСкрипта);
	
	// {{ Хаданович Роман - 06.06.2022 - Оптимизация выгрузки на сайт
	Если ТолькоОстатки = Ложь Тогда
		Результат = ОбработанныеДанныеСМагазинов(КоллекцияПолучателей);
	Иначе
		Результат = ОбработанныеДанныеСМагазиновТолькоОстатки(КоллекцияПолучателей);
    КонецЕсли;
    Возврат Результат;
	// }} Хаданович Роман - 06.06.2022 - Оптимизация выгрузки на сайт
	
КонецФункции

// Добавить файл выгрузки в коллекция. Коллекция используется для отправки файлов 
// на торговую площадку
//
// Параметры:
//  Коллекция	 - 	 - 
//  Имя			 - 	 - 
//  Путь		 - 	 - 
//
Процедура ДобавитьВКоллекциюФайлов(Коллекция, Знач Имя, Знач Путь) Экспорт
	
	Информация = Новый Структура;
	Информация.Вставить("Имя", Имя);
	Информация.Вставить("ПолноеИмя", Путь);
	
	Коллекция.Добавить(Информация);
	
КонецПроцедуры

// Добавляет новую запись в РегистрСведений.ЗаписатьНовыйВнешнийИдентификаторНоменклатуры
//	по номенклатуре
//
// Параметры:
//  Номенклатура - 	 - 
//
Функция ЗаписатьНовыйВнешнийИдентификаторНоменклатуры(Номенклатура) Экспорт
	
	// Блокировка
	СтруктураПараметровБлокировки = Новый Структура("ТипТаблицы, ИмяТаблицы", "РегистрСведений", "ВнешниеИдентификаторыОбъектов");
	СтруктураЗначенийБлокировки = Новый Структура;
	СтруктураИсточникаДанныхБлокировки = Новый Структура;
	Заголовок = "ОбщийМодуль.ОбменСОнлайнПлощадками.ЗаписатьНовыйВнешнийИдентификаторНоменклатуры(Номенклатура)";				
	ОмОбщиеПроцедурыИФункции.УстановитьУправляемуюБлокировку(
		СтруктураПараметровБлокировки,
		СтруктураЗначенийБлокировки,
		СтруктураИсточникаДанныхБлокировки,
		Ложь,
		Заголовок
	);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(ВнешниеИдентификаторыОбъектов.Значение) КАК Значение
	               |ИЗ
	               |	РегистрСведений.ВнешниеИдентификаторыОбъектов КАК ВнешниеИдентификаторыОбъектов";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Результат = Запрос.Выполнить();
	ТекущийНомер = 0;
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ТекущийНомер = Выборка.Значение;
		Если ТекущийНомер = Null Тогда
			ТекущийНомер = 0;
		КонецЕсли;
	КонецЕсли;
	
	НовыйНомер = ТекущийНомер + 1;
	
	Запись = РегистрыСведений.ВнешниеИдентификаторыОбъектов.СоздатьМенеджерЗаписи();
	Запись.Объект = Номенклатура;
	Запись.Значение = НовыйНомер;
	Запись.Записать();
	
	Возврат НовыйНомер;
	
КонецФункции

// Проверяет наличие внешнего идентификатора по номенклатуре
//
// Параметры:
//  Ссылка	 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция ЕстьВнешнийИдентификаторНоменклатуры(Ссылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВнешниеИдентификаторыОбъектов.Значение КАК Значение
	               |ИЗ
	               |	РегистрСведений.ВнешниеИдентификаторыОбъектов КАК ВнешниеИдентификаторыОбъектов
	               |ГДЕ
	               |	ВнешниеИдентификаторыОбъектов.Объект = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);	
	Результат = Запрос.Выполнить();
	Возврат Не Результат.Пустой();
	
КонецФункции

#КонецОбласти

