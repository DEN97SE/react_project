#Область СлужебныеПроцедурыИФункции
Процедура ПередЗаписью(Отказ, Замещение)
	
	// Соломин К.С. 11-05-2017, по запросу Сергеева П.Н. +++
	ТекстСообщения = "";
	
	// {{soaf - 20.01.2021 - #Для обрезания базы
	Если ДополнительныеСвойства.Свойство("ОбойтиЗапрет") Тогда
		
		Если ДополнительныеСвойства.ОбойтиЗапрет = Истина Тогда
			ОбойтиЗапрет = Истина;
		Иначе
			ОбойтиЗапрет = Ложь;
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ОбойтиЗапрет  <> Истина Тогда	
		
		Если ОмКомандорСервер.ПроверкаЗапретаРедактированияРегистровПартий(ЭтотОбъект, ТекстСообщения) Тогда
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;	
	// }} soaf - 20.01.2021 -#Для обрезания базы

	Если Отказ Тогда
		
		// {{ yulya_f - 10.01.2020 - Вывод информации по ошибке в служебных сообщениях. 	
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);	
		
		// }} yulya_f - 10.01.2020 - Вывод информации по ошибке в служебных сообщениях. 
	
		Возврат;
		
	КонецЕсли;
	// Соломин К.С. 11-05-2017, по запросу Сергеева П.Н. ---
	
	ОмПроцедурыСетевогоОбмена.ЗарегистрироватьОбъектДляОбработки(ЭтотОбъект, ОбменДанными.Загрузка, , Замещение);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	ОмПроцедурыСетевогоОбмена.НазначитьПолучателейПриИзмененииНабораЗаписейПартий(ЭтотОбъект);	
	// lebv+++ (Командор)
	Если ПланыОбмена.ГлавныйУзел() = Неопределено Тогда
		Для Каждого Получатель Из ОбменДанными.Получатели Цикл
			ОмПроцедурыСетевогоОбмена.ЗарегистрироватьПартииДляСтруктурнойЕдиницы(ЭтотОбъект, Получатель);
		КонецЦикла;
	КонецЕсли;
	// lebv--- (Командор)
КонецПроцедуры
#КонецОбласти