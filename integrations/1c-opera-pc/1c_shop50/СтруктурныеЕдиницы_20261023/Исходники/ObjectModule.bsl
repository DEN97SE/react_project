
#Область ОписаниеПеременных  

Перем КэшМатрица; // lebv  
// {{ Роман Хаданович 26.06.2017 ТЗ 1497 - Королев В.Г.
Перем НеобходимоЗаполнитьДСПоФорматам; //  Атоматическое сключение новых магазинов из начисления премии
// }} Роман Хаданович 26.06.2017 ТЗ 1497 - Королев В.Г.
Перем НеобходимоЗаполнитьРСДополнительныеСведенияпоСЕ Экспорт; // {{ pechericadv 22.07.2023 Иванова. АСТОР_ТОВ_253 }}

#КонецОбласти

#Область ОбработчикиСобытий 

#Если НЕ ВнешнееСоединение Тогда
Процедура ПриЗаписи(Отказ)
	
	Если ОмПроцедурыСетевогоОбмена.ОтказИзмененияНеВЦентральномУзлеСети(ОбменДанными.Загрузка) Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Изменение возможно только в центральном узле сети.");
	КонецЕсли; 
	
 	Если Не Отказ И (ОбменДанными.Загрузка) Тогда
		ОмПроцедурыСетевогоОбмена.ЗарегистрироватьОбъектДляОбработки(ЭтотОбъект, ОбменДанными.Загрузка);
	КонецЕсли; 
	
	// lebv >>>
	Если Не	ОбменДанными.Загрузка Тогда
		Если Ложь Тогда 
			// КэшМатрица <> АссортиментнаяМатрица Тогда выключаем механизм атк как АМ теперь ходят по ESB. Пичугин 2017/09/01
		
			Запрос = Новый Запрос("ВЫБРАТЬ
			                      |	ОбменДанными.Ссылка КАК Узел
			                      |ИЗ
			                      |	ПланОбмена.ОбменДанными КАК ОбменДанными
			                      |ГДЕ
			                      |		(ОбменДанными.СтруктурнаяЕдиница = &СтруктурнаяЕдиница
			                      |				И ОбменДанными.Ссылка <> &ЭтотУзел)"); 
			
			ОбменДаннымиЭтотУзел = ПланыОбмена.ОбменДанными.ЭтотУзел(); 
			Запрос.УстановитьПараметр("СтруктурнаяЕдиница", Ссылка);
			Запрос.УстановитьПараметр("ЭтотУзел", ОбменДаннымиЭтотУзел);	
			
			МассивУзлов	= Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Узел");
			Если МассивУзлов.Количество() > 0 Тогда 
				// Надо зарегистрировать всех родителей
				МассивРодители = Новый Массив;
				МассивРодители.Добавить(АссортиментнаяМатрица);
				РекурсивноНайтиРодителей(МассивРодители, АссортиментнаяМатрица);
				
				Запрос	=	Новый Запрос("ВЫБРАТЬ
				      	 	             |	АссортиментныеМатрицы.АссортиментнаяМатрица КАК АссортиментнаяМатрица,
				      	 	             |	АссортиментныеМатрицы.Объект КАК Ссылка
				      	 	             |ИЗ
				      	 	             |	РегистрСведений.АссортиментныеМатрицы КАК АссортиментныеМатрицы
				      	 	             |ГДЕ
				      	 	             |	АссортиментныеМатрицы.АссортиментнаяМатрица В(&массивМатриц)");
				
				Запрос.УстановитьПараметр("массивМатриц", МассивРодители);			
				ВыборкаИзРезультатовЗапроса	= Запрос.Выполнить().Выбрать();					
				
				ОбщаяФормаПрогрессор = ПолучитьОбщуюФорму("ОтображениеПрогрессора");	
				ОбщаяФормаПрогрессор.ПрогрессорЗапустить(
					"Регистрация номенклатуры ассортимента для обмена в магазин", 
					1, 
					ВыборкаИзРезультатовЗапроса.Количество());
					
				ОбщаяФормаПрогрессор.ЗначениеИндикатора = 1;
				
				Пока ВыборкаИзРезультатовЗапроса.Следующий() Цикл
					нзАссортиментныеМатрицы = РегистрыСведений.АссортиментныеМатрицы.СоздатьНаборЗаписей();				
					нзАссортиментныеМатрицы.Отбор.Объект.Установить(ВыборкаИзРезультатовЗапроса.Ссылка);
					нзАссортиментныеМатрицы.Отбор.АссортиментнаяМатрица.Установить(ВыборкаИзРезультатовЗапроса.АссортиментнаяМатрица);
					
					ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, нзАссортиментныеМатрицы);
					
					ОбщаяФормаПрогрессор.ПрогрессорОбновить(1);
				КонецЦикла;
				ОбщаяФормаПрогрессор.ПрогрессорЗакрыть();
			КонецЕсли;
		КонецЕсли;
		КэшМатрица	=	АссортиментнаяМатрица;	
	КонецЕсли;	
	// <<<
	
	// + Роман Хаданович 26.06.2017 ТЗ 1497 - Королев В.Г. - Атоматическое сключение новых магазинов из начисления премии
	Если НеобходимоЗаполнитьДСПоФорматам = Истина Тогда
		ЗаполнитьРСДсНаПремииПоФорматамНажатие();
	КонецЕсли;
	// - Роман Хаданович 26.06.2017 ТЗ 1497 - Королев В.Г. - Атоматическое сключение новых магазинов из начисления премии
	
	// {{ pechericadv 22.07.2023 Иванова. АСТОР_ТОВ_253 
	Если НеобходимоЗаполнитьРСДополнительныеСведенияпоСЕ.Выполнить Тогда
		ЗаполнитьРСДополнительныеСведенияпоСЕ();	
	КонецЕсли;
	// }} pechericadv 22.07.2023 Иванова. АСТОР_ТОВ_253 
	
	// {{permyakov - 16.04.2021 - #менять Формат, Направление в регистре НазначенияДоговоров, 
	// если формат или направление СЕ поменяны - заявки по УТЗ
	Если Не ОбменДанными.Загрузка Тогда
		Попытка
			
			НаборЗаписей = РегистрыСведений.EY_НазначенияДоговоров.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.СтруктурнаяЕдиница.Установить(Ссылка);
			НаборЗаписей.Прочитать();
				
			ЕстьИзменения = Ложь;
			Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
				Если ЗаписьНабора.Направление <> Направление Или ЗаписьНабора.Филиал <> Филиал Тогда
					ЗаписьНабора.Направление = Направление;
					ЗаписьНабора.Филиал = Филиал;
					ЕстьИзменения = Истина;
				КонецЕсли;
			КонецЦикла;
				
			Если ЕстьИзменения = Истина Тогда
				НаборЗаписей.ОбменДанными.Загрузка = Истина;
				НаборЗаписей.Записать();
			КонецЕсли;
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("Ошибка выполнения", УровеньЖурналаРегистрации.Ошибка, Метаданные(), Ссылка, ТекстОшибки);
			ОбщегоНазначения.СообщитьОбОшибке(ТекстОшибки);
			Отказ = Истина;
		КонецПопытки;
		
		// {{ PobotaevE - 30.06.2025 - #Проверка активности мест осуществления деятельности
		НаборЗаписей = РегистрыСведений.МестаОсуществленияДеятельности.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Наименование.Установить(Ссылка);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() = 0
			И Не ПометкаУдаления Тогда
	        Запись = НаборЗаписей.Добавить();
	        Запись.Наименование = Ссылка;
			НаборЗаписей.Записать();
		КонецЕсли; 
		
		Если ПометкаУдаления Тогда
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
		КонецЕсли;
		// }} PobotaevE - 30.06.2025 - #Проверка активности мест осуществления деятельности
		
	КонецЕсли;
	// }}permyakov - 16.04.2021 - #менять Формат, Направление в регистре НазначенияДоговоров, 
	// если формат или направление СЕ поменяны - заявки по УТЗ
	
КонецПроцедуры

// + Роман Хаданович 26.06.2017 ТЗ 1497 - Королев В.Г. - Атоматическое сключение новых магазинов из начисления премии
Процедура ЗаполнитьРСДсНаПремииПоФорматамНажатие() Экспорт
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
	   Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Направление) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДСНаПремииПоставщиков.Ссылка КАК СсылкаДС,
		|	ЕСТЬNULL(ПодзапросДСНаПремииПоФорматамСрезПоследних.Активен, ЛОЖЬ) КАК Активен
		|ИЗ
		|	РегистрСведений.ПараметрыДСНаПремии.СрезПоследних КАК ПараметрыДСНаПремииСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДСНаПремииПоставщиков КАК ДСНаПремииПоставщиков
		|		ПО ПараметрыДСНаПремииСрезПоследних.ДС = ДСНаПремииПоставщиков.Ссылка
		|			И (ДСНаПремииПоставщиков.ДатаОкончанияДействияДС > &ТекущаяДата)
		|			И (НЕ ДСНаПремииПоставщиков.ПометкаУдаления)
		|			И (ПараметрыДСНаПремииСрезПоследних.Параметр = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыДСНаПремии.СтатусДСНаПремии))
		|			И (ПараметрыДСНаПремииСрезПоследних.Значение = ЗНАЧЕНИЕ(Перечисление.СтатусСогласуемогоДокумента.ПодписанСторонами))
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			МАКСИМУМ(ДСНаПремииПоФорматамСрезПоследних.Активен) КАК Активен,
		|			ДСНаПремииПоФорматамСрезПоследних.ДС КАК ДСВиновник
		|		ИЗ
		|			РегистрСведений.ДСНаПремииПоФорматам.СрезПоследних(
		|					,
		|					Формат = &Направление
		|						И СтруктурнаяЕдиница <> &ТекСЕ) КАК ДСНаПремииПоФорматамСрезПоследних
		|		ГДЕ
		|			ДСНаПремииПоФорматамСрезПоследних.Активен = ИСТИНА
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ДСНаПремииПоФорматамСрезПоследних.ДС) КАК ПодзапросДСНаПремииПоФорматамСрезПоследних
		|		ПО (ПодзапросДСНаПремииПоФорматамСрезПоследних.ДСВиновник = ДСНаПремииПоставщиков.Ссылка)";
		
		ТекущаяДата = ТекущаяДатаСеанса();
		Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата));
		Запрос.УстановитьПараметр("Направление", Направление);
		Запрос.УстановитьПараметр("ТекСЕ", Ссылка);
		
		Результат = Запрос.Выполнить();
		ТекВремя = ТекущаяДата;
		НЗРСДСНаПремииПоФорматам = РегистрыСведений.ДСНаПремииПоФорматам.СоздатьНаборЗаписей();
		ВыборкаДетальныеЗаписи = Результат.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НЗРСДСНаПремииПоФорматам.Отбор.ДС.Установить(ВыборкаДетальныеЗаписи.СсылкаДС);
			НЗРСДСНаПремииПоФорматам.Отбор.СтруктурнаяЕдиница.Установить(Ссылка);
			НЗРСДСНаПремииПоФорматам.Отбор.Формат.Установить(Направление); 
			НоваяЗапись            = НЗРСДСНаПремииПоФорматам.Добавить();
			НоваяЗапись.Период     = ТекВремя;
			НоваяЗапись.ДС         = ВыборкаДетальныеЗаписи.СсылкаДС;
			НоваяЗапись.СтруктурнаяЕдиница = Ссылка;
			НоваяЗапись.Формат     = Направление;
			НоваяЗапись.Активен    = ВыборкаДетальныеЗаписи.Активен;
			НоваяЗапись.Записано   = ТекВремя;
			НоваяЗапись.Автор      = ПараметрыСеанса.ТекущийСотрудник;
			НоваяЗапись.Примечание = "Создано автоматически из Структурной единицы";
			НЗРСДСНаПремииПоФорматам.Записать();
			НЗРСДСНаПремииПоФорматам.Очистить();
		КонецЦикла;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено Направление!");	 
	КонецЕсли;
	
КонецПроцедуры
// - Роман Хаданович 26.06.2017 ТЗ 1497 - Королев В.Г. - Атоматическое сключение новых магазинов из начисления премии

// {{ pechericadv 22.07.2023 Иванова. АСТОР_ТОВ_253 
Процедура ЗаполнитьРСДополнительныеСведенияпоСЕ() Экспорт
	Запись = РегистрыСведений.ДополнительныеСведенияпоСЕ.СоздатьМенеджерЗаписи();
	Период = НеобходимоЗаполнитьРСДополнительныеСведенияпоСЕ.Период;
	Запись.Период = ?(Период <> Неопределено, Период, ТекущаяДатаСеанса());
	Запись.СтруктурнаяЕдиница = Ссылка;  
	Запись.Фирма = Справочники.Организации.ТСКомандор;
	Запись.ТипДопИнформации = Перечисления.ТипыДопИнформацииКом.Подформат;
	Запись.Информация = ПодФорматы; 
	Запись.Записать();                                
	НеобходимоЗаполнитьРСДополнительныеСведенияпоСЕ.Выполнить = Ложь;
	НеобходимоЗаполнитьРСДополнительныеСведенияпоСЕ.Период = Неопределено;
КонецПроцедуры                                      
// }} pechericadv 22.07.2023 Иванова. АСТОР_ТОВ_253 

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ОмПроцедурыСетевогоОбмена.ОтказИзмененияНеВЦентральномУзлеСети(ОбменДанными.Загрузка) Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Изменение возможно только в центральном узле сети.");
	КонецЕсли; 
	
КонецПроцедуры

// lebv >>>
Процедура РекурсивноНайтиРодителей(МассивРодители, Параметр)
	РодительПараметра = Параметр.Родитель;
	Если ЗначениеЗаполнено(РодительПараметра) Тогда 
		МассивРодители.Добавить(РодительПараметра);
		РекурсивноНайтиРодителей(МассивРодители, РодительПараметра);
	КонецЕсли;
КонецПроцедуры
#КонецЕсли

Процедура ПередЗаписью(Отказ)
	
	// + Роман Хаданович 26.06.2017 ТЗ 1497 - Королев В.Г. - Атоматическое сключение новых магазинов из начисления премии
	Если ЭтоНовый() Тогда
		НеобходимоЗаполнитьДСПоФорматам = Истина;                                         
		Если ЗначениеЗаполнено(ПодФорматы) Тогда
			// {{ pechericadv 27.07.2023 Иванова. АСТОР_ТОВ_253 
			НеобходимоЗаполнитьРСДополнительныеСведенияпоСЕ.Выполнить = Истина; 
			НеобходимоЗаполнитьРСДополнительныеСведенияпоСЕ.Период = ТекущаяДатаСеанса();
			// }} pechericadv 27.07.2023 Иванова. АСТОР_ТОВ_253 
		КонецЕсли;
		
		// BSLLS-выкл
		// {{ Хаданович Роман - 17.03.2026 - Остановить автоматическое создание «Структурных единиц» в Асторе. Куклинская ОВ 
		Если Не	(ОбменДанными.Загрузка И ОбщиеПроцедурыИФункцииПовтИсп.ЭтоБазаЦентральногоОфиса() = Ложь) Тогда
			// Исключение на запись в Магазине во время обмена
			// Важно! В ЦО запрещаем запись даже если это обмен. Так как в магазинах запрещено изменять СЕ, а другие обмены не должны менять СЕ
			Если Не ОбщегоНазначения.глРольДоступна("СправочникиОПЕРАТИВНОГОУчета") Тогда
				Отказ = Истина;              
				ТекстОшибки = "Запрет от отдела ""Мастер данных"": для создания СЕ необходима роль ""Справочники оперативного учета""";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки); 
				ЗаписьЖурналаРегистрации("Данные.Изменение", УровеньЖурналаРегистрации.Ошибка, Метаданные(), Ссылка, ТекстОшибки + " Наименование СЕ: " + СокрЛП(Наименование));
			КонецЕсли; 
		КонецЕсли;
		// }} Хаданович Роман - 17.03.2026 - Остановить автоматическое создание «Структурных единиц» в Асторе. Куклинская ОВ
		// BSLLS-вкл
		
	Иначе
		
		Если Направление <> Ссылка.Направление Тогда
			ТекстСообщения = "Изменен формат Структурной единицы, рекомендуется нажать кнопку 'Заполнить РС ""ДС по форматам""'";
			ТекстСообщения = ТекстСообщения + "чтобы обновить данные в активных ДС на премии поставщикам!";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли; 
		
	КонецЕсли;
	// - Роман Хаданович 26.06.2017 ТЗ 1497 - Королев В.Г. - Атоматическое сключение новых магазинов из начисления премии  
	
КонецПроцедуры

#КонецОбласти   

#Область Инициализация
// <<<
КэшМатрица = Ссылка.АссортиментнаяМатрица; // lebv
#КонецОбласти                                     

// {{ pechericadv 27.07.2023 Иванова. АСТОР_ТОВ_253 
НеобходимоЗаполнитьРСДополнительныеСведенияпоСЕ = Новый Структура;
