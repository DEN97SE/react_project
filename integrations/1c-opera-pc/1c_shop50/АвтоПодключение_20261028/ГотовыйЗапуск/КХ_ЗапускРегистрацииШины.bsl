// Новый ГЛОБАЛЬНЫЙ общий модуль: Сервер=Да, ВнешнееСоединение=Да, Глобальный=Да.
// Привилегированный=Нет. Повторное использование=Не использовать.
// Экспортные методы вызываются центральным отправлятором через внешнее соединение.

// {{ semidockij - 28.10.2026 - Подготовка отдельной базы к регистрации без записи
// Назначение: возвращает GUID, имя и состояние очереди для решения о допустимости перехода.
// Как работает: читает техническое состояние и собственные исходящие строки, не раскрывает ключи.
// }} semidockij - 28.10.2026
Функция КХ_ПолучитьДанныеРегистрацииШины() Экспорт
    Данные = КХ_СостояниеРегистрацииШины();
    Возврат КХ_ОбменШиныОпера.ВJSON(Данные);
КонецФункции

// {{ semidockij - 28.10.2026 - Применение индивидуального результата центрального HTTP-запроса
// Назначение: проверяет магазин/старую очередь, настраивает адреса отправителей и два подключения.
// Как работает: принимает секреты только в параметре, возвращает этап без секретов и текста исключения платформы.
// Не отправляет товары, не запускает full и не очищает очередь. Запись настроек двух сервисов последовательна.
// }} semidockij - 28.10.2026
Функция КХ_ПрименитьРегистрациюШины(ОтветJSON, ОжидаемыйМагазин,
    АдресOpera = "", АдресPC = "", ПолучательOpera = "BackendOpera", ПолучательPC = "Backend_PC") Экспорт
    Итог = Новый Структура("store_id,applied,error,stage", "", Ложь, Ложь, "Проверка");
    Попытка
        Данные = КХ_СостояниеРегистрацииШины();
        Итог.store_id = Данные.store_id;
        Если Данные.store_id <> ОжидаемыйМагазин Тогда
            ВызватьИсключение "Другая база";
        КонецЕсли;
        Если НЕ Данные.can_apply Тогда
            Итог.stage = "Требуется завершение прежней очереди/сессии";
            ВызватьИсключение "Требуется завершение прежней очереди/сессии";
        КонецЕсли;
        Ответ = КХ_ОбменШиныОпера.ИзJSON(ОтветJSON);
        Если ТипЗнч(Ответ) <> Тип("Структура") Тогда ВызватьИсключение "Неверный ответ"; КонецЕсли;
        Если КХ_ОбменШиныОпера.СтроковоеПоле(Ответ, "Код") <> Данные.store_id Тогда
            ВызватьИсключение "Ответ другому магазину";
        КонецЕсли;
        ИдентификаторКлюча = КХ_ОбменШиныОпера.СтроковоеПоле(Ответ, "clientid");
        СекретКлиента = КХ_ОбменШиныОпера.СтроковоеПоле(Ответ, "clientsecret");
        Если ПустаяСтрока(ИдентификаторКлюча) ИЛИ ПустаяСтрока(СекретКлиента) Тогда
            ВызватьИсключение "Неполный ответ";
        КонецЕсли;
        План = Новый Структура("Магазин,Подключения", Данные.store_id, Новый Массив);
        План.Подключения.Добавить(Новый Структура("Сервис,Адрес,ИдентификаторКлюча,СекретКлиента,Активность",
            "ExchOperaPC", АдресOpera, ИдентификаторКлюча, СекретКлиента, Истина));
        План.Подключения.Добавить(Новый Структура("Сервис,Адрес,ИдентификаторКлюча,СекретКлиента,Активность",
            "ExchPriceChecker", АдресPC, ИдентификаторКлюча, СекретКлиента, Истина));
        КХ_НастройкаПодключенийШины.ПроверитьПлан(План);
        Итог.stage = "Маршруты";
        // Штатные ограничители маршрутов остаются включёнными.
        КХ_ОбменШиныОпера.НастроитьМаршрутПрайсЧекеров(Данные.store_id, ПолучательPC);
        КХ_ОбменШиныОпера.НастроитьПолучателяОпера(ПолучательOpera);
        КХ_ОбменШиныОпера.УстановитьКодУзлаОтправителя(Данные.store_id);
        Итог.stage = "Настройки сервисов";
        Результаты = КХ_НастройкаПодключенийШины.ПрименитьПлан(План);
        Успех = Результаты.Количество() = 2;
        Для Каждого Результат Из Результаты Цикл
            Если Результат.Ошибка ИЛИ НЕ Результат.НастройкиЗаписаны
                ИЛИ НЕ Результат.АктивностьУстановлена Тогда Успех = Ложь; КонецЕсли;
        КонецЦикла;
        Итог.applied = Успех;
        Итог.error = НЕ Успех;
        Итог.stage = ?(Успех, "Параметры записаны; связь и ACK проверяются отдельно", "Не все настройки применены");
    Исключение
        Итог.error = Истина;
    КонецПопытки;
    Возврат КХ_ОбменШиныОпера.ВJSON(Итог);
КонецФункции

// {{ semidockij - 28.10.2026 - Проверка записанных параметров без выдачи секретов
// Назначение: после обновления кэша сравнивает адреса, идентификатор ключа и активность.
// Как работает: пароль не читает, не выводит; проверка не заменяет сетевую авторизацию и ACK.
// }} semidockij - 28.10.2026
Функция КХ_ПроверитьЗаписьРегистрацииШины(ОжидаемыйМагазин, ИдентификаторКлюча,
    АдресOpera = "", АдресPC = "") Экспорт
    Результат = Новый Структура("store_id,settings_verified,error", "", Ложь, Ложь);
    Попытка
        Результат.store_id = КХ_ОбменШиныОпера.ИдентификаторМагазина();
        Если Результат.store_id <> ОжидаемыйМагазин Тогда ВызватьИсключение "Другая база"; КонецЕсли;
        Успех = КХ_ОбменШиныОпера.КодУзлаОтправителя() = ОжидаемыйМагазин;
        МаршрутPC = КХ_ОбменШиныОпера.ПараметрыМаршрутаПрайсЧекеров();
        Если НЕ МаршрутPC.Настроен ИЛИ МаршрутPC.КодОтправителя <> ОжидаемыйМагазин Тогда Успех = Ложь; КонецЕсли;
        Для Каждого ИмяСервиса Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
            Настройки = СервисыИнтеграции[ИмяСервиса].ПолучитьНастройки();
            Если Настройки.ИмяПользователяВнешнегоСервисаИнтеграции <> ИдентификаторКлюча
                ИЛИ НЕ СервисыИнтеграции[ИмяСервиса].ПолучитьАктивность() Тогда Успех = Ложь; КонецЕсли;
            Адрес = ?(ИмяСервиса = "ExchOperaPC", АдресOpera, АдресPC);
            Если НЕ ПустаяСтрока(Адрес) И Настройки.АдресВнешнегоСервисаИнтеграции <> Адрес Тогда
                Успех = Ложь;
            КонецЕсли;
        КонецЦикла;
        Результат.settings_verified = Успех;
    Исключение
        Результат.error = Истина;
    КонецПопытки;
    Возврат КХ_ОбменШиныОпера.ВJSON(Результат);
КонецФункции

// {{ semidockij - 28.10.2026 - Ограничитель перехода существующих баз
// Назначение: разрешает новую регистрацию при отсутствии прежней незавершённой выгрузки и исходящей очереди.
// Как работает: читает только собственные записи, учитывает оба товарных проекта и общий справочник.
// Полные сессии, запросы и неподтверждённые пакеты должны быть завершены до смены личности подключения.
// }} semidockij - 28.10.2026
Функция КХ_СостояниеРегистрацииШины()
    Данные = Новый Структура("store_id,name,can_apply,pending_packets,full_active,pending_requests,services_present,addresses_ready,opera_address_ready,pc_address_ready,directory_identity_conflict",
        КХ_ОбменШиныОпера.ИдентификаторМагазина(), Строка(КХ_ОбменШиныОпера.ТекущаяСЕ()), Истина,
        0, Ложь, 0, Истина, Истина, Ложь, Ложь, Ложь);
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "Не запускайте регистрацию в транзакции"; КонецЕсли;
    Для Каждого ИмяСервиса Из СтрРазделить("ExchOperaPC,ExchPriceChecker", ",") Цикл
        Если Метаданные.СервисыИнтеграции.Найти(ИмяСервиса) = Неопределено Тогда
            Данные.services_present = Ложь;
        Иначе
            Настройки = СервисыИнтеграции[ИмяСервиса].ПолучитьНастройки();
            Если ИмяСервиса = "ExchOperaPC" Тогда
                Данные.opera_address_ready = НЕ ПустаяСтрока(Настройки.АдресВнешнегоСервисаИнтеграции);
            Иначе
                Данные.pc_address_ready = НЕ ПустаяСтрока(Настройки.АдресВнешнегоСервисаИнтеграции);
            КонецЕсли;
            Если ПустаяСтрока(Настройки.АдресВнешнегоСервисаИнтеграции) Тогда Данные.addresses_ready = Ложь; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    ЗапросОчереди = Новый Запрос;
    ЗапросОчереди.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК amount
    |ИЗ РегистрСведений.ОчередьШины КАК Очередь
    |ГДЕ Очередь.ВнешняяСистема В (""Opera"", ""PriceCheker"", ""StructuralUnits"")
    | И Очередь.СтатусСообщения <> &Подтверждено";
    ЗапросОчереди.УстановитьПараметр("Подтверждено", Перечисления.СтатусыСообщенийШины.ДоставкаПодтверждена);
    Данные.pending_packets = ЗапросОчереди.Выполнить().Выгрузить()[0].amount;
    ЗапросСостояния = Новый Запрос;
    ЗапросСостояния.Текст = "ВЫБРАТЬ Очередь.ИдентификаторОбъекта КАК id, Очередь.УзелПолучатель КАК node,
    | Очередь.СтроковыйОбъект КАК json, Очередь.СтатусСообщения КАК status
    |ИЗ РегистрСведений.ОчередьШины КАК Очередь
    |ГДЕ Очередь.ВнешняяСистема = ""OperaState"" И Очередь.КаналСервисаИнтеграции = """"";
    Для Каждого СтрокаСостояния Из ЗапросСостояния.Выполнить().Выгрузить() Цикл
        Узел = СокрЛП(СтрокаСостояния.node);
        Идентификатор = СокрЛП(СтрокаСостояния.id);
        КорневоеСостояние = Идентификатор = "КХ_OperaState" И ПустаяСтрока(Узел);
        Если КорневоеСостояние ИЛИ Идентификатор = "КХ_СЕState" Тогда
            Состояние = КХ_ОбменШиныОпера.ИзJSON(СтрокаСостояния.json);
            Если Идентификатор = "КХ_СЕState" Тогда
                ИсточникСправочника = КХ_ОбменШиныОпера.СтроковоеПоле(Состояние, "source_node");
                Если НЕ ПустаяСтрока(ИсточникСправочника) И ИсточникСправочника <> Данные.store_id Тогда
                    Данные.directory_identity_conflict = Истина;
                КонецЕсли;
            КонецЕсли;
            ПолнаяАктивна = Ложь;
            Если Состояние.Свойство("full_active", ПолнаяАктивна) И ПолнаяАктивна Тогда Данные.full_active = Истина; КонецЕсли;
            Запросы = Неопределено;
            Если Состояние.Свойство("catalog_requests", Запросы) Тогда
                Данные.pending_requests = Данные.pending_requests + Запросы.Количество();
            КонецЕсли;
        КонецЕсли;
        Если Узел = "КХ_СЕRequest_opera" ИЛИ Узел = "КХ_СЕRequest_pricechecker"
            ИЛИ Узел = "КХ_CatalogRequest_opera" ИЛИ Узел = "КХ_CatalogRequest_pricechecker" Тогда
            Если СтрокаСостояния.status = Перечисления.СтатусыСообщенийШины.ОжидаетОтправки Тогда
                Данные.pending_requests = Данные.pending_requests + 1;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Данные.can_apply = Данные.services_present И Данные.pending_packets = 0
        И НЕ Данные.full_active И Данные.pending_requests = 0 И НЕ Данные.directory_identity_conflict;
    Возврат Данные;
КонецФункции
