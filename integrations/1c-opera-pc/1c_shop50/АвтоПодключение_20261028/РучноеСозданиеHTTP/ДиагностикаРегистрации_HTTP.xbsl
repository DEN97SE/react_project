// semidockij — read-only диагностика перед повтором регистрации.
структура ДиагностикаРегистрации
    пер code: Строка = ""
    пер stage: Строка = ""
    пер info_system_exists: Булево = Ложь
    пер user_by_code_found: Булево = Ложь
    пер user_by_name_found: Булево = Ложь
    пер user_by_code_id: Строка = ""
    пер user_by_name_id: Строка = ""
    пер message: Строка = ""
;

// Проверяет ИС и пользователей по представлению GUID и имени.
// Используется только чтение: пользователи, ключи и членство не создаются.
метод ПроверитьРегистрациюМагазина(Запрос: HttpСервисЗапрос)
    пер Данные = новый ДиагностикаРегистрации()
    пер ПараметрКода = Запрос.Параметры.ПолучитьПервый("kod")
    если ПараметрКода == Неопределено
        ОтветитьОшибкой(Запрос, 400, "missing_kod")
        возврат
    ;
    пер Код = НормализоватьКод(ПараметрКода.ВСтроку())
    если Код.Пусто()
        ОтветитьОшибкой(Запрос, 400, "invalid_store_guid")
        возврат
    ;
    пер Наименование = "К0050"
    пер ПараметрИмени = Запрос.Параметры.ПолучитьПервый("name")
    если ПараметрИмени != Неопределено
        Наименование = ПараметрИмени.ВСтроку()
    ;
    Данные.code = Код
    попытка
        Данные.stage = "read_exch"
        Данные.info_system_exists = УчастникСуществует(Код)
        Данные.stage = "get_default_user_list"
        пер Список = СпискиПользователей.ПолучитьСписокПоУмолчанию().Ид
        Данные.stage = "find_user_by_code_representation"
        пер ПользовательПоКоду = ПользователиСервиса.НайтиПоПредставлению(Код, Список)
        если ПользовательПоКоду != Неопределено
            Данные.user_by_code_found = Истина
            Данные.user_by_code_id = ПользовательПоКоду.Ид.ВСтроку()
        ;
        Данные.stage = "find_user_by_name_representation"
        пер ПользовательПоИмени = ПользователиСервиса.НайтиПоПредставлению(Наименование, Список)
        если ПользовательПоИмени != Неопределено
            Данные.user_by_name_found = Истина
            Данные.user_by_name_id = ПользовательПоИмени.Ид.ВСтроку()
        ;
        Данные.stage = "done"
    поймать Искл: Исключение
        Запрос.Ответ.КодСтатуса = 500
        Данные.message = Искл.Описание
    ;
    УстановитьЗаголовкиОтвета(Запрос)
    Запрос.Ответ.УстановитьТело(СериализацияJson.ЗаписатьОбъект(Данные))
;
