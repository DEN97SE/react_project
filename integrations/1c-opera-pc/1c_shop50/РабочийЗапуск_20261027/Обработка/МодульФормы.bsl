// {{ semidockij - 27.10.2026 - Пояснения к методам
// Назначение: начинает полную сессию магазинов для настроенных получателей Opera и PC.
// Как работает: требует заранее включённую публикацию, затем вызывает общий метод полной сессии.
// Сама форма не вызывает отправителей; при включённом задании сообщения начнут обрабатываться по расписанию.
// }} semidockij - 27.10.2026
&НаСервере
Процедура ПодготовитьВсеМагазиныНаСервере()
	ПроверитьВключениеСправочника();
	Сессия = КХ_ОбменСтруктурныхЕдиниц.НачатьПолнуюВыгрузку(РазмерПорцииДляЗапуска());
	Состояние = "Полная сессия справочника: " + Сессия + Символы.ПС
		+ "Порции и отправку продолжает задание справочника." + Символы.ПС + ПолучитьТекстСостояния();
КонецПроцедуры

// {{ semidockij - 27.10.2026 - Пояснения к методам
// Назначение: сохраняет обновление выбранного магазина для обоих проектов.
// Как работает: проверяет выбор, передаёт одну ссылку в ПодготовитьВыбранныеМагазины и обновляет текст состояния.
// При пометке удаления передаётся ID удаления; остальные магазины на бэках не заменяются.
// }} semidockij - 27.10.2026
&НаСервере
Процедура ПодготовитьВыбранныйМагазинНаСервере()
	ПроверитьВключениеСправочника();
	Если НЕ ЗначениеЗаполнено(Магазин) Тогда ВызватьИсключение "Выберите магазин"; КонецЕсли;
	Если Магазин.ЭтоГруппа Тогда ВызватьИсключение "Нужен магазин, а не группа справочника"; КонецЕсли;
	Ссылки = Новый Массив;
	Ссылки.Добавить(Магазин);
	Если НЕ КХ_ОбменСтруктурныхЕдиниц.ПодготовитьВыбранныеМагазины(Ссылки) Тогда
		ВызватьИсключение "По выбранной СЕ не подготовлены данные";
	КонецЕсли;
	Состояние = "Карточка выбранного магазина поставлена в очередь." + Символы.ПС
		+ "Доставку продолжает задание справочника." + Символы.ПС + ПолучитьТекстСостояния();
КонецПроцедуры

// {{ semidockij - 27.10.2026 - Пояснения к методам
// Назначение: начинает полную товарную сессию текущей базы после явной настройки обоих маршрутов.
// Как работает: проверяет вид текущей СЕ, адрес PC и сохранённого получателя Opera, затем вызывает НачатьПолнуюВыгрузку.
// Поле Магазин на форме относится к справочнику магазинов и не переключает источник товарных цен и остатков.
// }} semidockij - 27.10.2026
&НаСервере
Процедура НачатьКаталогТоваровНаСервере()
	ТекущаяСЕ = КХ_ОбменШиныОпера.ТекущаяСЕ();
	Если ТекущаяСЕ.ВидСтруктурнойЕдиницы <> Перечисления.ВидыСтруктурныхЕдиниц.Магазин Тогда
		ВызватьИсключение "Товарный каталог запускается только в базе своего магазина";
	КонецЕсли;
	МаршрутPC = КХ_ОбменШиныОпера.ПараметрыМаршрутаПрайсЧекеров();
	Если НЕ МаршрутPC.Настроен Тогда ВызватьИсключение "Сначала настройте явный товарный маршрут PC"; КонецЕсли;
	СостояниеКаталога = ПрочитатьСостояниеКаталогаДляФормы();
	Если ПустаяСтрока(КХ_ОбменШиныОпера.СтроковоеПоле(СостояниеКаталога, "opera_backend_node")) Тогда
		ВызватьИсключение "Сначала настройте явного получателя Opera";
	КонецЕсли;
	Сессия = КХ_ОбменШиныОпера.НачатьПолнуюВыгрузку(РазмерПорцииДляЗапуска());
	Состояние = "Полная товарная сессия своего магазина: " + Сессия + Символы.ПС
		+ "Подготовку, доставку и очистку продолжает общее товарное задание." + Символы.ПС + ПолучитьТекстСостояния();
КонецПроцедуры

// {{ semidockij - 27.10.2026 - Пояснения к методам
// Назначение: включает обработку сохранённых пакетов справочника после тестовой подготовки или паузы.
// Как работает: требует выключенную публикацию и вызывает API возобновления без смены адресов и нового полного снимка.
// После включения задания обработает очередь; пропущенные при паузе события сверяются отдельной полной выгрузкой.
// }} semidockij - 27.10.2026
&НаСервере
Процедура ВозобновитьСправочникНаСервере()
	Если КХ_ОбменСтруктурныхЕдиниц.ПубликацияВключена() Тогда
		ВызватьИсключение "Публикация уже включена. Возобновление не требуется";
	КонецЕсли;
	КХ_ОбменСтруктурныхЕдиниц.ВозобновитьПубликациюБезНовойПолной();
	Состояние = "Публикация справочника включена без нового full." + Символы.ПС
		+ "Отправку сохранённых пакетов выполнит следующее задание справочника." + Символы.ПС + ПолучитьТекстСостояния();
КонецПроцедуры

// {{ semidockij - 27.10.2026 - Пояснения к методам
// Назначение: запрещает кнопкам подготовки неявно включать публикацию или менять источник.
// Как работает: читает выключатель, при отключении предлагает выполнить отдельную начальную настройку источника.
// Проверку привязки к ЦО и текущей СЕ дополнительно выполняют общие методы подготовки.
// }} semidockij - 27.10.2026
&НаСервере
Процедура ПроверитьВключениеСправочника()
	Если НЕ КХ_ОбменСтруктурныхЕдиниц.ПубликацияВключена() Тогда
		ВызватьИсключение "Публикация справочника выключена. Сначала выполните начальную настройку или возобновите подготовленную очередь";
	КонецЕсли;
КонецПроцедуры

// {{ semidockij - 27.10.2026 - Пояснения к методам
// Назначение: возвращает целый размер порции в допустимом для формы диапазоне.
// Как работает: ограничивает введённое число диапазоном 1-500, затем обновляет реквизит формы.
// Общий интерфейс подходит и товарной выгрузке, и справочнику магазинов.
// }} semidockij - 27.10.2026
&НаСервере
Функция РазмерПорцииДляЗапуска()
	РазмерПакета = Мин(500, Макс(1, Цел(РазмерПакета)));
	Возврат РазмерПакета;
КонецФункции

// {{ semidockij - 27.10.2026 - Пояснения к методам
// Назначение: обновляет многострочный реквизит Состояние диагностическим текстом.
// Как работает: вызывает единый сборщик текста без подготовки пакетов и без вызова сети.
// }} semidockij - 27.10.2026
&НаСервере
Процедура ОбновитьСостояниеНаСервере()
	Состояние = ПолучитьТекстСостояния();
КонецПроцедуры

// {{ semidockij - 27.10.2026 - Пояснения к методам
// Назначение: формирует сводку контекста, маршрутов и числа записей своих очередей.
// Как работает: читает параметры справочника, товарный маршрут и группирует ОчередьШины по системе и статусу.
// Товарные getter могут впервые создать техническую строку состояния; сама функция не инициирует full и не отправляет сообщения.
// }} semidockij - 27.10.2026
&НаСервере
Функция ПолучитьТекстСостояния()
	Строки = Новый Массив;
	ТекущаяСЕ = КХ_ОбменШиныОпера.ТекущаяСЕ();
	Строки.Добавить("Текущая СЕ базы: " + Строка(ТекущаяСЕ));
	Строки.Добавить("База ЦО: " + Строка(ОбщиеПроцедурыИФункцииПовтИсп.ЭтоБазаЦентральногоОфиса()));
	Настройки = КХ_ОбменСтруктурныхЕдиниц.ПараметрыПубликации();
	Строки.Добавить("Публикация справочника: " + Строка(Настройки.enabled));
	Строки.Добавить("Источник справочника: " + Настройки.source_id);
	Строки.Добавить("Получатель справочника Opera: " + Настройки.opera_node);
	Строки.Добавить("Общий получатель справочника PC: " + КХ_ОбменШиныОпера.СтроковоеПоле(Настройки, "pc_directory_node"));
	Строки.Добавить("Активный полный справочник: " + Строка(Настройки.full_active));
	МаршрутPC = КХ_ОбменШиныОпера.ПараметрыМаршрутаПрайсЧекеров();
	Строки.Добавить("Товарный отправитель Opera: " + КХ_ОбменШиныОпера.КодУзлаОтправителя());
	Строки.Добавить("Товарный маршрут PC: " + МаршрутPC.КодОтправителя + " -> " + МаршрутPC.КодПолучателя);
	СостояниеКаталога = ПрочитатьСостояниеКаталогаДляФормы();
	Строки.Добавить("Товарный получатель Opera: " + КХ_ОбменШиныОпера.СтроковоеПоле(СостояниеКаталога, "opera_backend_node"));
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Очередь.ВнешняяСистема КАК Система,
	| Очередь.СтатусСообщения КАК Статус, КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ РегистрСведений.ОчередьШины КАК Очередь
	|ГДЕ Очередь.ВнешняяСистема В (""Opera"", ""PriceCheker"", ""StructuralUnits"")
	|СГРУППИРОВАТЬ ПО Очередь.ВнешняяСистема, Очередь.СтатусСообщения";
	Для Каждого СтрокаОчереди Из Запрос.Выполнить().Выгрузить() Цикл
		Строки.Добавить(СтрокаОчереди.Система + " | " + Строка(СтрокаОчереди.Статус) + " | " + Строка(СтрокаОчереди.Количество));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// {{ semidockij - 27.10.2026 - Пояснения к методам
// Назначение: читает сохранённые товарные параметры для показа и проверки получателя Opera.
// Как работает: выбирает только технический ключ КХ_OperaState и разбирает его JSON.
// Возвращает пустую структуру при отсутствии строки; ничего не записывает и не меняет поля состояния.
// }} semidockij - 27.10.2026
&НаСервере
Функция ПрочитатьСостояниеКаталогаДляФормы()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Очередь.СтроковыйОбъект КАК Текст
	|ИЗ РегистрСведений.ОчередьШины КАК Очередь
	|ГДЕ Очередь.ВнешняяСистема = ""OperaState""
	| И Очередь.ИдентификаторОбъекта = ""КХ_OperaState""
	| И Очередь.УзелПолучатель = """" И Очередь.КаналСервисаИнтеграции = """"";
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 0 Тогда Возврат Новый Структура; КонецЕсли;
	Если Таблица.Количество() <> 1 Тогда ВызватьИсключение "Найден дубль состояния товарного обмена"; КонецЕсли;
	Возврат КХ_ОбменШиныОпера.ИзJSON(Таблица[0].Текст);
КонецФункции
