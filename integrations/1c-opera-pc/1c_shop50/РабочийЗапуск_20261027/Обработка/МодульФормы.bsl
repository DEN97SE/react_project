// {{ semidockij - 27.10.2026 - Пояснения к методам
// Назначение: задаёт начальный размер порции и показывает текущее состояние обмена.
// Как работает: выбирает текущую СЕ для поля Магазин, затем читает настройки и счётчики очереди.
// Ошибку контекста показывает текстом, не запускает подготовку или отправку сообщений.
// }} semidockij - 27.10.2026
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РазмерПакета = 200;
	Попытка
		Магазин = КХ_ОбменШиныОпера.ТекущаяСЕ();
		ОбновитьСостояниеНаСервере();
	Исключение
		Состояние = "Не удалось прочитать контекст обмена: " + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

// {{ semidockij - 27.10.2026 - Пояснения к методам
