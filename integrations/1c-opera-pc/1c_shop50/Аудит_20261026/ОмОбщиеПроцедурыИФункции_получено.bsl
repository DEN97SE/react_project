Функция ПроверкаКонтрольЦен(Контрагент, Договор, Дата) Экспорт
	Если Дата = Дата(1, 1, 1) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Если ТипЗнч(Контрагент) <> Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат Ложь;
	КонецЕсли;	
	Если Контрагент.ЦеныПоКонтрагенту Тогда
		Если Дата >= Контрагент.ДатаНачалаКонтрольЦен Тогда
			КонтрольЦен = Контрагент.КонтрольЦен;
		Иначе
