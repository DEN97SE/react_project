// <Описание функции>
//
// Параметры:
//  <СтруктурнаяЕдиница>  - Справочник.СтруктурныеЕдиницы
//
// Возвращаемое значение:
// СтруктураОсновныхРеквизитов - Тип Структура
// Включает реквизиты:
//   НомерМагазина   - ВАЖНО! Всегда должна быть числом. Ноль в случае, если это не магазин
//   ЭтоМагазин      - Всегда Булево
//
Функция ОсновныеРеквизитыСтруктурнойЕдиницы(СтруктурнаяЕдиница) Экспорт
	
	СтруктураОсновныхРеквизитов = Новый Структура;
	СтруктураОсновныхРеквизитов.Вставить("Ссылка",       Неопределено);
	СтруктураОсновныхРеквизитов.Вставить("Наименование", Неопределено);
	СтруктураОсновныхРеквизитов.Вставить("ПометкаУдаления", Неопределено);
	СтруктураОсновныхРеквизитов.Вставить("Работает",        Неопределено);
	СтруктураОсновныхРеквизитов.Вставить("НомерМагазина", 0);  // ВАЖНО! Всегда должна быть числом
	СтруктураОсновныхРеквизитов.Вставить("Направление", Неопределено);
	СтруктураОсновныхРеквизитов.Вставить("Филиал",      Неопределено);
	СтруктураОсновныхРеквизитов.Вставить("ДатаЗакрытия", Неопределено);
	СтруктураОсновныхРеквизитов.Вставить("ЭтоРаспределительныйЦентр", Неопределено);
	СтруктураОсновныхРеквизитов.Вставить("ЭтоЛогистическийОператор",  Неопределено);
	СтруктураОсновныхРеквизитов.Вставить("ЭтоМагазин", Ложь); // ВАЖНО! Всегда должно быть Булево
	
	Если ТипЗнч(СтруктурнаяЕдиница) = тип("СправочникСсылка.СтруктурныеЕдиницы") 
		  И ЗначениеЗаполнено(СтруктурнаяЕдиница) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КХ_СлужебныеСЕНеиспользуемыеКакМагазины.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница
		|ПОМЕСТИТЬ ВТ_НеиспользуемыеСЕ
		|ИЗ
		|	РегистрСведений.КХ_СлужебныеСЕНеиспользуемыеКакМагазины КАК КХ_СлужебныеСЕНеиспользуемыеКакМагазины
		|ГДЕ
		|	КХ_СлужебныеСЕНеиспользуемыеКакМагазины.СтруктурнаяЕдиница = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтруктурныеЕдиницы.Ссылка КАК Ссылка,
		|	СтруктурныеЕдиницы.Наименование КАК Наименование,
		|	СтруктурныеЕдиницы.ПометкаУдаления КАК ПометкаУдаления,
		|	СтруктурныеЕдиницы.Работает КАК Работает,
		|	СтруктурныеЕдиницы.НомерМагазина КАК НомерМагазина,
		|	СтруктурныеЕдиницы.Направление КАК Направление,
		|	СтруктурныеЕдиницы.Филиал КАК Филиал,
		|	СтруктурныеЕдиницы.ДатаЗакрытия КАК ДатаЗакрытия,
		|	СтруктурныеЕдиницы.ЭтоРаспределительныйЦентр КАК ЭтоРаспределительныйЦентр,
		|	СтруктурныеЕдиницы.ЭтоЛогистическийОператор КАК ЭтоЛогистическийОператор,
		|	ВЫБОР
		|		КОГДА СтруктурныеЕдиницы.ЭтоРаспределительныйЦентр = ИСТИНА
		|				ИЛИ СтруктурныеЕдиницы.ЭтоЛогистическийОператор = ИСТИНА
		|				ИЛИ СтруктурныеЕдиницы.Направление В (&МассивНаправленийНеМагазинов)
		|				ИЛИ НЕ ВТ_НеиспользуемыеСЕ.СтруктурнаяЕдиница ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЭтоМагазин
		|ИЗ
		|	Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НеиспользуемыеСЕ КАК ВТ_НеиспользуемыеСЕ
		|		ПО (ВТ_НеиспользуемыеСЕ.СтруктурнаяЕдиница = СтруктурныеЕдиницы.Ссылка)
		|ГДЕ
		|	СтруктурныеЕдиницы.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", СтруктурнаяЕдиница);  
		
		МассивНаправленийНеМагазинов = Новый Массив;
		МассивНаправленийНеМагазинов.Добавить(Справочники.Направления.РаспределительныйЦентр);
		МассивНаправленийНеМагазинов.Добавить(Справочники.Направления.ПолучитьСсылку(
		    Новый УникальныйИдентификатор("720df57a-31d0-11e6-8a3e-5ef3fd361d6b"))); // Оптовые продажи
