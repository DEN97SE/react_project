// {{ gorenski - 2022.06.16 - #Универсальная функция в рамках избавления от техдолга
// Возвращает ссылку объекта по уникальному идентификатору, уменьшая цикломатическую вложенность
//
// Параметры:
//  СсылочныйОбъект - СправочникСсылка, ДокументСсылка - объект любого ссылочного типа
//  Идентификатор - Строка
//  ЗначениеПоУмолчанию - Неопределено - любое значение
// Возвращаемое значение:
// 	СправочникСсылка, ДокументСсылка - объект любого ссылочного типа
Функция СсылкаПоИдентификатору(СсылочныйОбъект, Идентификатор, ЗначениеПоУмолчанию = Неопределено) Экспорт

	Результат = ЗначениеПоУмолчанию;
	
	// Нельзя использовать ЗначениеЗаполнено, т.к. &НаСервере возникает ошибка мутабельного значения
	Если Идентификатор = Неопределено
		 ИЛИ ПустаяСтрока(Идентификатор) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	ТекстОшибки = "";
	Попытка
		УИД = Новый УникальныйИдентификатор(Идентификатор);
		Результат = СсылочныйОбъект.ПолучитьСсылку(УИД);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // СсылкаПоИдентификатору()

// Удаляет в попытке файл, уменьшая цикломатическую вложенность
//
// Параметры:
//  СерверФТП - FTPСоединение - сервер ФТП
//  ИмяФайла - Строка
// Возвращаемое значение:
// 	Булево - результат корректного удления
Функция УдалитьФайлНаФТПСервере(СерверФТП, ИмяФайла) Экспорт

	Результат = Истина;
	
	ТекстОшибки = "";
	Попытка
		СерверФТП.Удалить(ИмяФайла);
	Исключение
		Результат = Ложь;
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // УдалитьФайлНаФТПСервере()
// }} gorenski - 2022.06.16 - #Универсальная функция в рамках избавления от техдолга

// {{ gorenski - 04.08.2022 - #Тиражирование WMS
// Удаляет файл в попытке, если не получается - регистрирует к удалению регламентым заданием
// Параметры:
//  ИмяФайлаИлиПуть - Строка
//  ИмяУдаляемогоФайла - Строка
Процедура УдалитьФайл(ИмяФайлаИлиПуть, ИмяУдаляемогоФайла = Неопределено) Экспорт
	
	УдаляемоеИмяФайла = "";
	Если ИмяУдаляемогоФайла = Неопределено Тогда
		УдаляемоеИмяФайла = СокрЛП(ИмяФайлаИлиПуть);
	Иначе
		УдаляемоеИмяФайла = ИмяФайла(ИмяФайлаИлиПуть, ИмяУдаляемогоФайла);
	КонецЕсли;
	
	РегистрыСведений.УдалениеФайлов.УдалитьФайл(УдаляемоеИмяФайла);

КонецПроцедуры // УдалитьФайл()
// }} gorenski - 04.08.2022 - #Тиражирование WMS

// {{ gorenski - 31.05.2023
// Возвращает корректное имя файла с учетом слеша после имени каталога в Windows и Linux
// Параметры:
//  Путь - Строка
//  ИмяФайла - Строка
// Возвращаемое значение:
// 	Строка - корректное имя файла
Функция ИмяФайла(Путь, ИмяФайла) Экспорт
	
	РезультатПуть = СокрЛП(Путь);
	Если РезультатПуть <> "\" И РезультатПуть <> "\\" Тогда
		Пока Прав(РезультатПуть, 1) = "\"  Цикл
			РезультатПуть = Лев(РезультатПуть, СтрДлина(РезультатПуть) - 1);
		КонецЦикла;
	КонецЕсли;

	Если Не ПустаяСтрока(РезультатПуть) И РезультатПуть <> "\" И РезультатПуть <> "\\" Тогда
		РезультатПуть = РезультатПуть + "\";
	КонецЕсли;
	
	РезультатИмяФайла = СокрЛП(ИмяФайла);
	Пока Лев(РезультатИмяФайла, 1) = "\" Цикл
		РезультатИмяФайла = Сред(РезультатИмяФайла, 2);
	КонецЦикла;
	
	Возврат РезультатПуть + РезультатИмяФайла;

КонецФункции // ИмяФайла()
// }} gorenski - 31.05.2023

