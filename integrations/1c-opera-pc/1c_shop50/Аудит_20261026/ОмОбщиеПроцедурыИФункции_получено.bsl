		КонецЕсли; 
	Иначе
		Если Дата >= Договор.ДатаНачалаКонтрольЦен Тогда
			КонтрольЦен = Договор.КонтрольЦен;
		Иначе
			КонтрольЦен = Ложь;
		КонецЕсли; 
	КонецЕсли;	
	Возврат КонтрольЦен;
КонецФункции	

