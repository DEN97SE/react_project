	В9 = Неопределено,
	В10 = Неопределено,
	В11 = Неопределено,
	В12 = Неопределено,
	В13 = Неопределено,
	В14 = Неопределено,
	В15 = Неопределено,
	В16 = Неопределено,
	В17 = Неопределено,
	В18 = Неопределено,
	В19 = Неопределено,
	В20 = Неопределено) Экспорт
	
	маСписок = Новый Массив();
	маСписок.Добавить(В1);
	маСписок.Добавить(В2);
	маСписок.Добавить(В3);
	маСписок.Добавить(В4);
	маСписок.Добавить(В5);
	маСписок.Добавить(В6);
	маСписок.Добавить(В7);
	маСписок.Добавить(В8);
	маСписок.Добавить(В9);
	маСписок.Добавить(В10);
	маСписок.Добавить(В11);
	маСписок.Добавить(В12);
	маСписок.Добавить(В13);
	маСписок.Добавить(В14);
	маСписок.Добавить(В15);
	маСписок.Добавить(В16);
	маСписок.Добавить(В17);
	маСписок.Добавить(В18);
	маСписок.Добавить(В19);
	маСписок.Добавить(В20);
	
	Пока маСписок.Количество() > 0 И маСписок[маСписок.Количество() - 1] = Неопределено Цикл
		маСписок.Удалить(маСписок.Количество() - 1);
	КонецЦикла;
	
	Возврат маСписок;
	
КонецФункции

// Получает строковый идентификатор типа
// В данной версии корректно работает для ссылок на справочники, документы, и примитивных типов
Функция ПолучитьИдентификаторТипа(Значение) Экспорт
	
	тТип = ТипЗнч(Значение);
	// может быть, это ссылка на справочник или документ?
	Если Справочники.ТипВсеСсылки().СодержитТип(тТип) Тогда
		Возврат "СправочникСсылка." + Значение.Метаданные().Имя;
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(тТип) Тогда
		Возврат "ДокументСсылка." + Значение.Метаданные().Имя;
	КонецЕсли;
	// может быть, это справочник или документ?
	Попытка
		ссСылка = Значение.Ссылка;
		тТипСсылки = ТипЗнч(ссСылка);
		Если Справочники.ТипВсеСсылки().СодержитТип(тТипСсылки) Тогда
			Возврат "СправочникОбъект." + Значение.Метаданные().Имя;
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(тТипСсылки) Тогда
			Возврат "ДокументОбъект." + Значение.Метаданные().Имя;
		КонецЕсли;
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Исключение_омОбщиеПроцедурыИФункции.ПолучитьИдентификаторТипа", 
		  УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат Строка(тТип);
	
КонецФункции
