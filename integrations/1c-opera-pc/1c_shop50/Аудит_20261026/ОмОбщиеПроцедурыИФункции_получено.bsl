//	Ключ - Строка
//	ЗначениеПоУмолчанию - Строка
// Возвращаемое значение:
//  Булево, Число, Строка, Неопределено - Значение любого типа, содержащееся в структуре
Функция ЗначениеСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Результат = ЗначениеПоУмолчанию;
	
	Если ТипЗнч(Структура) = Тип("Структура") И Структура.Свойство(Ключ) Тогда
		Результат = Структура[Ключ];
	КонецЕсли;
	
	Если ТипЗнч(Структура) = Тип("Соответствие") Тогда
		Значение = Структура[Ключ];
		Если Значение <> Неопределено Тогда
			Результат = Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ЗначениеСтруктуры()

