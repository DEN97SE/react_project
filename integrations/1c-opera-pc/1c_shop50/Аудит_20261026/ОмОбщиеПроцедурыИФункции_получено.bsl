Процедура ПриКопированииПриКопировании(Источник, ОбъектКопирования) Экспорт
	
	СобытиеЖР = "Исключение_омОбщиеПроцедурыИФункции.ПриКопированииПриКопировании";
	
	Попытка
		Док = Источник;
		ТипК = Тип("СправочникСсылка.Контрагенты");
		Реквизиты = Док.Метаданные().Реквизиты;
		Для Каждого Стр Из Реквизиты Цикл
			ЗнчРекв = Док[Стр.Имя];
			Если ЗначениеЗаполнено(Док[Стр.Имя]) И ТипЗнч(ЗнчРекв) = ТипК Тогда
				Попытка
					ОтборПричины = Новый Структура;
					ОтборПричины.Вставить("Контрагент", ЗнчРекв);
					ТекущаяРабота = РегистрыСведений.РаботаСКонтрагентами.СрезПоследних(ТекущаяДатаСеанса(), ОтборПричины);
					Если ТекущаяРабота.Количество() > 0 Тогда
						ПричинаИзмененияРежимаРаботы = ТекущаяРабота[0].ПричинаИзмененияРежимаРаботы;
						Если СокрЛП(ПричинаИзмененияРежимаРаботы) <> ""  Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Стр.Имя  + ": Работа с контрагентом прекращена!");
							Док[Стр.Имя] = Справочники.Контрагенты.ПустаяСсылка();
						КонецЕсли;
					КонецЕсли;          
				Исключение
					ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ЗаписьЖурналаРегистрации(СобытиеЖР, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(СобытиеЖР, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
КонецПроцедуры

Функция ПроверкаТЧ(Источник) Экспорт 
	Отказ = Ложь;
	Попытка
		Если Источник.Состав.Количество() = 0 Тогда
			стрСообщение = "Запрещено проведение документов с пустой табличной частью"; 
			ОмОперативныйУчет.СообщитьССервера(стрСообщение, Источник, СтатусСообщения.Внимание);
			Отказ = Истина;
		КонецЕсли;             
	Исключение
	КонецПопытки;
	Возврат Отказ;
КонецФункции
 
#Если Клиент Тогда
Процедура ИзменитьТекущуюСтруктурнуюЕдиницу() Экспорт
	
	Если ПараметрыСеанса.ТекущийПользователь.Владелец.ВидСтруктурнойЕдиницы 
		  = Перечисления.ВидыСтруктурныхЕдиниц.ТорговаяТочка Тогда
		Предупреждение("Пользователю торговой точки запрещено изменять текущую структурную единицу!");
		Возврат;
	КонецЕсли;	
	
	ТекСЕ = ПараметрыСеанса.ТекущаяСтруктурнаяЕдиница;
	ФормаВыбора = Справочники.СтруктурныеЕдиницы.ПолучитьФормуВыбора("ФормаВыбора");
	ФормаВыбора.ЭлементыФормы.СправочникСписок.ТекущаяСтрока = ТекСЕ;
	ЭлементОтбора = ФормаВыбора.СправочникСписок.Отбор.ВидСтруктурнойЕдиницы;
	ЭлементОтбора.ВидСравнения = ВидСравнения.ВСписке;
	сз = Новый СписокЗначений;
	сз.Добавить(Перечисления.ВидыСтруктурныхЕдиниц.ЦентральныйОфис);
	сз.Добавить(Перечисления.ВидыСтруктурныхЕдиниц.ТорговаяТочка);
	ЭлементОтбора.Значение = сз;
	ЭлементОтбора.Использование = Истина;
	ФормаВыбора.ЭлементыФормы.СправочникСписок.НастройкаОтбора.ВидСтруктурнойЕдиницы.Доступность = Ложь;
	Элемент = ФормаВыбора.ОткрытьМодально();
	Если Элемент <> Неопределено Тогда
		  УстановитьТекущуюСЕ(Элемент);
		  УстановитьЗаголовокОкнаСистемы();
	КонецЕсли;
	
КонецПроцедуры
 
Процедура УстановитьЗаголовокОкнаСистемы()  Экспорт
	ЗаголовокСистемы = "";
	// +++tymko 13.11.2018 #Компонента
		
		// Установим
		Если ПланыОбмена.ГлавныйУзел() = Неопределено Тогда
			ЗаголовокСистемы = "АСТОР:Торговая Сеть Центр";
		Иначе
			ЗаголовокСистемы = "АСТОР:Торговая Сеть " + ПараметрыСеанса.ТекущаяСтруктурнаяЕдиница;
		КонецЕсли; 
		
	// ---tymko 13.11.2018 #Компонента
	СЕ = ПараметрыСеанса.ТекущаяСтруктурнаяЕдиница;
	Если ПараметрыСеанса.ЭтоСеть = Истина Тогда 
		Если ПараметрыСеанса.ЭтоМагазин = Ложь Тогда
			// для центра
			Если СЕ.ВидСтруктурнойЕдиницы = Перечисления.ВидыСтруктурныхЕдиниц.ТорговаяТочка Тогда
				УстановитьЗаголовокСистемы("" + ЗаголовокСистемы + " (Торговая точка: " + СЕ + ")");
			Иначе	
				УстановитьЗаголовокСистемы("" + ЗаголовокСистемы + " " + ОмПроцедурыСетевогоОбмена.ОпределитьСтатусИБ());
			КонецЕсли;
		Иначе
			// для магазина в сети
			УстановитьЗаголовокСистемы("" + ЗаголовокСистемы + " " + ОмПроцедурыСетевогоОбмена.ОпределитьСтатусИБ());
		КонецЕсли;
	Иначе
		// для несетевого решения
		Константы.ЗаголовокСистемы.Установить(ЗаголовокСистемы);
	КонецЕсли;	
	
КонецПроцедуры	

Процедура УстановитьТекущуюСЕ(СЕ) Экспорт
		
		ПараметрыСеанса.ТекущаяСтруктурнаяЕдиница = СЕ;
	
КонецПроцедуры	
