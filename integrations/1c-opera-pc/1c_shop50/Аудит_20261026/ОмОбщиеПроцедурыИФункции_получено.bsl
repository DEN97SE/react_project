// Функция устанавливает параметру Значение из структуры соответсвующее ключу значение.
// Позволяет избежать конструкции проверки Структуры на тип "Структура" и наличию в ней ключевого значений.
// Если ключевого значения не существует и ЗначениеПоУмолчанию <> "", то значению присваивается
// ЗначениеПоУмолчанию.
// Возвращает Истина, если значение было успешно извлечено из структуры.
//
// Параметры:
//  Значение - Строка
//  Структура - Структура
//	Ключ - Строка
//	ЗначениеПоУмолчанию - Строка
// Возвращаемое значение:
//  Булево - Результат получения значения, Истина - получено.
Функция ЗначениеИзСтруктуры(Значение, Структура, Ключ, ЗначениеПоУмолчанию = "*") Экспорт
	
	Результат = Ложь;
	
	Если ТипЗнч(Структура) = Тип("Структура") И Структура.Свойство(Ключ) Тогда
		Значение = Структура[Ключ];
		Результат = Истина;
	Иначе
		Если ЗначениеПоУмолчанию <> "*" Тогда
			Значение = ЗначениеПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции
// }} gorenski - 20.07.2020

// {{ gorenski - 19.08.2020 #Начисление выгодных рублей на карту Копилка
// Параметры:
