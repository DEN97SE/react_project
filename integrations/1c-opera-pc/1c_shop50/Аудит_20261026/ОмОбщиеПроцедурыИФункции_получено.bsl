Процедура ОтменитьСзязаннуюСчетФактуру(ДокСсылка) Экспорт
	
	СФ = НайтиПодчиненнуюСчетФактуру(ДокСсылка);
	Если СФ <> Неопределено Тогда
		СФ = СФ.ПолучитьОбъект();
		СФ.ПометкаУдаления = ДокСсылка.ПометкаУдаления;
		Если СФ.Проведен Тогда
			СФ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Иначе
			СФ.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	
