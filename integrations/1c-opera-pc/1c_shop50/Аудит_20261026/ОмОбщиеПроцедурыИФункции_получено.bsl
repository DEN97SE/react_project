Функция ПолучитьТекущуюПодсистему() Экспорт
	ЗаголовокСистемы = Константы.ЗаголовокСистемы.Получить();
	Если СтрНайти(ЗаголовокСистемы, "Prof") > 0 Тогда
		Подсистема = Метаданные.Подсистемы.Конфигурации.Подсистемы.Prof;
	ИначеЕсли СтрНайти(ЗаголовокСистемы, "Lite") > 0 Тогда
		Подсистема = Метаданные.Подсистемы.Конфигурации.Подсистемы.Lite;
	ИначеЕсли СтрНайти(ЗаголовокСистемы, "Центр") > 0 Тогда
		Подсистема = Метаданные.Подсистемы.Конфигурации.Подсистемы.ProfNet;
	Иначе
		Подсистема = Метаданные.Подсистемы.Конфигурации.Подсистемы.LiteNet;
	КонецЕсли;
	Возврат Подсистема;
КонецФункции
Функция ПолучитьСписокТиповУправленияВСети(НезависимыеТипы) Экспорт	
	спТипы = Новый СписокЗначений;
	мсвТипыУправлений = Перечисления.ТипыУправленияВСети.ДецентрализованныйЗаказТоваров.Метаданные().ЗначенияПеречисления;
	Для каждого Элемент Из мсвТипыУправлений Цикл	
		Если СтрНайти(Элемент.Комментарий, "!") = 0 Тогда 
			Если Не НезависимыеТипы Тогда				
				спТипы.Добавить(Перечисления.ТипыУправленияВСети[Элемент.Имя]);
			КонецЕсли;
		Иначе // если есть !, то тип НеЗависимый от номенклатуры
			Если НезависимыеТипы Тогда
				спТипы.Добавить(Перечисления.ТипыУправленияВСети[Элемент.Имя]);
			КонецЕсли;				
		КонецЕсли;	
	КонецЦикла;	
	Возврат спТипы;
КонецФункции
Функция ПолучитьПрефиксФирмы(Объект) Экспорт
	// определяем префикс фирмы
	МетаданныеДокумента = Объект.Метаданные();
	
	Если ЕстьРеквизитДокумента("Фирма", МетаданныеДокумента) Тогда
		Префикс = Строка(Объект.Фирма.Префикс);
		ПрефиксФирмы = ВРег(Лев(Префикс, 1)) + НРег(Прав(Префикс, СтрДлина(Префикс) - 1));
	Иначе
		ПрефиксФирмы = "";
	КонецЕсли;	
	Возврат СокрЛП(ПрефиксФирмы);
КонецФункции
