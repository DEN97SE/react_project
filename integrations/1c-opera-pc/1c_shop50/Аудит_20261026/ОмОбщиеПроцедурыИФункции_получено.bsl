Функция ПолучитьДоступностьВВодаСчетФактуры(ДокОснование) Экспорт
	
	Если ДокОснование.Договор.ТипДоговора <> Перечисления.ТипыДоговоров.КупляПродажа Тогда
		флНуженСчетФактура = Ложь;
	Иначе	
		струкУчетнаяПолитикаФирмы = ОмОперативныйУчет.ПолучитьУчетнуюПолитикуФирмыДокумента(
		  ДокОснование,докОснование.метаданные().Имя,ДокОснование.Дата);
		флНуженСчетФактура = струкУчетнаяПолитикаФирмы.СхемаНалогообложения = Перечисления.СхемыНалогообложения.Общая
							 Или струкУчетнаяПолитикаФирмы.СхемаНалогообложения = Перечисления.СхемыНалогообложения.ОбщаяЕНВД;
	КонецЕсли;	
						 
	// {{ psmavrichev - 02.11.2020 - # Проект перехода СП в ТС Командор
	ЭтоПеремещениеНаСП = ОмОбщиеПроцедурыИФункции.ДокументПеремещениеСП(ДокОснование);	
	Если ЭтоПеремещениеНаСП Тогда
		флНуженСчетФактура = Ложь;
	КонецЕсли;
	// }} psmavrichev - 02.11.2020 - # Проект перехода СП в ТС Командор
	
	Возврат  флНуженСчетФактура;
	
КонецФункции
