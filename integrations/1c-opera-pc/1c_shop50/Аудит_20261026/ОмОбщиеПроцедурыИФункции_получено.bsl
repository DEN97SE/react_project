// получение даты конца периода для произвольной даты и значения периодичности
Функция ДатаКонцаПериода(ВыборДата, ВыборПериодичность) Экспорт
	стрЗапрос = "ВЫБРАТЬ
	|	КОНЕЦПЕРИОДА(&ВыборДата, " + ВыборПериодичность + ") КАК КонПериода";
	
	Возврат ЗапросЗначения(стрЗапрос, Новый Структура("ВыборДата", ВыборДата));
КонецФункции

// получение даты начала периода для произвольной даты и значения периодичности
Функция ДатаНачалаПериода(ВыборДата, ВыборПериодичность) Экспорт
	стрЗапрос = "ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(&ВыборДата, " + ВыборПериодичность + ") КАК КонПериода";
	
	Возврат ЗапросЗначения(стрЗапрос, Новый Структура("ВыборДата", ВыборДата));
КонецФункции

// получение даты путем прибавления к произвольной дате некоторого числа подпериодов
// для декады работает так:
// если ВыборДата - 1, 11, 21 число, тогда декада - это треть месяца, Иначе - декада - это 10 дней
Функция ДобавитьКДате(Знач ВыборДата, ВыборПериодичность, Знач Колво) Экспорт
	Если ВыборПериодичность = "Декада" Тогда
		Число01 = НачалоМесяца(ВыборДата);
		Число11 = ДобавитьКДате(Число01, "День", 10);
		Число21 = ДобавитьКДате(Число01, "День", 20);
		Если ВыборДата = Число01 Или ВыборДата = Число11 Или ВыборДата = Число21 Тогда
			// декада - это треть месяца
			// вычисляем количество месяцев
			КолвоМесяцев = Цел(Колво / 3);
			// и добавляем их, изменяя Колво
			Если КолвоМесяцев > 0 Тогда
				ВыборДата = ДобавитьМесяц(ВыборДата, КолвоМесяцев); 
				Колво = Колво - КолвоМесяцев * 3;
			КонецЕсли;
			
			РезультатДата = ВыборДата;
			Для Сч = 1 По Колво Цикл
				РезультатДата = ДатаКонцаПериода(РезультатДата, "Декада") + 1;
			КонецЦикла; 
			Возврат РезультатДата;
		КонецЕсли;
	КонецЕсли;
	// обработка общего случая
	Если Колво = 0 Тогда
		КолвоТекстом = "0";
	Иначе
		КолвоТекстом = Формат(Колво, "ЧГ=0");
	КонецЕсли; 
	стрЗапрос = "ВЫБРАТЬ
	|	ДОБАВИТЬКДАТЕ(&ВыборДата, " + ВыборПериодичность + ", " + КолвоТекстом + ") КАК РезультатДата";
	Возврат ЗапросЗначения(стрЗапрос, Новый Структура("ВыборДата", ВыборДата));
КонецФункции 

// подсчитывает количество подпериодов в периоде
Функция КолвоПериодов(Знач ВыборНачДата, ВыборКонДата, ВыборПериодичность) Экспорт
	Если ВыборПериодичность = "Декада" Тогда
		// выясняем количество месяцев
		КолвоМесяцев = КолвоПериодов(ВыборНачДата, ВыборКонДата, "Месяц");
	    // убираем их (учитывая количество месяцев в результате)
		ВыборНачДата = ДобавитьМесяц(ВыборНачДата, КолвоМесяцев);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если ВыборПериодичность = "Неделя" Тогда
		ВыборПериодичность2 = "День"; 
		Коэффициент = 7;
	ИначеЕсли ВыборПериодичность = "Декада" Тогда
		ВыборПериодичность2 = "День"; 
		Коэффициент = 10;	
	ИначеЕсли ВыборПериодичность = "Полугодие" Тогда
		ВыборПериодичность2 = "Квартал"; 
		Коэффициент = 2;	
	Иначе
		Коэффициент = 1;
		ВыборПериодичность2 = ВыборПериодичность;
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ
	|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&ВыборНачДата, " + ВыборПериодичность + "), ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(&ВыборКонДата, " 
		+ ВыборПериодичность + "), СЕКУНДА, 1), " + ВыборПериодичность2 + ") КАК КолвоПериодов";
	Запрос.УстановитьПараметр("ВыборНачДата", ВыборНачДата);
	Запрос.УстановитьПараметр("ВыборКонДата", ВыборКонДата);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Если ВыборПериодичность = "Декада"  Тогда
		Возврат КолвоМесяцев * 3 + Цел(Выборка.КолвоПериодов / Коэффициент);	
	Иначе	
		Возврат Цел(Выборка.КолвоПериодов / Коэффициент);
	КонецЕсли;
КонецФункции

// Вспомогательная функция, опред. заполненность Списка Значений
Функция ПустойСписок(Список) Экспорт
	Для каждого ЭлСписка Из Список Цикл
		Если Не ЗначениеНеЗаполнено(ЭлСписка.Значение) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	// нет элементов или все элементы пустые
	Возврат Истина;
КонецФункции

// Процедура убирает пустые и повторяющиеся значения из списка значений
// (основное использование - преобразование после интерактивного создания СЗ)
Процедура ОбработатьВыборСпискаЗначений(Список) Экспорт
	ОбрСч = Список.Количество() - 1; // последний индекс
	Пока ОбрСч >= 0 Цикл
		ТекЭл = Список[ОбрСч];
		// удаление пустого элемента списка
		Если ЗначениеНеЗаполнено(ТекЭл.Значение) Тогда
			Список.Удалить(ТекЭл);
			ОбрСч = ОбрСч - 1;
			Продолжить;
		КонецЕсли;
		// удаление повторяющегося элемента списка
		Для ПрямСч = 0 По ОбрСч - 1 Цикл
			Если Список[ПрямСч].Значение = ТекЭл.Значение Тогда
				Список.Удалить(ТекЭл);
				Прервать;	
			КонецЕсли;
		КонецЦикла;
		ОбрСч = ОбрСч - 1;
	КонецЦикла; 
КонецПроцедуры

// фунция определяет наличие элементов в списке значений с флагом Пометка = Истина
Функция ЕстьОтмеченныеЭлементы(СписокЗначений) Экспорт
	Для каждого Элемент Из СписокЗначений Цикл
		Если Элемент.Пометка = Истина Тогда
			Возврат Истина;
		КонецЕсли; 	
	КонецЦикла; 
	Возврат Ложь;
КонецФункции

// поиск элемента списка значений по представлению
Функция НайтиЭлСпискаПоПредставлению(Список, Представление) Экспорт
	Для каждого ЭлСписка Из Список Цикл
		Если ЭлСписка.Представление = Представление Тогда
			Возврат ЭлСписка;
		КонецЕсли;
	КонецЦикла;
	// Если элемент не найден, возвращаем Неопределено	
	Возврат Неопределено;
КонецФункции 

// упорядочивание элементов списка значений по значению поля "Пометка"
Процедура СортироватьСписокПоПометке(Список) Экспорт
	Сч = 0;
	Для каждого ЭлементСписка Из Список Цикл
		Если ЭлементСписка.Пометка Тогда
			Список.Сдвинуть(ЭлементСписка, Сч - Список.Индекс(ЭлементСписка));
			Сч = Сч + 1;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

