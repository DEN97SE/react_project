// {{ pobotaevds - 28.09.2022 - # Малышева Н.Б. "Формировать транспортный раздел ТТН ЕГАИС"
Процедура ЗаполнитьТранспортныйРазделЕГАИС(Объект, НовыйДокументТТНЕГАИС) Экспорт
	
	ЭтоВН = ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ВозвратнаяНакладная");
	
	Если Объект.СтруктурнаяЕдиница.ЭтоРаспределительныйЦентр И НЕ ЭтоВН Тогда
		НовыйДокументТТНЕГАИС.ТранспортнаяКомпания = Объект.ТранспортнаяКомпания;
		НовыйДокументТТНЕГАИС.Водитель = Объект.ВодительФИО;
		НовыйДокументТТНЕГАИС.РегистрационныйНомерТранспортногоСредства = Объект.ГосНомерТС;
		НовыйДокументТТНЕГАИС.Прицеп = "-";
		НовыйДокументТТНЕГАИС.МестоЗагрузки = НовыйДокументТТНЕГАИС.АдресОтправителя;
		НовыйДокументТТНЕГАИС.МестоРазгрузки = НовыйДокументТТНЕГАИС.АдресПолучателя;
		НовыйДокументТТНЕГАИС.Заказчик = НовыйДокументТТНЕГАИС.НаименованиеОтправитель;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	МестаПерегруза.Наименование КАК ТранспортнаяКомпания,
		               |	МестаПерегруза.Водитель КАК Водитель,
		               |	МестаПерегруза.НомерТС КАК РегистрационныйНомерТранспортногоСредства,
		               |	""-"" КАК Прицеп
		               |ИЗ
		               |	Справочник.МестаПерегруза КАК МестаПерегруза
		               |ГДЕ
		               |	НЕ МестаПерегруза.ПометкаУдаления
		               |	И МестаПерегруза.ИспользоватьДляТТН";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(НовыйДокументТТНЕГАИС, Выборка);
			НовыйДокументТТНЕГАИС.МестоЗагрузки = НовыйДокументТТНЕГАИС.АдресОтправителя;
			НовыйДокументТТНЕГАИС.МестоРазгрузки = НовыйДокументТТНЕГАИС.АдресПолучателя;
			НовыйДокументТТНЕГАИС.Заказчик = НовыйДокументТТНЕГАИС.НаименованиеОтправитель;
		КонецЕсли; 

	КонецЕсли;
	
	// {{ egaevsky - 12.02.2024 - #ЕГАИС, заполнение экспедитора в ТТН ЕГАИС, ТЗ Малышевой Н.Б.
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.РасходнаяНакладная") ИЛИ ЭтоВН Тогда
		ЭкспедиторФИО = СокрЛП(Объект.Экспедитор);
		Если НЕ ЗначениеЗаполнено(ЭкспедиторФИО) И ЗначениеЗаполнено(Объект.ВодительФИО) Тогда
			ЭкспедиторФИО = СокрЛП(Объект.ВодительФИО);
		КонецЕсли;
		Если ЗначениеЗаполнено(ЭкспедиторФИО) И НЕ ЗначениеЗаполнено(НовыйДокументТТНЕГАИС.Экспедитор) Тогда
			НовыйДокументТТНЕГАИС.Экспедитор = ЭкспедиторФИО;
		КонецЕсли;
		
		// уточнен порядок заполнения транспортных реквизитов ТТН ЕГАИС для магазинов, в приоритете - из РН
		// если одно из полей Фио водителя или гос номер ТС не заполнено, то использовать действующую схему
		Если НЕ Объект.СтруктурнаяЕдиница.ЭтоРаспределительныйЦентр Тогда
			ЕстьДанныеВодительГосНомер = ЗначениеЗаполнено(Объект.ВодительФИО) И ЗначениеЗаполнено(Объект.ГосНомерТС);
			Если ЕстьДанныеВодительГосНомер Тогда
				НовыйДокументТТНЕГАИС.Водитель = Объект.ВодительФИО;
				НовыйДокументТТНЕГАИС.РегистрационныйНомерТранспортногоСредства = Объект.ГосНомерТС;
			КонецЕсли;
			Если ЗначениеЗаполнено(Объект.ТранспортнаяКомпания) Тогда
				НовыйДокументТТНЕГАИС.ТранспортнаяКомпания = Объект.ТранспортнаяКомпания;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// }} egaevsky - 12.02.2024 - #ЕГАИС, заполнение экспедитора в ТТН ЕГАИС, ТЗ Малышевой Н.Б.
	
КонецПроцедуры
// }} pobotaevds - 28.09.2022 - # Малышева Н.Б. "Формировать транспортный раздел ТТН ЕГАИС в соответствии с требованиями зак-ва"

// {{ pobotaevds - 26.10.2022 - # Устранение техдолга
Функция ЕстьРеквизитИлиСвойствоОбъекта(Объект, ИмяРеквизита) Экспорт
	
	КлючУникальности   = Новый УникальныйИдентификатор;
	СтруктураРеквизита = Новый Структура(ИмяРеквизита, КлючУникальности);
	ЗаполнитьЗначенияСвойств(СтруктураРеквизита, Объект);
	
	Возврат СтруктураРеквизита[ИмяРеквизита] <> КлючУникальности;
	
КонецФункции
