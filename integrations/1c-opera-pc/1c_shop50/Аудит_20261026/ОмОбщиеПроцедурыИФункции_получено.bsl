	// }} kurzhosvl - 21.03.2024 # проект АРМ Супервайзера
	
	// СЕ_ЛЦ = СтруктурнаяЕдиница.ЭтоЛогистическийОператор ИЛИ СтруктурнаяЕдиница.ЭтоРаспределительныйЦентр;
