Процедура ВвестиСчетФактуруАвтоматически(ДокументОбъект) Экспорт
	Если ДокументОбъект.Дата = КонецДня(ДокументОбъект.Дата) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ПолучитьСтрокуСообщенияДляВремениТоварногоДокумента235959());
		Возврат;
	КонецЕсли;
	СчетФактура = НайтиПодчиненнуюСчетФактуру(ДокументОбъект.Ссылка);
	ОбъектСчФ = Неопределено;
	Если Не ЗначениеЗаполнено(СчетФактура) Тогда
		ОбъектСчФ = Документы.СчетФактура.СоздатьДокумент();
		ОбъектСчФ.Заполнить(ДокументОбъект.Ссылка);
		Если ОбъектСчФ.Состав.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Счет-фактура не сформирован: нет данных для формирования");
			Возврат;
		КонецЕсли;	
		ПриСозданииНовогоДокумента(ОбъектСчФ);
		// Лу софт НАЧАЛО 29.06.2012
  	    ОбъектСчФ.Дата = ДокументОбъект.Дата + 1;
  		// ЛУ софт КОНЕЦ 29.06.2012
		СформироватьНомерДокумента(ОбъектСчФ);
		ОбъектСчФ.Записать(РежимЗаписиДокумента.Проведение);
        ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ: " + ОбъектСчФ);
	Иначе
		ОбъектСчФ = СчетФактура.ПолучитьОбъект();
		ПредФирмаСчф = ОбъектСчФ.Фирма;
		ОбъектСчФ.Заполнить(ДокументОбъект.Ссылка); 
		Если ПредФирмаСчф <> ДокументОбъект.Фирма Тогда
			// Лу софт НАЧАЛО 29.06.2012
  	    	ОбъектСчФ.Дата = ДокументОбъект.Дата + 1;
  			// ЛУ софт КОНЕЦ 29.06.2012
			СформироватьНомерДокумента(ОбъектСчФ);
		КонецЕсли;
		ОбъектСчФ.ПометкаУдаления = Ложь;
		ОбъектСчФ.Записать(РежимЗаписиДокумента.Проведение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Переоформлен документ: " + ОбъектСчФ);
	КонецЕсли;
КонецПроцедуры

Функция НеобходимостьСозданияСчетаФактуры(Основание) Экспорт
	Флаг = Истина;
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ  Различные
	|	УчетнаяПолитикаНалоговыйУчетСрезПоследних.СхемаНалогообложения    как СНалогообложения
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаНалоговыйУчет.СрезПоследних(&НаДату, Организация = &Организация) КАК УчетнаяПолитикаНалоговыйУчетСрезПоследних";
	Запрос.УстановитьПараметр("Организация", Основание.фирма);
	ЗАпрос.УстановитьПараметр("НаДату", Основание.Дата);
	Рез = Запрос.выполнить();
	Выборка = Рез.Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.сНалогообложения = Перечисления.СхемыНалогообложения.Упрощенная 
			Или Выборка.сНалогообложения = Перечисления.СхемыНалогообложения.ЕНВД 
			Или Выборка.сналогообложения = Перечисления.СхемыНалогообложения.УпрощеннаяЕНВД Тогда
			Флаг = Ложь;
		ИначеЕсли Выборка.сНалогообложения = Перечисления.СхемыНалогообложения.ОбщаяЕНВД Тогда
			ЗапросЕНВД = Новый Запрос;
			ЗапросЕНВД.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ЦентрыДоходовИРасходовСрезПоследних.ДоходОтношениеКЕНВД КАК ДоходОтношениеКЕНВД,
			|	ЦентрыДоходовИРасходовСрезПоследних.РасходОтношениеКЕНВД КАК РасходОтношениеКЕНВД
			|ИЗ
			|	РегистрСведений.ЦентрыДоходовИРасходов.СрезПоследних(
			|			&НаДату,
			|			Склад = &Склад
			|				И Фирма = &Фирма) КАК ЦентрыДоходовИРасходовСрезПоследних";
			ЗапросЕНВД.УстановитьПараметр("НаДату", Основание.Дата);
			ЗапросЕНВД.УстановитьПараметр("Склад", Основание.склад);
			ЗапросЕНВД.УстановитьПараметр("ФИрма", Основание.фирма);
			РезЕНВД = ЗапросЕНВД.Выполнить();
			ВыборкаЕНВД = РезЕНВД.Выбрать();
			Пока ВыборкаЕНВД.Следующий() Цикл
				Если ВыборкаЕНВД.ДоходОтношениеКЕНВД Или ВыборкаЕНВД.РасходОтношениеКЕНВД Тогда
					Флаг = Ложь;
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			Флаг = Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Флаг;	
КонецФункции

Процедура ПереоформлениеСчетФактуры(Основание, Знач СчетФактураСсылка = Неопределено) Экспорт 
	Попытка
		
		// {{ psmavrichev - 02.11.2020 - # Проект перехода СП в ТС Командор		
		ЭтоПеремещениеНаСП = ОмОбщиеПроцедурыИФункции.ДокументПеремещениеСП(Основание); 
		Если ЭтоПеремещениеНаСП Тогда
			Возврат;
		КонецЕсли;			
		// }} psmavrichev - 02.11.2020 - # Проект перехода СП в ТС Командор
		
		Если СчетФактураСсылка = Неопределено Тогда
			Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	СсылкиДокументов.Ссылка КАК СчетФактура
			|ИЗ 
			|	КритерийОтбора.СсылкиДокументов(&ссылка) КАК СсылкиДокументов
			|ГДЕ
			|	СсылкиДокументов.Ссылка ССЫЛКА Документ.СчетФактура
			|	");
			Запрос.УстановитьПараметр("Ссылка", Основание);
			Результат = Запрос.Выполнить();
			Если Не Результат.Пустой() Тогда
				Выборка = Результат.Выбрать();
				Выборка.Следующий();
				СчетФактураСсылка = Выборка.СчетФактура;
			Иначе
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		СчетФактураОбъект = СчетФактураСсылка.ПолучитьОбъект();
		
		ФлагОтказа = Ложь;
		  			
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ВозвратнаяНакладная") Тогда
			Если Основание.ТипВозврата = Перечисления.ТипыВозвратов.ОтПокупателя Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Счет-фактура вводится только на основании возврата поставщику");
				ФлагОтказа = Истина;
			КонецЕсли;	
			струкУчетнаяПолитикаФирмы = ОмОперативныйУчет.ПолучитьУчетнуюПолитикуФирмы(Основание.Фирма, Основание.Дата);
			флСчетФактураНаОсновании = струкУчетнаяПолитикаФирмы.ВводитьСчетФактуруНаОснованииВозврата;
			// Лу софт НАЧАЛО 15.03.2012
			флНужнаСчетФактура = ПолучитьДоступностьВВодаСчетФактуры(Основание);
			Если Не флНужнаСчетФактура Тогда
				Если флСчетФактураНаОсновании Тогда
					СчетФактураОбъект.УстановитьПометкуУдаления(Истина);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Помечен на удаление документ " + счетФактураСсылка);
					Возврат;
				КонецЕсли;	
			КонецЕсли;	
              		
			Если флНужнаСчетФактура И Не флСчетФактураНаОсновании Тогда
   			// ЛУ софт КОНЕЦ 15.03.2012
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				  "В учетной политике не установлен флаг ввода счет-фактуры на основании возвратной накладной");
				ФлагОтказа = Истина;
			КонецЕсли;
			//Если Основание.ТипВозврата = Перечисления.ТипыВозвратов.Поставщику Тогда
			//	Если ОмУчетНДС.КонтрагентНеПлательщикНДС(Основание.Контрагент) Тогда
			//		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Контрагент не является плательщиком НДС. 
			//        Ввод счет-фактуры запрещен!");
			//		ФлагОтказа = Истина;
			//	КонецЕсли;	
			//КонецЕсли;	
		КонецЕсли;	
		
		Если Основание.Дата = КонецДня(Основание.Дата) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ПолучитьСтрокуСообщенияДляВремениТоварногоДокумента235959());
			ФлагОтказа = Истина;
		КонецЕсли;
		
		Если ФлагОтказа = Истина Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ " + СчетФактураОбъект + " не переоформлен");
			Если СчетФактураОбъект.Проведен Тогда
				СчетФактураОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ " + СчетФактураОбъект + " снят с проведения");
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		ПредФирмаСчф = СчетФактураОбъект.Фирма;
		
		СчетФактураОбъект.Переоформить(Основание);
		
		Если ПредФирмаСчф <> Основание.Фирма Тогда
			СформироватьНомерДокумента(СчетФактураОбъект);
		КонецЕсли; 
		
		СчетФактураОбъект.Дата = Основание.Дата + 1;
		
		СчетФактураОбъект.Записать(РежимЗаписиДокумента.Проведение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Переоформлен документ: " + СчетФактураОбъект);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Счет фактура не переоформлена:" + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

