// Осуществляет корректировку дробного количества в табличной части,
// исправляет дробное количество на целое.
//
// Параметры:
//  ТабличнаяЧасть - ДокументТабличнаяЧасть - табличная часть проверяемого документа
Процедура КонтрольТабличнойЧастиДробногоКоличестваДляШтучногоТовара(Источник) Экспорт
	// {{ yulya - 2023-11-09 - Перезаполнять поля после изменения количесва. Заявка КХ00-0000000000000609723
	ТабличнаяЧасть = Источник.Состав;   
	ТаблицаСостава = Новый ТаблицаЗначений;
	ТаблицаСостава.Колонки.Добавить("Номенклатура",     Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаСостава.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения"));
	МассивСтрок = Новый Массив;
	Для каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		Если Цел(СтрокаТЧ.Количество) <> СтрокаТЧ.Количество Тогда
			НоваяСтрока = ТаблицаСостава.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			МассивСтрок.Добавить(СтрокаТЧ);
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаСостава.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Состав.Номенклатура КАК Номенклатура,
	               |	Состав.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ПОМЕСТИТЬ ВТ_Состав
	               |ИЗ
	               |	&Состав КАК Состав
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Состав.Номенклатура КАК Номенклатура,
	               |	ВТ_Состав.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ВЫБОР
	               |		КОГДА ЕдиницыИзмерения.Владелец.ТипТовара = ЗНАЧЕНИЕ(Перечисление.ТипыТоваров.Штучный)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ШтучныйТовар,
	               |	ЕдиницыИзмерения.Владелец.Наименование КАК НаименованиеНоменклатуры
	               |ИЗ
	               |	ВТ_Состав КАК ВТ_Состав
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	               |		ПО ВТ_Состав.ЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка";
	
	Запрос.УстановитьПараметр("Состав", ТаблицаСостава);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
	    Возврат;
	КонецЕсли;
	
	ВыводЗаголовка = Истина;
	
	СтруктураПоиска = Новый Структура("Номенклатура,ЕдиницаИзмерения");
	Выборка = РезультатЗапроса.Выбрать();
	Для каждого СтрокаТЧ Из МассивСтрок Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТЧ);
		Выборка.Сбросить();
		
		Если Не (Выборка.НайтиСледующий(СтруктураПоиска) И Выборка.ШтучныйТовар) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВыводЗаголовка Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дробное количество недопустимо для штучного товара:");
			ВыводЗаголовка = Ложь;
		КонецЕсли;
		
		НовоеКоличество = Цел(СтрокаТЧ.Количество);
		Если НовоеКоличество < 1 Тогда
			НовоеКоличество = 1;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("   " + СокрЛП(Выборка.НаименованиеНоменклатуры) 
		  + ": " + СтрокаТЧ.Количество + " -> " + НовоеКоличество);
		СтрокаТЧ.Количество = НовоеКоличество;
		// {{ yulya - 2023-11-09 - Перезаполнять поля после изменения количесва. Заявка КХ00-0000000000000609723
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТЧ); 
		// {{ yulya_f - 2023-11-10 - Также есть проверка на Списание, 
		// для Всего и СуммаНДС только ПрН. Заявка КХ00-0000000000000660371		
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПриходнаяНакладная") 
			  Или  ТипЗнч(Источник) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда  
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТЧ, Источник.ВариантРасчетаНДС);
			ОбработкаТабличныхЧастей.РассчитатьВсегоТабЧасти(СтрокаТЧ, Источник.ВариантРасчетаНДС);
		КонецЕсли;
		// )) yulya - 2023-11-09 - Перезаполнять поля после изменения количесва. Заявка КХ00-0000000000000609723
	
	КонецЦикла;
	
КонецПроцедуры // КонтрольТабличнойЧастиДробногоКоличестваДляШтучногоТовара()
