// Федр
// Функция предназначена для получения курса заданной валюты на заданную дату по заданной категории
// Параметры:
//		спрВалюта - элемент справочника "Валюты". Валюта для которой необходимо получить значение курса
//		дтДатаКурса - дата. Дата, на которую необходимо получить значение курса. По умолчанию - РабочаяДата
//		спрКатегорияКурса - элемент справочника "Категории курсов валют". Категория курса, который
//							неободимо получить. По умолчанию - курс ЦБ.
//
// Возвращаемое значение: Число. Курс за единицу валюты (деленный на кратность).
//
Функция ПолучитьКурсВалюты(спрВалюта, Знач дтДатаКурса = Неопределено, Знач спрКатегорияКурса = Неопределено) Экспорт
	
	Если спрВалюта = Справочники.Валюты.Рубль Тогда
		// если валюта - это российский рубль, то возвращаем 1 в любом случае
		Возврат 1;
	КонецЕсли;
	
	Если ЗначениеНеЗаполнено(дтДатаКурса) Тогда
		// Если не задана дата, то курс получаем на рабочую дату
		дтДатаКурса = ТекущаяДатаСеанса();
	КонецЕсли; 
	Если спрКатегорияКурса = Неопределено Тогда
		// если не задана категория курса, то получаем курс по ЦБ
		спрКатегорияКурса = Справочники.КатегорииКурсовВалют.КурсЦБ;
	КонецЕсли;
	
	струкОтборПоВалютеИКатегорииКурса = Новый Структура("Валюта, КатегорияКурса", спрВалюта, спрКатегорияКурса);
	струкРезультат = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(дтДатаКурса, струкОтборПоВалютеИКатегорииКурса);
	Если струкРезультат.Кратность = 0 Тогда
		чКурсЗаЕдиницуВалюты = струкРезультат.Курс;
	Иначе
		чКурсЗаЕдиницуВалюты = струкРезультат.Курс / струкРезультат.Кратность;
	КонецЕсли; 
	
	Возврат чКурсЗаЕдиницуВалюты;
	
КонецФункции // ПолучитьКурсВалюты()

// федр
// Функция предназначена для пересчета значения из одной валюты в другую.
//		Пересчет производится через кросскурс по рублю.
// Параметры:
//		чЗначениеНач -		Число, Обязательный параметр.
//							Исходное значение, которое необходимо перевести в др. валюту
//
//		КурсВалютаНач -		Число или СправочникСсылка.Валюты, Необязательный параметр. 
//							Курс исходной валюты к рублю или ссылка на исходную валюту (в этом случае
//							курс будет извлекаться из регистра).
//							Значение по умолчанию - 1, т.е. пересчет производится из рублей.
//
//		КурсВалютаКон -		Число или СправочникСсылка.Валюты, Необязательный параметр. 
//							Курс валюты результата к рублю или ссылка на валюту результата (в этом случае
//							курс будет извлекаться из регистра).
//							Значение по умолчанию - 1, т.е. пересчет производится в рубли.
//
//		дтДатаКурсаНач -	Дата, Необязательный параметр.
//							Дата, на которую должент быть получен курс исходной валюты.	Имеет смысл,
//							если передана исходная валюта, а не курс. 
//							Значение по умолчанию - РабочаяДата.
//
//		дтДатаКурсаКон - 	Дата, Необязательный параметр. 
//							Дата, на которую должент быть получен курс валюты результата. Имеет смысл, 
//							если передана валюта результата, а не курс. 
//							Значение по умолчанию - дтДатаКурсаНач.
//
//		чОкруглятьДо -		Число, Необязательный параметр.
//							Определяет число знаков дробной части, до которых производится округление. 
//							Если параметр отрицательный, то число округляется до соответствующего разряда
//							в целой части, начиная с младших разрядов.
//							Значение по умолчанию: округления не производится.
//
//		спрКатегорияКурсаНач - СправочникСсылка.КатегорииКурсовВалют, Необязательный параметр. 
//							Категория, для которой должен быть получен курс исходной валюты. Имеет смысл,
//							если передана исходная валюта, а не курс. 
//							Значение по умолчанию - курс ЦБ РФ.
//
//		спрКатегорияКурсакон - СправочникСсылка.КатегорииКурсовВалют, Необязательный параметр.
//							Категория, для которой должен быть получен курс валюты результата. Имеет смысл,
//							если передана валюта результата, а не курс.	
//							Значение по умолчанию - курс ЦБ РФ.
//
//		чПроцент			 - Число, Необязательный параметр.
//							Процент, на который нужно увеличить результат, или который нужно "выкрутить"
//							из результата	
//							Значение по умолчанию - 0.
//
//		флДобавлятьПроцент	 - Булево, Необязательный параметр.
//							показывает, что нужно сделать с процентом.
//							Истина - к результату добавляется процент (начальная сумма = 100%),
//							Ложь - из результата "выкручивается процент" (начальная сумма - 100+чПроцент %)
//							Значение по умолчанию - Истина.
//
// Возвращаемое значение: Число. Результат пересчета.
//
Функция Пересчет(чЗначениеНач, КурсВалютаНач = 1, КурсВалютаКон = 1,
				дтДатаКурсаНач = Неопределено, дтДатаКурсаКон = Неопределено, 
				чОкруглятьДо = Неопределено, 
				Знач спрКатегорияКурсаНач = Неопределено, Знач спрКатегорияКурсаКон = Неопределено,
				чПроцент = 0, флДобавлятьПроцент = Истина) Экспорт
	
	чЗначениеКон = 0;
	
	Если ТипЗнч(КурсВалютаНач) = Тип("СправочникСсылка.Валюты") Тогда
		флПереданаВалютаНач = Истина;		
		Если (спрКатегорияКурсаНач = Неопределено) ИЛИ (спрКатегорияКурсаНач.Пустая()) Тогда
			спрКатегорияКурсаНач = Справочники.КатегорииКурсовВалют.КурсЦБ;
		КонецЕсли; 
	Иначе
		флПереданаВалютаНач = Ложь;		
	КонецЕсли;
	Если ТипЗнч(КурсВалютаКон) = Тип("СправочникСсылка.Валюты") Тогда
		флПереданаВалютаКон = Истина;		
		Если (спрКатегорияКурсаКон = Неопределено) ИЛИ (спрКатегорияКурсаКон.Пустая()) Тогда
			спрКатегорияКурсаКон = Справочники.КатегорииКурсовВалют.КурсЦБ;
		КонецЕсли; 
	Иначе
		флПереданаВалютаКон = Ложь;		
	КонецЕсли;
	
	Если флПереданаВалютаНач ИЛИ флПереданаВалютаКон Тогда
		// предана хотя бы одна валюта, нужно получить даты курсов
		Если дтДатаКурсаНач = Неопределено Тогда
			// по умолчанию дата курса исходной валюты равна рабочей дате
			дтДатаКурсаНач = ТекущаяДатаСеанса();
		КонецЕсли; 
		Если дтДатаКурсаКон = Неопределено Тогда
			// по умолчанию дата курса валюты результата равна дате курса исходной валюты
			дтДатаКурсаКон = дтДатаКурсаНач;
		КонецЕсли; 
	КонецЕсли; 
	
	Если (флПереданаВалютаНач И флПереданаВалютаКон) 
			И (КурсВалютаНач = КурсВалютаКон)
			И (спрКатегорияКурсаНач = спрКатегорияКурсаКон)
			И (дтДатаКурсаНач = дтДатаКурсаКон) Тогда
			// валюты, категории курсов и даты курсов равны
			// не будем получать курсы, т.к. они все равно равны
			чКурсНач = 1;
			чКурсКон = 1;
	Иначе
		Если флПереданаВалютаНач Тогда
			// предана исходная валюта, получим курс
			чКурсНач = ПолучитьКурсВалюты(КурсВалютаНач, дтДатаКурсаНач, спрКатегорияКурсаНач);
		Иначе
			чКурсНач = КурсВалютаНач;
		КонецЕсли;
		Если флПереданаВалютаКон Тогда
			// предана валюта результата, получим курс
			чКурсКон = ПолучитьКурсВалюты(КурсВалютаКон, дтДатаКурсаКон, спрКатегорияКурсаКон);
		Иначе
			чКурсКон = КурсВалютаКон;
		КонецЕсли;
		
	КонецЕсли;
	
	Если чКурсКон = 0 Тогда
		// не задан курс конечной валюты, во избежание деления на ноль приравняем к 1
		чКурсКон = 1;
	КонецЕсли;
	
	// выкручиваем процент
	Если Не флДобавлятьПроцент И (чПроцент <> 0) Тогда
		чЗначениеНач = чЗначениеНач / (1 + чПроцент / 100);
	КонецЕсли;

	// вычисление
	Если чЗначениеНач = NULL Тогда
		чЗначениеКон = 0;
	Иначе
		чЗначениеКон = чЗначениеНач * (чКурсНач / чКурсКон);
	КонецЕсли; 
	
	// добавляем процент
	Если флДобавлятьПроцент И (чПроцент <> 0) Тогда
		чЗначениеКон = чЗначениеКон * (1 + чПроцент / 100);
	КонецЕсли;
	
	Если чОкруглятьДо <> Неопределено Тогда
		// нужно округлить результат
		чЗначениеКон = Окр(чЗначениеКон, чОкруглятьДо);
	КонецЕсли; 
	
	Возврат чЗначениеКон;
	
КонецФункции // Пересчет()

// федр 
// Функция предназначена для получения списка валют, используемого при выборе валюты в документах
// Список может состоять из рубля, иностранных валют (все из справочника, кроме рубля) 
// и пункта для ввода курса в любых сочетаниях
//
// Параметры
//  флполучатьВалюты	 - Булево 	- признак включения в список иностранных валют
//  флПолучатьРубль		 - Булево	- признак включения в список рубля
//  флДобавлятьРубль	 - Булево	- признак включения в список пункта для ввода курса
//
// Возвращаемое значение:
//   СписокЗначений	- Список содержит значения типа СправочникСсылка.Валюты 
//					и значение типа Число, если требуется добавлять пункт для курса
//
Функция ПолучитьСписокВалютДляВыбора(флПолучатьВалюты = Истина, флПолучатьРубль = Истина, флДобавлятьКурс = Ложь, 
	  чСтартовоеЗначениеКурса = 0) Экспорт 
	
	сзСписокРезультат = Новый СписокЗначений();
	спрРубль = Справочники.Валюты.Рубль;
	
	Если флПолучатьВалюты Тогда
		
		Запрос = Новый Запрос();
		Запрос.Текст = 	"ВЫБРАТЬ
						|	Валюты.Ссылка КАК Валюта
						|ИЗ
						|	Справочник.Валюты КАК Валюты
						|ГДЕ
						|	Валюты.Ссылка <> &Рубль
						|АВТОУПОРЯДОЧИВАНИЕ";
		Запрос.УстановитьПараметр("Рубль", спрРубль);
		мсвРезультат  = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Валюта");
		сзСписокРезультат.ЗагрузитьЗначения(мсвРезультат);
		
	КонецЕсли;
	
	Если флПолучатьРубль Тогда
		
		#Если Клиент Тогда
			сзСписокРезультат.Вставить(0, спрРубль, , , БиблиотекаКартинок.РоссийскийФлаг);
		#Иначе
			сзСписокРезультат.Вставить(0, спрРубль);
		#КонецЕсли
		
	КонецЕсли;
                          	
	Если флДобавлятьКурс Тогда
		
		#Если Клиент Тогда
			сзСписокРезультат.Добавить(чСтартовоеЗначениеКурса, 
			  НСтр("ru = ""Курс = ""; en = ""Exchange rate = """) + Формат(чСтартовоеЗначениеКурса, "ЧЦ=10; ЧДЦ=4; ЧН=00,0000"),
			  , БиблиотекаКартинок.Калькулятор);
		#Иначе
			сзСписокРезультат.Добавить(чСтартовоеЗначениеКурса, 
			НСтр("ru = ""Курс = ""; en = ""Exchange rate = """) + Формат(чСтартовоеЗначениеКурса, "ЧЦ=10; ЧДЦ=4; ЧН=00,0000"));
		#КонецЕсли
		
	КонецЕсли;
	
	Возврат сзСписокРезультат;

КонецФункции // ПолучитьСписокВалютДляВыбора()

#Если Клиент Тогда
// федр
// Функция открывает выбор из меню по переданному списку валют (см. функцию ПолучитьСписокВалютДляВыбора)
// и возвращает выбранное значение. Определена только на клиенте
//
// Параметры
//  Элемент  - ЭлементУправления - элемент управления, к которому будет пристроено меню выбора, обязательный параметр
//  Форма  - Форма - форма, из которой осуществляется выбор, обязательный параметр
//  СписокВалютДляВыбора - СписокЗначений - список выбора (см. функцию ПолучитьСписокВалютДляВыбора)
//
// Возвращаемое значение:
//   СправочникСсылка.Валюты, Число, Неопределено - выбранная валюта, курс, Неопределено в случае отмены выбора
// Пример использования:
//		В обработчике "при начале выбора" поля ввода для валюты нужно написать следующее:
//
//		Процедура ВалютаНачалоВыбора(Элемент, СтандартнаяОбработка)
//			СтандартнаяОбработка = Ложь;
//			Выбор = ВыбратьВалютуКурс(Элемент, ЭтаФорма); - так будем выбирать из всех валют в справочнике
//	или		Выбор = ВыбратьВалютуКурс(Элемент, ЭтаФорма, 
//           ПолучитьСписокВалютДляВыбора(Ложь)); - так в списке будет только рубль
//	или     Выбор = ВыбратьВалютуКурс(Элемент, ЭтаФорма, 
//           ПолучитьСписокВалютДляВыбора(,Ложь)); - так в списке будут только валюты (кроме рубля)
//	или		Выбор = ВыбратьВалютуКурс(Элемент, ЭтаФорма, 
//           ПолучитьСписокВалютДляВыбора(,,Истина)); - так в списке будут все валюты и курс
//  или		Выбор = ВыбратьВалютуКурс(Элемент, ЭтаФорма, 
//           сзСписокВалют); - так будем выбирать из переданного списка значений
//			Если Выбор <> Неопределено Тогда
//				<действия при выборе валюты>
//			КонецЕсли;
//		КонецПроцедуры
//		
//      Для ввода лучше сбросить флажок "Редактирование текста", 
//       т.к. в этом случае пользователь сможет выбрать любую валююту без ограничения
//
Функция ВыбратьВалютуКурс(Элемент, Форма, СписокВалютДляВыбора = Неопределено) Экспорт 

	Если СписокВалютДляВыбора = Неопределено Тогда
		// если не был передан список валют, то будем выбирать любую (без курса)
		СписокВалютДляВыбора = ПолучитьСписокВалютДляВыбора();
	КонецЕсли;
	Если СписокВалютДляВыбора.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Выбор = Форма.ВыбратьИзМеню(СписокВалютДляВыбора, Элемент);
	Если Выбор <> Неопределено Тогда
		ЗначениеВыбора = Выбор.Значение;
		Если ТипЗнч(ЗначениеВыбора) = Тип("Число") Тогда
			// выбираем курс
			ВвестиЧисло(ЗначениеВыбора, "Курс", 10, 4);
		КонецЕсли;
		Возврат ЗначениеВыбора;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции // ВыбратьВалютуКурс()
#КонецЕсли

#Если Клиент Тогда
// федр
// Функция открывает меню с двумя пунктами: курс валюты по ЦБ и ручной ввод курса
// в случае выбора пользователем первого варианта возврацает курс валюты по ЦБ из регистра,
// в случае второго варианта открывает диалог для ввода числа и возвращает введенное значение
//
// Параметры
//  Форма  - Форма - Форма, из которой осуществляется выбор, обязательный параментр
//  Элемент  - <ЭлементУправления> - элемент, к которму будет "пристроено" меню 
//    и в которой будет помещено значение курса, обязательный парметр
//  спрВалюта  - <СправочникСсылка.Валюты> - валюта, для которой нужно выбрать курс, обязательный параметр
//  дтДата  - <Дата> - дата, на которую будет получаться курс ЦБ, по умолчанию - рабочая дата
// Возвращаемое значение:
//   <Булево>   - Истина, если пользователь выбрал курс по ЦБ или ничего не выбрал, ложь - ручной ввод
//
Функция ОбновитьВыбратьКурс(Форма, Элемент = Неопределено, спрВалюта = Неопределено,  дтДата = Неопределено) Экспорт

	Если спрВалюта = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	сзМеню = Новый СписокЗначений();
	чКурсВалютыПоЦБ = ПолучитьКурсВалюты(спрВалюта, дтДата);
	сзМеню.Добавить(Истина, "Установить курс ЦБ (" + Формат(чКурсВалютыПоЦБ, "ЧЦ=10; ЧДЦ=4") + ")");
	сзМеню.Добавить(Ложь, "Ввести курс", , БиблиотекаКартинок.Калькулятор);
	
	Выбор = Форма.ВыбратьИзМеню(сзМеню, Элемент);
	
	Если Выбор = Неопределено Тогда
		
		// ничего не выбрали
		Возврат Истина;
		
	ИначеЕсли Выбор.Значение Тогда // выбрали курс ЦБ
		
		Элемент.Значение = чКурсВалютыПоЦБ;
		Возврат Истина;
				
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;

КонецФункции // ОбновитьВыбратьКурс()
#КонецЕсли

