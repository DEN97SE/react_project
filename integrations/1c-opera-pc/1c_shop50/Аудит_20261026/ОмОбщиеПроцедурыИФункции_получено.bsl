// Функция предназначена для преобразования секунд в строку формата Часы, Минуты, Секунды
// Параметры:
//		чСекунды - число секунд
//		флЧ - флаг необходимости включать часы в результирующую строку
//		флМ - флаг необходимости включать минуты в результирующую строку
//		флС - флаг необходимости включать секунды в результирующую строку
// Возвращаемое значение:
//
Функция ПолучитьСтрокуВремениИзСекунд(чСекунды, флЧ = Истина, флМ = Истина, флС = Истина) Экспорт
	стрСекунды = "" + чСекунды % 60;
	стрМинуты  = "" + Цел(чСекунды / 60) % 60;
	стрЧасы    = "" + Цел(чСекунды / 3600);
	Возврат ?(флЧ, стрЧасы + "ч ", "") + ?(флМ, стрМинуты + "м ", "") + ?(флС, стрСекунды + "с ", "");
КонецФункции // ПолучитьСтрокуВремениИзСекунд()

// Выводит в сообщения интервал времени, прошедший с определенного момента.
// Предназначена, в основном, для измерения времени выполнения обработок, формирования отчетов, и т.д.
// В ТД 5.0 аналогичные задачи выполняла пара функций ВремяНачало() и ВремяКонец()
// Если Константы.Отладка.Получить() = Ложь, не делает ничего
// Пример использования:
// дВремяНачала=ТекущаяДата()
// ...
// <формирование отчета>
// ...
// СообщитьВремяИнтервал(дВремяНачала)
//
// Параметры:
//  дВремяНачала  - дата/время начала интервала
//  фВыводВСекундах - если истина, результат будет выведен в секундах
Процедура СообщитьВремяИнтервал(дВремяНачала, фВыводВСекундах = Ложь) Экспорт
	Если Не Константы.Отладка.Получить() Тогда
		Возврат;
	КонецЕсли;
	чСекунд = ТекущаяДатаСеанса() - дВремяНачала;
	Если фВыводВСекундах Тогда
		стрИнтервал = Строка(чСекунд) + " сек";
	Иначе
		стрИнтервал =
			Строка(Цел(чСекунд / 60 / 60)) + " ч "
			+ Формат(Цел(чСекунд % (60 * 60) / 60), "ЧЦ=2;ЧН=") + " мин "
			+ Формат(Цел(чСекунд % 60), "ЧЦ=2;ЧН=") + " сек ";
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Время выполнения " + стрИнтервал);
КонецПроцедуры // ВремяНачало()

// Разбивает строку по указанному разделителю и формирует массив из полученных подстрок
// Символы перевода строки и табуляции превращаются в пробелы.
//
// Параметры
//  стрСтрока  - разбиваемая строка
//                 
//  стрРазделитель  - разделитель, по которому разбивается строка
//
//	фУдалитьПробелы - если Истина, удаляет пробелы на концах подстрок
//
//	фПропускатьПустые - если Истина, пустые подстроки будут пропущены
//
// Возвращаемое значение:
//   Массив из подстрок
//
Функция МассивИзСтроки_(стрСтрока, стрРазделитель = ",", фУдалитьПробелы = Ложь, фПропускатьПустые = Ложь) Экспорт
	стрСтрокаСтроки = СтрЗаменить(
		СтрЗаменить(
			СтрЗаменить(
				СтрЗаменить(стрСтрока, Символы.Таб, " "),
				Символы.ПС,
				" "),
			Символы.ВК,
			" "),
		стрРазделитель,
		Символы.ПС);
	чЧислоСтрок = СтрЧислоСтрок(стрСтрокаСтроки);
	маРезультат = Новый Массив;
	Для й = 1 По чЧислоСтрок Цикл
		Если фУдалитьПробелы Тогда
			стрПодстрока = СокрЛП(СтрПолучитьСтроку(стрСтрокаСтроки, й));
		Иначе
			стрПодстрока = СтрПолучитьСтроку(стрСтрокаСтроки, й);
		КонецЕсли;
		Если Не фПропускатьПустые Или Не ПустаяСтрока(стрПодстрока) Тогда
			маРезультат.Добавить(стрПодстрока);
		КонецЕсли;
	КонецЦикла;
	Возврат маРезультат;
КонецФункции // МассивИзСтроки_()

// Формирует массив подстрок из строки, в которой упакованы подстроки с байтами длинны.
//
// Параметры
//  стрСтрока  - разбиваемая строка
//
// Возвращаемое значение:
//   Массив из подстрок
Функция МассивИзСтрокиСДлинами(стрСтрока) Экспорт
	мРезультат = Новый Массив();
	й = 1;
	Пока й < СтрДлина(стрСтрока) Цикл
		чДлинаПодстроки = КодСимвола(стрСтрока, й);
		стрПодстрока = Сред(стрСтрока, й + 1, чДлинаПодстроки);
		й = й + чДлинаПодстроки + 1;
		мРезультат.Добавить(стрПодстрока);
	КонецЦикла;
	Возврат мРезультат;
КонецФункции // МассивИзСтрокиСДлинной()

// Возвращает ЗначениеДляНеопределено, если Значение = Неопределено или Значение в противном случае
Функция НеопределеноВЗначение(Значение, ЗначениеДляНеопределено = 0) Экспорт
	Если Значение = Неопределено Тогда
		Возврат ЗначениеДляНеопределено;
	КонецЕсли;
	Возврат Значение;
КонецФункции // НеопределеноВЗначение()

// Выполняет запрос и возвращает одно значение - первое поле первой строки
// или Неопределено, если запрос пустой.
// Это полезно, например, когда нужно посчитать количество с помощью запроса
// или в других случаях, когда результатом запроса является одно-единственное значение
Функция ЗапросЗначения(стрЗапрос, стПараметры = Неопределено) Экспорт
	зЗапрос = Новый Запрос(стрЗапрос);
	УстановитьПараметрыЗапросаИзСтруктуры(зЗапрос, стПараметры);
	выбЗапрос = зЗапрос.Выполнить().Выбрать();
	Если Не выбЗапрос.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат выбЗапрос[0];
КонецФункции

// Устанавливает параметры запроса из структуры, кде ключом является наименование параметра,
// а значением - значение параметра
Процедура УстановитьПараметрыЗапросаИзСтруктуры(зЗапрос, стПараметры) Экспорт
	Если стПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Параметр Из стПараметры Цикл
		зЗапрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
КонецПроцедуры

// Копирует массив.
// Параметры:
//	маИсточник - массив-источник; может быть Неопределено, в этом случыае возвращается Неопределено
// Возвращаемое значение:
//	Копия переданного массива.
Функция КопироватьМассив(маИсточник) Экспорт
	Если маИсточник = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	чКоличество = маИсточник.Количество();
	Если чКоличество = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	маПриемник = Новый Массив(чКоличество);
	Для й = 0 По чКоличество - 1 Цикл
		маПриемник[й] = КопироватьОбъект(маИсточник[й]);
	КонецЦикла;
	Возврат маПриемник;
КонецФункции

// Создает копию структуры с источника.
// Важно: если значением элемента структуры является тоже структура, она будет тоже скопирована по значению,
//	но некоторые элементы могут копироваться по ссылке.
// Параметры:
//	стИсточник - Структура-источник
//	стПриемник - Структура, куда будет скопирован источник. Приемник перед копированием НЕ ОЧИЩАЕТСЯ, поэтому,
//	             если необходимо получить копию, этот параметр нужно не указывать или передать в него пустую структуру.
// Возвращаемое значение:
//	Структура-приемник с добавленными из источника элементами, или новая структура - копия структуры-источника.
Функция КопироватьСтруктуру(стИсточник, стПриемник = Неопределено) Экспорт
	Если стПриемник <> Неопределено Тогда
		стРезультат = стПриемник;
	Иначе
		стРезультат = Новый Структура;
	КонецЕсли;
	Для Каждого ЭлементИсточника Из стИсточник Цикл
		стРезультат.Вставить(ЭлементИсточника.Ключ, КопироватьОбъект(ЭлементИсточника.Значение));
	КонецЦикла;
	Возврат стРезультат;
КонецФункции

// Копирует объект. Полностью копирует структуры, массивы, в том числе вложенные объекты в них.
// Некоторые объекты может копировать по ссылке.
// Параметры:
//	обИсточник - копируемый объект
// Возвращаемое значение:
//	Копия объекта.
Функция КопироватьОбъект(обИсточник) Экспорт
	Если ТипЗнч(обИсточник) = Тип("Структура") Тогда
		Возврат КопироватьСтруктуру(обИсточник);
	ИначеЕсли ТипЗнч(обИсточник) = Тип("Массив") Тогда
		Возврат КопироватьМассив(обИсточник);
	Иначе
		Возврат обИсточник;
	КонецЕсли;
КонецФункции

// Формирует массив из списка параметров
// Возможно передать до 20 параметров.
// Параметры:
//	В1 - В20 - любые значения
// Возвращаемое значение:
//	Массив из переданных параметров.
Функция СписокПараметров(
	В1 = Неопределено,
	В2 = Неопределено,
	В3 = Неопределено,
	В4 = Неопределено,
