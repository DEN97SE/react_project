Функция ПроверкаПравПользователяДляОбъекта(ИмяОбъекта, Пользователь, Справочник = Неопределено) Экспорт
	
	// {guseinov-a 11.07.2022 -#Вынес в модуль повторного использования, 
	// вынес тело функции в отдельную процедуру и вызываю из МодуляПовторногоИспользования
	Возврат ОбщиеПроцедурыИФункцииПовтИсп.ПроверкаПравПользователяДляОбъекта(ИмяОбъекта, Пользователь, Справочник);
	// }guseinov-a 11.07.2022 -#Вынес в модуль повторного использования	
	
КонецФункции

Функция ПроверкаПравПользователяДляОбъектаЛокальная(ИмяОбъекта, Пользователь, Справочник = Неопределено) Экспорт
	
	СписокРолей = "";

	// {{ tymko - 19.02.2020
	Если Не ОбщиеПроцедурыИФункции.ЭтоБазаЦентральногоОфиса() Тогда
		Возврат СписокРолей; 	
	КонецЕсли;
	// }} tymko - 19.02.2020
	
	Выборка = ОграничениеПоРолямНаОбъект(ИмяОбъекта, Справочник);

	// {{ tymko - 19.02.2020
	Если Выборка = Неопределено Тогда
		Возврат СписокРолей;
	КонецЕсли;
	// }} tymko - 19.02.2020
	
	НетРоли = Ложь;
	Пока Выборка.Следующий() Цикл
		ПользовательИмеетРоль = ПользовательИмеетДополнительнуюРоль(Пользователь, Выборка.Роль);
		Если Не ПользовательИмеетРоль Тогда
			Если ЗначениеЗаполнено(СписокРолей) Тогда
				СписокРолей = СписокРолей + "; " + Выборка.Роль;
			Иначе
				СписокРолей = СписокРолей + Выборка.Роль;
			КонецЕсли;
		Иначе
			СписокРолей = Неопределено;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Вернет пустую строку, если на объект не назначена доп роль.
	// Вернет Неопределено, если назначенная доп роль назначена пользователю.
	// Вернет список назначенных ролей, если на объект назначена доп роль, но не назначена пользователю.
	Возврат СписокРолей;
	
КонецФункции

Функция ПроверкаПравПользователяДляСвойства(Свойство, Справочник, Пользователь) Экспорт
	
	РольДляИзмененияСвойства = ПроверкаПравПользователяДляОбъекта(Свойство, Пользователь, Справочник);
	Если ЗначениеЗаполнено(РольДляИзмененияСвойства) Тогда
		// Если на свойство назначена доп роль, и ее нет у пользователя.
		ТекстСообщения = "Свойство """ + Свойство 
		   + """ может изменять только пользователь с ролью: [" + РольДляИзмененияСвойства + "]
		   |Получение данной роли необходимо согласовать с отделом по управлению Мастер Данными.";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат Истина;	
	КонецЕсли;
	
	РольДляРедактированияСправочника = ПроверкаПравПользователяДляОбъекта(Справочник, Пользователь);
	Если ЗначениеЗаполнено(РольДляРедактированияСправочника) И Не РольДляИзмененияСвойства = Неопределено Тогда
		// Если на справочник назначена доп роль, а на свойство не назначена 
		// и у польователя нет этой доп роли (назначенной на справочник).
		Возврат Истина;
	КонецЕсли;
	
	// Если ни на свойство, ни на справочник не назначена доп роль или у пользователя есть назначенная роль
	// вернем ложь, чтобы можно было сохранить/отредактировать доп свойство.
	Возврат Ложь;
	
КонецФункции

Функция ПользовательИмеетДополнительнуюРоль(Пользователь, ДополнительнаяРоль)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДополнительныеРолиПользователей.Пользователь КАК Пользователь
	|ИЗ
	|	РегистрСведений.ДополнительныеРолиПользователей КАК ДополнительныеРолиПользователей
	|ГДЕ
	|	ДополнительныеРолиПользователей.Пользователь = &Пользователь
	|	И ДополнительныеРолиПользователей.ДополнительнаяРоль = &ДополнительнаяРоль";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("ДополнительнаяРоль", ДополнительнаяРоль);
	
	Результат = Запрос.Выполнить();
	// Возвращает Истина - если пользователю назначена доп роль. 
	Возврат НЕ Результат.Пустой();
	
КонецФункции

Функция ОграничениеПоРолямНаОбъект(ОбъектПроверки, Справочник)
	
	// {{ tymko - 19.02.2020
	Если ЭтоИсключениеИзПроверкиПоРолям(ОбъектПроверки) Тогда		
		Возврат Неопределено;	
	КонецЕсли;
	// }} tymko - 19.02.2020
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СоответствиеОбъектовСистемыИОграниченийПоРолям.ДополнительнаяРоль КАК Роль
	|ИЗ
	|	РегистрСведений.СоответствиеОбъектовСистемыИОграниченийПоРолям КАК СоответствиеОбъектовСистемыИОграниченийПоРолям
	|ГДЕ
	|	СоответствиеОбъектовСистемыИОграниченийПоРолям.Объект = &Объект
	|	И СоответствиеОбъектовСистемыИОграниченийПоРолям.Справочник = &Справочник";
	
	Запрос.УстановитьПараметр("Объект", ОбъектПроверки);
	Если Справочник = Неопределено Тогда
		Запрос.УстановитьПараметр("Справочник", "");
	Иначе
		Запрос.УстановитьПараметр("Справочник", Справочник);
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выбрать();
	// Возвращает список доп ролей, назначенных на объект.
	Возврат Результат;
	
КонецФункции
