Функция ПолучитьТаблицуТоваровПоЗаказам(МассивЗаказов, Ссылка) Экспорт
	Если Ссылка.Проведен Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
		|	ВложенныйЗапрос.Характеристика КАК Характеристика,
		|	СУММА(ВложенныйЗапрос.Количество) КАК Количество
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЗаказыИсходящиеОстатки.Номенклатура КАК Номенклатура,
		|		ЗаказыИсходящиеОстатки.Характеристика КАК Характеристика,
		|		ЗаказыИсходящиеОстатки.КоличествоОстаток КАК Количество
		|	ИЗ
		|		РегистрНакопления.ЗаказыИсходящие.Остатки(, ПоДокументу В (&ПоДокументу)) КАК ЗаказыИсходящиеОстатки
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ЗаказыИсходящие.Номенклатура,
		|		ЗаказыИсходящие.Характеристика,
		|		ЗаказыИсходящие.Количество
		|	ИЗ
		|		РегистрНакопления.ЗаказыИсходящие КАК ЗаказыИсходящие
		|	ГДЕ
		|		ЗаказыИсходящие.Регистратор В
		|				(ВЫБРАТЬ
		|					ЗакрытиеЗаказов.Ссылка КАК Док
		|				ИЗ
		|					Документ.ЗакрытиеЗаказов КАК ЗакрытиеЗаказов
		|				ГДЕ
		|					ЗакрытиеЗаказов.ПриходнаяНакладная = &Ссылка)) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Номенклатура,
		|	ВложенныйЗапрос.Характеристика");
	Иначе	
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЗаказыИсходящиеОстатки.Номенклатура КАК Номенклатура,
		|	ЗаказыИсходящиеОстатки.Характеристика КАК Характеристика,
		|	ЗаказыИсходящиеОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ЗаказыИсходящие.Остатки(, ПоДокументу В (&ПоДокументу)) КАК ЗаказыИсходящиеОстатки");
	КонецЕсли;
	Запрос.УстановитьПараметр("ПоДокументу", МассивЗаказов);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// SerP добавил параметр ТолькоНеЗаблокированные
Функция ПолучитьТаблицуТоваровПоДоговоруЗакупки(КонтрагентДоговор, НаДату, ТолькоНеЗаблокированные = Истина) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЦеныПоставщиковСрезПоследних.Номенклатура,
	|	ЦеныПоставщиковСрезПоследних.ЕдиницаИзмерения,
	|	ЦеныПоставщиковСрезПоследних.Характеристика,
	|	ЦеныПоставщиковСрезПоследних.Цена,
	|	ЦеныПоставщиковСрезПоследних.ОтклонениеПлюс,
	|	ЦеныПоставщиковСрезПоследних.ОтклонениеМинус,
	|	ЦеныПоставщиковСрезПоследних.ЕдиницаИзмерения.Коэффициент КАК Коэффициент,
	|	ЦеныПоставщиковСрезПоследних.КоличествоВесТоварПлюс,
	|	ЦеныПоставщиковСрезПоследних.Заблокировано КАК Заблокировано
	|ПОМЕСТИТЬ ВыборкаЦен
	|ИЗ
	|	РегистрСведений.ЦеныПоставщиков.СрезПоследних(&НаДату, Выразить(Договор Как Справочник.Договоры) = &КонтрагентДоговор) КАК ЦеныПоставщиковСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВыборкаЦен.Номенклатура,
	|	ВыборкаЦен.ЕдиницаИзмерения,
	|	ВыборкаЦен.Характеристика,
	|	ВыборкаЦен.Цена,
	|	ВыборкаЦен.ОтклонениеПлюс,
	|	ВыборкаЦен.ОтклонениеМинус,
	|	ВыборкаЦен.Коэффициент КАК Коэффициент,
	|	ВыборкаЦен.КоличествоВесТоварПлюс
	|ИЗ
	|	ВыборкаЦен КАК ВыборкаЦен" + ?(ТолькоНеЗаблокированные, "
	|ГДЕ
	|	(НЕ ВыборкаЦен.Заблокировано)", "") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Коэффициент";
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("КонтрагентДоговор", КонтрагентДоговор);
	
	// {{ tymko - 04.02.2020
	Если ТипЗнч(КонтрагентДоговор) = Тип("СправочникСсылка.Контрагенты") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, 
		  "Выразить(Договор Как Справочник.Договоры)", "Выразить(Договор Как Справочник.Контрагенты)");
	КонецЕсли;
	// }} tymko - 04.02.2020
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПроверитьЦенуЗакупки(СтруктураОтбора, ВыбЦена, тзКонтроляЦен, ЦенаДоговораЗакупки, ТекущийДокумент, 
	  ДопустимаяЦенаОтклоненияПлюс = 0, ДопустимаяЦенаОтклоненияМинус = 0) Экспорт
	ДопустимаяЦенаОтклоненияПлюс  = ВыбЦена;
	ДопустимаяЦенаОтклоненияМинус = ВыбЦена;
	ЦенаДоговораЗакупки = ВыбЦена;
	МассивНайденныхСтрок = тзКонтроляЦен.НайтиСтроки(СтруктураОтбора);
	Если МассивНайденныхСтрок.Количество() > 0 Тогда
		СтрМассива = МассивНайденныхСтрок[0];
		ЦенаДоговораЗакупки = ОмОбщиеПроцедурыИФункции.Пересчет(СтрМассива.Цена, ТекущийДокумент.Договор.Валюта, 
		  ТекущийДокумент.Валюта, ТекущийДокумент.Дата, ТекущийДокумент.Дата, 2);
		ДопустимаяЦенаОтклоненияПлюс  = ЦенаДоговораЗакупки + (ЦенаДоговораЗакупки * СтрМассива.ОтклонениеПлюс / 100);
		ДопустимаяЦенаОтклоненияМинус = ЦенаДоговораЗакупки - (ЦенаДоговораЗакупки * СтрМассива.ОтклонениеМинус / 100);
	Иначе
		ВыбЕдиницаИзмерения = "";
		СтруктураОтбора.Свойство("ЕдиницаИзмерения", ВыбЕдиницаИзмерения);
		СтруктураОтбора.Удалить("ЕдиницаИзмерения");
		МассивНайденныхСтрок = тзКонтроляЦен.НайтиСтроки(СтруктураОтбора);
		Если МассивНайденныхСтрок.Количество() > 0 Тогда
			СтрМассива = МассивНайденныхСтрок[0];
			ЦенаДоговораЗакупки = СтрМассива.Цена * (ВыбЕдиницаИзмерения.Коэффициент / СтрМассива.Коэффициент);
			ДопустимаяЦенаОтклоненияПлюс  = ЦенаДоговораЗакупки + (ЦенаДоговораЗакупки * СтрМассива.ОтклонениеПлюс / 100);
			ДопустимаяЦенаОтклоненияМинус = ЦенаДоговораЗакупки - (ЦенаДоговораЗакупки * СтрМассива.ОтклонениеМинус / 100);
		КонецЕсли;
	КонецЕсли;
	Возврат ((ВыбЦена <= ДопустимаяЦенаОтклоненияПлюс) И (ВыбЦена >= ДопустимаяЦенаОтклоненияМинус));
КонецФункции

// Предназначена для получения пустого значения заданного типа:
//	примитивного, или ссылочного. Используется
//
// Параметры:
//	ЗаданныйТип   - тип, пустое значение которого нужно получить
//
Функция ПустоеЗначениеТипа(ЗаданныйТип) Экспорт

	Если ЗаданныйТип = Тип("Число") Тогда
		Возврат 0;

	ИначеЕсли ЗаданныйТип = Тип("Строка") Тогда
		Возврат "";

	ИначеЕсли ЗаданныйТип = Тип("Дата") Тогда
		Возврат '00010101000000';

	ИначеЕсли ЗаданныйТип = Тип("Булево") Тогда
		Возврат Ложь;

	Иначе
		Возврат Новый (ЗаданныйТип);

	КонецЕсли;

КонецФункции // ПустоеЗначениеТипа()

// определяет, является ли строка целым числом (то есть состоит только из символов 0..9)
// Параметры:
//	стр - исследуемая строка
// Возвращаемое значение:
//	Истина - строка является числом 
//	Ложь - строка не является числом
Функция ЭтоЧисло(стр) Экспорт
	чДлина = СтрДлина(стр);
	Если чДлина = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для й = 1 По чДлина Цикл
		Если СтрНайти("0123456789", Сред(стр, й, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

