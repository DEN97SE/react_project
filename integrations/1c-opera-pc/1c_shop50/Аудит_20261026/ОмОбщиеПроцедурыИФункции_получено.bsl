// {{ gorenski - 20.02.2020 - #Периодичность классификатора видов алкогольной продукции
// Преобразует массив в таблицу значений с одной колонкой
//
// Параметры:
//  ИсходныйМассив - Массив
//  ИмяКолонки - Строка - Наименование колонки в таблице значений, если не задано - Колонка1
// Возвращаемое значение:
//  ТаблицаЗначений - Описание:
// * Колонка - ЭлементМассива
Функция МассивВТаблицуЗначений(ИсходныйМассив, Знач ИмяКолонки = "") Экспорт
	
	Если ПустаяСтрока(ИмяКолонки) Тогда
		ИмяКолонки = "Колонка1";
	КонецЕсли;
	
	ИмяКолонки = СтрЗаменить(ИмяКолонки, " ", "_");
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить(ИмяКолонки);
	
	Если ЗначениеЗаполнено(ИсходныйМассив) Тогда
		Для Сч = 1 По ИсходныйМассив.Количество() Цикл
			Результат.Добавить();
		КонецЦикла;
		Результат.ЗагрузитьКолонку(ИсходныйМассив, ИмяКолонки);
	КонецЕсли;
	
	Возврат Результат;	

КонецФункции // МассивВТаблицуЗначений()

// Возвращает исходный массив без дублирующих значений
//
// Параметры:
//  ИсходныйМассив - Массив - массив любых значений
// Возвращаемое значение:
//  Массив - Массив без дублирующих элементов
Функция МассивБезДублей(ИсходныйМассив) Экспорт

	Результат = Новый Массив;
	ВремТаб = МассивВТаблицуЗначений(ИсходныйМассив);
	Если ЗначениеЗаполнено(ВремТаб) Тогда
		ВремТаб.Свернуть(ВремТаб.Колонки[0].Имя);
		Результат = ВремТаб.ВыгрузитьКолонку(0);
	КонецЕсли;
	
	Возврат Результат;	

КонецФункции // МассивБезДублей()

// Обеспечивает корректную выгрузку колонки таблицы значений
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений
//  ИмяКолонки - Строка
//  БезДубликатов - Булево
// Возвращаемое значение:
//  Массив - Массив значений строк колонки
Функция ВыгрузитьКолонку(ТаблицаЗначений, ИмяКолонки, БезДубликатов = Ложь) Экспорт

	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(ТаблицаЗначений) И ТипЗнч(ТаблицаЗначений) = Тип("ТаблицаЗначений") Тогда
		
		Если ТаблицаЗначений.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			Результат = ТаблицаЗначений.ВыгрузитьКолонку(ИмяКолонки);
		КонецЕсли;
		
		Если БезДубликатов = Истина Тогда
			Результат = МассивБезДублей(Результат);
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ВыгрузитьКолонку()
// }} gorenski - 20.02.2020 - #Периодичность классификатора видов алкогольной продукции

// {{ gorenski - 11.04.2020
//
// Параметры:
//  ИсходныйМассив - Массив
//  КоличествоЭлементов - Число - Количество элементов в подмассивах
// Возвращаемое значение:
//  Массив - Массив с разбитыми подмассивами
Функция РазбитьМассивНаПодмассивы(ИсходныйМассив, КоличествоЭлементов) Экспорт

	Результат = Новый Массив;
	Подмассив = Новый Массив;
	
	Счетчик = 0;
	Для каждого Элемент Из ИсходныйМассив Цикл
		
		Подмассив.Добавить(Элемент);
		Счетчик = Счетчик + 1;
		
		Если Счетчик = КоличествоЭлементов Тогда
			Результат.Добавить(Подмассив);
			Счетчик = 0;
			ПодМассив = Новый Массив;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Счетчик > 0 Тогда
		Результат.Добавить(Подмассив);
	КонецЕсли;

	Возврат Результат;

КонецФункции // РазбитьМассивНаПодмассивы()
// }} gorenski - 11.04.2020

Процедура ЗаписьСтроковогоИдентификатораПередЗаписью(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ЭтоНовый() Тогда
		
		ИмяСправочника = Источник.Метаданные().Имя;
		
		НоваяСсылка = Справочники[ИмяСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор);
		
		Источник.УстановитьСсылкуНового(НоваяСсылка);
		
		Источник.СтроковыйИдентификатор = XMLСтрока(НоваяСсылка);
		
	Иначе
		
		СтроковыйИдентификаторИсточника = XMLСтрока(Источник.Ссылка);
		
		Если СтроковыйИдентификаторИсточника <> Источник.СтроковыйИдентификатор Тогда
			Источник.СтроковыйИдентификатор = СтроковыйИдентификаторИсточника;
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

