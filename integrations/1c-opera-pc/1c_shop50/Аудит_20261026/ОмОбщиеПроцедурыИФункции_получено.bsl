				|	РегистрНакопления.Резервы КАК Резервы
				|ГДЕ
				|	Резервы.Регистратор = &ДокОснование
				|
				|СГРУППИРОВАТЬ ПО
				|	Резервы.МестоХранения");
		ЗапросПоСкладам.УстановитьПараметр("ДокОснование", ДокОснование);
		МассивСкладов = ЗапросПоСкладам.Выполнить().Выгрузить().ВыгрузитьКолонку("Склад");
		Если МассивСкладов.Количество() = 1 Тогда
			Склад = МассивСкладов[0];
		Иначе
			СписокСкладов = Новый СписокЗначений();
