// Vold Замена долговыполняющейся "Свернуть" таблицы значений
//                               Таблица , <Колонки группировок>, <Колонки суммирования>) 
//		<СтрокаСуммирования> -Тип (Строка, Структура) 
//			Строка с именами, группируемых колонок
//			или структура, где ключ - имя группируемой колонки, а значение - функция для группирования
Функция СвернутьТаблицуЗначений(Таб, строкаГруппировок, СтрокаСуммирования, Знач ГраничноеКоличество = 1500) Экспорт
	Если ТипЗНЧ(СтрокаСуммирования) = Тип("Строка") Тогда
		Таб.Свернуть(строкаГруппировок, СтрокаСуммирования); 
		Возврат Таб;
	КонецЕсли;
	пз = Новый ПостроительЗапроса();
	пз.ИсточникДанных = Новый ОписаниеИсточникаДанных(Таб);
	пз.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
	СтрукГруппировок = Новый Структура(строкаГруппировок);
	КоличествоГруппировок = СтрукГруппировок.Количество();
	Для каждого Эл Из СтрукГруппировок Цикл
		пз.ИсточникДанных.Колонки[Эл.Ключ].Измерение = Истина;
	КонецЦикла;
	
	Если ТипЗНч(СтрокаСуммирования) = Тип("Строка") Тогда
		СтрукСуммирования = Новый Структура(СтрокаСуммирования);
		Для каждого эл Из СтрукСуммирования Цикл
			СтрукСуммирования.Вставить(эл.Ключ, "СУММА");
		КонецЦикла;
	ИначеЕсли ТипЗНч(СтрокаСуммирования) = Тип("Структура") Тогда
		СтрукСуммирования = Новый Структура();
		Для каждого эл Из СтрокаСуммирования Цикл
			СтрукСуммирования.Вставить(эл.Ключ, эл.Значение);
		КонецЦикла; 
	КонецЕсли; 
	Для каждого Эл Из СтрукСуммирования Цикл
		пз.ИсточникДанных.Колонки[Эл.Ключ].Итог = "" + эл.Значение + "(" + Эл.Ключ + ")";
	КонецЦикла;
	
	Таб1 = Новый ТаблицаЗначений;
	Для каждого Колонка Из Таб.Колонки Цикл
		Если (СтрукГруппировок.Свойство(Колонка.Имя) = Ложь)
			И (СтрукСуммирования.Свойство(Колонка.Имя) = Ложь) Тогда
			Продолжить;
		КонецЕсли; 
		Таб1.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла; 
	
	пз.ЗаполнитьНастройки();
	пз.Выполнить();	
	ЗаполнитьТаблицуПоВыборке(пз.Результат, Таб1, КоличествоГруппировок);
	Возврат Таб1;
КонецФункции

Процедура ЗаполнитьТаблицуПоВыборке(Рез, Таб, Знач КоличествоГруппировок)
	выб = Рез.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока выб.Следующий() Цикл
		Если КоличествоГруппировок = 0 Тогда
			НовСтрока = Таб.Добавить();	
			ЗаполнитьЗначенияСвойств(НовСтрока, выб);
		Иначе
			ЗаполнитьТаблицуПоВыборке(выб, Таб, КоличествоГруппировок - 1);
		КонецЕсли; 
	КонецЦикла;
КонецПроцедуры	
	
Функция ПолучитьПредставлениеДокументаБезВремени(докСсылкаИлиОбъект) Экспорт 
	стрПредставлениеОснования = Строка(докСсылкаИлиОбъект);
	чДлинаСтрокиБезВремени = СтрДлина(стрПредставлениеОснования) - 9;
	Если чДлинаСтрокиБезВремени > 0 Тогда
		Возврат Лев(стрПредставлениеОснования, чДлинаСтрокиБезВремени);
	Иначе
		Возврат стрПредставлениеОснования;
	КонецЕсли;
КонецФункции

Функция ПолучитьДатуДействияСтатусаПоУмолчанию(спрСтатусыНоменклатуры) Экспорт
	СтатусПоУмолчаниюСрокДействия = спрСтатусыНоменклатуры.СтатусПоУмолчаниюСрокДействия;
	Если СтатусПоУмолчаниюСрокДействия = 0 Тогда
		ДатаДействияСтатуса = Дата("00010101");
	Иначе
		ДатаДействияСтатуса = ТекущаяДатаСеанса() + СтатусПоУмолчаниюСрокДействия * 86400;
	КонецЕсли; 
	Возврат ДатаДействияСтатуса;
КонецФункции 

