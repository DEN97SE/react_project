// draa функция проверяет есть ли хоть один документ в ИБ за определенный период
//
Функция ЕстьХотьОдинДокумент(дтДатаНач, дтДатаКон) Экспорт
	стрОбъединить = " ОБЪЕДИНИТЬ ВСЕ ";				   
	флРезультат = Ложь;
    чСч = 1;
	стрЗапрос = "";
	Для каждого мдДокумент Из Метаданные.Документы Цикл
		стрИмяТаблицы = мдДокумент.Имя;
		Если чСч = 20 Тогда
			Если ЕстьДокументы(дтДатаНач, дтДатаКон, стрЗапрос) Тогда
				Возврат Истина;
			Иначе
				чСч = 1;
				стрЗапрос = "";
			КонецЕсли;	
		КонецЕсли;	
		Если чСч = 1 Тогда
			стр1 = "";
		Иначе
			стр1 = стрОбъединить;
		КонецЕсли;	
		стрЗапрос = стрЗапрос + стр1 + " ВЫБРАТЬ количество(*) КАК КолДок из Документ." + стрИмяТаблицы 
			+ " КАК Док ГДЕ Док.Дата МЕЖДУ &ДатаНач И &ДатаКон ";
		чСч = чСч + 1;
	КонецЦикла;
	Если стрЗапрос <> "" Тогда
		Возврат ЕстьДокументы(дтДатаНач, дтДатаКон, стрЗапрос);
	КонецЕсли;
	Возврат Ложь;
КонецФункции

