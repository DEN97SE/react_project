//     если ставка не установлена, то возвращается пустая ссылка
//
Функция ПолучитьОсновнуюСтавкуНДС(спрФирма, дтДата = Неопределено) Экспорт 
	Возврат Константы.ОсновнаяСтавкаНДС.Получить();
