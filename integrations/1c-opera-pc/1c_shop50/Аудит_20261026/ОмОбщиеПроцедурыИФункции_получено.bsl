Процедура СоздатьСлужебноеСообщение(СлужебноеСообщение, Описание = "", глКомпоненты = Неопределено, 
	  Знач обПарам1 = 0, Знач обПарам2 = 0, Знач обПарам3 = 0, Знач обПарам4 = 0, Знач обПарам5 = 0, 
	  Знач обПарам6 = 0, Знач обПарам7 = 0, Знач обПарам8 = 0, Знач обПарам9 = 0, Знач обПарам10 = 0) Экспорт
	// проверим, является ли описание кодом сообщения
	стрКодСообщения = Описание;
	Если Лев(стрКодСообщения, 1) = "#" Тогда
		стрКодСообщения = Прав(стрКодСообщения, СтрДлина(стрКодСообщения) - 1);
	КонецЕсли;
	Если глКомпоненты <> Неопределено Тогда
		обПарам1 = глКомпоненты.Сообщения.МаскировкаСпецСимволов(обПарам1);
		обПарам2 = глКомпоненты.Сообщения.МаскировкаСпецСимволов(обПарам2);
		обПарам3 = глКомпоненты.Сообщения.МаскировкаСпецСимволов(обПарам3);
		обПарам4 = глКомпоненты.Сообщения.МаскировкаСпецСимволов(обПарам4);
		обПарам5 = глКомпоненты.Сообщения.МаскировкаСпецСимволов(обПарам5);
		обПарам6 = глКомпоненты.Сообщения.МаскировкаСпецСимволов(обПарам6);
		обПарам7 = глКомпоненты.Сообщения.МаскировкаСпецСимволов(обПарам7);
		обПарам8 = глКомпоненты.Сообщения.МаскировкаСпецСимволов(обПарам8);
		обПарам9 = глКомпоненты.Сообщения.МаскировкаСпецСимволов(обПарам9);
		обПарам10 = глКомпоненты.Сообщения.МаскировкаСпецСимволов(обПарам10);
	КонецЕсли;
	Если ЭтоЧисло(стрКодСообщения) Тогда
		// да, это код сообщения
		Если глКомпоненты = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			  "Не задан параметр ""глКомпоненты"" при вызове ""СоздатьСлужебноеСообщение""!");
			Возврат;
		КонецЕсли;
		стрСообщение = глКомпоненты.Сообщения.Сообщение(Описание, глКомпоненты.Сообщения.Вид.Текст, , 
		  "СлужебноеСообщение", обПарам1, обПарам2, обПарам3, обПарам4, обПарам5, обПарам6, обПарам7, 
		  обПарам8, обПарам9, обПарам10);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(стрСообщение);
	Иначе
		Если глКомпоненты = Неопределено Тогда
			стрСообщение = Описание;
		Иначе
			стрСообщения = глКомпоненты.Сообщения.ФорматнаяПечать(Описание, обПарам1, обПарам2, обПарам3, обПарам4, 
			  обПарам5, обПарам6, обПарам7, обПарам8, обПарам9, обПарам10);
		КонецЕсли;
	КонецЕсли;
	Если Не СлужебноеСообщение.Ответственный.Пустая() Тогда
		здчЗадача = Задачи.Задача.СоздатьЗадачу();
		// общие параметры
		здчЗадача.ЗаполнитьПоУмолчанию();
		здчЗадача.БизнесПроцесс = Неопределено;
		здчЗадача.ТочкаМаршрута = Неопределено;
		здчЗадача.Наименование = СлужебноеСообщение.Наименование;
		здчЗадача.Описание = "Структурная единица - " + ПараметрыСеанса.ТекущаяСтруктурнаяЕдиница + "
		|" + стрСообщение;
		здчЗадача.Дата = ТекущаяДатаСеанса();
		здчЗадача.ДатаНапоминания = ТекущаяДатаСеанса();
		// параметры адресации
		здчЗадача.РольИсполнителя = Неопределено; // нет роли, указана конкретная фамилия
		здчЗадача.Исполнитель = СлужебноеСообщение.Ответственный.Сотрудник;
		здчЗадача.СтруктурнаяЕдиница = СлужебноеСообщение.Ответственный.Владелец;
		// дополнительные параметры
		здчЗадача.Важность = 2; // очень высокая важность
		здчЗадача.РазрешитьИнтерактивноеВыполнение = Истина; // по умолчанию - можно выполнять руками
		здчЗадача.ТипЗадачи = Перечисления.ТипыЗадач.Специальная;
		здчЗадача.Записать();
	КонецЕсли;	
КонецПроцедуры	

Функция ПроверкаЗаполненияСтавкиНДС(СписНоменклатуры, НаДату) Экспорт
