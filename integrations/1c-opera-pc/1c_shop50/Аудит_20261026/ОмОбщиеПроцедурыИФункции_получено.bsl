// ЛУ софт КОНЕЦ 28.06.2012

Процедура ПереоформлениеРегистрацииСчетФактуры(Основание, Знач Договор = Неопределено) Экспорт 
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ 
	|	//ПЕРВЫЕ//ПЕРВЫЕ 1
	|	СсылкиДокументов.Ссылка КАК СчетФактура
	|ИЗ 
	|	КритерийОтбора.СсылкиДокументов(&ссылка) КАК СсылкиДокументов
	|ГДЕ
	|	СсылкиДокументов.Ссылка ССЫЛКА Документ.РегистрацияСчетаФактуры
	|	//АвОтчет//И СсылкиДокументов.Ссылка.Договор = &Договор");
	Запрос.УстановитьПараметр("Ссылка", Основание);
	
	Если Не ТипЗнч(Основание) = Тип("ДокументСсылка.АвансовыйОтчет") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ПЕРВЫЕ//", "");
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда 
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СчетФактураСсылка = Выборка.СчетФактура;
		Попытка
			ФлагОтказа = Ложь;
			
			Если ТипЗнч(Основание) = Тип("ДокументСсылка.ВозвратнаяНакладная") Тогда
				Если Основание.ТипВозврата = Перечисления.ТипыВозвратов.Поставщику Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					  "Регистрация счета-фактуры вводится только на основании возврата от покупателя");
					ФлагОтказа = Истина;
				КонецЕсли;	
				струкУчетнаяПолитикаФирмы = ОмОперативныйУчет.ПолучитьУчетнуюПолитикуФирмы(Основание.Фирма, Основание.Дата);
				флСчетФактураНаОсновании = струкУчетнаяПолитикаФирмы.ВводитьСчетФактуруНаОснованииВозврата;
				Если Не флСчетФактураНаОсновании Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					  "В учетной политике не установлен флаг ввода счет-фактуры на основании возвратной накладной");
					ФлагОтказа = Истина;
				КонецЕсли;	
			КонецЕсли;	
			
			Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПриходнаяНакладная") 
				  И ТипЗнч(Основание.Контрагент) = Тип("СправочникСсылка.СтруктурныеЕдиницы") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				  "Регистрация счета-фактуры вводится только на основании приходной накладной от стороннего поставщика");
				ФлагОтказа = Истина;
			КонецЕсли;
			
			Если Основание.Дата = КонецДня(Основание.Дата) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ПолучитьСтрокуСообщенияДляВремениТоварногоДокумента235959());
			    ФлагОтказа = Истина;
			КонецЕсли;	
			
			СчетФактураОбъект = СчетФактураСсылка.ПолучитьОбъект();
			
			Если ФлагОтказа = Истина Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ " + СчетФактураОбъект + " не переоформлен");
				Если СчетФактураОбъект.Проведен Тогда
					СчетФактураОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ " + СчетФактураОбъект + " снят с проведения");
				КонецЕсли;
				Возврат;
			КонецЕсли;
			
			ПредФирмаСчф = СчетФактураОбъект.Фирма;
				
			СчетФактураОбъект.Фирма = Основание.Фирма;
			
			Если Не ТипЗнч(Основание) = Тип("ДокументСсылка.АвансовыйОтчет") 
				// Лу софт НАЧАЛО 28.06.2012
		        И Не ТипЗнч(Основание) = Тип("ДокументСсылка.КорректировкаПоступления") 
				// ЛУ софт КОНЕЦ 28.06.2012
				Тогда
				СчетФактураОбъект.Договор = Основание.Договор;
				СчетФактураОбъект.Контрагент = Основание.КОнтрагент;
			КонецЕсли;
			
			СчетФактураОбъект.ОбновитьСоставНДС();
			СчетФактураОбъект.ОбновитьДанные(СчетФактураОбъект.Состав);
			
			СчетФактураОбъект.Дата = Основание.Дата + 1;
			
			Если ПредФирмаСчф <> Основание.Фирма Тогда
				ОмОбщиеПроцедурыИФункции.СформироватьНомерДокумента(СчетФактураОбъект);
			КонецЕсли; 
			
			Если СчетФактураОбъект.Проведен И СчетФактураОбъект.СоставНДС.Количество() = 0 Тогда
				СчетФактураОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения)
			КонецЕсли;
			
			СчетФактураОбъект.Записать(РежимЗаписиДокумента.Проведение);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Переоформлен документ: " + СчетФактураОбъект);
			
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Регистрация счет фактуры не переоформлена:" + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры
	
Функция ПолучитьЗадолженность(Фирма, Контрагент, Договор, Валюта) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	isnull(СУММА(УчетВзаиморасчетовОстатки.СуммаВалОстаток),0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.УчетВзаиморасчетов.Остатки(
	|			,
	|			Фирма = &Фирма
	|				И Контрагент = &Контрагент
	|				И Договор = &Договор
	|				И Валюта = &Валюта) КАК УчетВзаиморасчетовОстатки");
	Запрос.УстановитьПараметр("Фирма",      Фирма);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Договор",    Договор);
	Запрос.УстановитьПараметр("Валюта",     Валюта);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сумма;
	Иначе
		Возврат 0;
	КонецЕсли;	
КонецФункции

