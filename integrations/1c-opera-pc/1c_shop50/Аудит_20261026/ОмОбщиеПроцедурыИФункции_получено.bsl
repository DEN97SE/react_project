// Переименование колонок таблицы значений по данным соответствия
Процедура ПереименованиеКолонок(ТаблицаЗначений, СоответствиеНазваний, Обратное = Ложь, 
	  СообщатьОбОшибке = Истина) Экспорт
	
	Колонки = ТаблицаЗначений.Колонки;
	
	Для каждого Колонка Из СоответствиеНазваний Цикл
		Если Обратное Тогда
			СтароеНазвание = Колонка.Значение;
			НовоеНазвание =  Колонка.Ключ;
		Иначе
			СтароеНазвание = Колонка.Ключ;
			НовоеНазвание =  Колонка.Значение;
		КонецЕсли;
		Если Колонки.Найти(СтароеНазвание) = Неопределено Тогда
			Если СообщатьОбОшибке Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				  "При переименовании колонок таблицы не обнаружена колонка с именем """
					+ СтароеНазвание + """! Переименование колонки не произведено.");
			КонецЕсли; 
		ИначеЕсли Не Колонки.Найти(НовоеНазвание) = Неопределено Тогда
			Если СообщатьОбОшибке Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				  "При переименовании колонок таблицы обнаружена колонка с именем """
					+ НовоеНазвание + """, переименование существующей колонки """ 
					+ СтароеНазвание + """ невозможно! Переименование колонки не произведено.");
			КонецЕсли; 
		Иначе
			Колонки[СтароеНазвание].Имя = НовоеНазвание;
		КонецЕсли;
	КонецЦикла; 
                     
КонецПроцедуры
 
// Добавляет в таблицу значений строки из другой таблицы значений и 
// в них значения колонок с совпадающими наименованиями.
//
// Параметры:
//  ТаблицаИсточник - таблица значений, откуда берутся значения.
//  ТаблицаПриемник - таблица значений, куда добавляются строки.
//
Процедура ЗагрузитьВТаблицуЗначений(ТаблицаИсточник, ТаблицаПриемник) Экспорт

	Для каждого СтрокаТаблицыИсточника Из ТаблицаИсточник Цикл

		СтрокаТаблицыПриемника = ТаблицаПриемник.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыПриемника, СтрокаТаблицыИсточника);

	КонецЦикла;

КонецПроцедуры // ЗагрузитьВТаблицуЗначений()

// Удаляет повторяющиеся элементы массива.
Функция УдалитьПовторяющиесяЭлементыМассива(Массив, НеИспользоватьНеопределено = Ложь) Экспорт
	
	ОписаниеТиповСправочники  = Справочники.ТипВсеСсылки(); 
	ОписаниеТиповДокументы    = Документы.ТипВсеСсылки(); 
	ОписаниеТиповПВХ          = ПланыВидовХарактеристик.ТипВсеСсылки(); 
	ОписаниеТиповПланыСчетов  = ПланыСчетов.ТипВсеСсылки(); 
	ОписаниеТиповПланыРасчета = ПланыВидовРасчета.ТипВсеСсылки(); 
	
	Если ТипЗнч(Массив) = Тип("Массив") Тогда 
		
		УжеВМассиве = Новый Соответствие; 
		БылоНеопределено = Ложь;
		
		КолвоЭлементовВМассиве = Массив.Количество(); 
		
		Для ОбратныйИндекс = 1 По КолвоЭлементовВМассиве Цикл 
			ЭлементМассива = Массив[КолвоЭлементовВМассиве - ОбратныйИндекс]; 
			ТипЭлемента = ТипЗнч(ЭлементМассива); 
			УсловиеСодержитТип = ОписаниеТиповСправочники.СодержитТип(ТипЭлемента) 
				Или ОписаниеТиповДокументы.СодержитТип(ТипЭлемента) 
				Или ОписаниеТиповПВХ.СодержитТип(ТипЭлемента) 
				Или ОписаниеТиповПланыСчетов.СодержитТип(ТипЭлемента) 
				Или ОписаниеТиповПланыРасчета.СодержитТип(ТипЭлемента);
				
			Если ЭлементМассива = Неопределено Тогда
				Если БылоНеопределено Или НеИспользоватьНеопределено Тогда
					Массив.Удалить(КолвоЭлементовВМассиве - ОбратныйИндекс); 
				Иначе
					БылоНеопределено = Истина;
				КонецЕсли;
				Продолжить;
			ИначеЕсли УсловиеСодержитТип Тогда 
				
				ИДЭлемента = Строка(ЭлементМассива.УникальныйИдентификатор()); 
				
			Иначе 
				
				ИДЭлемента = ЭлементМассива; 
				
			КонецЕсли; 
			
			Если УжеВМассиве[ИДЭлемента] = Истина Тогда 
				Массив.Удалить(КолвоЭлементовВМассиве - ОбратныйИндекс); 
			Иначе 
				УжеВМассиве[ИДЭлемента] = Истина; 
			КонецЕсли; 
		КонецЦикла;      
		
	КонецЕсли;
	
	Возврат Массив;
	
КонецФункции

Функция ПолучитьТаблицуСтатусовТоваровПоМатрицам(НоменклатураСсылка, мсвСписокМатриц) Экспорт
	КоличествоМатриц = мсвСписокМатриц.Количество();
	Если КоличествоМатриц = 0 Тогда
		Возврат Новый ТаблицаЗначений;	
	КонецЕсли;	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Объект", НоменклатураСсылка);
	Запрос.УстановитьПараметр("ПустойСтатус", Справочники.СтатусыНоменклатуры.ПустаяСсылка());
	ТекМатрица = 1;
	Для каждого МатрицаСсылка Из мсвСписокМатриц Цикл
		Родитель = МатрицаСсылка;
		мсвАссортиментныеМатрицы = Новый Массив();		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ * ИЗ (ВЫБРАТЬ ПЕРВЫЕ 1
		|	АссортиментныеМатрицы.Значение,
		|	&ИндексМатрицы" + ТекМатрица + " КАК Матрица,
		|	ВЫБОР
		|";
		Запрос.УстановитьПараметр("ИндексМатрицы" + ТекМатрица, "Матрица" + ТекМатрица);
		сч = 1;
		Пока Не Родитель.Пустая() Цикл
			мсвАссортиментныеМатрицы.Добавить(Родитель);
			Запрос.УстановитьПараметр("Р" + сч + "_" + ТекМатрица, Родитель);
			Запрос.Текст = Запрос.Текст + " КОГДА АссортиментныеМатрицы.АссортиментнаяМатрица = &Р" 
			  + сч + "_" + ТекМатрица + " ТОГДА " + сч;
			Родитель = Родитель.Родитель;
			сч = сч + 1;
		КонецЦикла; 
		Запрос.Текст = Запрос.Текст + " КОНЕЦ КАК Порядок
		|ИЗ
		|	РегистрСведений.АссортиментныеМатрицы КАК АссортиментныеМатрицы
		|ГДЕ
		|	АссортиментныеМатрицы.Объект = &Объект
		|	И АссортиментныеМатрицы.АссортиментнаяМатрица В(&мсвАссортиментныеМатрицы" + ТекМатрица + ")
		|   И (АссортиментныеМатрицы.Значение <> &ПустойСтатус)
		|УПОРЯДОЧИТЬ ПО
		|	Порядок ) КАК Запрос" + ТекМатрица;
		Запрос.УстановитьПараметр("мсвАссортиментныеМатрицы" + ТекМатрица, мсвАссортиментныеМатрицы);
		Если ТекМатрица <> КоличествоМатриц Тогда
			Запрос.Текст = Запрос.Текст + " ОБЪЕДИНИТЬ ВСЕ ";
		КонецЕсли; 
		ТекМатрица = ТекМатрица + 1;
	КонецЦикла; 
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
 
Функция НайтиПодчиненнуюРегистрациюСчетаФактуры(Ссылка) Экспорт
	
	// {{ tymko - 04.02.2020
	// у приходных накладных нет СФ
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		Возврат Неопределено;
	КонецЕсли;	
	// }} tymko - 04.02.2020
	
	НайденныйДокумент = Неопределено;
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	СсылкиДокументов.Ссылка КАК Фактура
		|ИЗ
		|	КритерийОтбора.СсылкиДокументов(&Основание) КАК СсылкиДокументов
		|ГДЕ
		|	СсылкиДокументов.Ссылка ССЫЛКА Документ.РегистрацияСчетаФактуры");
		Запрос.УстановитьПараметр("Основание", Ссылка);
		ВыборкаИзЗапроса = Запрос.Выполнить().Выбрать();
 		Если ВыборкаИзЗапроса.Следующий() Тогда
			НайденныйДокумент = ВыборкаИзЗапроса.Фактура;
		КонецЕсли;
	КонецЕсли;
	Возврат НайденныйДокумент;
КонецФункции	

Функция ПолучитьСтрокуСообщенияДляВремениТоварногоДокумента235959()
	
	Возврат "Время товарного документа не может равняться 23:59:59. 
		|Так как время документа счет-фактура должно быть на 1 секунду позже чем время товарного документа.
		|Необходимо изменить время товарного документа на 1 секунду раньше.";
	
КонецФункции	

Процедура ВвестиРегистрациюСчетаФактурыАвтоматически(ДокументОбъект) Экспорт

	флЦентра = ОмПроцедурыСетевогоОбмена.ЭтоСтруктурнаяЕдиницаГлавногоУзла(ПараметрыСеанса.ТекущаяСтруктурнаяЕдиница);
	Отказ = ((ДокументОбъект.Фирма.МестоВводаСчетовФактур = Перечисления.МестоВводаСчетовФактур.Магазин) И (флЦентра)) 
		Или ((ДокументОбъект.Фирма.МестоВводаСчетовФактур = Перечисления.МестоВводаСчетовФактур.Центр) И (Не флЦентра));
	Если Отказ Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ввод счетов-фактур по фирме " + ДокументОбъект.Фирма 
			+ " в данной структурной единице запрещен!!!");
		Возврат;
	КонецЕсли;
	
	Если ДокументОбъект.Дата = КонецДня(ДокументОбъект.Дата) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ПолучитьСтрокуСообщенияДляВремениТоварногоДокумента235959());
		Возврат;
	КонецЕсли;	
	
	СчетФактура = ОмОбщиеПроцедурыИФункции.НайтиПодчиненнуюРегистрациюСчетаФактуры(ДокументОбъект.Ссылка);
	ОбъектСчетаФактуры = Неопределено;
	Если (ОмОбщиеПроцедурыИФункции.ЗначениеНеЗаполнено(СчетФактура)) Тогда
		ОбъектСчетаФактуры = Документы["РегистрацияСчетаФактуры"].СоздатьДокумент();
		ОбъектСчетаФактуры.Заполнить(ДокументОбъект.Ссылка); 
		ПриСозданииНовогоДокумента(ОбъектСчетаФактуры);
		// Лу софт НАЧАЛО 29.06.2012
  	    ОбъектСчетаФактуры.Дата = ДокументОбъект.Дата + 1;
  		// ЛУ софт КОНЕЦ 29.06.2012
		СформироватьНомерДокумента(ОбъектСчетаФактуры);
		ОбъектСчетаФактуры.Записать(РежимЗаписиДокумента.Проведение);
        ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ: " + ОбъектСчетаФактуры);
	Иначе
		ОбъектСчетаФактуры = СчетФактура.ПолучитьОбъект();
		ПредФирмаСчф = ОбъектСчетаФактуры.Фирма;
		ОбъектСчетаФактуры.Заполнить(ДокументОбъект.Ссылка); 
		Если ПредФирмаСчф <> ДокументОбъект.Фирма Тогда
			// Лу софт НАЧАЛО 29.06.2012
			ОбъектСчетаФактуры.Дата = ДокументОбъект.Дата + 1;
	  		// ЛУ софт КОНЕЦ 29.06.2012
			СформироватьНомерДокумента(ОбъектСчетаФактуры);
		КонецЕсли;
		ОбъектСчетаФактуры.ПометкаУдаления = Ложь;
		ОбъектСчетаФактуры.Записать(РежимЗаписиДокумента.Проведение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Переоформлен документ: " + ОбъектСчетаФактуры);
	КонецЕсли;
	
КонецПроцедуры

