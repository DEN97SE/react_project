// Добавить в конец существующего InfoBases; импорт Основной и прежние helpers сохранить.
// GET /pilot-status -> СостояниеПилота; POST /pilot-enroll -> ЗарегистрироватьПилот.
// Все уровни HTTP-доступа: РазрешеноАдминистраторам. Один центральный исполнитель, без параллельных POST.
// {{ semidockij - 28.10.2026 - Диагностируемая регистрация пилота Opera и PC
структура ЗаявкаПилота
    пер Код: Строка = ""
    пер Наименование: Строка = ""
    пер ОжидаемыйПользователь: Строка = ""
;
структура ИтогПилота
    пер version: Строка = "opera-pc-pilot-3.2"
    пер code: Строка = ""
    пер node_code: Строка = ""
    пер name: Строка = ""
    пер stage: Строка = ""
    пер count: Число = 0
    пер user_id: Строка = ""
    пер global_user_id: Строка = ""
    пер user_by_code: Строка = ""
    пер user_by_name: Строка = ""
    пер credential_id: Строка = ""
    пер created: Булево = Ложь
    пер user_created: Булево = Ложь
    пер key_issued: Булево = Ложь
    пер clientid: Строка = ""
    пер clientsecret: Строка = ""
    пер error: Строка = ""
;

// Читает только ИС; не ищет пользователей и не преобразует UserId в строку.
метод ПрочитатьПилот(Код: Строка, Имя: Строка): ИтогПилота
    пер Итог = новый ИтогПилота()
    Итог.code = Код
    пер КодУчастника = "S" + Код.Заменить("-", "")
    Итог.node_code = КодУчастника
    Итог.name = Имя
    пер ИС = Запрос{
        ВЫБРАТЬ Т.Код, Т.ПользовательПоУмолчанию КАК Пользователь, Т.ИдТокена КАК Ключ
        ИЗ Exch КАК Т
    }
    для СтрокаИС из ИС.Выполнить()
        если СтрокаИС.Код == КодУчастника или СтрокаИС.Код == Код
            Итог.count = Итог.count + 1
            Итог.node_code = СтрокаИС.Код
            Итог.credential_id = СтрокаИС.Ключ
        ;
    ;
    возврат Итог
;

// Отдаёт состояние и идентификатор ошибки; административный секрет в ответ не включается.
метод ОтветитьПилотом(Запрос: HttpСервисЗапрос, Итог: ИтогПилота, Статус: Число)
    если Статус != 200
        если не Итог.clientsecret.Пусто()
            Итог.error = Итог.error.Заменить(Итог.clientsecret, "[secret removed]")
        ;
        Итог.clientid = ""
        Итог.clientsecret = ""
    ;
    УстановитьЗаголовкиОтвета(Запрос)
    Запрос.Ответ.КодСтатуса = Статус
    Запрос.Ответ.УстановитьТело(СериализацияJson.ЗаписатьОбъект(Итог))
;

// Позволяет исследовать последствия старого HTTP 500 без повторного создания пользователя.
метод СостояниеПилота(Запрос: HttpСервисЗапрос)
    пер Итог = новый ИтогПилота()
    попытка
        Итог.stage = "read_parameters"
        пер Код = Запрос.Параметры.ПолучитьПервый("kod")
        пер Имя = Запрос.Параметры.ПолучитьПервый("name")
        если Код == Неопределено или Имя == Неопределено
            ОтветитьОшибкой(Запрос, 400, "missing_kod_or_name")
            возврат
        ;
        пер GUID = НормализоватьКод(Код.ВСтроку())
        если GUID.Пусто()
            ОтветитьОшибкой(Запрос, 400, "invalid_store_guid")
            возврат
        ;
        Итог.stage = "read_catalog_and_users"
        Итог = ПрочитатьПилот(GUID, Имя.ВСтроку())
        Итог.stage = "read_only_done_membership_not_checked"
        ОтветитьПилотом(Запрос, Итог, 200)
    поймать Искл: Исключение
        Итог.error = Искл.Описание
        ОтветитьПилотом(Запрос, Итог, 500)
    ;
;

// Создаёт только ИС; связывает с существующим общим тестовым K0410 и включает в оба процесса.
// Пользователей и API-ключей не создаёт. Существующие ИС и их владельцев не изменяет.
метод ЗарегистрироватьПилот(Запрос: HttpСервисЗапрос)
    пер Итог = новый ИтогПилота()
    пер Вход = новый ЗаявкаПилота()
    попытка
        Итог.stage = "read_request"
        пер НастройкиJson = новый НастройкиЧтенияОбъектовJson()
        НастройкиJson.ИгнорироватьНеизвестныеСвойства = Ложь
        Вход = СериализацияJson.ПрочитатьОбъект(Запрос.Тело, Тип<ЗаявкаПилота>, НастройкиJson)
        Вход.Код = НормализоватьКод(Вход.Код)
        если Вход.Код.Пусто() или Вход.Наименование.Пусто()
            ОтветитьОшибкой(Запрос, 400, "invalid_store_guid_or_name")
            возврат
        ;
        Итог.stage = "read_existing"
        Итог = ПрочитатьПилот(Вход.Код, Вход.Наименование)
        если Итог.count != 0
            Итог.error = "existing_info_system_no_new_key_check_existing_connection"
            ОтветитьПилотом(Запрос, Итог, 409)
            возврат
        ;
        Итог.stage = "find_existing_shared_user"
        пер Список = СпискиПользователей.ПолучитьСписокПоУмолчанию().Ид
        пер Общий = ПользователиСервиса.НайтиПоПредставлению("K0410", Список)
        если Общий == Неопределено
            Итог.error = "existing_shared_user_K0410_not_found"
            ОтветитьПилотом(Запрос, Итог, 409)
            возврат
        ;
        // Найти принимает ИдПользователя и возвращает ссылку; сигнатура подтверждена IDE.
        Итог.stage = "find_connected_user"
        пер Пользователь = Пользователи.Найти(Общий.Ид)
        если Пользователь == Неопределено
            Итог.error = "connected_shared_user_not_found"
            ОтветитьПилотом(Запрос, Итог, 409)
            возврат
        ;
        исп Транзакция = Транзакции.Начать()
        попытка
            Итог.stage = "save_exch"
            пер ИС = новый Exch.Объект()
            ИС.Код = Итог.node_code
            ИС.Наименование = Вход.Наименование
            ИС.Описание = "opera-pc-pilot-shared-user"
            ИС.ПользовательПоУмолчанию = Пользователь
            ИС.Записать()
            Итог.stage = "opera_participant"
            Opera.ДобавитьУчастника(ИС, ИС.ПользовательПоУмолчанию)
            Итог.stage = "opera_group"
            Opera.ДобавитьУчастниковВГруппы("MagazyniOpera", ИС)
            Итог.stage = "pc_participant"
            PC.ДобавитьУчастника(ИС, ИС.ПользовательПоУмолчанию)
            Итог.stage = "pc_group"
            PC.ДобавитьУчастниковВГруппы("MagazinyPriceChecker", ИС)
            Итог.stage = "commit"
            Транзакция.Фиксировать()
            Итог.count = 1
            Итог.created = Истина
        поймать Искл: Исключение
            Транзакция.Откатить()
            Итог.error = Искл.Описание
            ОтветитьПилотом(Запрос, Итог, 500)
            возврат
        ;
        Итог.stage = "registered_existing_user_no_new_key"
        ОтветитьПилотом(Запрос, Итог, 200)
    поймать Искл: Исключение
        Итог.error = Искл.Описание
        ОтветитьПилотом(Запрос, Итог, 500)
    ;
;
// }} semidockij - 28.10.2026
