// {{ semidockij - 29.10.2026 - Чтение фактических параметров и локальная проверка маршрутов
// Консоль «На сервере». Настройки, очередь, full и сеть не изменяет.
Параметры = КХ_ОбменШиныОпера.ПараметрыОбмена();
Для Каждого Имя Из СтрРазделить(
    "СервисИнтеграции,СервисИнтеграцииПрайсЧекеры,КаналОпера,КаналПрайсЧекеры,ПрежнийКаналПрайсЧекеры", ",") Цикл
    Значение = Неопределено;
    Если Параметры.Свойство(Имя, Значение) Тогда
        Сообщить("ПАРАМЕТР " + Имя + "=[" + Строка(Значение)
            + "]; тип=" + Строка(ТипЗнч(Значение)));
        Если ТипЗнч(Значение) = Тип("Строка") Тогда
            Сообщить("  длина=" + Строка(СтрДлина(Значение))
                + "; после СокрЛП=" + Строка(СтрДлина(СокрЛП(Значение))));
        КонецЕсли;
    Иначе
        Сообщить("ПАРАМЕТР " + Имя + " ОТСУТСТВУЕТ");
    КонецЕсли;
КонецЦикла;

Проверки = Новый Массив;
Проверки.Добавить(Новый Структура("Метка,Система,Канал,Проект",
    "Opera", "Opera", "Основной_ExchangeOpera_FromOpera", ""));
Проверки.Добавить(Новый Структура("Метка,Система,Канал,Проект",
    "PC новый", "PriceCheker", "Komandor_Opera_PC_Основной_PC_FromShops", ""));
Проверки.Добавить(Новый Структура("Метка,Система,Канал,Проект",
    "PC прежний", "PriceCheker", "Основной_PriceChekerExc_FromShops", ""));
Проверки.Добавить(Новый Структура("Метка,Система,Канал,Проект",
    "Справочник PC", "StructuralUnits", "Komandor_Opera_PC_Основной_PC_FromShops", "pricechecker"));
ФактическийКанал = Неопределено;
Если Параметры.Свойство("КаналПрайсЧекеры", ФактическийКанал) Тогда
    Проверки.Добавить(Новый Структура("Метка,Система,Канал,Проект",
        "PC из параметров модуля", "PriceCheker", ФактическийКанал, ""));
КонецЕсли;

Для Каждого Проверка Из Проверки Цикл
    Попытка
        Маршрут = КХ_ОбменШиныОпера.МаршрутКаналаОтправки(
            Проверка.Система, Проверка.Канал, Проверка.Проект);
        Сообщить("OK " + Проверка.Метка + ": сервис=["
            + Строка(Маршрут.СервисИнтеграции) + "]; канал=["
            + Строка(Маршрут.Канал) + "]");
    Исключение
        Сообщить("FAIL " + Проверка.Метка + ": " + ОписаниеОшибки());
    КонецПопытки;
КонецЦикла;
Сообщить("Диагностика завершена. Отправка, ACK, смена ключей и full не вызывались.");
// }} semidockij - 29.10.2026
