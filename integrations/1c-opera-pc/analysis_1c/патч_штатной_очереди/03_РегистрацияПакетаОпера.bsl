// Добавить в существующий КХ_ОбменШиныОпера.
// Это регистрация готового пакета; она не выбирает товары и не отправляет их.
// УзелПолучатель передаётся явно согласно маршрутизации вашей схемы.
Функция ЗарегистрироватьПакетОпераВОчередиШины(Пакет, УзелПолучатель) Экспорт

	Если ТипЗнч(Пакет) <> Тип("Структура") Тогда
		ВызватьИсключение "Пакет Оперы должен быть структурой";
	КонецЕсли;

	ИдентификаторПакета = Неопределено;

	Если НЕ Пакет.Свойство("batch_id", ИдентификаторПакета) Тогда
		ВызватьИсключение "В пакете Оперы отсутствует batch_id";
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(Строка(ИдентификаторПакета))) Тогда
		ВызватьИсключение "В пакете Оперы не заполнен batch_id";
	КонецЕсли;

	// Стабильный UUID пакета, а не GUID номенклатуры и не новый UUID на повтор.
	ИдентификаторПакета = Новый УникальныйИдентификатор(Строка(ИдентификаторПакета));

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(ЗаписьJSON, Пакет);
	ТекстПакета = ЗаписьJSON.Закрыть();

	Интеграция1СШина.ЗарегистрироватьОбъектВОчереди(
		ТекстПакета,
		УзелПолучатель,
		"Komandor_PriceCheker_Основной_ExchangeOpera_FromShopsOpera",
		ИдентификаторПакета,
		"Opera");

	Возврат Строка(ИдентификаторПакета);

КонецФункции
