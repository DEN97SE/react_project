// В модуле Интеграция1СШинаПереопределяемый заменить только эту функцию.
// Существующая КодТекущегоУзлаВШине остаётся в модуле.
Функция ОтправитьСообщениеВШину(Данные, Узлы, КаналСервисаИнтеграции, ДополнительныеПараметрыЗаголовкаСообщения = "") Экспорт

	КаналИнтеграции = СокрЛП(КаналСервисаИнтеграции);
	ЭтоТипТоварногоОбмена = Данные.ТипСообщения = "OperaProducts"
		Или Данные.ТипСообщения = "PriceCheckerResponse";

	// Имена взяты из последнего скриншота сервиса ExchangePriceCheker.
	// Выбор сервиса по каналу нужен также для штатных сообщений receipt.
	ЭтоКаналТоварногоОбмена = КаналИнтеграции = "Komandor_PriceCheker_Основной_ExchangeOpera_FromShopsOpera"
		Или КаналИнтеграции = "Komandor_PriceCheker_Основной_ExchangeOpera_ToBackend";

	ЭтоТоварныйОбмен = ЭтоТипТоварногоОбмена Или ЭтоКаналТоварногоОбмена;
	СервисИнтеграции = "СервисИнтеграцииВЭДО";
	ПараметрыЗаголовка = ДополнительныеПараметрыЗаголовкаСообщения;

	Если ЭтоТоварныйОбмен Тогда

		СЕ = ОбщиеПроцедурыИФункцииПовтИсп.ТекущаяСтруктурнаяЕдиница();

		Если НЕ ЗначениеЗаполнено(СЕ) Тогда
			Возврат Новый Структура("ЕстьОшибки,ТекстОшибки", Истина,
				"Не определена структурная единица отправителя товарного обмена");
		КонецЕсли;

		Если ПустаяСтрока(СокрЛП(Строка(СЕ.Код))) Тогда
			Возврат Новый Структура("ЕстьОшибки,ТекстОшибки", Истина,
				"Не заполнен код структурной единицы отправителя товарного обмена");
		КонецЕсли;

		СервисИнтеграции = "ExchangePriceCheker";

		// Не изменяем переданную вызывающим кодом структуру заголовков.
		ПараметрыЗаголовка = Новый Структура;

		Если ТипЗнч(ДополнительныеПараметрыЗаголовкаСообщения) = Тип("Структура") Тогда
			Для Каждого Параметр Из ДополнительныеПараметрыЗаголовкаСообщения Цикл
				ПараметрыЗаголовка.Вставить(Параметр.Ключ, Параметр.Значение);
			КонецЦикла;
		КонецЕсли;

		Если ЭтоТипТоварногоОбмена Тогда
			ПараметрыЗаголовка.Вставить("Content-Type", "application/json");
			ПараметрыЗаголовка.Вставить("configuration", "Astor");
		КонецЕсли;

	КонецЕсли;

	КодТекущегоУзла = КодТекущегоУзлаВШине();

	Если ПустаяСтрока(КодТекущегоУзла) Тогда
		ВызватьИсключение "Не задан код системы в 1С:Шине";
	КонецЕсли;

	Возврат Интеграция1СШина.ОтправитьИсходящееСообщениеВШину(
		СервисИнтеграции, КаналИнтеграции,
		Данные.ТипСообщения, КодТекущегоУзла, Данные.Данные, Узлы, ПараметрыЗаголовка);

КонецФункции
