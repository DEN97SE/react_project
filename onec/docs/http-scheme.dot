digraph HTTP_KP {
 graph [rankdir=LR, bgcolor="#f6f8fc", pad="0.3", nodesep="0.55", ranksep="0.65", fontname="DejaVu Sans", fontsize=20, labelloc=t, label="HTTP через Шину · существующая очередь · TTL 72 часа"];
 node [shape=box, style="rounded,filled", fillcolor=white, color="#aab9cd", fontname="DejaVu Sans", fontsize=12, margin="0.15,0.12"];
 edge [color="#52657f", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10];
 A [label="Астор", fillcolor="#dbedff"];
 Q [label="ОчередьШины\nKP_SUPPLIER · 72 часа", fillcolor="#dbedff"];
 D [label="DocumentManager\nДО", fillcolor="#e5e0ff"];
 B [label="Бэкенд кабинета\nHTTP / HTTPS", fillcolor="#dcf4e8"];
 subgraph cluster_bus {
  label="1С:Шина · существующие имена узлов"; color="#9bb2d1"; style="rounded"; bgcolor="#edf3fb"; fontsize=16;
  AK [label="Astor_to_kp"];
  DK [label="DO_to_kp"];
  R [label="МаршрутизаторПоСодержимому\nСообщение.Параметры[configuration]"];
  HA [label="Http_kp_Astor",color="#28a278"];
  HD [label="Http_kp_DO",color="#28a278"];
  RA [label="From_kp_Astor\nОтвет от сайта"];
  RD [label="From_kp_DO\nОтвет от сайта"];
  KP [label="HTTP-сервис KP\nПолучитьКП / GET"];
  M [label="message_kp"];
  TD [label="kp_to_DO"];
 }
 A -> Q -> AK -> R;
 D -> DK -> R;
 R -> HA [label="Astor"];
 R -> HD [label="DocumentManager"];
 HA -> B [label="исходный JSON",color="#28a278"];
 HD -> B [label="данные ДО",color="#28a278"];
 HA -> RA [label="HTTP-ответ",style=dashed,constraint=false];
 HD -> RD [label="HTTP-ответ",style=dashed,constraint=false];
 RA -> A [label="результат: требуется привязка",style=dashed,constraint=false];
 A -> Q [label="подтверждён успех → удалить",style=dashed,constraint=false];
 RD -> D [style=dashed,constraint=false];
 B -> KP [label="входящий запрос с телом КП",constraint=false,color="#9b6fb5"];
 KP -> M -> TD;
 TD -> D [label="доставка КП в ДО",constraint=false];
}
